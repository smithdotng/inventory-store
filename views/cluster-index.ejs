<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Market Clusters</title>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Jost', sans-serif; background: #f7f7f8; color: #222; }
    .topbar { background: #0d0d1a; padding: 20px 32px; display: flex; align-items: center; justify-content: space-between; }
    .topbar img { height: 36px; }
    .topbar a.home-link { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem; }
    .topbar a.home-link:hover { color: #FF9800; }
    .hero { background: #0d0d1a; padding: 50px 32px 70px; text-align: center; }
    .hero h1 { color: #fff; font-size: 2.1rem; font-weight: 700; margin-bottom: 12px; }
    .hero p { color: rgba(255,255,255,0.6); font-size: 1rem; max-width: 560px; margin: 0 auto; }
    .wrap { max-width: 1100px; margin: -40px auto 80px; padding: 0 24px; }
    .cluster-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .cluster-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.08); text-decoration: none; color: inherit; display: block; transition: transform 0.2s, box-shadow 0.2s; }
    .cluster-card:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(0,0,0,0.12); }
    .cluster-card-img { height: 150px; background: linear-gradient(135deg, #008B8B, #0d0d1a); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.85); font-size: 2.2rem; }
    .cluster-card-img img { width: 100%; height: 150px; object-fit: cover; }
    .cluster-card-body { padding: 20px 22px; }
    .cluster-card-name { font-size: 1.15rem; font-weight: 700; color: #0d0d1a; margin-bottom: 6px; }
    .cluster-card-desc { font-size: 0.87rem; color: #888; margin-bottom: 12px; min-height: 40px; }
    .cluster-card-footer { display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; color: #666; }
    .cluster-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
    .cluster-tag { background: #f0f0f0; padding: 2px 9px; border-radius: 20px; font-size: 0.7rem; color: #666; }
    .empty-state { text-align: center; color: #999; padding: 60px 0; }
  </style>
</head>
<body>
<%- include('partials/shopper-bar', { shopper: typeof shopper !== 'undefined' ? shopper : null }) %>

  <div class="topbar">
    <a href="/"><img src="/images/logo.png" alt="Shed"></a>
    <a href="/search" class="home-link"><i class="fas fa-search"></i> Search Shed</a>
  </div>

  <div class="hero">
    <h1>Shop by Market Cluster</h1>
    <p>Browse established market areas on Shed — like Alaba International for electricals and electronics — and see every store and product in that market at once.</p>
  </div>

  <div class="wrap">
    <% if (!clusters.length) { %>
      <div class="empty-state">No market clusters are set up yet. Check back soon.</div>
    <% } else { %>
      <div class="cluster-grid">
        <% clusters.forEach(function(c) { %>
          <a href="/cluster/<%= c.slug %>" class="cluster-card">
            <div class="cluster-card-img">
              <% if (c.image) { %>
                <img src="<%= c.image %>" alt="<%= c.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<i class=&quot;fas fa-map-marker-alt&quot;></i>'">
              <% } else { %>
                <i class="fas fa-map-marker-alt"></i>
              <% } %>
            </div>
            <div class="cluster-card-body">
              <div class="cluster-card-name"><%= c.name %></div>
              <% if (c.description) { %>
                <div class="cluster-card-desc"><%= c.description %></div>
              <% } %>
              <% if (c.focusCategories && c.focusCategories.length) { %>
                <div class="cluster-tags">
                  <% c.focusCategories.forEach(function(cat) { %><span class="cluster-tag"><%= cat %></span><% }) %>
                </div>
              <% } %>
              <div class="cluster-card-footer">
                <span><i class="fas fa-store" style="color:#008B8B;margin-right:4px;"></i><%= c.storeCount %> store<%= c.storeCount === 1 ? '' : 's' %></span>
                <span style="color:#008B8B;font-weight:600;">Browse <i class="fas fa-arrow-right"></i></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
