<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Transactions | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Transactions</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
      /* Transaction actions */
      .transaction-actions {
        display: flex;
        gap: 15px;
        align-items: center;
      }
      .transaction-actions form {
        margin: 0;
      }
      
      /* Outlet transaction styling */
      .outlet-transaction {
        background-color: #f8fafc;
        border-left: 4px solid #3b82f6;
      }
      .outlet-badge {
        background-color: #e0f2fe;
        color: #0369a1;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.8rem;
        margin-left: 5px;
        display: inline-block;
      }
      .source-indicator {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 3px;
      }
      .admin-source {
        color: #10b981;
      }
      .outlet-source {
        color: #3b82f6;
      }
      /* Updated Filter Section Styles */
      .filter-section {
        margin: 20px 0;
        width: 95%;
      }

      .filter-section form {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr auto auto;
        gap: 15px;
        align-items: center;
        max-width: 100%;
      }

      .filter-section label {
        font-weight: 500;
        color: #374151;
      }

      .filter-section input[type="date"] {
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.9rem;
        width: 100%;
        max-width: 200px;
      }

      .filter-btn,
      .reset-btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
      }

      .filter-btn {
        background-color: #20b115;
        color: white;
      }

      .filter-btn:hover {
        background-color: #4deb25;
        transform: translateY(-1px);
      }

      .reset-btn {
        background-color: #6b7280;
        color: white;
      }

      .reset-btn:hover {
        background-color: #4b5563;
        transform: translateY(-1px);
      }

      /* Responsive Styles */
      @media (max-width: 768px) {
        .filter-section form {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .filter-section input[type="date"] {
          max-width: 100%;
        }

        .filter-btn,
        .reset-btn {
          width: 100%;
        }
      
    </style>
  </head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Shedfactory Business Solutions">
    </div>
    
    <h2>Welcome, <%= username %>!</h2>
    <a href="/pos">Point of Sale</a>
    <a href="/update-stock">Manage Inventory</a>
    <a href="/invoices">Generate Invoice</a>
    <a href="/transactions" class="active">View Transactions</a>
    <a href="/customers">Customers</a>
    <a href="/home">Manage Outlets</a>
    <a href="/admin-logout">Log Out</a>
  </div>

  <!-- Toggle Button -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent">
    <div class="container">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
      </div>
      <h1>Transactions</h1>

      <!-- Business Details -->
      <div class="business-details">
        <p><strong>Business Name:</strong> <%= admin.businessName || 'N/A' %></p>
        <p><strong>Email:</strong> <%= admin.email || 'N/A' %></p>
        <p><strong>Currency:</strong> <%= admin.currency || 'N/A' %></p>
      </div>

      <!-- Filter Form -->
      <!-- Updated Filter Form -->
        <div class="filter-section">
          <form method="GET" action="/transactions">
            <label for="startDate" style="color: #d1d5db;">From:</label>
            <input type="date" id="startDate" name="startDate" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>">
            <label for="endDate" style="color: #d1d5db;">To:</label>
            <input type="date" id="endDate" name="endDate" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>">
            <button type="submit" class="filter-btn">Filter</button>
            <a href="/transactions" class="reset-btn">Reset</a>
          </form>
        </div>

      <!-- Transactions Table -->
      <div class="table-section">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Customer</th>
              <th>Source</th>
              <th>Items</th>
              <th>Total Amount</th>
              <th>Payment Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(transaction => { %>
              <tr class="<%= transaction.outletName ? 'outlet-transaction' : '' %>">
                <!-- Date -->
                <td><%= transaction.date ? new Date(transaction.date).toLocaleString() : 'N/A' %></td>

                <!-- Customer Name -->
                <td><%= transaction.customerName || 'N/A' %></td>

                <!-- Source -->
                <td>
                  <% if (transaction.outletName) { %>
                    <span class="outlet-source">
                      <i class="source-indicator">Outlet:</i><br>
                      <%= transaction.outletName %>
                    </span>
                  <% } else { %>
                    <span class="admin-source">
                      <i class="source-indicator">Admin Store</i>
                    </span>
                  <% } %>
                </td>

                <!-- Items -->
                <td>
                  <ul>
                    <% if (transaction.items && transaction.items.length > 0) { %>
                      <% transaction.items.forEach(item => { %>
                        <li>
                          <%= item.itemName %> 
                          (Qty: <%= item.quantity %>, Cost: <%= admin.currency %> <%= (item.unitCost || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>)
                        </li>
                      <% }) %>
                    <% } else if (transaction.itemName) { %>
                      <!-- For older single-item transactions -->
                      <li>
                        <%= transaction.itemName %>
                        (Qty: <%= transaction.quantity %>, Cost: <%= admin.currency %> <%= (transaction.cost || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>)
                      </li>
                    <% } else { %>
                      <li>No items found.</li>
                    <% } %>
                  </ul>
                </td>

                <!-- Total Amount -->
                <td>
                  <%= admin.currency %> 
                  <% if (transaction.totalAmount !== undefined && transaction.totalAmount !== null) { %>
                    <%= transaction.totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  <% } else if (transaction.cost && transaction.quantity) { %>
                    <!-- For older single-item transactions -->
                    <%= (transaction.cost * transaction.quantity).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  <% } else { %>
                    0.00
                  <% } %>
                </td>

                <!-- Payment Status -->
                <td>
                  <%= transaction.paymentStatus || 'Pending' %>
                </td>

                <!-- Actions -->
                <td>
                  <div class="transaction-actions">
                    <a href="/receipt/<%= transaction._id %>" class="download-btn">Receipt</a>
                    <% if (transaction.paymentStatus !== 'Paid') { %>
                      <form action="/transactions/mark-paid/<%= transaction._id %>" method="POST">
                        <button type="submit" class="mark-paid-btn">Mark Paid</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Toggle sidebar visibility (only active on small screens)
    toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
        sidebar.classList.toggle('hidden');
        if (sidebar.classList.contains('visible')) {
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        } else {
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        }
      });

    // Set initial sidebar state
    function setSidebarState() {
      if (window.innerWidth <= 768) {
        sidebar.classList.add('hidden');
        mainContent.style.marginLeft = '0';
        mainContent.style.width = '100%';
      } else {
        sidebar.classList.remove('hidden');
        sidebar.classList.remove('visible');
        mainContent.style.marginLeft = '200px';
        mainContent.style.width = 'calc(100% - 200px)';
      }
    }
    setSidebarState();
    window.addEventListener('resize', setSidebarState);
  </script>
</body>
</html>