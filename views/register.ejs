<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Create Your Account</title>

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Ashley CSS (same stack as landing page) -->
  <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
  <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; font-family: 'Jost', sans-serif; }
    body { display: flex; min-height: 100vh; background: #0d0d1a; }

    /* ── Left dark panel ── */
    .auth-left {
      width: 38%;
      background: #0d0d1a;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 70px 52px;
      position: relative;
      overflow: hidden;
    }
    .auth-left::before {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 340px; height: 340px;
      border-radius: 50%;
      background: rgba(0, 139, 139, 0.07);
    }
    .auth-left::after {
      content: '';
      position: absolute;
      bottom: -60px; left: -40px;
      width: 240px; height: 240px;
      border-radius: 50%;
      background: rgba(0, 139, 139, 0.05);
    }
    .auth-logo { margin-bottom: 44px; }
    .auth-logo img { width: 120px; height: auto; }
    .auth-tagline h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
      margin-bottom: 16px;
    }
    .auth-tagline h1 span { color: #008B8B; }
    .auth-tagline p { color: rgba(255,255,255,0.5); font-size: 0.95rem; line-height: 1.7; }
    .auth-steps { margin-top: 40px; display: flex; flex-direction: column; gap: 16px; }
    .auth-step { display: flex; align-items: flex-start; gap: 14px; }
    .step-num {
      width: 28px; height: 28px; min-width: 28px;
      background: #008B8B;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.78rem; font-weight: 700; color: #fff;
    }
    .step-text { color: rgba(255,255,255,0.65); font-size: 0.88rem; line-height: 1.5; }
    .step-text strong { color: rgba(255,255,255,0.9); display: block; }

    /* ── Right form panel ── */
    .auth-right {
      flex: 1;
      background: #fff;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 56px 48px;
      overflow-y: auto;
    }
    .auth-form-box { width: 100%; max-width: 560px; }
    .auth-form-box h2 {
      font-size: 1.9rem;
      font-weight: 700;
      color: #0d0d1a;
      margin-bottom: 6px;
    }
    .auth-form-box .subtitle { color: #888; font-size: 0.93rem; margin-bottom: 32px; }

    .row { display: flex; gap: 18px; }
    .col-half { flex: 1; }

    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block;
      font-weight: 600;
      font-size: 0.82rem;
      color: #555;
      margin-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .form-control {
      width: 100%;
      padding: 12px 15px;
      border: 1.5px solid #e5e5e5;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: 'Jost', sans-serif;
      color: #222;
      background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: #008B8B;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(0,139,139,0.1);
    }

    .btn-auth {
      width: 100%;
      padding: 14px;
      background: #008B8B;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      font-family: 'Jost', sans-serif;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-top: 10px;
    }
    .btn-auth:hover { background: #006f6f; transform: translateY(-1px); }

    .btn-upload {
      padding: 10px 18px;
      background: transparent;
      border: 1.5px solid #008B8B;
      border-radius: 8px;
      color: #008B8B;
      font-family: 'Jost', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .btn-upload:hover { background: #008B8B; color: #fff; }

    .logo-preview-container { margin-top: 14px; }
    #logoPreview {
      max-width: 100px; max-height: 100px;
      border-radius: 10px;
      border: 2px solid #e5e5e5;
      display: none;
    }

    .password-requirements {
      font-size: 0.82rem;
      color: #999;
      margin-top: 8px;
      list-style: none;
      padding: 0;
    }
    .password-requirements li { margin: 3px 0; padding-left: 0; }
    .password-requirements li::before { content: none; }
    .password-requirements .valid { color: #008B8B; }
    .password-requirements .invalid { color: #e74c3c; }

    .auth-links { text-align: center; margin-top: 24px; color: #888; font-size: 0.9rem; }
    .auth-links a { color: #008B8B; font-weight: 500; text-decoration: none; }
    .auth-links a:hover { text-decoration: underline; }

    .alert-error {
      background: #fff5f5;
      border: 1px solid #ffd0d0;
      color: #c0392b;
      padding: 13px 16px;
      border-radius: 8px;
      margin-bottom: 24px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 9px;
    }

    @media (max-width: 900px) {
      body { flex-direction: column; }
      .auth-left { display: none; }
      .auth-right { padding: 40px 24px; }
      .row { flex-direction: column; gap: 0; }
    }
  </style>
</head>
<body>

  <!-- Left: Dark branding panel -->
  <div class="auth-left">
    <div class="auth-logo">
      <img src="/images/logo.png" alt="Shed">
    </div>
    <div class="auth-tagline">
      <h1>Start Selling Smarter<br>with <span>Shed.</span></h1>
      <p>Inventory, invoices, and your own online storefront — all in one place. 14 days free, no card required.</p>
    </div>
    <div class="auth-steps">
      <div class="auth-step">
        <div class="step-num">1</div>
        <div class="step-text"><strong>Create your account</strong>Fill in your business details below — no card needed</div>
      </div>
      <div class="auth-step">
        <div class="step-num">2</div>
        <div class="step-text"><strong>Set up your inventory</strong>Add products, set prices and stock levels</div>
      </div>
      <div class="auth-step">
        <div class="step-num">3</div>
        <div class="step-text"><strong>Sell everywhere</strong>Invoice from POS and sell from your own storefront</div>
      </div>
      <div class="auth-step">
        <div class="step-num"><i class="fas fa-gift" style="font-size:0.7rem;"></i></div>
        <div class="step-text"><strong>14-day free trial</strong>Full access from day one — we'll only ask for payment when your trial ends</div>
      </div>
    </div>
  </div>

  <!-- Right: Form panel -->
  <div class="auth-right">
    <div class="auth-form-box">
      <h2>Create Your Shed</h2>
      <p class="subtitle">14-day free trial — no card required. Set up your business account below.</p>

      <% if (error) { %>
        <div class="alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>

      <form action="/admin-register<%= typeof referralCode !== 'undefined' && referralCode ? '?ref=' + referralCode : '' %>" method="POST" enctype="multipart/form-data">

        <div class="row">
          <div class="col-half">
            <div class="form-group">
              <label>Business Name</label>
              <input type="text" class="form-control" name="businessName" placeholder="Your Business Name" required
                value="<%= typeof businessName !== 'undefined' ? businessName : '' %>">
            </div>
          </div>
          <div class="col-half">
            <div class="form-group">
              <label>Username</label>
              <input type="text" class="form-control" name="username" placeholder="Choose a username" required
                value="<%= typeof username !== 'undefined' ? username : '' %>">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-half">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" class="form-control" name="firstName" placeholder="First Name" required
                value="<%= typeof firstName !== 'undefined' ? firstName : '' %>">
            </div>
          </div>
          <div class="col-half">
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" class="form-control" name="lastName" placeholder="Last Name" required
                value="<%= typeof lastName !== 'undefined' ? lastName : '' %>">
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Email Address</label>
          <input type="email" class="form-control" name="email" placeholder="you@example.com" required
            value="<%= typeof email !== 'undefined' ? email : '' %>">
        </div>

        <div class="row">
          <div class="col-half">
            <div class="form-group">
              <label>Country</label>
              <select class="form-control" name="country" id="country" required>
                <option value="">Select Country</option>
                <option value="Nigeria" <%= typeof country !== 'undefined' && country === 'Nigeria' ? 'selected' : '' %>>Nigeria</option>
                <option value="South Africa" <%= typeof country !== 'undefined' && country === 'South Africa' ? 'selected' : '' %>>South Africa</option>
                <option value="Ghana" <%= typeof country !== 'undefined' && country === 'Ghana' ? 'selected' : '' %>>Ghana</option>
                <option value="Kenya" <%= typeof country !== 'undefined' && country === 'Kenya' ? 'selected' : '' %>>Kenya</option>
              </select>
            </div>
          </div>
          <div class="col-half">
            <div class="form-group">
              <label>Currency</label>
              <select class="form-control" name="currency" id="currency" required>
                <option value="">Select Currency</option>
                <option value="NGN" <%= typeof currency !== 'undefined' && currency === 'NGN' ? 'selected' : '' %>>NGN (₦)</option>
                <option value="ZAR" <%= typeof currency !== 'undefined' && currency === 'ZAR' ? 'selected' : '' %>>ZAR (R)</option>
                <option value="GHS" <%= typeof currency !== 'undefined' && currency === 'GHS' ? 'selected' : '' %>>GHS (₵)</option>
                <option value="KES" <%= typeof currency !== 'undefined' && currency === 'KES' ? 'selected' : '' %>>KES (KSh)</option>
                <option value="USD" <%= typeof currency !== 'undefined' && currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Logo Upload -->
        <div class="form-group">
          <label>Business Logo <span style="font-weight:400;text-transform:none;color:#aaa;">(optional)</span></label>
          <input type="file" id="logoInput" name="logo" accept="image/*" style="display:none">
          <input type="hidden" name="croppedImageData" id="croppedImageData">
          <button type="button" class="btn-upload" onclick="document.getElementById('logoInput').click()">
            <i class="fas fa-upload"></i> Upload Logo
          </button>
          <div class="logo-preview-container">
            <img id="logoPreview" alt="Logo preview">
          </div>
        </div>

        <div class="row">
          <div class="col-half">
            <div class="form-group">
              <label>Password</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="Create a strong password" required>
              <ul class="password-requirements">
                <li id="req-length"  class="invalid"><i class="fas fa-times"></i> At least 8 characters</li>
                <li id="req-upper"   class="invalid"><i class="fas fa-times"></i> One uppercase letter</li>
                <li id="req-lower"   class="invalid"><i class="fas fa-times"></i> One lowercase letter</li>
                <li id="req-number"  class="invalid"><i class="fas fa-times"></i> One number</li>
                <li id="req-special" class="invalid"><i class="fas fa-times"></i> One special character</li>
              </ul>
            </div>
          </div>
          <div class="col-half">
            <div class="form-group">
              <label>Confirm Password</label>
              <input type="password" class="form-control" id="confirmPassword" placeholder="Repeat your password" required>
              <div id="confirmFeedback" style="font-size:0.82rem;margin-top:6px;"></div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-auth">
          Create Account &nbsp;<i class="fas fa-arrow-right"></i>
        </button>
      </form>

      <div class="auth-links">
        <p>Already have an account? <a href="/admin-login">Sign in here</a></p>
        <p style="margin-top:8px;">Already received a code? <a href="/verify-email">Enter it here →</a></p>
        <p style="margin-top:8px;"><a href="/outlet-login">Outlet Manager? Sign in here →</a></p>
      </div>
    </div>
  </div>

  <script src="/js/plugins/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
  <script>
    // Country → Currency auto-sync
    $('#country').on('change', function () {
      const map = { Nigeria: 'NGN', 'South Africa': 'ZAR', Ghana: 'GHS', Kenya: 'KES' };
      const val = $(this).val();
      if (map[val]) $('#currency').val(map[val]);
    });

    // Logo preview
    $('#logoInput').on('change', function (e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => $('#logoPreview').attr('src', ev.target.result).show();
      reader.readAsDataURL(file);
    });

    // Password strength
    function check(id, ok) {
      const el = document.getElementById(id);
      if (!el) return;
      el.className = ok ? 'valid' : 'invalid';
      el.innerHTML = (ok ? '<i class="fas fa-check"></i>' : '<i class="fas fa-times"></i>') + ' ' + el.innerText.replace(/^. /, '');
    }
    $('#password').on('input', function () {
      const p = $(this).val();
      check('req-length',  p.length >= 8);
      check('req-upper',   /[A-Z]/.test(p));
      check('req-lower',   /[a-z]/.test(p));
      check('req-number',  /[0-9]/.test(p));
      check('req-special', /[^A-Za-z0-9]/.test(p));
    });

    // Confirm match
    $('#confirmPassword').on('input', function () {
      const match = $(this).val() === $('#password').val() && $('#password').val();
      $('#confirmFeedback')
        .text($(this).val() ? (match ? 'Passwords match ✓' : 'Passwords do not match') : '')
        .css('color', match ? '#008B8B' : '#e74c3c');
    });
  </script>
</body>
</html>
