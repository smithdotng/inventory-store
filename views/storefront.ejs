    <script>
        const SHED_SHOPPER_LOGGED_IN = <%= (typeof shopper !== 'undefined' && shopper) ? 'true' : 'false' %>;

        // Add to the account-based, cross-store cart (server-side). Anonymous
        // visitors are sent to sign in first — the cart lives on the account.
        async function addToShopperCart(adminId, itemId, button) {
            if (!SHED_SHOPPER_LOGGED_IN) {
                window.location.href = '/shopper/login?next=' + encodeURIComponent(window.location.pathname);
                return;
            }
            const original = button.innerHTML;
            button.disabled = true;
            button.innerHTML = 'Adding…';
            try {
                const res = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ adminId, itemId, quantity: 1 })
                });
                const data = await res.json();
                if (data.success) {
                    button.innerHTML = '<i class="fas fa-check mil-mr-5"></i> Added!';
                    const badge = document.getElementById('shedCartCount');
                    if (badge) { badge.textContent = data.count; badge.style.display = 'flex'; }
                    setTimeout(() => { button.innerHTML = original; button.disabled = false; }, 1500);
                } else {
                    alert(data.error || 'Could not add item.');
                    button.innerHTML = original; button.disabled = false;
                }
            } catch (err) {
                alert('Could not add item. Please try again.');
                button.innerHTML = original; button.disabled = false;
            }
        }

        const currency = '<%= currency %>';

        function scrollToStore() {
            const storeSection = document.getElementById('store');
            if (storeSection && typeof gsap !== 'undefined') {
                gsap.to(window, {
                    duration: 1,
                    scrollTo: {y: storeSection, offsetY: 80},
                    ease: 'power2.out'
                });
            } else {
                window.scrollTo({top: storeSection?.offsetTop - 80, behavior: 'smooth'});
            }
        }

        function searchInventory() {
            const input = document.getElementById('inventorySearchInput').value.toLowerCase();
            const grid = document.getElementById('inventoryGrid');
            const items = grid.getElementsByClassName('mil-inventory-item');

            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const name = item.querySelector('.mil-product-title').textContent.toLowerCase();
                const match = name.includes(input);
                item.style.display = match ? '' : 'none';
            }
        }

        function searchOrderTable() {
            const input = document.getElementById('orderSearchInput').value.toLowerCase();
            const table = document.getElementById('orderTable');
            const rows = table.getElementsByTagName('tr');

            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName('td');
                let match = false;

                for (let j = 0; j < cells.length; j++) {
                    if (cells[j].textContent.toLowerCase().includes(input)) {
                        match = true;
                        break;
                    }
                }

                row.style.display = match ? '' : 'none';
            }
        }

        window.addEventListener('load', () => {
            // Search icon toggle
            const searchIconBtn  = document.getElementById('searchIconBtn');
            const productSearchBar = document.getElementById('productSearchBar');
            const searchBarClose = document.getElementById('searchBarClose');
            const searchInput    = document.getElementById('inventorySearchInput');

            function openSearchBar() {
                productSearchBar.classList.add('open');
                setTimeout(() => searchInput.focus(), 50);
            }
            function closeSearchBar() {
                productSearchBar.classList.remove('open');
                searchInput.value = '';
                searchInventory(); // reset grid
            }

            searchIconBtn.addEventListener('click', openSearchBar);
            searchBarClose.addEventListener('click', closeSearchBar);
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && productSearchBar.classList.contains('open')) closeSearchBar();
            });

            // Live filter as user types
            searchInput.addEventListener('input', searchInventory);
        });

        document.getElementById('orderSearchInput')?.addEventListener('input', searchOrderTable);

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof gsap !== 'undefined') {
                gsap.set(['.mil-search-input', '.mil-quantity-input', '.mil-form-control'], {
                    textTransform: 'none',
                    clearProps: 'textTransform'
                });
                gsap.set('footer.mil-dark-bg', {
                    opacity: 1,
                    display: 'block',
                    visibility: 'visible',
                    clearProps: 'all'
                });
                console.log('Storefront GSAP reset applied');
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const subscribeForm = document.getElementById('subscribeForm');
            const errorDiv = document.querySelector('.mil-subscribe-error');
            const successDiv = document.querySelector('.mil-subscribe-success');
            const formContainer = document.querySelector('.mil-subscribe-container');

            if (!subscribeForm || !errorDiv || !successDiv || !formContainer) {
                console.warn('Subscription form elements not found');
                return;
            }

            subscribeForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = subscribeForm.querySelector('input[name="email"]').value.trim();

                errorDiv.style.display = 'none';
                errorDiv.textContent = '';
                successDiv.style.display = 'none';

                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errorDiv.textContent = 'Please enter a valid email address';
                    errorDiv.style.display = 'block';
                    return;
                }

                try {
                    const response = await fetch('/api/subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({email})
                    });

                    const data = await response.json();

                    if (response.ok) {
                        subscribeForm.style.display = 'none';
                        successDiv.style.display = 'block';
                        if (typeof gsap !== 'undefined') {
                            gsap.fromTo(successDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                        }
                        subscribeForm.reset();
                    } else {
                        errorDiv.textContent = data.message || 'Subscription failed. Please try again.';
                        errorDiv.style.display = 'block';
                        if (typeof gsap !== 'undefined') {
                            gsap.fromTo(errorDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                        }
                    }
                } catch (error) {
                    console.error('Subscription error:', error.message);
                    let errorMessage = 'Network error. Please try again.';
                    if (error.message.includes('Failed to fetch')) {
                        errorMessage = 'Unable to reach server. Check /api/subscribe endpoint.';
                    }
                    errorDiv.textContent = errorMessage;
                    errorDiv.style.display = 'block';
                    if (typeof gsap !== 'undefined') {
                        gsap.fromTo(errorDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                    }
                }
            });
        });
    </script>
    <script>
        (function() {
            function initMenu() {
                var openBtn  = document.getElementById('shedMenuOpen');
                var closeBtn = document.getElementById('shedMenuClose');
                var frame    = document.getElementById('shedMenuFrame');
                if (openBtn)  openBtn.onclick  = function() { frame.classList.add('mil-active'); };
                if (closeBtn) closeBtn.onclick = function() { frame.classList.remove('mil-active'); };
                if (frame) frame.addEventListener('click', function(e) {
                    if (e.target === frame) frame.classList.remove('mil-active');
                });
            }
            document.addEventListener('DOMContentLoaded', initMenu);
        })();
    </script>
