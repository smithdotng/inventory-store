    <!-- Inline CSS (same as signup page) -->
    <style>
        /* Same styles as in your signup page */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
            margin-top: 20px;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        .mil-frame-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px;
            background: #fff;
            height: 70px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }
        .mil-logo img {
            width: 100px;
            height: auto;
        }
        .mil-main-menu {
            display: flex;
            position: relative;
        }
        .mil-main-menu ul {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .mil-main-menu ul li {
            position: relative;
            margin: 0 10px;
        }
        .mil-main-menu ul li a {
            color: #333;
            text-decoration: none;
            font-size: 14px;
            padding: 8px;
            display: block;
        }
        .mil-main-menu ul li.mil-has-children > a::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-left: 5px;
            font-size: 10px;
        }
        .mil-main-menu ul li ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            min-width: 180px;
            flex-direction: column;
            z-index: 1000;
        }
        .mil-main-menu ul li ul li {
            margin: 0;
        }
        .mil-main-menu ul li ul li a {
            padding: 8px 12px;
            color: #333;
            font-size: 14px;
        }
        .mil-main-menu ul li:hover > ul {
            display: flex;
        }
        .mil-main-menu ul li ul li:hover a {
            background: #f5f5f5;
        }
        .mil-menu-btn {
            display: none;
            cursor: pointer;
            font-size: 20px;
            color: #333;
        }
        .mil-frame-bottom {
            background: #1a1a1a;
            padding: 10px;
            text-align: center;
            color: #fff;
        }
        .mil-frame-bottom .mil-back-to-top a {
            color: #fff;
            text-decoration: none;
        }
        .mil-subscribe-form {
            position: relative;
            display: flex;
            align-items: center;
            padding: 5px;
            border-radius: 5px;
        }
        .mil-subscribe-form input {
            flex: 1;
            border: none;
            background-color: beige;
            padding: 8px;
            font-size: 14px;
            outline: none;
        }
        .mil-subscribe-form button {
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .mil-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            display: none;
        }
        .mil-search-results.active {
            display: block;
        }
        .mil-search-result-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #333;
        }
        .mil-search-result-item:hover {
            background: #f5f5f5;
        }
        .mil-search-result-item img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }
        .mil-search-result-item div {
            flex: 1;
        }
        .mil-search-result-item h6 {
            margin: 0;
            font-size: 14px;
            color: #333;
        }
        .mil-search-result-item p {
            margin: 0;
            font-size: 12px;
            color: #666;
        }
        .mil-search-no-results {
            padding: 10px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        @media screen and (max-width: 991px) {
            .mil-main-menu {
                display: none;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: #fff;
                z-index: 999;
            }
