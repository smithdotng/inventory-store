                            <td><%= escapeEjs(transaction.type || 'N/A') %></td>
                            <td><%= escapeEjs(transaction.status || 'N/A') %></td>
                            <td><%= transaction.date ? new Date(transaction.date).toLocaleString() : 'N/A' %></td>
