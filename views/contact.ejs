    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Search overlay
            const overlay   = document.getElementById('searchOverlay');
            const toggleBtn = document.getElementById('searchToggleBtn');
            const closeBtn  = document.getElementById('searchCloseBtn');
            if (toggleBtn) toggleBtn.addEventListener('click', () => { overlay.classList.add('active'); setTimeout(() => overlay.querySelector('input').focus(), 50); });
            if (closeBtn)  closeBtn.addEventListener('click', () => overlay.classList.remove('active'));
            if (overlay)   overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('active'); });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay) overlay.classList.remove('active'); });

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(link => {
                link.addEventListener('click', (e) => {
                    const target = document.querySelector(link.getAttribute('href'));
                    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
                });
            });

            // Newsletter
            const subForm = document.getElementById('subscribeForm');
            if (subForm) {
                subForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const email = subForm.querySelector('input[name="email"]').value;
                    try {
                        const r = await fetch('/api/newsletter/subscribe', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email }) });
                        if (r.ok) { subForm.style.display = 'none'; subForm.nextElementSibling.style.display = 'block'; }
                    } catch(err) {}
                });
            }
        });
    </script>
    <script>
        (function() {
            function initMenu() {
                var openBtn  = document.getElementById('shedMenuOpen');
                var closeBtn = document.getElementById('shedMenuClose');
                var frame    = document.getElementById('shedMenuFrame');
                var setMenu = function(open) {
                    if (!frame) return;
                    frame.classList.toggle('mil-active', open);
                    if (openBtn) {
                        openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                        openBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
                    }
                };
                if (openBtn) {
                    openBtn.setAttribute('aria-controls', 'shedMenuFrame');
                    setMenu(frame ? frame.classList.contains('mil-active') : false);
                    // tapping the button again closes the menu
                    openBtn.onclick = function() {
                        setMenu(!frame.classList.contains('mil-active'));
                    };
                }
                if (closeBtn) closeBtn.onclick = function() { setMenu(false); };
                if (frame) frame.addEventListener('click', function(e) {
                    if (e.target === frame) setMenu(false);
                });
                if (!window.__shedMenuEscBound) {
                    window.__shedMenuEscBound = true;
                    document.addEventListener('keydown', function(e) {
                        if (e.key !== 'Escape') return;
                        var f = document.getElementById('shedMenuFrame');
                        var b = document.getElementById('shedMenuOpen');
                        if (f && f.classList.contains('mil-active')) {
                            f.classList.remove('mil-active');
                            if (b) {
                                b.setAttribute('aria-expanded', 'false');
                                b.setAttribute('aria-label', 'Open menu');
                                b.focus();
                            }
                        }
                    });
                }
            }
            document.addEventListener('DOMContentLoaded', initMenu);
            if (window.swup) window.swup.on('contentReplaced', initMenu);
        })();
    </script>
