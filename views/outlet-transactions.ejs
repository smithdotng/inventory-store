<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlet Transactions</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<!-- Outlet Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo">
    <img src="/images/logo.png" alt="Shed">
  </div>
  <nav class="sidebar-nav">
    <a href="/outlet/sales-form"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
    <a href="/outlet/<%= outlet._id %>/stock-view"><i class="fas fa-boxes"></i> View Inventory</a>
    <a href="/outlet-transactions/<%= outlet._id %>" class="active"><i class="fas fa-chart-bar"></i> Transactions</a>
    <a href="/outlet-customers/<%= outlet._id %>"><i class="fas fa-users"></i> Customers</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/outlet-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Transactions</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Shed' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= outlet.name[0].toUpperCase() %></div>
        <%= outlet.name %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>Transactions</h1>
        <p><%= outlet.name %> — transaction history</p>
      </div>
    </div>

    <% if (transactions && transactions.length > 0) { %>
      <div class="app-card">
        <div style="overflow-x:auto;">
          <table class="app-table">
            <thead>
              <tr>
                <th>Item Name</th>
                <th>Qty Sold</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Commission</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(transaction => { %>
                <% transaction.items.forEach(item => { %>
                  <tr>
                    <td style="font-weight:500;"><%= item.itemName %></td>
                    <td><%= item.quantity %></td>
                    <td><%= transaction.customerName %></td>
                    <td style="font-size:0.83rem; color:#888; white-space:nowrap;">
                      <%= new Date(transaction.date).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
                    </td>
                    <td style="color:#008B8B; font-weight:600;">
                      <%= admin.currency || '$' %><%= item.commissionAmount ? item.commissionAmount.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) : '0.00' %>
                    </td>
                  </tr>
                <% }) %>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-receipt" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No transactions yet</h3>
        <p style="color:#999;">Sales made at this outlet will appear here.</p>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
