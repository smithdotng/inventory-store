<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Profile | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Cropper.js CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet" />
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Banner starts at top */
        .mil-banner {
            margin-top: 0;
            padding-top: 0;
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
        }
        /* Content padding */
        .mil-content {
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
            width: 100%;
            margin: 0;
        }
        footer.mil-dark-bg .container-fluid {
            padding: 120px 30px;
        }
        @media (min-width: 1200px) {
            footer.mil-dark-bg .container-fluid {
                max-width: 1400px;
                margin: 0 auto;
                padding: 120px 60px;
            }
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        /* Checkbox styling */
        .mil-form-group.checkbox-group {
            display: flex;
            align-items: center;
            margin-top: 5px;
        }
        .mil-form-group.checkbox-group label {
            margin-left: 10px;
            padding-top: 0;
            font-size: 12px;
            cursor: pointer;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 10px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-button.edit-btn {
            background-color: rgb(255, 193, 7);
            color: #333;
        }
        .mil-button.edit-btn:hover {
            background-color: #fff;
            color: rgb(255, 193, 7);
            border: 2px solid rgb(255, 193, 7);
        }
        .mil-button.update-btn {
            background-color: rgb(40, 167, 69);
            color: #fff;
        }
        .mil-button.update-btn:hover {
            background-color: #fff;
            color: rgb(40, 167, 69);
            border: 2px solid rgb(40, 167, 69);
        }
        .mil-button.cancel-btn {
            background-color: rgb(108, 117, 125);
            color: #fff;
        }
        .mil-button.cancel-btn:hover {
            background-color: #fff;
            color: rgb(108, 117, 125);
            border: 2px solid rgb(108, 117, 125);
        }
        .mil-button.image-upload-btn {
            background-color: rgb(111, 66, 193);
            color: #fff;
        }
        .mil-button.image-upload-btn:hover {
            background-color: #fff;
            color: rgb(111, 66, 193);
            border: 2px solid rgb(111, 66, 193);
        }
        /* Sidebar styling */
        .mil-wrapper .mil-sidebar {
            width: 250px;
            background-color: #f8f8f8 !important;
            opacity: 1 !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 20px;
            z-index: 1001;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .mil-wrapper .mil-sidebar.hidden {
            transform: translateX(-100%);
        }
        .mil-wrapper .mil-sidebar * {
            background-color: transparent !important;
            opacity: 1 !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container {
            text-align: center;
            margin-bottom: 20px;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container img {
            width: 100px;
            height: auto;
        }
        .mil-wrapper .mil-sidebar h2 {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 500;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: background 0.3s ease;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a:hover {
            background: rgb(235, 166, 17) !important;
            color: #fff;
        }
        .mil-wrapper .mil-sidebar a.active {
            background: rgb(235, 166, 17) !important;
            color: #fff;
            font-weight: bold;
        }
        /* Toggle button */
        .mil-toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            background: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 8px 12px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            z-index: 1002;
        }
        /* Main content */
        .mil-main-content {
            padding: 20px;
            transition: margin-left 0.3s ease;
            width: 100%;
            box-sizing: border-box;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .mil-main-content.full-width {
            margin-left: 0;
        }
        /* Center the main content container */
        .mil-about .container {
            display: flex;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .mil-sidebar:not(.hidden) ~ .mil-content .mil-about .container {
            margin-left: calc(250px + ((100% - 250px - 800px) / 2));
            margin-right: auto;
        }
        .mil-sidebar.hidden ~ .mil-content .mil-about .container {
            margin-left: auto;
            margin-right: auto;
        }
        /* Profile details */
        .mil-profile-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .mil-profile-details .value {
            background: white;
            padding: 10px;
            border-radius: 4px;
            font-size: 13px;
            color: #333;
            border: 1px solid #dee2e6;
        }
        /* Account section */
        .mil-account-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        /* Social links */
        .mil-social-links {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
        }
        .mil-social-links a {
            color: rgb(235, 166, 17);
            text-decoration: none;
            margin: 0 10px;
        }
        .mil-social-links a:hover {
            text-decoration: underline;
        }
        /* Form section */
        .mil-form-section {
            margin-bottom: 20px;
        }
        .mil-form-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }
        /* Image preview */
        .mil-image-preview-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }
        .mil-image-placeholder {
            width: 100px;
            height: 100px;
            background: #f8f9fa;
            border: 1px solid #ced4da;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #6c757d;
        }
        .mil-image-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #ced4da;
        }
        /* Error/Success Messages */
        .mil-error {
            color: #d32f2f;
            background-color: #fde8e8;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid #f5c2c7;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-success {
            color: #388e3c;
            background-color: #e8f5e9;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid #c8e6c9;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-error i, .mil-success i {
            margin-right: 8px;
        }
        /* Cropper Modal */
        .mil-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .mil-modal.show {
            display: flex;
        }
        .mil-modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }
        .mil-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 10px;
        }
        .mil-modal-title {
            color: #333;
            font-size: 16px;
        }
        .mil-modal-body img {
            max-width: 100%;
            display: block;
            margin: 0 auto;
        }
        .mil-modal-footer {
            border-top: 1px solid #e0e0e0;
            padding-top: 10px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }
        .mil-modal-close {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #333;
        }
        /* Hidden class */
        .hidden {
            display: none !important;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-wrapper .mil-sidebar {
                width: 200px;
                background-color: #f8f8f8 !important;
                opacity: 1 !important;
            }
            .mil-main-content {
                margin-left: 0;
            }
            .mil-main-content.full-width {
                margin-left: 0;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .mil-profile-details .value {
                font-size: 12px;
            }
            .mil-social-links {
                font-size: 12px;
            }
            .mil-image-preview,
            .mil-image-placeholder {
                width: 80px;
                height: 80px;
            }
            .mil-about .container {
                margin-left: auto;
                margin-right: auto;
                max-width: 100%;
                padding-left: 15px;
                padding-right: 15px;
            }
            .mil-form-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-form-actions .mil-button {
                width: 100%;
            }
        }
        @media (max-width: 576px) {
            .mil-main-content {
                padding: 10px;
                width: 95%;
                margin: 0 auto;
            }
            .mil-modal-content {
                padding: 15px;
            }
        }
    </style>

    <title>Profile</title>
</head>
<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up active"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Profile </span>Settings</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Manage your personal and business profile details.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo" style="height: 50px; margin-bottom: 10px;">
                                        <h4 style="color: #333; font-size: 16px;">Profile for <%= admin.businessName || 'Your Business' %></h4>
                                    </div>
                                </div>

                                <!-- Error/Success Messages -->
                                <% if (error) { %>
                                    <div class="mil-error mil-up">
                                        <i class="fas fa-exclamation-circle"></i><%= error %>
                                    </div>
                                <% } %>
                                <% if (success) { %>
                                    <div class="mil-success mil-up">
                                        <i class="fas fa-check-circle"></i><%= success %>
                                    </div>
                                <% } %>

                                <!-- View Mode -->
                                <div id="profileView" class="mil-form-section mil-up">
                                    <div class="mil-profile-details">
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-user"></i> First Name</label>
                                            <div class="value"><%= admin.firstName || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-user"></i> Last Name</label>
                                            <div class="value"><%= admin.lastName || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-user"></i> Username</label>
                                            <div class="value"><%= admin.username %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-envelope"></i> Email</label>
                                            <div class="value"><%= admin.email %> (<%= admin.publicEmail ? 'Public' : 'Private' %>)</div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-building"></i> Business Name</label>
                                            <div class="value"><%= admin.businessName || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-money-bill-wave"></i> Currency</label>
                                            <div class="value"><%= admin.currency || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-phone"></i> Phone</label>
                                            <div class="value"><%= admin.phone || 'N/A' %> (<%= admin.publicPhone ? 'Public' : 'Private' %>)</div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-map-marker-alt"></i> Address</label>
                                            <div class="value"><%= admin.address || 'N/A' %> (<%= admin.publicAddress ? 'Public' : 'Private' %>)</div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-brands fa-facebook"></i> Facebook</label>
                                            <div class="value"><%= admin.facebook || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-brands fa-instagram"></i> Instagram</label>
                                            <div class="value"><%= admin.instagram || 'N/A' %></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-brands fa-x-twitter"></i> X</label>
                                            <div class="value"><%= admin.twitter || 'N/A' %></div>
                                        </div>
                                    </div>

                                    <!-- Social Media Links -->
                                    <div class="mil-social-links">
                                        <% if (admin.facebook) { %>
                                            <a href="<%= admin.facebook %>" target="_blank">Facebook</a>
                                        <% } %>
                                        <% if (admin.instagram) { %>
                                            <a href="<%= admin.instagram %>" target="_blank">Instagram</a>
                                        <% } %>
                                        <% if (admin.twitter) { %>
                                            <a href="<%= admin.twitter %>" target="_blank">X</a>
                                        <% } %>
                                    </div>

                                    <!-- Account Information -->
                                    <div class="mil-account-section">
                                        <h5 style="color: #333; font-size: 14px; margin-bottom: 15px;">Bank Account Information</h5>
                                        <div class="account-info">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Primary Account Name</label>
                                                <div class="value"><%= admin.primaryAccount && admin.primaryAccount.bankAccountName ? admin.primaryAccount.bankAccountName : 'N/A' %></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Primary Account Number</label>
                                                <div class="value"><%= admin.primaryAccount && admin.primaryAccount.accountNumber ? admin.primaryAccount.accountNumber : 'N/A' %></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Primary Bank Name</label>
                                                <div class="value"><%= admin.primaryAccount && admin.primaryAccount.bankName ? admin.primaryAccount.bankName : 'N/A' %></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Secondary Account Name</label>
                                                <div class="value"><%= admin.secondaryAccount && admin.secondaryAccount.bankAccountName ? admin.secondaryAccount.bankAccountName : 'N/A' %></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Secondary Account Number</label>
                                                <div class="value"><%= admin.secondaryAccount && admin.secondaryAccount.accountNumber ? admin.secondaryAccount.accountNumber : 'N/A' %></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-university"></i> Secondary Bank Name</label>
                                                <div class="value"><%= admin.secondaryAccount && admin.secondaryAccount.bankName ? admin.secondaryAccount.bankName : 'N/A' %></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mil-form-actions">
                                        <button class="mil-button edit-btn" id="editProfileBtn">
                                            Edit Profile <i class="fa-solid fa-edit"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Edit Mode -->
