    <!-- Inline CSS for Fixes, Menu, Search Results, Form Styling, and Image -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
            margin-top: 20px;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Adjust .mil-frame-top to be fixed at top */
        .mil-frame-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px;
            background: #fff;
            height: 70px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }
        .mil-logo img {
            width: 100px;
            height: auto;
        }
        .mil-main-menu {
            display: flex;
            position: relative;
        }
        .mil-main-menu ul {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .mil-main-menu ul li {
            position: relative;
            margin: 0 10px;
        }
        .mil-main-menu ul li a {
            color: #333;
            text-decoration: none;
            font-size: 14px;
            padding: 8px;
            display: block;
        }
        .mil-main-menu ul li.mil-has-children > a::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-left: 5px;
            font-size: 10px;
        }
        .mil-main-menu ul li ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            min-width: 180px;
            flex-direction: column;
            z-index: 1000;
        }
        .mil-main-menu ul li ul li {
            margin: 0;
        }
        .mil-main-menu ul li ul li a {
            padding: 8px 12px;
            color: #333;
            font-size: 14px;
        }
        .mil-main-menu ul li:hover > ul {
            display: flex;
        }
        .mil-main-menu ul li ul li:hover a {
            background: #f5f5f5;
        }
        .mil-menu-btn {
            display: none;
            cursor: pointer;
            font-size: 20px;
            color: #333;
        }
        /* Style mil-frame-bottom to scroll with the page */
        .mil-frame-bottom {
            background: #1a1a1a;
            padding: 10px;
            text-align: center;
            color: #fff;
        }
        .mil-frame-bottom .mil-back-to-top a {
            color: #fff;
            text-decoration: none;
        }
        /* Search form and results */
        .mil-subscribe-form {
            position: relative;
            display: flex;
            align-items: center;
            padding: 5px;
            border-radius: 5px;
        }
        .mil-subscribe-form input {
            flex: 1;
            border: none;
            background-color: beige;
            padding: 8px;
            font-size: 14px;
            outline: none;
        }
        .mil-subscribe-form button {
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .mil-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            display: none;
        }
        .mil-search-results.active {
            display: block;
        }
        .mil-search-result-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #333;
        }
        .mil-search-result-item:hover {
            background: #f5f5f5;
        }
        .mil-search-result-item img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }
        .mil-search-result-item div {
            flex: 1;
        }
        .mil-search-result-item h6 {
            margin: 0;
            font-size: 14px;
            color: #333;
        }
        .mil-search-result-item p {
            margin: 0;
            font-size: 12px;
            color: #666;
        }
        .mil-search-no-results {
            padding: 10px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        /* Mobile Menu */
        @media screen and (max-width: 991px) {
            .mil-main-menu {
                display: none;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: #fff;
                z-index: 999;
            }
            .mil-main-menu.active {
                display: block;
            }
            .mil-main-menu ul {
                flex-direction: column;
                padding: 10px;
            }
            .mil-main-menu ul li {
                margin: 5px 0;
            }
            .mil-main-menu ul li ul {
                position: static;
                box-shadow: none;
                display: none;
            }
            .mil-main-menu ul li.mil-has-children.active > ul {
                display: flex;
            }
            .mil-menu-btn {
                display: block;
            }
            .mil-subscribe-form {
                width: 100%;
            }
            .mil-search-results {
                width: 100%;
            }
        }
        /* Content padding to avoid overlap with fixed header */
        .mil-content {
            padding-top: 80px;
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-main-menu ul li::before,
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        .mil-accordion-content ol li {
            padding-left: 30px;
            margin-bottom: 10px;
        }
        .mil-accordion-content ol li::before {
            font-size: 16px;
            color: #008B8B;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        .mil-form-col.country-code {
            flex: 0 0 30%;
            max-width: 30%;
        }
        .mil-form-col.mobile-number {
            flex: 0 0 70%;
            max-width: 70%;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        /* Links styling */
        .mil-login-links {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
        }
        .mil-login-links p {
            margin: 5px 0;
            color: #333;
        }
        .mil-login-links a {
            color: rgb(235, 166, 17);
            text-decoration: none;
            font-weight: 500;
        }
        .mil-login-links a:hover {
            text-decoration: underline;
        }
        /* Promo Image Styling */
        .mil-promo-image {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 15px;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-col.country-code,
            .mil-form-col.mobile-number {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .mil-login-links {
                font-size: 12px;
            }
            .mil-promo-image {
                max-height: 300px;
            }
        }
        @media screen and (max-width: 991px) {
            .mil-main-menu ul li {
                padding-left: 25px;
            }
            .mil-main-menu ul li::before {
                content: '\f00c';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                color: #008B8B;
                position: absolute;
                left: 5px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 14px;
            }
            .mil-main-menu ul li ul li::before {
                left: 15px;
            }
        }
    </style>

    <title>Shed | Become an Affiliate</title>
</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- frame top (header) -->
        <div class="mil-frame-top">
            <a href="/" class="mil-logo"><img src="/images/logo.png" alt="Shed Logo"></a>
            <nav class="mil-main-menu" id="swupMenu">
                <form class="mil-subscribe-form mil-up" style="background-color: beige;">
                    <input type="text" placeholder="Search for a Shed" size="50">
                    <button type="submit" class="mil-button mil-icon-button-sm mil-arrow-place"></button>
                    <div class="mil-search-results"></div>
                </form>
            </nav>
            <div class="mil-menu-btn">
                <i class="fas fa-search"></i>
            </div>
        </div>
        <!-- frame top end -->

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Join as an </span>Affiliate</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Join our affiliate program and earn rewards by referring new users to Shed!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- Content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-6">
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-bell"></i> <%= error %>
                                    </div>
                                <% } %>

                                <form action="/referrals/signup" method="POST" class="mil-up">
                                    <!-- First Name -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-user"></i> First Name</label>
                                        <input type="text" class="mil-form-control" id="firstName" name="firstName" placeholder="Enter first name..." required>
                                    </div>

                                    <!-- Last Name -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-user"></i> Last Name</label>
                                        <input type="text" class="mil-form-control" id="lastName" name="lastName" placeholder="Enter last name..." required>
                                    </div>

                                    <!-- Email -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-envelope"></i> Email Address</label>
                                        <input type="email" class="mil-form-control" id="email" name="email" placeholder="Enter email address..." required>
                                    </div>

                                    <!-- Country -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-globe"></i> Country</label>
                                        <input type="text" class="mil-form-control" id="country" name="country" placeholder="Enter your country..." required>
                                    </div>

                                    <!-- Phone Number (Country Code + Mobile Number) -->
                                    <div class="mil-form-row">
                                        <div class="mil-form-col country-code">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-phone"></i> Country Code</label>
                                                <select class="mil-form-control" id="countryCode" name="countryCode" required>
                                                    <option value="" disabled selected>Select country code...</option>
                                                    <option value="+1">+1 (United States)</option>
                                                    <option value="+44">+44 (United Kingdom)</option>
                                                    <option value="+234">+234 (Nigeria)</option>
                                                    <option value="+91">+91 (India)</option>
                                                    <option value="+81">+81 (Japan)</option>
                                                    <option value="+86">+86 (China)</option>
