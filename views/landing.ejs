                                    <div class="mil-up mil-img-frame" style="padding-bottom: 160%;">
                                        <img src="images/promo.jpg" alt="img" class="mil-scale" data-value-1="1" data-value-2="1.2">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
