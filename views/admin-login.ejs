<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shed | Login</title>

    <!-- favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- vendor css -->
    <link rel="stylesheet" href="asset1/css/bootstrap.min.css">
    <link rel="stylesheet" href="asset1/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="asset1/css/animate.min.css">

    <!-- template styles -->
    <link rel="stylesheet" href="asset1/css/main.css">
    <link rel="stylesheet" href="asset1/css/rtl.css">

    <style>
        body {
            background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Jost', sans-serif;
        }

        .login-wrapper {
            max-width: 480px;
            width: 100%;
            margin: 40px auto;
            padding: 50px 40px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        }

        .login-logo {
            text-align: center;
            margin-bottom: 40px;
        }

        .login-logo img {
            max-width: 180px;
            height: auto;
        }

        .login-title {
            text-align: center;
            margin-bottom: 40px;
            color: #2c3e50;
        }

        .form-group {
            margin-bottom: 28px;
        }

        .form-group label {
            font-weight: 600;
            color: #444;
            margin-bottom: 10px;
            display: block;
        }

        .thm-btn.login-btn {
            width: 100%;
            padding: 14px;
            font-size: 1.1rem;
            background: #e74c3c;
            border: none;
            border-radius: 30px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .thm-btn.login-btn:hover {
            background: #c0392b;
            transform: translateY(-2px);
        }

        .links {
            text-align: center;
            margin-top: 30px;
            color: #666;
        }

        .links a {
            color: #e74c3c;
            font-weight: 500;
            text-decoration: none;
            margin: 0 12px;
        }

        .links a:hover {
            color: #c0392b;
            text-decoration: underline;
        }

        .alert {
            border-radius: 8px;
            padding: 14px;
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>

<div class="login-wrapper wow fadeInUp" data-wow-duration="800ms">
    <!-- Logo -->
    <div class="login-logo">
        <img src="/images/logo.png" alt="Shed Logo">
    </div>

    <!-- Title -->
    <h2 class="login-title">Welcome Back</h2>

    <!-- Error Message -->
    <% if (error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
        </div>
    <% } %>

    <!-- Login Form -->
    <form action="/admin-login" method="POST">
        <div class="form-group">
            <label for="usernameOrEmail">Username or Email</label>
            <input 
                type="text" 
                class="form-control" 
                id="usernameOrEmail" 
                name="usernameOrEmail" 
                placeholder="Enter username or email"
                required 
                autofocus
            >
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input 
                type="password" 
                class="form-control" 
                id="password" 
                name="password" 
                placeholder="Enter your password"
                required
            >
        </div>

        <button type="submit" class="thm-btn login-btn mt-3">
            Sign In <i class="fas fa-arrow-right ms-2"></i>
        </button>
    </form>

    <!-- Links -->
    <div class="links">
        <p>
            <a href="/admin-register">Create your Shed</a> • 
            <a href="/forgot-password">Forgot Password?</a>
        </p>
        <p>
            <a href="/outlet-login">Login as Outlet Manager →</a>
        </p>
    </div>
</div>

<!-- Scripts (only what's needed) -->
<script src="asset1/js/jquery-3.5.1.min.js"></script>
<script src="asset1/js/wow.js"></script>
<script src="asset1/js/bootstrap.bundle.min.js"></script>

<script>
    new WOW().init();
</script>

</body>
</html>