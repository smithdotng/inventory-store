    <!-- Sidebar Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const toggleBtn = document.getElementById('toggleBtn');

            // Check screen size and sidebar state
            const isMobile = window.innerWidth <= 768;
            const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true' || isMobile;

            if (isSidebarHidden) {
                sidebar.classList.add('hidden');
                mainContent.classList.add('full-width');
                toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
            } else {
                sidebar.classList.remove('hidden');
                mainContent.classList.remove('full-width');
                toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
            }

            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                mainContent.classList.toggle('full-width');
                toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                localStorage.setItem('sidebarHidden', sidebar.classList.contains('hidden'));
            });

            // Adjust sidebar visibility on resize
            function setSidebarState() {
                if (window.innerWidth <= 768) {
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                    localStorage.setItem('sidebarHidden', true);
                } else if (!localStorage.getItem('sidebarHidden') || localStorage.getItem('sidebarHidden') === 'false') {
                    sidebar.classList.remove('hidden');
                    mainContent.classList.remove('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
                }
            }

            window.addEventListener('resize', setSidebarState);
            setSidebarState();
        });
    </script>

    <!-- Invoice Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const createInvoiceBtn = document.getElementById('createInvoiceBtn');
                const createInvoiceForm = document.getElementById('createInvoiceForm');
                const cancelInvoiceBtn = document.getElementById('cancelInvoiceBtn');
                const customerSelect = document.getElementById('customerSelect');
                const newCustomerFields = document.getElementById('newCustomerFields');
                const itemsContainer = document.getElementById('itemsContainer');
                const addItemBtn = document.getElementById('addItemBtn');
                const paymentMethod = document.getElementById('paymentMethod');
                const bankDetails = document.getElementById('bankDetails');
                const invoiceForm = document.getElementById('invoiceForm');

                let itemIndex = <%= formData.items && formData.items.itemId ? (Array.isArray(formData.items.itemId) ? formData.items.itemId.length : 1) : 1 %>;

                // Toggle invoice form visibility
                if (createInvoiceBtn && createInvoiceForm) {
                    createInvoiceBtn.addEventListener('click', () => {
                        createInvoiceForm.style.display = 'block';
                        createInvoiceBtn.parentElement.style.display = 'none';
                    });
                }

                // Cancel invoice creation
                if (cancelInvoiceBtn && createInvoiceForm) {
                    cancelInvoiceBtn.addEventListener('click', () => {
                        createInvoiceForm.style.display = 'none';
                        createInvoiceBtn.parentElement.style.display = 'flex';
                        invoiceForm.reset();
                        const rows = itemsContainer.querySelectorAll('.mil-item-row');
                        if (rows.length > 1) {
                            for (let i = 1; i < rows.length; i++) {
                                rows[i].remove();
                            }
                        }
                        newCustomerFields.classList.add('hidden');
                        bankDetails.classList.add('hidden');
                        updateRemoveButtons();
                        validateCustomer();
                        validateItems();
                        validatePaymentMethod();
                    });
                }

                // Toggle new customer fields
                if (customerSelect && newCustomerFields) {
                    customerSelect.addEventListener('change', () => {
                        const isNewCustomer = customerSelect.value === 'new';
                        newCustomerFields.classList.toggle('hidden', !isNewCustomer);
                        newCustomerFields.querySelectorAll('input').forEach(input => {
                            input.required = isNewCustomer;
                        });
                        validateCustomer();
                    });
                }

                // Toggle bank details
                if (paymentMethod && bankDetails) {
                    paymentMethod.addEventListener('change', () => {
                        const isBankTransfer = paymentMethod.value === 'Bank Transfer';
                        bankDetails.classList.toggle('hidden', !isBankTransfer);
                        bankDetails.querySelectorAll('input').forEach(input => {
                            input.required = isBankTransfer;
                        });
                        validatePaymentMethod();
                    });
                }

                // Add new item row
                if (addItemBtn && itemsContainer) {
                    addItemBtn.addEventListener('click', () => {
                        const newRow = document.createElement('div');
                        newRow.className = 'mil-item-row';
                        newRow.dataset.index = itemIndex;
                        newRow.innerHTML = `
                            <select name="items[itemId][]" class="mil-form-control" required>
                                <option value="">Select Item</option>
                                <% inventory.forEach(item => { %>
                                    <option value="<%= item._id %>" data-stock="<%= item.stock %>" data-isVatable="<%= item.isVatable %>">
                                        <%= item.name %> (Stock: <%= item.stock %>)<%= item.isVatable ? ' [VAT]' : '' %>
                                    </option>
                                <% }) %>
                                <option value="new">Create New Product</option>
                            </select>
                            <input type="number" name="items[quantity][]" class="mil-form-control" placeholder="Quantity" min="1" required>
                            <button type="button" class="mil-button delete-btn remove-btn">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <div class="mil-new-product-fields hidden" id="newProductFields${itemIndex}">
                                <div class="mil-form-group">
                                    <label><i class="fa-solid fa-box"></i> Product Name</label>
                                    <input type="text" name="items[newProductName][]" class="mil-form-control new-product-name" placeholder="Product Name">
                                </div>
                                <div class="mil-form-group">
                                    <label><i class="fa-solid fa-money-bill"></i> Cost</label>
                                    <input type="number" name="items[newProductCost][]" class="mil-form-control new-product-cost" placeholder="Cost" min="0" step="0.01">
                                </div>
                                <div class="mil-form-group">
                                    <label><i class="fa-solid fa-cubes"></i> Stock</label>
                                    <input type="number" name="items[newProductStock][]" class="mil-form-control new-product-stock" placeholder="Stock" min="0">
                                </div>
                                <div class="mil-form-actions">
                                    <button type="button" class="mil-button confirm-new-product-btn">
                                        Confirm Product <i class="fa-solid fa-check"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mil-field-error" id="itemError${itemIndex}"></div>
                        `;
                        itemsContainer.appendChild(newRow);
                        const select = newRow.querySelector('select');
                        select.addEventListener('change', () => toggleNewProductFields(select));
                        select.addEventListener('change', validateItems);
                        newRow.querySelector('input[type="number"]').addEventListener('input', validateItems);
                        newRow.querySelectorAll('.mil-new-product-fields input').forEach(input => input.addEventListener('input', validateItems));
                        newRow.querySelector('.remove-btn').addEventListener('click', () => {
                            if (itemsContainer.querySelectorAll('.mil-item-row').length > 1) {
                                newRow.remove();
                                validateItems();
                                updateRemoveButtons();
                            }
                        });
                        itemIndex++;
                        updateRemoveButtons();
                    });
                }

                // Toggle new product fields
                function toggleNewProductFields(select) {
                    const index = select.closest('.mil-item-row').dataset.index;
                    const newProductFields = document.getElementById(`newProductFields${index}`);
                    const isNewProduct = select.value === 'new';
                    newProductFields.classList.toggle('hidden', !isNewProduct);
                    newProductFields.querySelectorAll('input').forEach(input => {
                        input.required = isNewProduct;
                    });
                    validateItems();
                }

                // Handle confirming a new product
                function handleConfirmNewProduct(button) {
                    const row = button.closest('.mil-item-row');
                    const index = row.dataset.index;
                    const nameInput = row.querySelector('.new-product-name');
                    const costInput = row.querySelector('.new-product-cost');
                    const stockInput = row.querySelector('.new-product-stock');
                    const select = row.querySelector('select');
                    const quantityInput = row.querySelector('input[type="number"]');
                    const errorElement = document.getElementById(`itemError${index}`);

                    // Validate the new product
                    const name = nameInput.value.trim();
                    const cost = parseFloat(costInput.value) || 0;
                    const stock = parseInt(stockInput.value) || 0;
                    const qty = parseInt(quantityInput.value) || 0;

                    if (!name) {
                        errorElement.textContent = 'Product name is required.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (cost <= 0) {
                        errorElement.textContent = 'Cost must be greater than 0.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (stock < 0) {
                        errorElement.textContent = 'Stock cannot be negative.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (qty <= 0) {
                        errorElement.textContent = 'Quantity must be greater than 0.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (qty > stock) {
                        errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
                        errorElement.style.display = 'block';
                        return false;
                    }

                    // Create a new option for the select
                    const newOption = document.createElement('option');
                    newOption.value = `new_${Date.now()}`; // Temporary ID
                    newOption.textContent = `${name} (Stock: ${stock})`;
                    newOption.dataset.stock = stock;
                    newOption.dataset.cost = cost;
                    newOption.selected = true;
                    
                    // Clear existing options and add the new one
                    select.innerHTML = '';
                    select.appendChild(newOption);
                    
                    // Hide the new product fields
                    document.getElementById(`newProductFields${index}`).classList.add('hidden');
                    
                    // Clear the error
                    errorElement.style.display = 'none';
                    
                    // Log the new product (replace with actual API call if needed)
                    console.log('New product confirmed:', {
                        name: name,
                        cost: cost,
                        stock: stock,
                        quantity: qty
                    });
                    
                    return true;
                }

                // Add event listener for confirm buttons
                document.addEventListener('click', (e) => {
                    if (e.target.closest('.confirm-new-product-btn')) {
                        handleConfirmNewProduct(e.target.closest('.confirm-new-product-btn'));
                    }
                });

                // Validate items
                function validateItems() {
                    let isValid = true;
                    const rows = itemsContainer.querySelectorAll('.mil-item-row');
                    rows.forEach(row => {
                        const index = row.dataset.index;
                        const select = row.querySelector('select');
                        const quantityInput = row.querySelector('input[type="number"]');
                        const errorElement = document.getElementById(`itemError${index}`);
                        const isNewProduct = select.value === 'new';
                        const isConfirmedNewProduct = select.value.startsWith('new_');

                        if (!select.value) {
                            errorElement.textContent = 'Please select an item.';
                            errorElement.style.display = 'block';
                            isValid = false;
                        } else if (isNewProduct) {
                            errorElement.style.display = 'none';
                        } else if (isConfirmedNewProduct) {
                            const stock = parseInt(select.selectedOptions[0].dataset.stock) || 0;
                            const qty = parseInt(quantityInput.value) || 0;

                            if (qty <= 0) {
                                errorElement.textContent = 'Quantity must be greater than 0.';
                                errorElement.style.display = 'block';
                                isValid = false;
                            } else if (qty > stock) {
                                errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
                                errorElement.style.display = 'block';
                                isValid = false;
                            } else {
                                errorElement.style.display = 'none';
                            }
                        } else {
                            const stock = parseInt(select.selectedOptions[0].dataset.stock) || 0;
                            const qty = parseInt(quantityInput.value) || 0;

                            if (qty <= 0) {
                                errorElement.textContent = 'Quantity must be greater than 0.';
                                errorElement.style.display = 'block';
                                isValid = false;
                            } else if (qty > stock) {
                                errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
                                errorElement.style.display = 'block';
                                isValid = false;
                            } else {
                                errorElement.style.display = 'none';
                            }
                        }
                    });
                    return isValid;
                }

                // Update remove buttons visibility
                function updateRemoveButtons() {
                    const rows = itemsContainer.querySelectorAll('.mil-item-row');
                    rows.forEach((row, index) => {
                        const removeBtn = row.querySelector('.remove-btn');
                        removeBtn.style.display = index === 0 && rows.length === 1 ? 'none' : 'block';
                    });
                }

                // Client-side validation
                function validateCustomer() {
                    const errorElement = document.getElementById('customerSelectError');
                    if (!customerSelect.value) {
                        errorElement.textContent = 'Please select a customer.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (customerSelect.value === 'new') {
                        const name = document.getElementById('newCustomerName').value.trim();
                        const nameError = document.getElementById('newCustomerNameError');
                        if (!name) {
                            nameError.textContent = 'Customer name is required.';
                            nameError.style.display = 'block';
                            errorElement.style.display = 'none';
                            return false;
                        } else {
                            nameError.style.display = 'none';
                            errorElement.style.display = 'none';
                            return true;
                        }
                    } else {
                        errorElement.style.display = 'none';
                        return true;
                    }
                }

                function validatePaymentMethod() {
                    const errorElement = document.getElementById('paymentMethodError');
                    if (!paymentMethod.value) {
                        errorElement.textContent = 'Please select a payment method.';
                        errorElement.style.display = 'block';
                        return false;
                    } else if (paymentMethod.value === 'Bank Transfer') {
                        const bankName = document.getElementById('bankName').value.trim();
                        const bankAccountName = document.getElementById('bankAccountName').value.trim();
                        const accountNumber = document.getElementById('accountNumber').value.trim();
                        const bankNameError = document.getElementById('bankNameError');
                        const bankAccountNameError = document.getElementById('bankAccountNameError');
                        const accountNumberError = document.getElementById('accountNumberError');

                        let isValid = true;
                        if (!bankName) {
                            bankNameError.textContent = 'Bank name is required.';
                            bankNameError.style.display = 'block';
                            isValid = false;
                        } else {
                            bankNameError.style.display = 'none';
                        }
                        if (!bankAccountName) {
                            bankAccountNameError.textContent = 'Bank account name is required.';
                            bankAccountNameError.style.display = 'block';
                            isValid = false;
                        } else {
                            bankAccountNameError.style.display = 'none';
                        }
                        if (!accountNumber) {
                            accountNumberError.textContent = 'Account number is required.';
                            accountNumberError.style.display = 'block';
                            isValid = false;
                        } else {
                            accountNumberError.style.display = 'none';
                        }
                        if (isValid) {
                            errorElement.style.display = 'none';
                        }
                        return isValid;
                    } else {
                        errorElement.style.display = 'none';
                        return true;
                    }
                }

                // Attach validation and toggle listeners
                if (customerSelect) customerSelect.addEventListener('change', validateCustomer);
                if (document.getElementById('newCustomerName')) document.getElementById('newCustomerName').addEventListener('input', validateCustomer);
                if (paymentMethod) paymentMethod.addEventListener('change', validatePaymentMethod);
                if (document.getElementById('bankName')) document.getElementById('bankName').addEventListener('input', validatePaymentMethod);
                if (document.getElementById('bankAccountName')) document.getElementById('bankAccountName').addEventListener('input', validatePaymentMethod);
                if (document.getElementById('accountNumber')) document.getElementById('accountNumber').addEventListener('input', validatePaymentMethod);
                itemsContainer.querySelectorAll('select').forEach(select => {
                    select.addEventListener('change', () => toggleNewProductFields(select));
                    select.addEventListener('change', validateItems);
                });
                itemsContainer.querySelectorAll('input[type="number"]').forEach(input => input.addEventListener('input', validateItems));
                itemsContainer.querySelectorAll('.mil-new-product-fields input').forEach(input => input.addEventListener('input', validateItems));
                itemsContainer.querySelectorAll('.remove-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        if (itemsContainer.querySelectorAll('.mil-item-row').length > 1) {
                            btn.closest('.mil-item-row').remove();
                            validateItems();
                            updateRemoveButtons();
                        }
                    });
                });

                // Handle form submission
                if (invoiceForm) {
                    invoiceForm.addEventListener('submit', (e) => {
                        const isCustomerValid = validateCustomer();
                        const areItemsValid = validateItems();
                        const isPaymentMethodValid = validatePaymentMethod();
                        if (!isCustomerValid || !areItemsValid || !isPaymentMethodValid) {
                            e.preventDefault();
                        }
                    });
                }

                // Handle "Mark as Paid" form submission
                document.querySelectorAll('.action-form').forEach(form => {
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const saleId = form.dataset.saleId;
                        try {
                            const response = await fetch(form.action, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            });
                            if (response.ok) {
                                const row = document.getElementById(`sale-${saleId}`);
                                row.querySelector('.payment-status').textContent = 'Paid';
                                row.querySelector('.payment-status').className = 'payment-status Paid';
                                form.remove();
                            } else {
                                alert('Failed to mark invoice as paid.');
                            }
                        } catch (error) {
                            console.error('Error marking invoice as paid:', error);
                            alert('An error occurred while marking the invoice as paid.');
                        }
                    });
                });

                // Initial setup
                updateRemoveButtons();
                newCustomerFields.classList.toggle('hidden', customerSelect.value !== 'new');
                bankDetails.classList.toggle('hidden', paymentMethod.value !== 'Bank Transfer');
                itemsContainer.querySelectorAll('select').forEach(select => toggleNewProductFields(select));
                validateCustomer();
                validateItems();
                validatePaymentMethod();
            } catch (error) {
                console.error('Error initializing scripts:', error);
            }
        });
    </script>
</body>
</html>