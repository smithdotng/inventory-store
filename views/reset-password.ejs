<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Reset Password</title>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
  <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Jost', sans-serif; }
    body { display: flex; min-height: 100vh; background: #0d0d1a; }

    .auth-left {
      width: 45%; background: #0d0d1a;
      display: flex; flex-direction: column; justify-content: center;
      padding: 70px 60px; position: relative; overflow: hidden;
    }
    .auth-left::before {
      content: ''; position: absolute; top: -80px; right: -80px;
      width: 380px; height: 380px; border-radius: 50%;
      background: rgba(0,139,139,0.07); pointer-events: none;
    }
    .auth-logo { margin-bottom: 52px; }
    .auth-logo img { width: 130px; height: auto; }
    .auth-tagline h1 { font-size: 2.2rem; font-weight: 700; color: #fff; line-height: 1.25; margin-bottom: 16px; }
    .auth-tagline h1 span { color: #008B8B; }
    .auth-tagline p { color: rgba(255,255,255,0.5); font-size: 0.95rem; line-height: 1.7; }

    .auth-right {
      flex: 1; background: #fff;
      display: flex; align-items: center; justify-content: center;
      padding: 60px 40px;
    }
    .auth-form-box { width: 100%; max-width: 400px; }
    .auth-form-box h2 { font-size: 1.9rem; font-weight: 700; color: #0d0d1a; margin-bottom: 6px; }
    .auth-form-box .subtitle { color: #888; font-size: 0.92rem; margin-bottom: 32px; }

    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block; font-weight: 600; font-size: 0.83rem;
      color: #444; margin-bottom: 8px;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .form-control {
      width: 100%; padding: 13px 16px;
      border: 1.5px solid #e5e5e5; border-radius: 8px;
      font-size: 0.97rem; font-family: 'Jost', sans-serif;
      color: #222; background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {
      outline: none; border-color: #008B8B; background: #fff;
      box-shadow: 0 0 0 3px rgba(0,139,139,0.1);
    }
    .btn-auth {
      width: 100%; padding: 14px;
      background: #008B8B; color: #fff;
      border: none; border-radius: 8px;
      font-size: 1rem; font-weight: 600;
      font-family: 'Jost', sans-serif;
      cursor: pointer; transition: background 0.2s;
      margin-top: 8px;
    }
    .btn-auth:hover { background: #006f6f; }
    .alert-error {
      background: #fff5f5; border: 1px solid #ffd0d0; color: #c0392b;
      padding: 13px 16px; border-radius: 8px; margin-bottom: 20px;
      font-size: 0.9rem; display: flex; align-items: center; gap: 9px;
    }
    .auth-links { text-align: center; margin-top: 24px; color: #888; font-size: 0.9rem; }
    .auth-links a { color: #008B8B; font-weight: 500; text-decoration: none; }
    .auth-links a:hover { text-decoration: underline; }

    @media(max-width:768px) {
      body { flex-direction: column; }
      .auth-left { display: none; }
      .auth-right { padding: 48px 24px; }
    }
  </style>
</head>
<body>

  <div class="auth-left">
    <div class="auth-logo"><img src="/images/logo.png" alt="Shed"></div>
    <div class="auth-tagline">
      <h1>Create a New<br><span>Password</span></h1>
      <p>Choose a strong password to keep your account secure.</p>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-form-box">
      <h2>Reset Password</h2>
      <p class="subtitle">Enter and confirm your new password</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>

      <form action="/reset-password" method="POST">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-group">
          <label for="password">New Password</label>
          <input type="password" class="form-control" id="password" name="password"
                 placeholder="Choose a strong password" required autofocus>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                 placeholder="Repeat your new password" required>
        </div>
        <button type="submit" class="btn-auth">
          Reset Password &nbsp;<i class="fas fa-lock"></i>
        </button>
      </form>

      <div class="auth-links">
        <p><a href="/admin-login">← Back to Sign In</a></p>
      </div>
    </div>
  </div>

</body>
</html>
