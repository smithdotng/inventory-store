    <!-- Search Functionality -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchOverlay   = document.getElementById('searchOverlay');
            const searchToggleBtn = document.getElementById('searchToggleBtn');
            const searchCloseBtn  = document.getElementById('searchCloseBtn');
            const searchForm      = document.getElementById('searchForm');
            const searchInput     = searchForm.querySelector('input[name="q"]');
            const searchResults   = searchForm.querySelector('.mil-search-results');

            function openSearch()  { searchOverlay.classList.add('active'); setTimeout(() => searchInput.focus(), 50); }
            function closeSearch() { searchOverlay.classList.remove('active'); searchResults.classList.remove('active'); searchInput.value = ''; }

            searchToggleBtn.addEventListener('click', openSearch);
            searchCloseBtn.addEventListener('click', closeSearch);
            searchOverlay.addEventListener('click', (e) => { if (e.target === searchOverlay) closeSearch(); });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });

            // Tabs
            const tabsHtml = `<div class="mil-search-tabs"><button class="mil-search-tab active" data-type="all">All</button><button class="mil-search-tab" data-type="stores">Stores</button><button class="mil-search-tab" data-type="products">Products</button></div>`;
            searchResults.insertAdjacentHTML('afterbegin', tabsHtml);

            const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };

            const fetchResults = async (q, type) => {
                const r = await fetch(`/api/search/suggestions?q=${encodeURIComponent(q)}&type=${type}`);
                if (!r.ok) throw new Error();
                return r.json();
            };

            const displayResults = (data, q, type) => {
                const id = `mil-search-${type}`;
                let sec = document.getElementById(id);
                if (!sec) { sec = document.createElement('div'); sec.id = id; sec.className = `mil-search-section ${type === 'all' ? 'active' : ''}`; searchResults.appendChild(sec); }
                sec.innerHTML = `<div class="mil-search-section-header">${type === 'all' ? 'All Results' : type === 'stores' ? 'Stores' : 'Products'}</div>`;
                if (!data.length) { sec.innerHTML += `<div class="mil-search-no-results">No ${type} found</div>`; return; }
                data.forEach(item => {
                    const a = document.createElement('a');
                    a.className = 'mil-search-result-item';
                    const isStore = item.type === 'store' || type === 'stores';
                    a.href = isStore ? `/store/${item.username}` : `/store/${item.storeUsername}?product=${item._id}`;
                    a.innerHTML = `<img src="${item.logo || item.image || '/img/placeholder-store.png'}" alt=""><div><h6>${item.businessName || item.name || 'Unnamed'}</h6><p>${isStore ? '@' + item.username : '₦' + (item.cost ? parseFloat(item.cost).toLocaleString() : '—')}</p></div><div class="mil-search-arrow">→</div>`;
                    sec.appendChild(a);
                });
                const all = document.createElement('a');
                all.href = `/search?q=${encodeURIComponent(q)}&type=${type}`;
                all.className = 'mil-search-result-item'; all.style.cssText = 'justify-content:center;font-weight:600;color:#008B8B;';
                all.innerHTML = `View all ${type} results →`; sec.appendChild(all);
            };

            searchResults.addEventListener('click', (e) => {
                if (!e.target.classList.contains('mil-search-tab')) return;
                document.querySelectorAll('.mil-search-tab').forEach(t => t.classList.remove('active'));
                e.target.classList.add('active');
                const type = e.target.dataset.type;
                document.querySelectorAll('.mil-search-section').forEach(s => s.classList.remove('active'));
                const sec = document.getElementById(`mil-search-${type}`);
                if (sec) sec.classList.add('active');
                const q = searchInput.value.trim();
                if (q) fetchAndShow(q, type);
            });

            const fetchAndShow = async (q, type = 'all') => {
                if (!q || q.length < 2) { searchResults.classList.remove('active'); return; }
                try { displayResults(await fetchResults(q, type), q, type); searchResults.classList.add('active'); }
                catch(e) {}
            };

            searchInput.addEventListener('input', debounce(() => {
                const type = document.querySelector('.mil-search-tab.active')?.dataset.type || 'all';
                fetchAndShow(searchInput.value.trim(), type);
            }, 300));
        });
    </script>

    <!-- Newsletter subscribe -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form    = document.getElementById('subscribeForm');
            const success = form?.nextElementSibling;
            const error   = form?.previousElementSibling;
            if (!form) return;
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = form.querySelector('input[name="email"]').value;
                try {
                    const r = await fetch('/api/newsletter/subscribe', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email }) });
                    if (r.ok) { form.style.display = 'none'; if (success) success.style.display = 'block'; }
                    else { if (error) { error.textContent = 'Could not subscribe. Please try again.'; error.style.display = 'block'; } }
                } catch(err) { if (error) { error.textContent = 'Network error. Please try again.'; error.style.display = 'block'; } }
            });
        });
    </script>
    <script>
        (function() {
            function initMenu() {
                var openBtn  = document.getElementById('shedMenuOpen');
                var closeBtn = document.getElementById('shedMenuClose');
                var frame    = document.getElementById('shedMenuFrame');
                if (openBtn)  openBtn.onclick  = function() { frame.classList.add('mil-active'); };
                if (closeBtn) closeBtn.onclick = function() { frame.classList.remove('mil-active'); };
                if (frame) frame.addEventListener('click', function(e) {
                    if (e.target === frame) frame.classList.remove('mil-active');
                });
            }
            document.addEventListener('DOMContentLoaded', initMenu);
            if (window.swup) window.swup.on('contentReplaced', initMenu);
        })();
    </script>
