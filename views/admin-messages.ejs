<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Messages | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/custom.css">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Match update-stock styling */
        .mil-banner { height: 400px; }
        .mil-main-content { padding: 20px; transition: margin-left 0.3s ease; width: 100%; box-sizing: border-box; }
        .mil-main-content.full-width { margin-left: 0; }
        .mil-sidebar { width: 250px; background-color: #f8f8f8; position: fixed; top: 0; left: 0; bottom: 0; padding: 20px; z-index: 1001; transition: transform 0.3s ease; overflow-y: auto; }
        .mil-sidebar.hidden { transform: translateX(-100%); }
        .mil-toggle-btn { position: fixed; top: 10px; left: 10px; background: #eba611; color: #333; border: none; padding: 8px 12px; font-size: 16px; cursor: pointer; border-radius: 4px; z-index: 1002; }
        .mil-form-group { margin-bottom: 15px; }
        .mil-form-control { background-color: white; border: 1px solid #ced4da; color: #495057; font-size: 13px; padding: 0.375rem 0.75rem; width: 100%; border-radius: 4px; }
        .mil-form-control:focus { border-color: #80bdff; box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25); outline: none; }
        .mil-button { background-color: #eba611; color: #333; border: none; padding: 10px 20px; font-size: 13px; font-weight: 500; border-radius: 5px; cursor: pointer; transition: all 0.3s ease; }
        .mil-button:hover { background-color: #fff; color: #eba611; border: 2px solid #eba611; }
        .mil-button i { margin-left: 8px; }
        .mil-button.delete-btn { background-color: #dc3545; color: #fff; }
        .mil-button.delete-btn:hover { background-color: #fff; color: #dc3545; border: 2px solid #dc3545; }
        .mil-button.mark-read-btn { background-color: #28a745; color: #fff; }
        .mil-button.mark-read-btn:hover { background-color: #fff; color: #28a745; border: 2px solid #28a745; }
        .mil-alert { color: #d32f2f; background-color: #fde8e8; padding: 12px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #f5c2c7; font-size: 14px; display: flex; align-items: center; }
        .mil-alert.success { color: #388e3c; background-color: #e8f5e9; border: 1px solid #c8e6c9; }
        .mil-alert i { margin-right: 8px; }
        .mil-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9999; display: none; align-items: center; justify-content: center; }
        .mil-modal.active { display: flex; }
        .mil-modal-content { background: white; padding: 20px; border-radius: 8px; max-width: 800px; width: 90%; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); max-height: 80vh; overflow-y: auto; }
        .mil-modal-buttons { display: flex; justify-content: flex-end; gap: 10px; margin-top: 15px; }
        .mil-table-section table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 1000px; }
        .mil-table-section th, .mil-table-section td { padding: 10px; border: 1px solid #dee2e6; text-align: left; }
        .mil-table-section th { background-color: #f8f9fa; color: #333; font-weight: 500; }
        .mil-table-section tr:nth-child(even) { background-color: #f9f9f9; }
        .mil-table-section .content-cell { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
        .mil-table-section .unread { font-weight: bold; background-color: #e6f3ff; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; position: relative; }
        .table-responsive::-webkit-scrollbar { height: 8px; }
        .table-responsive::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
        .table-responsive::-webkit-scrollbar-track { background: #f1f1f1; }
        
        /* Message content styling */
        .message-content-container {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .message-content-container h1, 
        .message-content-container h2, 
        .message-content-container h3 {
            color: #2c3e50;
            margin-top: 1.5em;
            margin-bottom: 0.5em;
        }
        .message-content-container p {
            margin-bottom: 1em;
        }
        .message-content-container ul, 
        .message-content-container ol {
            margin-bottom: 1em;
            padding-left: 1.5em;
        }
        .message-content-container table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1em;
        }
        .message-content-container table th,
        .message-content-container table td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .message-content-container table th {
            background-color: #f2f2f2;
        }
        .message-content-container .info-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            border-left: 4px solid #eba611;
        }
        
        /* Sidebar overlay for mobile */
        .mil-sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            display: none;
        }
        
        @media (max-width: 768px) {
            .mil-sidebar { 
                width: 250px; 
                transform: translateX(-100%); 
                overflow-y: auto;
            }
            .mil-sidebar.hidden { 
                transform: translateX(-100%); 
            }
            .mil-sidebar:not(.hidden) {
                transform: translateX(0);
            }
            .mil-sidebar-overlay.active {
                display: block;
            }
            .mil-main-content { padding: 10px; }
            .mil-table-section table { min-width: 800px; }
            .mil-form-control { font-size: 12px; }
            .mil-button { font-size: 12px; padding: 8px 16px; }
            .mil-modal-content { width: 95%; padding: 15px; }
        }
        @media (max-width: 576px) {
            .mil-table-section table { min-width: 600px; }
            .mil-form-control { font-size: 11px; }
            .mil-button { font-size: 11px; padding: 6px 12px; }
        }
    </style>

    <title>Shed | Messages</title>
</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
    <!-- sidebar -->
    <div class="mil-sidebar" id="sidebar">
        <div class="mil-logo-container">
            <img src="/images/logo.png" alt="Shed Logo">
        </div>
        <h2 class="mil-up">Welcome, <%= username %>!</h2>
        <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
        <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
        <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
        <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
        <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
        <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
        <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
        <a href="/admin-messages" class="mil-up active"><i class="fas fa-envelope"></i> Messages</a>
        <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
    </div>

    <!-- Sidebar overlay -->
    <div class="mil-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- toggle button -->
    <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

    <!-- content -->
    <div class="mil-content">
        <div id="swupMain" class="mil-main-transition">
            <!-- banner -->
            <section class="mil-banner mil-dark-bg">
                <div class="mi-invert-fix">
                    <div class="mil-animation-frame">
                        <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                        <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                        <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                    </div>
                    <div class="mil-gradient"></div>
                    <div class="container">
                        <div class="mil-banner-content mil-up">
                            <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Admin </span>Messages</h1>
                            <div class="row">
                                <div class="col-md-7 col-lg-5">
                                    <p class="mil-light-soft mil-mb-60">View messages for <%= admin.businessName || 'Your Business' %>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- main content -->
            <section class="mil-about">
                <div class="container mil-p-120-60">
                    <div class="row">
                        <div class="col-lg-8 mil-main-content" id="mainContent">
                            <!-- Business Info -->
                            <div class="mil-form-section mil-up">
                                <div class="mil-center">
                                    <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo">
                                    <h4>Messages for <%= admin.businessName || 'Your Business' %></h4>
                                    <p>
                                        Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                    </p>
                                </div>
                            </div>

                            <!-- Error/Success Messages -->
                            <% if (error) { %>
                                <div class="mil-alert mil-up">
                                    <i class="fa-solid fa-bell"></i> <%= error %>
                                </div>
                            <% } %>
                            <% if (success) { %>
                                <div class="mil-alert success mil-up">
                                    <i class="fa-solid fa-check"></i> <%= success %>
                                </div>
                            <% } %>

                            <!-- Search Section -->
                            <div class="mil-search-section mil-up">
                                <form method="GET" action="/admin-messages">
                                    <div class="mil-form-group">
                                        <label>Search Messages <i class="fa-solid fa-search"></i></label>
                                        <div>
                                            <div>
                                                <input type="text" name="search" class="mil-form-control" placeholder="Search by sender or subject" value="<%= search || '' %>">
                                                <button type="submit" class="mil-button search-button">
                                                    <i class="fa-solid fa-search"></i>
                                                </button>
                                            </div>
                                            <% if (search) { %>
                                                <a href="/admin-messages" class="mil-button clear-btn">
                                                    Clear <i class="fa-solid fa-times"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- Table Section -->
                            <div class="mil-table-section mil-up">
                                <% if (messages && messages.length > 0) { %>
                                    <h2 class="mil-mb-30">Messages</h2>
                                    <div class="table-responsive">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Sender</th>
                                                    <th>Subject</th>
                                                    <th>Date</th>
                                                    <th>Preview</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% messages.forEach(message => { %>
                                                    <tr id="row-<%= message._id %>" class="<%= message.read ? '' : 'unread' %>">
                                                        <td><%= message.sender || 'System' %></td>
                                                        <td><%= message.subject || 'No Subject' %></td>
                                                        <td><%= message.createdAt ? new Date(message.createdAt).toLocaleString() : 'N/A' %></td>
                                                        <td class="content-cell" data-id="<%= message._id %>" data-content="<%= message.content ? message.content.replace(/"/g, '&quot;') : '' %>" data-is-html="<%= message.isHtml || false %>">
                                                            <% if (message.content) { %>
                                                                <% if (message.isHtml) { %>
                                                                    <%= message.content.replace(/<[^>]*>/g, '').substring(0, 50) + (message.content.length > 50 ? '...' : '') %>
                                                                <% } else { %>
                                                                    <%= message.content.substring(0, 50) + (message.content.length > 50 ? '...' : '') %>
                                                                <% } %>
                                                            <% } else { %>
                                                                N/A
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <div class="mil-form-row">
                                                                <button class="mil-button mark-read-btn" data-id="<%= message._id %>" data-read="<%= message.read %>" aria-label="<%= message.read ? 'Mark as Unread' : 'Mark as Read' %>">
                                                                    <%= message.read ? 'Mark Unread' : 'Mark Read' %> <i class="fa-solid fa-envelope<%= message.read ? '-open' : '' %>"></i>
                                                                </button>
                                                                <button class="mil-button delete-btn" data-id="<%= message._id %>" data-subject="<%= message.subject ? message.subject.replace(/"/g, '&quot;') : 'Message' %>" aria-label="Delete Message">
                                                                    Delete <i class="fa-solid fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <p class="mil-center">No messages found.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Content Modal -->
    <div id="contentModal" class="mil-modal">
        <div class="mil-modal-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 id="contentModalTitle">Message Content</h5>
                <button id="closeContentModal" class="mil-button" style="padding: 5px 10px;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="contentText" class="message-content-container"></div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal" class="mil-modal">
        <div class="mil-modal-content">
            <h5>Delete Message</h5>
            <p>Are you sure you want to delete "<span id="deleteModalSubject"></span>"? This action cannot be undone.</p>
            <div class="mil-modal-buttons">
                <button type="button" class="mil-button" id="cancelDeleteModal">
                    Cancel <i class="fa-solid fa-times"></i>
                </button>
                <form id="deleteForm" action="/admin/delete-message" method="POST">
                    <input type="hidden" name="_id" id="deleteMessageId">
                    <button type="submit" class="mil-button delete-btn">
                        Delete <i class="fa-solid fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- footer -->
    <footer class="mil-dark-bg">
        <div class="mil-footer">
            <div class="container mil-p-120-60">
                <div class="row justify-content-between">
                    <div class="col-md-4 col-lg-4 mil-mb-60">
                        <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                    </div>
                    <div class="col-md-7 col-lg-6">
                        <div class="row justify-content-end">
                            <div class="mil-vert-between">
                                <p class="mil-light-soft mil-up"><a>New to Shed? <a href="/admin-register">Create New Shed!</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript Dependencies -->
    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/fancybox.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/main.js"></script>

    <!-- Sidebar Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const toggleBtn = document.getElementById('toggleBtn');
            const menuItems = document.querySelectorAll('.mil-sidebar a');
            const overlay = document.getElementById('sidebarOverlay');

            // Initialize based on screen size
            function initializeSidebar() {
                const isMobile = window.innerWidth <= 768;
                const storedState = localStorage.getItem('sidebarHidden');
                
                if (isMobile) {
                    // On mobile, always start hidden regardless of stored state
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                    if (overlay) overlay.classList.remove('active');
                } else {
                    // On desktop, use stored state or default to visible
                    const shouldHide = storedState === 'true';
                    sidebar.classList.toggle('hidden', shouldHide);
                    mainContent.classList.toggle('full-width', shouldHide);
                    toggleBtn.innerHTML = shouldHide ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                    if (overlay) overlay.classList.remove('active');
                }
            }

            // Set up toggle button
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                mainContent.classList.toggle('full-width');
                
                // Update button icon and overlay
                const isHidden = sidebar.classList.contains('hidden');
                toggleBtn.innerHTML = isHidden ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                if (overlay) overlay.classList.toggle('active', !isHidden);
                
                // Only store state on larger screens
                if (window.innerWidth > 768) {
                    localStorage.setItem('sidebarHidden', isHidden);
                }
            });

            // Close sidebar when menu item is clicked (mobile only)
            menuItems.forEach(item => {
                item.addEventListener('click', () => {
                    if (window.innerWidth <= 768) {
                        sidebar.classList.add('hidden');
                        mainContent.classList.add('full-width');
                        toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                        if (overlay) overlay.classList.remove('active');
                    }
                });
            });

            // Close sidebar when overlay is clicked
            if (overlay) {
                overlay.addEventListener('click', () => {
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                    overlay.classList.remove('active');
                });
            }

            // Initialize on load
            initializeSidebar();
            
            // Update on resize
            window.addEventListener('resize', initializeSidebar);
        });
    </script>

    <!-- Messages Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                // Content Modal
                function showContentModal(content, isHtml, subject) {
                    const modal = document.getElementById('contentModal');
                    const contentText = document.getElementById('contentText');
                    const title = document.getElementById('contentModalTitle');
                    
                    title.textContent = subject || 'Message Content';
                    
                    if (isHtml) {
                        contentText.innerHTML = content || '<p>No content available</p>';
                    } else {
                        contentText.textContent = content || 'No content available';
                    }
                    
                    modal.classList.add('active');
                }

                function hideContentModal() {
                    const modal = document.getElementById('contentModal');
                    modal.classList.remove('active');
                }

                // Delete Modal
                function showDeleteModal(id, subject) {
                    const modal = document.getElementById('deleteModal');
                    const subjectSpan = document.getElementById('deleteModalSubject');
                    const deleteForm = document.getElementById('deleteForm');
                    subjectSpan.textContent = subject;
                    deleteForm.querySelector('#deleteMessageId').value = id;
                    modal.classList.add('active');
                }

                function hideDeleteModal() {
                    const modal = document.getElementById('deleteModal');
                    modal.classList.remove('active');
                }

                // Mark Read/Unread
                document.querySelectorAll('.mark-read-btn').forEach(button => {
                    button.addEventListener('click', async () => {
                        const id = button.dataset.id;
                        const isRead = button.dataset.read === 'true';
                        
                        try {
                            const response = await fetch('/mark-as-read', {
                                method: 'POST',
                                headers: { 
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify({ 
                                    _id: id, 
                                    read: !isRead 
                                })
                            });
                            
                            const data = await response.json();
                            
                            if (data.success) {
                                const row = document.getElementById(`row-${id}`);
                                button.dataset.read = !isRead;
                                button.innerHTML = `${isRead ? 'Mark Read' : 'Mark Unread'} <i class="fa-solid fa-envelope${isRead ? '' : '-open'}"></i>`;
                                row.classList.toggle('unread', !isRead);
                            } else {
                                alert('Failed to update message status: ' + (data.error || 'Unknown error'));
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            alert('Error updating message status');
                        }
                    });
                });

                // Delete Button
                document.querySelectorAll('.delete-btn').forEach(button => {
                    if (button.tagName === 'BUTTON') {
                        button.addEventListener('click', (e) => {
                            e.preventDefault();
                            const id = button.dataset.id;
                            const subject = button.dataset.subject;
                            showDeleteModal(id, subject);
                        });
                    }
                });

                // Content Cell
                document.querySelectorAll('.content-cell').forEach(cell => {
                    cell.addEventListener('click', () => {
                        const content = cell.dataset.content;
                        const isHtml = cell.dataset.isHtml === 'true';
                        const subject = cell.closest('tr').querySelector('td:nth-child(2)').textContent;
                        showContentModal(content, isHtml, subject);
                    });
                });

                // Modal Controls
                document.getElementById('cancelDeleteModal')?.addEventListener('click', hideDeleteModal);
                document.getElementById('closeContentModal')?.addEventListener('click', hideContentModal);
                
                document.getElementById('contentModal')?.addEventListener('click', (e) => {
                    if (e.target === e.currentTarget) hideContentModal();
                });
                
                document.getElementById('deleteModal')?.addEventListener('click', (e) => {
                    if (e.target === e.currentTarget) hideDeleteModal();
                });

                // Escape key to close modals
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        hideContentModal();
                        hideDeleteModal();
                    }
                });

            } catch (error) {
                console.error('Error in messages scripts:', error);
            }
        });
    </script>

    <script>
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>

</body>
</html>