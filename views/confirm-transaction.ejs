<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Confirm Transaction</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .detail-row { display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid #f5f5f5; font-size:0.92rem; }
    .detail-row:last-child { border-bottom:none; }
    .detail-label { color:#999; font-weight:500; }
    .detail-value { color:#0d0d1a; font-weight:600; text-align:right; }
    .item-entry { background:#f8f9fa; border-radius:8px; padding:12px 16px; margin-bottom:10px; }
    .item-entry:last-child { margin-bottom:0; }
    .vat-badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
    .vat-on { background:rgba(0,139,139,0.12); color:#008B8B; }
    .vat-off { background:#f0f0f0; color:#999; }
    .amount-block { background:#0d0d1a; border-radius:10px; padding:16px 20px; margin-top:16px; }
    .amount-line { display:flex; justify-content:space-between; color:rgba(255,255,255,0.6); font-size:0.88rem; margin-bottom:8px; }
    .amount-total { display:flex; justify-content:space-between; color:#fff; font-size:1.1rem; font-weight:700; border-top:1px solid rgba(255,255,255,0.15); padding-top:10px; margin-top:4px; }
    .amount-total span:last-child { color:#008B8B; }
  </style>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'pos', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Confirm Transaction</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
          <%= admin.firstName || admin.username %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/profile"><i class="fas fa-user-circle"></i> Profile &amp; Settings</a>
          <a href="/admin-messages"><i class="fas fa-envelope"></i> Messages</a>
          <div class="dropdown-divider"></div>
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>Confirm Transaction</h1>
        <p>Review the sale details before confirming</p>
      </div>
      <a href="/pos" class="btn-secondary-app"><i class="fas fa-times"></i> Cancel</a>
    </div>

    <div style="max-width:680px;">

      <!-- Customer details -->
      <div class="app-card" style="margin-bottom:20px;">
        <div class="app-card-title">Customer Details</div>
        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-user" style="color:#008B8B; margin-right:6px;"></i>Customer Name</span>
          <span class="detail-value"><%= customerName %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-phone" style="color:#008B8B; margin-right:6px;"></i>Phone</span>
          <span class="detail-value"><%= phoneNumber || 'N/A' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-envelope" style="color:#008B8B; margin-right:6px;"></i>Email</span>
          <span class="detail-value"><%= email || 'N/A' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label"><i class="fas fa-credit-card" style="color:#008B8B; margin-right:6px;"></i>Payment Method</span>
          <span class="detail-value"><%= paymentMethod %></span>
        </div>
      </div>

      <!-- Items -->
      <div class="app-card" style="margin-bottom:20px;">
        <div class="app-card-title">Items</div>
        <% saleItems.forEach(item => { %>
          <div class="item-entry">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span style="font-weight:600; color:#0d0d1a;"><%= item.itemName %></span>
              <span class="vat-badge <%= item.isVatable ? 'vat-on' : 'vat-off' %>">
                <%= item.isVatable ? 'VAT ' + item.vatRate + '%' : 'No VAT' %>
              </span>
            </div>
            <div style="display:flex; gap:20px; font-size:0.85rem; color:#666;">
              <span>Qty: <strong><%= item.quantity %></strong></span>
              <span>Unit: <strong><%= currency %><%= formatCurrency(item.unitCost) %></strong></span>
              <span>Subtotal: <strong><%= currency %><%= formatCurrency(item.totalCost) %></strong></span>
              <% if (item.isVatable && item.vatAmount > 0) { %>
                <span>VAT: <strong><%= currency %><%= formatCurrency(item.vatAmount) %></strong></span>
              <% } %>
            </div>
          </div>
        <% }) %>

        <div class="amount-block">
          <div class="amount-line"><span>Subtotal</span><span><%= currency %><%= formatCurrency(subtotalAmount) %></span></div>
          <% if (totalVatAmount > 0) { %>
            <div class="amount-line"><span>VAT Total</span><span><%= currency %><%= formatCurrency(totalVatAmount) %></span></div>
          <% } %>
          <div class="amount-total"><span>Total</span><span><%= currency %><%= formatCurrency(totalOrderAmount) %></span></div>
        </div>
      </div>

      <!-- Confirm form -->
      <form action="/confirm-sale" method="POST">
        <input type="hidden" name="customerName" value="<%= customerName %>">
        <input type="hidden" name="phoneNumber" value="<%= phoneNumber %>">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="paymentMethod" value="<%= paymentMethod %>">
        <input type="hidden" name="totalOrderAmount" value="<%= totalOrderAmount %>">
        <input type="hidden" name="subtotalAmount" value="<%= subtotalAmount %>">
        <input type="hidden" name="totalVatAmount" value="<%= totalVatAmount %>">
        <% saleItems.forEach((item, index) => { %>
          <input type="hidden" name="saleItems[<%= index %>][itemId]" value="<%= item.itemId %>">
          <input type="hidden" name="saleItems[<%= index %>][itemName]" value="<%= item.itemName %>">
          <input type="hidden" name="saleItems[<%= index %>][quantity]" value="<%= item.quantity %>">
          <input type="hidden" name="saleItems[<%= index %>][unitCost]" value="<%= item.unitCost %>">
          <input type="hidden" name="saleItems[<%= index %>][totalCost]" value="<%= item.totalCost %>">
          <input type="hidden" name="saleItems[<%= index %>][isVatable]" value="<%= item.isVatable %>">
          <input type="hidden" name="saleItems[<%= index %>][vatRate]" value="<%= item.vatRate %>">
          <input type="hidden" name="saleItems[<%= index %>][vatAmount]" value="<%= item.vatAmount %>">
          <input type="hidden" name="saleItems[<%= index %>][itemTotalWithVat]" value="<%= item.itemTotalWithVat %>">
        <% }) %>
        <div style="display:flex; gap:12px;">
          <button type="submit" class="btn-primary-app">
            <i class="fas fa-check-circle"></i> Confirm Sale
          </button>
          <a href="/pos" class="btn-secondary-app">
            <i class="fas fa-times"></i> Cancel
          </a>
        </div>
      </form>

    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
