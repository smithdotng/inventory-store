<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Invoices | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Banner starts at top */
        .mil-banner {
            margin-top: 0;
            padding-top: 0;
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
        }
        /* Content padding */
        .mil-content {
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-alert i {
            margin-right: 8px;
        }
        .mil-field-error {
            color: #d32f2f;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 10px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-button.add-product-btn {
            background-color: rgb(255, 204, 0);
            color: #333;
        }
        .mil-button.add-product-btn:hover {
            background-color: #fff;
            color: rgb(255, 204, 0);
            border: 2px solid rgb(255, 204, 0);
        }
        .mil-button.update-btn {
            background-color: rgb(40, 167, 69);
            color: #fff;
        }
        .mil-button.update-btn:hover {
            background-color: #fff;
            color: rgb(40, 167, 69);
            border: 2px solid rgb(40, 167, 69);
        }
        .mil-button.delete-btn {
            background-color: rgb(220, 53, 69);
            color: #fff;
        }
        .mil-button.delete-btn:hover {
            background-color: #fff;
            color: rgb(220, 53, 69);
            border: 2px solid rgb(220, 53, 69);
        }
        .mil-button.cancel-btn {
            background-color: rgb(108, 117, 125);
            color: #fff;
        }
        .mil-button.cancel-btn:hover {
            background-color: #fff;
            color: rgb(108, 117, 125);
            border: 2px solid rgb(108, 117, 125);
        }
        .mil-button.download-btn {
            background-color: rgb(23, 162, 184);
            color: #fff;
        }
        .mil-button.download-btn:hover {
            background-color: #fff;
            color: rgb(23, 162, 184);
            border: 2px solid rgb(23, 162, 184);
        }
        /* Sidebar styling */
        .mil-wrapper .mil-sidebar {
            width: 250px;
            background-color: #f8f8f8 !important;
            opacity: 1 !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 20px;
            z-index: 1001;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .mil-wrapper .mil-sidebar.hidden {
            transform: translateX(-100%);
        }
        .mil-wrapper .mil-sidebar * {
            background-color: transparent !important;
            opacity: 1 !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container {
            text-align: center;
            margin-bottom: 20px;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container img {
            width: 100px;
            height: auto;
        }
        .mil-wrapper .mil-sidebar h2 {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 500;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: background 0.3s ease;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a:hover {
            background: rgb(235, 166, 17) !important;
            color: #fff;
        }
        .mil-wrapper .mil-sidebar a.active {
            background: rgb(235, 166, 17) !important;
            color: #fff;
            font-weight: bold;
        }
        /* Toggle button */
        .mil-toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            background: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 8px 12px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            z-index: 1002;
        }
        /* Main content */
        .mil-main-content {
            padding: 20px;
            transition: margin-left 0.3s ease;
            width: 100%;
            box-sizing: border-box;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .mil-main-content.full-width {
            margin-left: 0;
        }
        /* Center the main content container */
        .mil-about .container {
            display: flex;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .mil-sidebar:not(.hidden) ~ .mil-content .mil-about .container {
            margin-left: calc(250px + ((100% - 250px - 800px) / 2));
            margin-right: auto;
        }
        .mil-sidebar.hidden ~ .mil-content .mil-about .container {
            margin-left: auto;
            margin-right: auto;
        }
        /* Table styling */
        .mil-table-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .mil-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .mil-table th, .mil-table td {
            padding: 10px;
            border: 1px solid #dee2e6;
            text-align: left;
            color: #333;
        }
        .mil-table th {
            background-color: #e9ecef;
            color: #333;
            font-weight: 500;
        }
        .mil-table td {
            background-color: white;
        }
        /* Item row */
        .mil-item-row {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        .mil-item-row select,
        .mil-item-row input[type="number"] {
            flex: 1;
            min-width: 150px;
        }
        /* New customer and product fields */
        .mil-new-customer-fields, .mil-bank-details, .mil-new-product-fields {
            margin-top: 10px;
            padding: 10px;
            background-color: #f9f9f9;
            border-radius: 4px;
            width: 100%;
        }
        /* Form actions */
        .mil-form-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .mil-button-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .mil-action-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        /* Hidden class */
        .hidden {
            display: none !important;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-wrapper .mil-sidebar {
                width: 200px;
                background-color: #f8f8f8 !important;
                opacity: 1 !important;
            }
            .mil-main-content {
                margin-left: 0;
            }
            .mil-main-content.full-width {
                margin-left: 0;
            }
            .mil-form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .mil-item-row {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-item-row select,
            .mil-item-row input[type="number"] {
                min-width: 100%;
            }
            .mil-form-actions, .mil-button-group, .mil-action-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-form-actions .mil-button,
            .mil-button-group .mil-button,
            .mil-action-buttons .mil-button {
                width: 100%;
            }
            .mil-about .container {
                margin-left: auto;
                margin-right: auto;
                max-width: 100%;
                padding-left: 15px;
                padding-right: 15px;
            }
            .mil-table {
                font-size: 12px;
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
            .mil-table th, .mil-table td {
                padding: 8px;
                min-width: 100px;
            }
        }
        @media (max-width: 576px) {
            .mil-main-content {
                padding: 10px;
                width: 95%;
                margin: 0 auto;
            }
            .mil-table th, .mil-table td {
                padding: 6px;
                min-width: 90px;
            }
        }
    </style>

    <title>Invoices</title>
</head>
<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up active"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Generate </span>Invoice</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Manage invoices for <%= admin.businessName || 'Your Business' %>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo" style="height: 50px; margin-bottom: 10px;">
                                        <h4 style="color: #333; font-size: 16px;">Invoices for <%= admin.businessName || 'Your Business' %></h4>
                                        <p style="color: #333; font-size: 13px;">
                                            Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Error Messages -->
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-exclamation-circle"></i> <%= error %>
                                    </div>
                                <% } %>

                                <!-- Create Invoice Button -->
                                <div class="mil-button-group">
                                    <button id="createInvoiceBtn" class="mil-button add-product-btn">
                                        Create Invoice <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>

                                <!-- Create Invoice Form (Hidden by Default) -->
                                <div class="mil-form-section" id="createInvoiceForm" style="display: <%= error ? 'block' : 'none' %>;">
                                    <h2 class="mil-mb-30">Create New Invoice</h2>
                                    <form id="invoiceForm" action="/invoices/create" method="POST">
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-user"></i> Customer</label>
                                            <select id="customerSelect" name="customerId" class="mil-form-control" required>
                                                <option value="">Select Customer</option>
                                                <% customers.forEach(customer => { %>
                                                    <option value="<%= customer._id %>" <%= formData.customerId === customer._id.toString() ? 'selected' : '' %>>
                                                        <%= customer.name %> (<%= customer.phone || 'N/A' %>)
                                                    </option>
                                                <% }) %>
                                                <option value="new" <%= formData.customerId === 'new' ? 'selected' : '' %>>Create New Customer</option>
                                            </select>
                                            <div class="mil-field-error" id="customerSelectError"></div>
                                        </div>

                                        <div id="newCustomerFields" class="mil-new-customer-fields hidden">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-user-plus"></i> New Customer Name</label>
                                                <input type="text" name="newCustomerName" id="newCustomerName" class="mil-form-control" placeholder="New Customer Name" value="<%= formData.newCustomerName || '' %>">
                                                <div class="mil-field-error" id="newCustomerNameError"></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-phone"></i> Phone Number</label>
                                                <input type="text" name="newCustomerPhone" id="newCustomerPhone" class="mil-form-control" placeholder="Phone Number" value="<%= formData.newCustomerPhone || '' %>">
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-envelope"></i> Email Address</label>
                                                <input type="email" name="newCustomerEmail" id="newCustomerEmail" class="mil-form-control" placeholder="Email Address" value="<%= formData.newCustomerEmail || '' %>">
                                            </div>
                                        </div>

                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-boxes"></i> Items</label>
                                            <div id="itemsContainer">
                                                <% if (formData.items && formData.items.itemId) { %>
                                                    <% const itemIds = Array.isArray(formData.items.itemId) ? formData.items.itemId : [formData.items.itemId]; %>
                                                    <% const quantities = Array.isArray(formData.items.quantity) ? formData.items.quantity : [formData.items.quantity]; %>
                                                    <% itemIds.forEach((itemId, index) => { %>
                                                        <div class="mil-item-row" data-index="<%= index %>">
                                                            <select name="items[itemId][]" class="mil-form-control" required>
                                                                <option value="">Select Item</option>
                                                                <% inventory.forEach(item => { %>
                                                                    <option value="<%= item._id %>" <%= itemId === item._id.toString() ? 'selected' : '' %> data-stock="<%= item.stock %>">
                                                                        <%= item.name %> (Stock: <%= item.stock %>)
                                                                    </option>
                                                                <% }) %>
                                                                <option value="new">Create New Product</option>
                                                            </select>
                                                            <input type="number" name="items[quantity][]" class="mil-form-control" placeholder="Quantity" min="1" value="<%= quantities[index] || '' %>" required>
                                                            <button type="button" class="mil-button delete-btn remove-btn">
                                                                <i class="fa-solid fa-minus"></i>
                                                            </button>
                                                            <div class="mil-new-product-fields hidden" id="newProductFields<%= index %>">
                                                                <div class="mil-form-group">
                                                                    <label><i class="fa-solid fa-box"></i> Product Name</label>
                                                                    <input type="text" name="items[newProductName][]" class="mil-form-control" placeholder="Product Name">
                                                                </div>
                                                                <div class="mil-form-group">
                                                                    <label><i class="fa-solid fa-money-bill"></i> Cost</label>
                                                                    <input type="number" name="items[newProductCost][]" class="mil-form-control" placeholder="Cost" min="0" step="0.01">
                                                                </div>
                                                                <div class="mil-form-group">
                                                                    <label><i class="fa-solid fa-cubes"></i> Stock</label>
                                                                    <input type="number" name="items[newProductStock][]" class="mil-form-control" placeholder="Stock" min="0">
                                                                </div>
                                                            </div>
                                                            <div class="mil-field-error" id="itemError<%= index %>"></div>
                                                        </div>
                                                    <% }) %>
                                                <% } else { %>
                                                    <div class="mil-item-row" data-index="0">
                                                        <select name="items[itemId][]" class="mil-form-control" required>
                                                            <option value="">Select Item</option>
                                                            <% inventory.forEach(item => { %>
                                                                <option value="<%= item._id %>" data-stock="<%= item.stock %>">
                                                                    <%= item.name %> (Stock: <%= item.stock %>)
                                                                </option>
                                                            <% }) %>
                                                            <option value="new">Create New Product</option>
                                                        </select>
                                                        <input type="number" name="items[quantity][]" class="mil-form-control" placeholder="Quantity" min="1" required>
                                                        <button type="button" class="mil-button delete-btn remove-btn" style="display: none;">
                                                            <i class="fa-solid fa-minus"></i>
                                                        </button>
                                                        <div class="mil-new-product-fields hidden" id="newProductFields0">
                                                            <div class="mil-form-group">
                                                                <label><i class="fa-solid fa-box"></i> Product Name</label>
                                                                <input type="text" name="items[newProductName][]" class="mil-form-control" placeholder="Product Name">
                                                            </div>
                                                            <div class="mil-form-group">
                                                                <label><i class="fa-solid fa-money-bill"></i> Cost</label>
                                                                <input type="number" name="items[newProductCost][]" class="mil-form-control" placeholder="Cost" min="0" step="0.01">
                                                            </div>
                                                            <div class="mil-form-group">
                                                                <label><i class="fa-solid fa-cubes"></i> Stock</label>
                                                                <input type="number" name="items[newProductStock][]" class="mil-form-control" placeholder="Stock" min="0">
                                                            </div>
                                                        </div>
                                                        <div class="mil-field-error" id="itemError0"></div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="mil-form-actions">
                                            <button type="button" id="addItemBtn" class="mil-button add-product-btn">
                                                Add Another Item <i class="fa-solid fa-plus"></i>
                                            </button>
                                        </div>

                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-credit-card"></i> Payment Method</label>
                                            <select name="paymentMethod" id="paymentMethod" class="mil-form-control" required>
                                                <option value="">Select Payment Method</option>
                                                <option value="Cash" <%= formData.paymentMethod === 'Cash' ? 'selected' : '' %>>Cash</option>
                                                <option value="Credit Card" <%= formData.paymentMethod === 'Credit Card' ? 'selected' : '' %>>Credit Card</option>
                                                <option value="Bank Transfer" <%= formData.paymentMethod === 'Bank Transfer' ? 'selected' : '' %>>Bank Transfer</option>
                                                <option value="Mobile Payment" <%= formData.paymentMethod === 'Mobile Payment' ? 'selected' : '' %>>Mobile Payment</option>
                                            </select>
                                            <div class="mil-field-error" id="paymentMethodError"></div>
                                        </div>

                                        <div id="bankDetails" class="mil-bank-details hidden">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-bank"></i> Bank Name</label>
                                                <input type="text" name="bankName" id="bankName" class="mil-form-control" placeholder="Bank Name" value="<%= formData.bankName || '' %>">
                                                <div class="mil-field-error" id="bankNameError"></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-user"></i> Bank Account Name</label>
                                                <input type="text" name="bankAccountName" id="bankAccountName" class="mil-form-control" placeholder="Bank Account Name" value="<%= formData.bankAccountName || '' %>">
                                                <div class="mil-field-error" id="bankAccountNameError"></div>
                                            </div>
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-hashtag"></i> Account Number</label>
                                                <input type="text" name="accountNumber" id="accountNumber" class="mil-form-control" placeholder="Account Number" value="<%= formData.accountNumber || '' %>">
                                                <div class="mil-field-error" id="accountNumberError"></div>
                                            </div>
                                        </div>

                                        <div class="mil-form-actions">
                                            <button type="submit" class="mil-button update-btn">
                                                Create Invoice <i class="fa-solid fa-file-invoice"></i>
                                            </button>
                                            <button type="button" class="mil-button cancel-btn" id="cancelInvoiceBtn">
                                                Cancel <i class="fa-solid fa-times"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <!-- Invoices Table -->
                                <div class="mil-table-section mil-up">
                                    <h2 class="mil-mb-30">Existing Invoices</h2>
                                    <table class="mil-table">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Customer Name</th>
                                                <th>Items</th>
                                                <th>Total Amount</th>
                                                <th>Payment Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% sales.forEach(sale => { %>
                                                <tr id="sale-<%= sale._id %>">
                                                    <td><%= new Date(sale.date).toLocaleDateString() %></td>
                                                    <td><%= sale.customerName %></td>
                                                    <td>
                                                        <% if (sale.items) { %>
                                                            <%= sale.items.map(item => `${item.itemName} (${item.quantity})`).join(', ') %>
                                                        <% } else { %>
                                                            <%= `${sale.itemName} (${sale.quantity})` %>
                                                        <% } %>
                                                    </td>
                                                    <td><%= admin.currency %><%= formatCurrency(sale.totalAmount || 0) %></td>
                                                    <td class="payment-status"><%= sale.paymentStatus || 'Pending' %></td>
                                                    <td>
                                                        <div class="mil-action-buttons">
                                                            <a href="/invoices/download/<%= sale._id %>" class="mil-button download-btn">
                                                                Download PDF <i class="fa-solid fa-download"></i>
                                                            </a>
                                                            <% if (sale.paymentStatus !== 'Paid') { %>
                                                                <form action="/invoices/mark-paid/<%= sale._id %>" method="POST" class="action-form" data-sale-id="<%= sale._id %>">
                                                                    <button type="submit" class="mil-button update-btn">
                                                                        Mark as Paid <i class="fa-solid fa-check"></i>
                                                                    </button>
                                                                </form>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

