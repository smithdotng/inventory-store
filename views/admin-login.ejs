<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="Login | Shed: Inventory, Invoices and More" />
  <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
  <meta property="og:image" content="/android-chrome-512x512.png" />
  <title>Shed</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  
  
</head>
<body style="justify-content: center;">
  <div class="container" style="align-self: center; position: absolute; justify-self: center;">
    <!-- Logo above the form -->
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Yearnings Custom Store Logo" style="width: 300px; padding-bottom: 50px;">
    </div>

    <div class="form-section" style="width: 600px; justify-self: center;">
      <h2>Login to your Shed<span class="icon-verification" style="margin-left: 10px;"></span></h2>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/admin-login" method="POST">
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Login <span class="icon-right-arrow"></span></button>
      </form>
      <div style="padding-top: 30px;">You don't have account? Don't miss out, <span style="color: green;"><a href="/admin-register">Register</a></span> </div>
    </div>
  </div>
</body>
</html>