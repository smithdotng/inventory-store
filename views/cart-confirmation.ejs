<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Order Confirmed</title>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Jost', sans-serif; background: #f7f7f8; color: #222; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { background: #fff; border-radius: 16px; padding: 44px 40px; max-width: 460px; width: 100%; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.08); }
    .icon { width: 72px; height: 72px; border-radius: 50%; background: #eafaf1; color: #1e8449; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px; }
    h1 { font-size: 1.4rem; margin-bottom: 10px; }
    p { color: #777; font-size: 0.92rem; margin-bottom: 6px; }
    .total { font-size: 1.6rem; font-weight: 700; color: #FF9800; margin: 18px 0; }
    .btn { display: inline-block; margin-top: 20px; padding: 12px 26px; background: #FF9800; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600; }
    .invoice-list { text-align: left; margin-top: 24px; padding-top: 20px; border-top: 1px solid #f0f0f0; }
    .invoice-list p { color: #555; font-weight: 600; margin-bottom: 10px; }
    .invoice-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; font-size: 0.88rem; }
    .invoice-row a { color: #FF9800; text-decoration: none; font-weight: 600; margin-left: 14px; }
    .invoice-row a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon"><i class="fas fa-check"></i></div>
    <h1>Order placed!</h1>
    <% if (typeof note !== 'undefined' && note) { %>
      <p><%= note %></p>
    <% } else { %>
      <p>Your order across <%= storeCount %> store<%= storeCount === 1 ? '' : 's' %> has been paid for.</p>
      <% if (total) { %><div class="total">₦<%= Number(total).toLocaleString('en-US', {minimumFractionDigits:2}) %></div><% } %>
      <p>Each store owner has been notified and will process your order.</p>
      <% if (saleIds && saleIds.length) { %>
        <div class="invoice-list">
          <p>Invoices &amp; receipts</p>
          <% saleIds.forEach(function(id, i) { %>
            <div class="invoice-row">
              <span>Order <%= i + 1 %></span>
              <span>
                <a href="/shopper/orders/<%= id %>/invoice" target="_blank" rel="noopener">View</a>
                <a href="/shopper/orders/<%= id %>/invoice?download=1">Download</a>
              </span>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>
    <a class="btn" href="/shopper/account">View My Orders</a>
  </div>
</body>
</html>
