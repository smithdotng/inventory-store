<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Sent Messages | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="View your sent messages to admins." />
    <meta property="og:image" content="/android-chrome-512x512.png" />

    <!-- Google Tag Manager -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS matching dashboard style -->
    <style>
        :root {
            --primary-color: rgb(235, 166, 17);
            --secondary-color: #008B8B;
            --dark-bg: #1a1a1a;
            --light-bg: #f8f8f8;
            --text-dark: #333;
            --text-light: #fff;
            --success-color: #388e3c;
            --error-color: #d32f2f;
            --warning-color: #ffa000;
            --border-radius: 4px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }

        /* Logo size adjustment */
        .mil-logo-container img {
            width: 120px;
            height: auto;
            max-width: 100%;
        }

        .message-content {
            white-space: pre-wrap;
            max-width: 400px;
            overflow-wrap: break-word;
        }

        .message-recipient {
            font-weight: 500;
        }

        .message-date {
            color: #666;
            font-size: 13px;
        }

        .message-read-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .message-read-status .read {
            color: var(--success-color);
        }

        .message-read-status .unread {
            color: var(--warning-color);
        }

        /* Responsive table adjustments */
        @media (max-width: 767px) {
            .message-content {
                max-width: 200px;
            }
        }
    </style>

    <title>Sent Messages | Superadmin Dashboard</title>
</head>
<body>
    <div class="mil-wrapper" id="top">
        <!-- Scrollbar Progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>

        <!-- Sidebar with properly sized logo -->
        <div class="mil-sidebar hidden" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= currentAdmin.username %>!</h2>
            <a href="/superadmin/dashboard" class="mil-up"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/superadmin/create-admin" class="mil-up"><i class="fas fa-user-plus"></i> Create Admin</a>
            <a href="/superadmin/sent-messages" class="mil-up active"><i class="fas fa-envelope"></i> Sent Messages</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>

        <!-- Toggle Button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- Content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- Banner -->
                <section class="mil-banner mil-dark-bg">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Sent </span>Messages</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">View all messages you've sent to admins</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-10 mil-main-content" id="mainContent">
                                <!-- Flash Messages -->
                                <% if (Array.isArray(success) && success.length > 0) { %>
                                    <% success.forEach(function(msg) { %>
                                        <div class="mil-success mil-up">
                                            <i class="fas fa-check-circle"></i> <%= msg %>
                                        </div>
                                    <% }) %>
                                <% } %>
                                <% if (Array.isArray(error) && error.length > 0) { %>
                                    <% error.forEach(function(msg) { %>
                                        <div class="mil-error mil-up">
                                            <i class="fas fa-exclamation-circle"></i> <%= msg %>
                                        </div>
                                    <% }) %>
                                <% } %>

                                <!-- Messages Table -->
                                <div class="mil-form-section mil-up">
                                    <h4 style="color: #333; font-size: 16px; margin-bottom: 20px;">Your Sent Messages</h4>
                                    <% if (messages && messages.length > 0) { %>
                                        <div class="table-responsive" aria-label="Scrollable messages table">
                                            <table class="mil-table">
                                                <thead>
                                                    <tr>
                                                        <th style="min-width: 150px;">Recipient</th>
                                                        <th style="min-width: 300px;">Message</th>
                                                        <th style="min-width: 150px;">Sent At</th>
                                                        <th style="min-width: 100px;">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% messages.forEach(msg => { %>
                                                        <tr>
                                                            <td class="message-recipient"><%= msg.recipient %></td>
                                                            <td class="message-content"><%= msg.content %></td>
                                                            <td class="message-date"><%= msg.formattedDate %></td>
                                                            <td>
                                                                <span class="message-read-status">
                                                                    <% if (msg.read) { %>
                                                                        <i class="fas fa-check-circle read"></i> <span>Read</span>
                                                                        <% if (msg.readAtFormatted) { %>
                                                                            <br><small><%= msg.readAtFormatted %></small>
                                                                        <% } %>
                                                                    <% } else { %>
                                                                        <i class="fas fa-clock unread"></i> <span>Unread</span>
                                                                    <% } %>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } else { %>
                                        <p style="text-align: center; color: #333;">No messages have been sent yet.</p>
                                    <% } %>
                                </div>

                                <!-- Back to Dashboard Button -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-form-actions">
                                        <a href="/superadmin/dashboard" class="mil-button">
                                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- Footer -->
        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container-fluid">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-lg-6 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mil-vert-between text-lg-end">
                                <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- JavaScript Dependencies -->
    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/fancybox.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/smooth-scroll.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/main.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Sent messages script loaded');
            try {
                // Sidebar Toggle
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                const toggleBtn = document.getElementById('toggleBtn');

                if (!sidebar || !mainContent || !toggleBtn) {
                    console.error('Sidebar, mainContent, or toggleBtn not found');
                    return;
                }

                // Check if mobile device
                const isMobile = window.matchMedia('(max-width: 767px)').matches;
                
                // Initialize sidebar state
                const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true' || isMobile;
                if (isSidebarHidden) {
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                } else {
                    sidebar.classList.remove('hidden');
                    mainContent.classList.remove('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
                }

                // Toggle sidebar function
                function toggleSidebar() {
                    sidebar.classList.toggle('hidden');
                    mainContent.classList.toggle('full-width');
                    toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                    localStorage.setItem('sidebarHidden', sidebar.classList.contains('hidden'));
                }

                // Toggle button click event
                toggleBtn.addEventListener('click', toggleSidebar);

                // Close sidebar when clicking outside on mobile
                document.addEventListener('click', function(e) {
                    if (window.innerWidth <= 768 && sidebar && !sidebar.contains(e.target) && e.target !== toggleBtn) {
                        if (!sidebar.classList.contains('hidden')) {
                            toggleSidebar();
                        }
                    }
                });

                // Progress bar
                window.addEventListener('scroll', function() {
                    const progressBar = document.querySelector('.mil-progress');
                    if (progressBar) {
                        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
                        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                        const scrolled = (scrollTop / scrollHeight) * 100;
                        progressBar.style.width = scrolled + '%';
                    }
                });

                // Responsive adjustments
                function handleResize() {
                    if (window.innerWidth <= 767) {
                        // Mobile view - ensure sidebar is hidden by default
                        if (!sidebar.classList.contains('hidden')) {
                            sidebar.classList.add('hidden');
                            mainContent.classList.add('full-width');
                            toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                        }
                    } else {
                        // Desktop view - restore sidebar state from localStorage
                        const shouldShowSidebar = localStorage.getItem('sidebarHidden') !== 'true';
                        if (sidebar.classList.contains('hidden') && shouldShowSidebar) {
                            sidebar.classList.remove('hidden');
                            mainContent.classList.remove('full-width');
                            toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
                        }
                    }
                }

                window.addEventListener('resize', handleResize);
                handleResize();

            } catch (error) {
                console.error('Error in sent messages scripts:', error);
            }
        });
    </script>
</body>
</html>