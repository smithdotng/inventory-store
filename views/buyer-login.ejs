<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buyer Login — Shed</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #0d0d0d;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* Split layout */
    .bl-wrap {
      display: flex;
      width: 100%;
      max-width: 860px;
      min-height: 520px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    }

    /* Left brand panel */
    .bl-brand {
      width: 42%;
      background: #FF9800;
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .bl-brand-logo {
      font-size: 28px;
      font-weight: 800;
      color: #000;
      letter-spacing: -1px;
      text-decoration: none;
    }
    .bl-brand-logo span { opacity: 0.4; }
    .bl-brand-headline {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 32px 0;
    }
    .bl-brand-headline h1 {
      font-size: 2rem;
      font-weight: 800;
      color: #000;
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .bl-brand-headline p {
      font-size: 0.95rem;
      color: rgba(0,0,0,0.6);
      line-height: 1.6;
    }
    .bl-brand-features {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .bl-feature {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.85rem;
      color: rgba(0,0,0,0.7);
    }
    .bl-feature i { font-size: 14px; color: #000; }

    /* Right form panel */
    .bl-form-panel {
      flex: 1;
      background: #1a1a1a;
      padding: 48px 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .bl-form-panel h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }
    .bl-form-panel .bl-subtitle {
      font-size: 0.9rem;
      color: #888;
      margin-bottom: 32px;
      line-height: 1.5;
    }
    .bl-subtitle strong { color: #FF9800; }

    /* Progress steps */
    .bl-steps {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 32px;
    }
    .bl-step {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: #555;
    }
    .bl-step.active { color: #FF9800; }
    .bl-step.done   { color: #4caf50; }
    .bl-step-dot {
      width: 22px; height: 22px;
      border-radius: 50%;
      border: 2px solid currentColor;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700;
    }
    .bl-step.active .bl-step-dot { background: #FF9800; border-color: #FF9800; color: #000; }
    .bl-step.done   .bl-step-dot { background: #4caf50; border-color: #4caf50; color: #fff; }
    .bl-step-line { flex: 1; height: 1px; background: #333; }

    /* Form */
    .bl-field { margin-bottom: 20px; }
    .bl-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: #aaa;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .bl-input {
      width: 100%;
      padding: 13px 16px;
      background: #252525;
      border: 1.5px solid #333;
      border-radius: 8px;
      color: #fff;
      font-size: 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    .bl-input:focus {
      border-color: #FF9800;
      box-shadow: 0 0 0 3px rgba(255,152,0,0.15);
    }
    .bl-input::placeholder { color: #555; }

    /* OTP input style */
    .bl-otp-input {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 16px;
      text-align: center;
      padding: 16px;
    }

    .bl-error {
      background: rgba(220,53,69,0.12);
      border: 1px solid rgba(220,53,69,0.3);
      color: #f87171;
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 0.875rem;
      margin-bottom: 20px;
    }

    .bl-btn {
      width: 100%;
      padding: 14px;
      background: #FF9800;
      color: #000;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .bl-btn:hover { background: #e68900; transform: translateY(-1px); }
    .bl-btn:active { transform: translateY(0); }

    .bl-back {
      margin-top: 16px;
      text-align: center;
      font-size: 0.85rem;
      color: #555;
    }
    .bl-back a { color: #FF9800; text-decoration: none; }
    .bl-back a:hover { text-decoration: underline; }

    .bl-email-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #252525;
      border: 1px solid #333;
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 0.85rem;
      color: #ddd;
      margin-bottom: 20px;
    }
    .bl-email-chip i { color: #FF9800; }

    @media (max-width: 640px) {
      .bl-brand { display: none; }
      .bl-form-panel { padding: 36px 28px; }
    }
  </style>
</head>
<body>
  <div class="bl-wrap">
    <!-- Brand panel -->
    <div class="bl-brand">
      <a href="/" class="bl-brand-logo">Shed<span>.</span></a>
      <div class="bl-brand-headline">
        <h1>Your shopping history, all in one place.</h1>
        <p>Sign in to see orders from every Shed store you've bought from — and discover new ones.</p>
      </div>
      <div class="bl-brand-features">
        <div class="bl-feature"><i class="fas fa-receipt"></i> Full order history across stores</div>
        <div class="bl-feature"><i class="fas fa-store"></i> Discover stores you'll love</div>
        <div class="bl-feature"><i class="fas fa-bolt"></i> No password needed</div>
      </div>
    </div>

    <!-- Form panel -->
    <div class="bl-form-panel">
      <% if (step === 'email') { %>
        <h2>Sign in to Shed</h2>
        <p class="bl-subtitle">Enter your email and we'll send you a login code — no password required.</p>

        <!-- Progress steps -->
        <div class="bl-steps">
          <div class="bl-step active">
            <div class="bl-step-dot">1</div>
            <span>Email</span>
          </div>
          <div class="bl-step-line"></div>
          <div class="bl-step">
            <div class="bl-step-dot">2</div>
            <span>Verify code</span>
          </div>
        </div>

        <% if (error) { %><div class="bl-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

        <form method="POST" action="/buyer/login/otp">
          <div class="bl-field">
            <label class="bl-label">Email address</label>
            <input type="email" name="email" class="bl-input" placeholder="you@example.com"
                   value="<%= email || '' %>" required autofocus>
          </div>
          <button type="submit" class="bl-btn">
            <i class="fas fa-paper-plane"></i> Send my code
          </button>
        </form>

        <div class="bl-back" style="margin-top:24px">
          <a href="/"><i class="fas fa-arrow-left"></i> Back to Shed</a>
        </div>

      <% } else { %>
        <h2>Check your inbox</h2>
        <p class="bl-subtitle">We sent a 6-digit code to <strong><%= email %></strong>. It expires in 10 minutes.</p>

        <!-- Progress steps -->
        <div class="bl-steps">
          <div class="bl-step done">
            <div class="bl-step-dot"><i class="fas fa-check"></i></div>
            <span>Email</span>
          </div>
          <div class="bl-step-line"></div>
          <div class="bl-step active">
            <div class="bl-step-dot">2</div>
            <span>Verify code</span>
          </div>
        </div>

        <div class="bl-email-chip"><i class="fas fa-envelope"></i> <%= email %></div>

        <% if (error) { %><div class="bl-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

        <form method="POST" action="/buyer/login/verify">
          <input type="hidden" name="email" value="<%= email %>">
          <div class="bl-field">
            <label class="bl-label">6-digit code</label>
            <input type="text" name="otp" class="bl-input bl-otp-input"
                   placeholder="······" maxlength="6" inputmode="numeric"
                   pattern="[0-9]{6}" required autofocus autocomplete="one-time-code">
          </div>
          <button type="submit" class="bl-btn">
            <i class="fas fa-unlock-alt"></i> Verify & sign in
          </button>
        </form>

        <div class="bl-back">
          Didn't get it? <a href="/buyer/login">Try a different email</a> or
          <a href="/buyer/login/otp" onclick="document.getElementById('resubForm').submit();return false;">resend code</a>
          <form id="resubForm" method="POST" action="/buyer/login/otp" style="display:none">
            <input type="hidden" name="email" value="<%= email %>">
          </form>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
