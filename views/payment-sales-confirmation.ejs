<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Payment Confirmation</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'transactions', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Payment Confirmation</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
        <%= admin.firstName || admin.username %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>Payment Confirmation</h1>
        <p>Confirm payment for this transaction</p>
      </div>
      <a href="/transactions" class="btn-secondary-app"><i class="fas fa-arrow-left"></i> Back to Transactions</a>
    </div>

    <div style="max-width:480px;">
      <div class="app-card">
        <div class="app-card-title">Transaction Details</div>

        <div style="display:flex; flex-direction:column; gap:0;">
          <div style="display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #f5f5f5; font-size:0.92rem;">
            <span style="color:#999; font-weight:500;">Customer Name</span>
            <span style="font-weight:600; color:#0d0d1a;"><%= sale.customerName %></span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #f5f5f5; font-size:0.92rem;">
            <span style="color:#999; font-weight:500;">Total Amount</span>
            <span style="font-weight:700; color:#008B8B; font-size:1.1rem;"><%= admin.currency %><%= formatCurrency(sale.totalAmount) %></span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:12px 0; font-size:0.92rem;">
            <span style="color:#999; font-weight:500;">Payment Status</span>
            <span style="background:<%= sale.paymentStatus === 'paid' ? 'rgba(0,139,139,0.1)' : 'rgba(235,166,17,0.1)' %>; color:<%= sale.paymentStatus === 'paid' ? '#008B8B' : '#b8830a' %>; padding:4px 12px; border-radius:20px; font-size:0.83rem; font-weight:600; text-transform:capitalize;">
              <%= sale.paymentStatus %>
            </span>
          </div>
        </div>

        <div style="margin-top:24px;">
          <form action="/confirm-payment/<%= sale._id %>" method="POST">
            <button type="submit" class="btn-primary-app" style="width:100%; justify-content:center;">
              <i class="fas fa-check-circle"></i> Confirm Payment
            </button>
          </form>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
