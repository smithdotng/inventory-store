<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Login | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Login</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
  </head>
<body style="justify-content: center;">
  <div class="container">
    <!-- Logo above the form -->
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Yearnings Custom Store Logo">
    </div>

    <div class="form-section">
      <h2>Business Registration <span class="icon-verification" style="margin-left: 10px;"></span></h2>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/admin-register" method="POST" enctype="multipart/form-data">
        <input type="text" name="businessName" placeholder="Business Name" required>
        <input type="email" name="email" placeholder="Email Address" required>
        <select name="currency" required>
          <option value="">Select Currency</option>
          <option value="USD">USD - United States Dollar</option>
          <option value="EUR">EUR - Euro</option>
          <option value="GBP">GBP - British Pound</option>
          <option value="NGN">NGN - Nigerian Naira</option>
          <option value="CAD">CAD - Canadian Dollar</option>
          <!-- Add more currencies as needed -->
        </select>
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <label for="logo" style="display: block; text-align: left; margin-bottom: 5px; font-weight: bold;">Upload Logo:</label>
        <input type="file" id="logo" name="logo" accept="image/*">
        
        <button type="submit">Register <span class="icon-right-arrow"></span></button>
      </form>
      <div class="login-link">
        Already have an account? <a href="/admin-login">Login here</a>
      </div>
    </div>
  </div>
</body>
</html>