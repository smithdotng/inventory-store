<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= query ? `Search Results for "${query}" - Shed` : 'Search - Shed' %></title>
    
    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <style>
        :root {
            /* Updated to match landing.js orange/amber theme */
            --primary-color: rgb(255, 152, 0);
            --secondary-color: #ea580c; /* Orange-600 */
            --accent-color: #fb923c; /* Orange-400 */
            --light-bg: #fff7ed; /* Orange-50 */
            --border-color: #fed7aa; /* Orange-200 */
            --text-color: #431407; /* Orange-950 */
            --text-light: #9a3412; /* Orange-800 */
            --shadow: 0 2px 10px rgba(249, 115, 22, 0.1);
            --radius: 8px;
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            line-height: 1.6;
            color: var(--text-color);
            background-color: #fff;
            padding-top: 0; /* Removed padding since header is not fixed anymore */
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header - NOT fixed anymore to prevent obstruction */
        .search-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 40px 0 30px; /* Reduced padding */
            margin-bottom: 30px;
            position: relative; /* Changed from fixed to relative */
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            height: auto; /* Changed from fixed height to auto */
            min-height: 160px; /* Reduced minimum height */
        }

        .search-content {
            margin-top: 0; /* Removed margin since header is not fixed */
        }

        .search-header-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

        .search-header h1 {
            font-size: 2.2rem; /* Slightly smaller */
            margin-bottom: 10px; /* Reduced margin */
            font-weight: 600;
        }

        .search-header p {
            font-size: 1rem; /* Slightly smaller */
            opacity: 0.9;
            margin-bottom: 20px; /* Reduced margin */
        }

        /* Search Form */
        .search-form-container {
            background: white;
            border-radius: var(--radius);
            padding: 15px; /* Reduced padding */
            box-shadow: var(--shadow);
            margin-bottom: 20px; /* Reduced margin */
        }

        .search-form {
            display: flex;
            gap: 10px;
            margin-bottom: 10px; /* Reduced margin */
        }

        .search-form input {
            flex: 1;
            padding: 12px 15px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius);
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .search-form input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .search-form button {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: var(--radius);
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: background-color 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form button:hover {
            background-color: var(--secondary-color);
        }

        /* Search Tabs */
        .search-tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 15px; /* Reduced margin */
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px; /* Reduced padding */
        }

        .search-tab {
            padding: 8px 20px;
            background: none;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-light);
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .search-tab:hover {
            background-color: var(--light-bg);
            text-decoration: none;
            color: var(--text-color);
        }

        .search-tab.active {
            background-color: var(--primary-color);
            color: white;
            border-bottom: 2px solid var(--primary-color);
        }

        .search-tab .count {
            background: rgba(255,255,255,0.2);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 12px;
            margin-left: 5px;
        }

        /* Results Count */
        .results-count {
            margin-bottom: 25px; /* Reduced margin */
            padding: 12px 15px; /* Reduced padding */
            background-color: var(--light-bg);
            border-radius: var(--radius);
            font-size: 14px;
            color: var(--text-light);
        }

        .results-count strong {
            color: var(--primary-color);
            font-weight: 600;
        }

        /* Results Grid */
        .results-grid {
            display: grid;
            gap: 25px;
            margin-bottom: 40px;
        }

        .store-card, .product-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            color: inherit;
            display: block;
            border: 1px solid var(--border-color);
        }

        .store-card:hover, .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(249, 115, 22, 0.15);
            border-color: var(--primary-color);
        }

        /* Store Card */
        .store-card-header {
            display: flex;
            align-items: center;
            padding: 20px;
            background-color: var(--light-bg);
        }

        .store-logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 15px;
            border: 3px solid white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .store-info {
            flex: 1;
        }

        .store-name {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: var(--primary-color);
        }

        .store-username {
            font-size: 14px;
            color: var(--text-light);
            margin-bottom: 10px;
        }

        .store-description {
            font-size: 14px;
            color: var(--text-color);
            line-height: 1.5;
        }

        .store-footer {
            padding: 12px 20px; /* Reduced padding */
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-light);
            background: #fffaf3; /* Slightly different background */
        }

        .store-location {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .store-join-date {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* Product Card */
        .product-image-container {
            height: 200px;
            overflow: hidden;
            background-color: var(--light-bg);
            position: relative;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-content {
            padding: 20px;
        }

        .product-store {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .product-store-logo {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 8px;
            border: 1px solid var(--border-color);
        }

        .product-store-name {
            font-size: 12px;
            color: var(--text-light);
        }

        .product-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-color);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-description {
            font-size: 14px;
            color: var(--text-light);
            margin-bottom: 15px;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-price {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 5px;
        }

        .product-stock {
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .product-stock.in-stock {
            color: var(--success);
        }

        .product-stock.out-of-stock {
            color: var(--danger);
        }

        .product-stock.low-stock {
            color: var(--warning);
        }

        .product-footer {
            padding: 12px 20px; /* Reduced padding */
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-light);
            background: #fffaf3; /* Slightly different background */
        }

        .product-category {
            background-color: var(--light-bg);
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            border: 1px solid var(--border-color);
        }

        /* No Results */
        .no-results {
            text-align: center;
            padding: 50px 20px; /* Reduced padding */
            background-color: var(--light-bg);
            border-radius: var(--radius);
            margin: 30px 0; /* Reduced margin */
            border: 1px solid var(--border-color);
        }

        .no-results-icon {
            font-size: 3.5rem; /* Slightly smaller */
            color: var(--border-color);
            margin-bottom: 20px;
        }

        .no-results h3 {
            font-size: 1.4rem; /* Slightly smaller */
            margin-bottom: 10px;
            color: var(--text-light);
        }

        .no-results p {
            color: var(--text-light);
            margin-bottom: 20px;
        }

        /* Pagination */
        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px; /* Reduced gap */
            margin: 30px 0; /* Reduced margin */
            flex-wrap: wrap;
        }

        .pagination-button {
            padding: 8px 15px;
            border: 1px solid var(--border-color);
            background: white;
            border-radius: var(--radius);
            cursor: pointer;
            font-size: 14px;
            color: var(--text-color);
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .pagination-button:hover:not(.disabled) {
            background-color: var(--light-bg);
            text-decoration: none;
            border-color: var(--primary-color);
        }

        .pagination-button.active {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .pagination-button.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            border-color: var(--border-color);
        }

        /* Error Message */
        .error-message {
            background-color: #fee2e2;
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 12px 15px; /* Reduced padding */
            border-radius: var(--radius);
            margin: 15px 0; /* Reduced margin */
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px; /* Reduced gap */
        }

        /* Loading */
        .loading {
            text-align: center;
            padding: 30px; /* Reduced padding */
            font-size: 1.1rem;
            color: var(--text-light);
        }

        .loading-spinner {
            border: 3px solid var(--light-bg);
            border-top: 3px solid var(--primary-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Grid Layouts */
        .stores-grid {
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        }

        .products-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        }

        .all-results-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 35px; /* Reduced gap */
        }

        .results-section {
            margin-bottom: 35px; /* Reduced margin */
        }

        .section-title {
            font-size: 1.4rem; /* Slightly smaller */
            font-weight: 600;
            margin-bottom: 15px; /* Reduced margin */
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border-color);
        }

        .section-title i {
            font-size: 1.2rem;
        }

        .view-all-link {
            display: inline-block;
            margin-top: 12px; /* Reduced margin */
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: color 0.3s;
        }

        .view-all-link:hover {
            text-decoration: underline;
            color: var(--secondary-color);
        }

        /* Back to Top */
        .back-to-top {
            position: fixed;
            bottom: 25px; /* Adjusted position */
            right: 25px; /* Adjusted position */
            width: 45px; /* Slightly smaller */
            height: 45px; /* Slightly smaller */
            background-color: var(--primary-color);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            z-index: 1000;
            text-decoration: none;
            box-shadow: 0 2px 10px rgba(249, 115, 22, 0.3);
            border: 2px solid white;
        }

        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            background-color: var(--secondary-color);
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(249, 115, 22, 0.4);
        }

        /* Highlight search terms */
        mark {
            background-color: #ffedd5; /* Orange-100 */
            padding: 0 2px;
            border-radius: 2px;
            color: var(--text-color);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            body {
                padding-top: 0; /* Already 0 */
            }
            
            .search-header {
                padding: 30px 0 20px; /* Further reduced padding */
                min-height: 140px; /* Further reduced height */
            }

            .search-content {
                margin-top: 0;
            }

            .search-header h1 {
                font-size: 1.8rem;
                margin-bottom: 8px;
            }

            .search-header p {
                font-size: 0.95rem;
                margin-bottom: 15px;
            }

            .search-form {
                flex-direction: column;
            }

            .search-tabs {
                overflow-x: auto;
                padding-bottom: 8px;
            }

            .search-tab {
                white-space: nowrap;
                padding: 6px 15px; /* Reduced padding */
                font-size: 13px;
            }

            .stores-grid {
                grid-template-columns: 1fr;
            }

            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            }

            .store-card-header {
                flex-direction: column;
                text-align: center;
                padding: 15px; /* Reduced padding */
            }

            .store-logo {
                margin-right: 0;
                margin-bottom: 12px; /* Reduced margin */
                width: 60px; /* Smaller logo */
                height: 60px; /* Smaller logo */
            }

            .store-footer {
                flex-direction: column;
                gap: 8px; /* Reduced gap */
                align-items: flex-start;
                padding: 10px 15px; /* Further reduced padding */
            }
        }

        @media (max-width: 480px) {
            .products-grid {
                grid-template-columns: 1fr;
            }

            .search-header h1 {
                font-size: 1.5rem;
            }

            .section-title {
                font-size: 1.2rem;
            }

            .pagination {
                gap: 5px;
            }

            .pagination-button {
                padding: 6px 10px;
                font-size: 12px;
            }

            .search-form-container {
                padding: 12px; /* Further reduced padding */
            }

            .search-form button {
                padding: 10px 20px; /* Reduced padding */
                font-size: 14px;
            }
        }

        /* Navigation Back */
        .nav-back {
            margin-bottom: 15px; /* Reduced margin */
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: var(--radius);
            transition: background-color 0.3s;
            border: 1px solid var(--border-color);
        }

        .back-button:hover {
            background-color: var(--light-bg);
            text-decoration: none;
            border-color: var(--primary-color);
        }

        /* Debug Information */
        .debug-info {
            background: #ffedd5;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 12px 15px; /* Reduced padding */
            margin: 15px 0; /* Reduced margin */
            font-family: monospace;
            font-size: 11px; /* Smaller font */
            color: var(--text-light);
            overflow-x: auto;
        }
        
        .debug-info.hidden {
            display: none;
        }

        /* Popular Search Tags */
        .popular-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .popular-tags a {
            background: var(--light-bg);
            padding: 6px 12px; /* Reduced padding */
            border-radius: 20px;
            text-decoration: none;
            color: var(--text-color);
            font-size: 13px; /* Smaller font */
            transition: all 0.3s;
            border: 1px solid var(--border-color);
        }

        .popular-tags a:hover {
            background: var(--accent-color);
            color: white;
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }
    </style>
</head>

<body>
    <!-- Initialize error variable if not passed -->
    <% if (typeof error === 'undefined') { %>
        <% error = null; %>
    <% } %>
    
    <!-- Initialize safe defaults -->
    <% 
        const safeQuery = query || '';
        const safeType = type || 'all';
        const safePage = parseInt(page) || 1;
        const safeTotalPages = parseInt(totalPages) || 1;
        const safeTotalStores = parseInt(totalStores) || 0;
        const safeTotalProducts = parseInt(totalProducts) || 0;
        const safeTotalResults = parseInt(totalResults) || 0;
        const safeStores = stores || [];
        const safeProducts = products || [];
    %>

    <!-- Debug Information (remove in production) -->
    <div class="debug-info hidden" id="debugInfo">
        <strong>Debug Info:</strong><br>
        Query: <%= safeQuery %><br>
        Type: <%= safeType %><br>
        Page: <%= safePage %><br>
        Stores Found: <%= safeStores.length %> / <%= safeTotalStores %><br>
        Products Found: <%= safeProducts.length %> / <%= safeTotalProducts %><br>
        Total Results: <%= safeTotalResults %>
    </div>

    <!-- Header - Now positioned relative, not fixed -->
    <header class="search-header">
        <div class="container">
            <div class="search-header-content">
                <h1>
                    <% if (safeQuery && safeQuery.length > 0) { %>
                        Search Results for "<%= safeQuery %>"
                    <% } else { %>
                        Search Shed
                    <% } %>
                </h1>
                <p>Discover stores and products across our platform</p>
                
                <div class="search-form-container">
                    <form class="search-form" action="/search" method="GET">
                        <input 
                            type="text" 
                            name="q" 
                            value="<%= safeQuery %>" 
                            placeholder="Search for stores or products..."
                            autocomplete="off"
                            required
                        >
                        <button type="submit">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </form>
                    
                    <% if (safeQuery && safeQuery.length > 0) { %>
                        <div class="search-tabs">
                            <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=all" 
                               class="search-tab <%= safeType === 'all' ? 'active' : '' %>">
                                All Results
                                <% if (safeType === 'all') { %>
                                    <span class="count"><%= safeTotalResults %></span>
                                <% } %>
                            </a>
                            <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=stores" 
                               class="search-tab <%= safeType === 'stores' ? 'active' : '' %>">
                                Stores
                                <% if (safeType === 'stores') { %>
                                    <span class="count"><%= safeTotalStores %></span>
                                <% } %>
                            </a>
                            <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=products" 
                               class="search-tab <%= safeType === 'products' ? 'active' : '' %>">
                                Products
                                <% if (safeType === 'products') { %>
                                    <span class="count"><%= safeTotalProducts %></span>
                                <% } %>
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="search-content">
        <div class="container">
            <% if (error && typeof error === 'string' && error.trim().length > 0) { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-circle"></i> <%= error %>
                </div>
            <% } %>

            <% if (safeQuery && safeQuery.length > 0) { %>
                <!-- Results Count -->
                <div class="results-count">
                    <% if (safeType === 'all') { %>
                        Found <strong><%= safeTotalResults %></strong> results for "<%= safeQuery %>"
                        <% if (safeTotalStores > 0 && safeTotalProducts > 0) { %>
                            (<%= safeTotalStores %> stores and <%= safeTotalProducts %> products)
                        <% } else if (safeTotalStores > 0) { %>
                            (<%= safeTotalStores %> stores)
                        <% } else if (safeTotalProducts > 0) { %>
                            (<%= safeTotalProducts %> products)
                        <% } %>
                    <% } else if (safeType === 'stores') { %>
                        Found <strong><%= safeTotalStores %></strong> stores for "<%= safeQuery %>"
                        <% if (safePage > 1) { %>
                            (Page <%= safePage %> of <%= safeTotalPages %>)
                        <% } %>
                    <% } else if (safeType === 'products') { %>
                        Found <strong><%= safeTotalProducts %></strong> products for "<%= safeQuery %>"
                        <% if (safePage > 1) { %>
                            (Page <%= safePage %> of <%= safeTotalPages %>)
                        <% } %>
                    <% } %>
                </div>

                <!-- Results Content -->
                <% if (safeType === 'all') { %>
                    <!-- All Results View -->
                    <div class="all-results-grid">
                        <% if (safeStores.length > 0) { %>
                            <div class="results-section">
                                <h2 class="section-title">
                                    <i class="fas fa-store"></i> Stores (<%= safeStores.length %>)
                                </h2>
                                <div class="results-grid stores-grid">
                                    <% safeStores.forEach(store => { %>
                                        <% 
                                            const storeId = store._id ? (typeof store._id === 'object' ? store._id.toString() : store._id) : 'unknown';
                                            const storeName = store.businessName || store.name || 'Unnamed Store';
                                            const storeUsername = store.username || 'unknown';
                                            const storeDescription = store.description || 'No description available';
                                            const storeLogo = store.logo || store.image || '/images/logo.png';
                                            const storeLocation = store.location || store.address || 'Location not specified';
                                            const storeCreatedAt = store.createdAt || new Date();
                                        %>
                                        <a href="/store/<%= storeUsername %>" class="store-card">
                                            <div class="store-card-header">
                                                <img src="<%= storeLogo %>" 
                                                     alt="<%= storeName %>" 
                                                     class="store-logo"
                                                     onerror="this.src='/images/logo.png'">
                                                <div class="store-info">
                                                    <h3 class="store-name"><%= storeName %></h3>
                                                    <p class="store-username">@<%= storeUsername %></p>
                                                    <p class="store-description">
                                                        <%= typeof truncateText === 'function' ? truncateText(storeDescription, 120) : storeDescription.substring(0, 120) + '...' %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="store-footer">
                                                <div class="store-location">
                                                    <i class="fas fa-map-marker-alt"></i>
                                                    <%= storeLocation %>
                                                </div>
                                                <div class="store-join-date">
                                                    <i class="far fa-calendar"></i>
                                                    <% if (typeof formatDate === 'function') { %>
                                                        <%= formatDate(storeCreatedAt) %>
                                                    <% } else { %>
                                                        <%= new Date(storeCreatedAt).toLocaleDateString() %>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </a>
                                    <% }) %>
                                </div>
                                <% if (safeTotalStores > safeStores.length) { %>
                                    <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=stores" class="view-all-link">
                                        View all <%= safeTotalStores %> stores <i class="fas fa-arrow-right"></i>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>

                        <% if (safeProducts.length > 0) { %>
                            <div class="results-section">
                                <h2 class="section-title">
                                    <i class="fas fa-box"></i> Products (<%= safeProducts.length %>)
                                </h2>
                                <div class="results-grid products-grid">
                                    <% safeProducts.forEach(product => { %>
                                        <% 
                                            const productId = product._id ? (typeof product._id === 'object' ? product._id.toString() : product._id) : 'unknown';
                                            const productName = product.name || 'Unnamed Product';
                                            const productDescription = product.description || 'No description available';
                                            const productCost = product.cost || product.price || 0;
                                            const productStock = product.stock || 0;
                                            const productImage = product.image || (Array.isArray(product.images) && product.images.length > 0 ? product.images[0] : '/images/placeholder-product.png');
                                            const productCategory = product.category || 'Uncategorized';
                                            const productCreatedAt = product.createdAt || new Date();
                                            
                                            const storeName = product.storeName || product.store?.businessName || 'Unknown Store';
                                            const storeUsername = product.storeUsername || product.store?.username || 'unknown';
                                            const storeLogo = product.storeLogo || product.store?.logo || '/images/logo.png';
                                        %>
                                        <a href="/store/<%= storeUsername %>?product=<%= productId %>" class="product-card">
                                            <div class="product-image-container">
                                                <img src="<%= productImage %>" 
                                                     alt="<%= productName %>" 
                                                     class="product-image"
                                                     onerror="this.src='/images/placeholder-product.png'">
                                            </div>
                                            <div class="product-content">
                                                <div class="product-store">
                                                    <img src="<%= storeLogo %>" 
                                                         alt="<%= storeName %>" 
                                                         class="product-store-logo"
                                                         onerror="this.src='/images/logo.png'">
                                                    <span class="product-store-name"><%= storeName %></span>
                                                </div>
                                                <h3 class="product-name"><%= productName %></h3>
                                                <p class="product-description">
                                                    <%= typeof truncateText === 'function' ? truncateText(productDescription, 100) : productDescription.substring(0, 100) + '...' %>
                                                </p>
                                                <div class="product-price">
                                                    <% if (typeof formatCurrency === 'function') { %>
                                                        <%= formatCurrency(productCost) %>
                                                    <% } else { %>
                                                        ₦<%= parseFloat(productCost).toFixed(2) %>
                                                    <% } %>
                                                </div>
                                                <div class="product-stock <%= productStock > 10 ? 'in-stock' : productStock > 0 ? 'low-stock' : 'out-of-stock' %>">
                                                    <i class="fas <%= productStock > 10 ? 'fa-check-circle' : productStock > 0 ? 'fa-exclamation-circle' : 'fa-times-circle' %>"></i>
                                                    <% if (productStock > 10) { %>
                                                        In stock
                                                    <% } else if (productStock > 0) { %>
                                                        Low stock (<%= productStock %> left)
                                                    <% } else { %>
                                                        Out of stock
                                                    <% } %>
                                                </div>
                                            </div>
                                            <div class="product-footer">
                                                <span class="product-category">
                                                    <%= productCategory %>
                                                </span>
                                                <span>
                                                    <i class="far fa-calendar"></i>
                                                    <% if (typeof formatDate === 'function') { %>
                                                        <%= formatDate(productCreatedAt) %>
                                                    <% } else { %>
                                                        <%= new Date(productCreatedAt).toLocaleDateString() %>
                                                    <% } %>
                                                </span>
                                            </div>
                                        </a>
                                    <% }) %>
                                </div>
                                <% if (safeTotalProducts > safeProducts.length) { %>
                                    <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=products" class="view-all-link">
                                        View all <%= safeTotalProducts %> products <i class="fas fa-arrow-right"></i>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>
                        
                        <% if (safeStores.length === 0 && safeProducts.length === 0) { %>
                            <div class="no-results">
                                <div class="no-results-icon">
                                    <i class="fas fa-search"></i>
                                </div>
                                <h3>No results found</h3>
                                <p>We couldn't find any stores or products matching "<%= safeQuery %>"</p>
                                <div style="margin-top: 20px;">
                                    <a href="/" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px;">
                                        <i class="fas fa-home"></i> Go to Homepage
                                    </a>
                                    <button onclick="document.querySelector('.search-form input').focus();" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px; background: var(--secondary-color);">
                                        <i class="fas fa-redo"></i> Try another search
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>

                <% } else if (safeType === 'stores') { %>
                    <!-- Stores Only View -->
                    <% if (safeStores.length > 0) { %>
                        <div class="results-grid stores-grid">
                            <% safeStores.forEach(store => { %>
                                <% 
                                    const storeId = store._id ? (typeof store._id === 'object' ? store._id.toString() : store._id) : 'unknown';
                                    const storeName = store.businessName || store.name || 'Unnamed Store';
                                    const storeUsername = store.username || 'unknown';
                                    const storeDescription = store.description || 'No description available';
                                    const storeLogo = store.logo || store.image || '/images/logo.png';
                                    const storeLocation = store.location || store.address || 'Location not specified';
                                    const storeCreatedAt = store.createdAt || new Date();
                                %>
                                <a href="/store/<%= storeUsername %>" class="store-card">
                                    <div class="store-card-header">
                                        <img src="<%= storeLogo %>" 
                                             alt="<%= storeName %>" 
                                             class="store-logo"
                                             onerror="this.src='/images/logo.png'">
                                        <div class="store-info">
                                            <h3 class="store-name"><%= storeName %></h3>
                                            <p class="store-username">@<%= storeUsername %></p>
                                            <p class="store-description">
                                                <%= typeof truncateText === 'function' ? truncateText(storeDescription, 150) : storeDescription.substring(0, 150) + '...' %>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="store-footer">
                                        <div class="store-location">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <%= storeLocation %>
                                        </div>
                                        <div class="store-join-date">
                                            <i class="far fa-calendar"></i>
                                            <% if (typeof formatDate === 'function') { %>
                                                <%= formatDate(storeCreatedAt) %>
                                            <% } else { %>
                                                <%= new Date(storeCreatedAt).toLocaleDateString() %>
                                            <% } %>
                                        </div>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="no-results">
                            <div class="no-results-icon">
                                <i class="fas fa-store-slash"></i>
                            </div>
                            <h3>No stores found</h3>
                            <p>We couldn't find any stores matching "<%= safeQuery %>"</p>
                            <div style="margin-top: 20px;">
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=all" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px;">
                                    <i class="fas fa-search"></i> Search all results
                                </a>
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=products" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px; background: var(--secondary-color);">
                                    <i class="fas fa-box"></i> Try products instead
                                </a>
                            </div>
                        </div>
                    <% } %>

                <% } else if (safeType === 'products') { %>
                    <!-- Products Only View -->
                    <% if (safeProducts.length > 0) { %>
                        <div class="results-grid products-grid">
                            <% safeProducts.forEach(product => { %>
                                <% 
                                    const productId = product._id ? (typeof product._id === 'object' ? product._id.toString() : product._id) : 'unknown';
                                    const productName = product.name || 'Unnamed Product';
                                    const productDescription = product.description || 'No description available';
                                    const productCost = product.cost || product.price || 0;
                                    const productStock = product.stock || 0;
                                    const productImage = product.image || (Array.isArray(product.images) && product.images.length > 0 ? product.images[0] : '/images/placeholder-product.png');
                                    const productCategory = product.category || 'Uncategorized';
                                    const productCreatedAt = product.createdAt || new Date();
                                    
                                    const storeName = product.storeName || product.store?.businessName || 'Unknown Store';
                                    const storeUsername = product.storeUsername || product.store?.username || 'unknown';
                                    const storeLogo = product.storeLogo || product.store?.logo || '/images/logo.png';
                                %>
                                <a href="/store/<%= storeUsername %>?product=<%= productId %>" class="product-card">
                                    <div class="product-image-container">
                                        <img src="<%= productImage %>" 
                                             alt="<%= productName %>" 
                                             class="product-image"
                                             onerror="this.src='/images/placeholder-product.png'">
                                    </div>
                                    <div class="product-content">
                                        <div class="product-store">
                                            <img src="<%= storeLogo %>" 
                                                 alt="<%= storeName %>" 
                                                 class="product-store-logo"
                                                 onerror="this.src='/images/logo.png'">
                                            <span class="product-store-name"><%= storeName %></span>
                                        </div>
                                        <h3 class="product-name"><%= productName %></h3>
                                        <p class="product-description">
                                            <%= typeof truncateText === 'function' ? truncateText(productDescription, 120) : productDescription.substring(0, 120) + '...' %>
                                        </p>
                                        <div class="product-price">
                                            <% if (typeof formatCurrency === 'function') { %>
                                                <%= formatCurrency(productCost) %>
                                            <% } else { %>
                                                ₦<%= parseFloat(productCost).toFixed(2) %>
                                            <% } %>
                                        </div>
                                        <div class="product-stock <%= productStock > 10 ? 'in-stock' : productStock > 0 ? 'low-stock' : 'out-of-stock' %>">
                                            <i class="fas <%= productStock > 10 ? 'fa-check-circle' : productStock > 0 ? 'fa-exclamation-circle' : 'fa-times-circle' %>"></i>
                                            <% if (productStock > 10) { %>
                                                In stock
                                            <% } else if (productStock > 0) { %>
                                                Low stock (<%= productStock %> left)
                                            <% } else { %>
                                                Out of stock
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="product-footer">
                                        <span class="product-category">
                                            <%= productCategory %>
                                        </span>
                                        <span>
                                            <i class="far fa-calendar"></i>
                                            <% if (typeof formatDate === 'function') { %>
                                                <%= formatDate(productCreatedAt) %>
                                            <% } else { %>
                                                <%= new Date(productCreatedAt).toLocaleDateString() %>
                                            <% } %>
                                        </span>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="no-results">
                            <div class="no-results-icon">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <h3>No products found</h3>
                            <p>We couldn't find any products matching "<%= safeQuery %>"</p>
                            <div style="margin-top: 20px;">
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=all" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px;">
                                    <i class="fas fa-search"></i> Search all results
                                </a>
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=stores" class="search-form button" style="margin: 5px; display: inline-block; padding: 10px 20px; background: var(--secondary-color);">
                                    <i class="fas fa-store"></i> Try stores instead
                                </a>
                            </div>
                        </div>
                    <% } %>
                <% } %>

                <!-- Pagination (for single type views) -->
                <% if ((safeType === 'stores' && safeTotalPages > 1) || (safeType === 'products' && safeTotalPages > 1)) { %>
                    <div class="pagination">
                        <% if (safePage > 1) { %>
                            <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=<%= safeType %>&page=<%= safePage - 1 %>" 
                               class="pagination-button">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        <% } else { %>
                            <span class="pagination-button disabled">
                                <i class="fas fa-chevron-left"></i> Previous
                            </span>
                        <% } %>

                        <% for (let i = 1; i <= safeTotalPages; i++) { %>
                            <% if (i === safePage) { %>
                                <span class="pagination-button active"><%= i %></span>
                            <% } else if (i >= safePage - 2 && i <= safePage + 2) { %>
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=<%= safeType %>&page=<%= i %>" 
                                   class="pagination-button"><%= i %></a>
                            <% } else if (i === 1 || i === safeTotalPages) { %>
                                <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=<%= safeType %>&page=<%= i %>" 
                                   class="pagination-button"><%= i %></a>
                            <% } else if (i === safePage - 3 || i === safePage + 3) { %>
                                <span class="pagination-button">...</span>
                            <% } %>
                        <% } %>

                        <% if (safePage < safeTotalPages) { %>
                            <a href="/search?q=<%= encodeURIComponent(safeQuery) %>&type=<%= safeType %>&page=<%= safePage + 1 %>" 
                               class="pagination-button">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        <% } else { %>
                            <span class="pagination-button disabled">
                                Next <i class="fas fa-chevron-right"></i>
                            </span>
                        <% } %>
                    </div>
                <% } %>

            <% } else { %>
                <!-- Empty State (no query) -->
                <div class="no-results">
                    <div class="no-results-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3>What are you looking for?</h3>
                    <p>Enter a search term above to find stores and products on Shed</p>
                    
                    <div style="max-width: 600px; margin: 25px auto; text-align: left;">
                        <h4 style="margin-bottom: 15px; color: var(--primary-color);">Search Tips:</h4>
                        <ul style="list-style: none; padding-left: 0;">
                            <li style="margin-bottom: 10px; padding-left: 25px; position: relative;">
                                <i class="fas fa-store" style="position: absolute; left: 0; color: var(--primary-color);"></i>
                                <strong>Search for stores:</strong> Enter store names, usernames, or locations
                            </li>
                            <li style="margin-bottom: 10px; padding-left: 25px; position: relative;">
                                <i class="fas fa-box" style="position: absolute; left: 0; color: var(--primary-color);"></i>
                                <strong>Search for products:</strong> Enter product names, categories, or descriptions
                            </li>
                            <li style="margin-bottom: 10px; padding-left: 25px; position: relative;">
                                <i class="fas fa-lightbulb" style="position: absolute; left: 0; color: var(--primary-color);"></i>
                                <strong>Use keywords:</strong> Try specific terms like "electronics", "clothing", or "services"
                            </li>
                            <li style="margin-bottom: 10px; padding-left: 25px; position: relative;">
                                <i class="fas fa-filter" style="position: absolute; left: 0; color: var(--primary-color);"></i>
                                <strong>Filter results:</strong> Use the tabs above to filter between stores and products
                            </li>
                        </ul>
                    </div>
                    
                    <!-- Popular Searches -->
                    <div style="max-width: 600px; margin: 25px auto;">
                        <h4 style="margin-bottom: 15px; color: var(--primary-color); text-align: center;">Try searching for:</h4>
                        <div class="popular-tags" style="justify-content: center;">
                            <a href="/search?q=electronics&type=all">electronics</a>
                            <a href="/search?q=clothing&type=all">clothing</a>
                            <a href="/search?q=food&type=all">food</a>
                            <a href="/search?q=books&type=all">books</a>
                            <a href="/search?q=furniture&type=all">furniture</a>
                            <a href="/search?q=services&type=all">services</a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Back to Top Button -->
    <a href="#" class="back-to-top" id="backToTop">
        <i class="fas fa-chevron-up"></i>
    </a>

    <script>
        // Back to Top functionality
        const backToTop = document.getElementById('backToTop');
        
        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTop.classList.add('visible');
            } else {
                backToTop.classList.remove('visible');
            }
        });

        backToTop.addEventListener('click', (e) => {
            e.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // Auto-focus search input
        const searchInput = document.querySelector('input[name="q"]');
        if (searchInput && !searchInput.value) {
            searchInput.focus();
        }

        // Image error handling
        document.addEventListener('error', (e) => {
            if (e.target.tagName === 'IMG') {
                if (e.target.classList.contains('store-logo') || e.target.classList.contains('product-store-logo')) {
                    e.target.src = '/images/logo.png';
                } else if (e.target.classList.contains('product-image')) {
                    e.target.src = '/images/placeholder-product.png';
                }
            }
        }, true);

        // Highlight search terms in results
        function highlightText(text, query) {
            if (!query || !text || query.length < 2) return text;
            
            try {
                const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const regex = new RegExp(`(${escapedQuery})`, 'gi');
                return text.replace(regex, '<mark>$1</mark>');
            } catch (e) {
                return text;
            }
        }

        // Apply highlighting on page load
        document.addEventListener('DOMContentLoaded', function() {
            const query = '<%= safeQuery %>';
            if (query && query.length >= 2) {
                // Store names
                document.querySelectorAll('.store-name').forEach(el => {
                    el.innerHTML = highlightText(el.textContent, query);
                });
                // Product names
                document.querySelectorAll('.product-name').forEach(el => {
                    el.innerHTML = highlightText(el.textContent, query);
                });
                // Store descriptions
                document.querySelectorAll('.store-description').forEach(el => {
                    el.innerHTML = highlightText(el.textContent, query);
                });
                // Product descriptions
                document.querySelectorAll('.product-description').forEach(el => {
                    el.innerHTML = highlightText(el.textContent, query);
                });
                // Store usernames
                document.querySelectorAll('.store-username').forEach(el => {
                    el.innerHTML = highlightText(el.textContent, query);
                });
            }
            
            // Toggle debug info with Ctrl+Shift+D
            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.shiftKey && e.key === 'D') {
                    e.preventDefault();
                    const debugInfo = document.getElementById('debugInfo');
                    if (debugInfo) {
                        debugInfo.classList.toggle('hidden');
                        console.log('Debug info toggled');
                    }
                }
            });
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            // Focus search input when '/' is pressed
            if (e.key === '/' && !e.target.matches('input, textarea, select')) {
                e.preventDefault();
                searchInput.focus();
            }
            
            // Submit form with Ctrl+Enter
            if (e.ctrlKey && e.key === 'Enter' && document.activeElement === searchInput) {
                e.preventDefault();
                searchInput.form.submit();
            }
        });

        // Add loading state to form submission
        const searchForm = document.querySelector('.search-form');
        if (searchForm) {
            searchForm.addEventListener('submit', function() {
                const button = this.querySelector('button[type="submit"]');
                if (button) {
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
                    button.disabled = true;
                }
            });
        }
        
        // Initialize tooltips for category tags
        document.querySelectorAll('.product-category').forEach(category => {
            category.title = 'Category: ' + category.textContent;
        });
        
        // Add hover effects for store cards
        document.querySelectorAll('.store-card, .product-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.cursor = 'pointer';
            });
        });
        
        // Check if we should show debug info (if there are no results)
        window.onload = function() {
            const query = '<%= safeQuery %>';
            const hasResults = <%= safeTotalResults > 0 %>;
            
            if (query && !hasResults) {
                console.warn('No results found for query:', query);
                // Optionally show debug info automatically when no results
                // document.getElementById('debugInfo').classList.remove('hidden');
            }
        };
    </script>
</body>
</html>