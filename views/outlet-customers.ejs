<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlet Customers</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<!-- Outlet Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo">
    <img src="/images/logo.png" alt="Shed">
  </div>
  <nav class="sidebar-nav">
    <a href="/outlet/sales-form" class="<%= typeof currentPage !== 'undefined' && currentPage === 'pos' ? 'active' : '' %>">
      <i class="fas fa-shopping-bag"></i> Point of Sale
    </a>
    <a href="/outlet/<%= outlet._id %>/stock-view" class="<%= typeof currentPage !== 'undefined' && currentPage === 'stock' ? 'active' : '' %>">
      <i class="fas fa-boxes"></i> View Inventory
    </a>
    <a href="/outlet-transactions/<%= outlet._id %>" class="<%= typeof currentPage !== 'undefined' && currentPage === 'transactions' ? 'active' : '' %>">
      <i class="fas fa-chart-bar"></i> Transactions
    </a>
    <a href="/outlet-customers/<%= outlet._id %>" class="<%= typeof currentPage !== 'undefined' && currentPage === 'customers' ? 'active' : '' %>">
      <i class="fas fa-users"></i> Customers
    </a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/outlet-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Customers</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Shed' %></span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= outlet.name[0].toUpperCase() %></div>
          <%= outlet.name %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/profile"><i class="fas fa-user-circle"></i> Profile &amp; Settings</a>
          <a href="/admin-messages"><i class="fas fa-envelope"></i> Messages</a>
          <div class="dropdown-divider"></div>
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>Customers</h1>
        <p><%= outlet.name %> — customer records</p>
      </div>
    </div>

    <% if (customers && customers.length > 0) { %>
      <div class="app-card">
        <div style="overflow-x:auto;">
          <table class="app-table">
            <thead>
              <tr>
                <th>Customer Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Total Purchases</th>
              </tr>
            </thead>
            <tbody>
              <% customers.forEach(customer => { %>
                <tr>
                  <td style="font-weight:600;"><%= customer.customerName %></td>
                  <td><%= customer.phoneNumber || '—' %></td>
                  <td><%= customer.email || '—' %></td>
                  <td style="color:#008B8B; font-weight:600;">
                    <%= admin.currency || '$' %><%= customer.totalPurchases ? formatCurrency(customer.totalPurchases) : formatCurrency(0) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-users" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No customers yet</h3>
        <p style="color:#999;">Customers who purchase from this outlet will appear here.</p>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
