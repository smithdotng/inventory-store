<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Store Unavailable</title>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Jost', sans-serif; background: #f7f7f8; color: #222; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { background: #fff; border-radius: 16px; padding: 44px 40px; max-width: 440px; width: 100%; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.08); }
    .icon { width: 72px; height: 72px; border-radius: 50%; background: #fdecea; color: #c0392b; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px; }
    h1 { font-size: 1.3rem; margin-bottom: 10px; }
    p { color: #777; font-size: 0.92rem; }
    .btn { display: inline-block; margin-top: 22px; padding: 12px 26px; background: #FF9800; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon"><i class="fas fa-lock"></i></div>
    <h1><%= businessName %> is temporarily unavailable</h1>
    <% if (typeof forBusinessUser !== 'undefined' && forBusinessUser) { %>
      <p>This store's subscription has lapsed. Please contact the store owner to reactivate it — only the account owner can update billing.</p>
      <a class="btn" href="/admin-logout">Log Out</a>
    <% } else { %>
      <p>This store's subscription has lapsed and it isn't accepting orders right now.</p>
      <a class="btn" href="/search">Browse Other Stores</a>
    <% } %>
  </div>
</body>
</html>
