<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Invoices | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Invoices</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
      .error-message {
        color: red;
        margin-bottom: 10px;
        font-weight: bold;
        padding: 5px;
        background-color: #ffe6e6;
        border: 1px solid red;
      }
      .field-error {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
        display: none;
      }
      .item-row {
        position: relative;
        margin-bottom: 15px;
      }
      .hidden {
        display: none;
      }
      .new-product-fields {
        margin-top: 10px;
        padding: 10px;
        border: 1px solid #ccc;
        background-color: #f9f9f9;
      }
      .new-product-fields input {
        display: block;
        margin-bottom: 10px;
        width: 100%;
      }
      /* Add these new styles */
      .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
      }
      .invoice-actions {
        display: flex;
        gap: 15px;
        align-items: center;
      }
      .action-form {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <div class="logo-container">
        <img src="/images/logo.png" alt="Shedfactory Business Solutions">
      </div>
      <h2>Welcome, <%= username %>!</h2>
      <a href="/pos">Point of Sale</a>
      <a href="/update-stock">Manage Inventory</a>
      <a href="/invoices"  class="active">Generate Invoice</a>
      <a href="/transactions">View Transactions</a>
      <a href="/customers">Customers</a>
      <a href="/home">Manage Outlets</a>
      <a href="/store-view">View Store</a>
      <a href="/create-outlet">Create Outlet</a>
      <a href="/admin-logout">Log Out</a>
    </div>

    <!-- Toggle Button -->
    <button class="toggle-btn" id="toggleBtn">☰</button>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
      <div class="container">
        <div class="content-logo-container">
          <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
        </div>
        <h1>Invoices</h1>

        <!-- Business Details -->
        <div class="business-details">
          <p><strong>Business Name:</strong> <%= admin.businessName || 'N/A' %></p>
          <p><strong>Email:</strong> <%= admin.email || 'N/A' %></p>
          <p><strong>Currency:</strong> <%= admin.currency || 'N/A' %></p>
        </div>

        <button class="create-btn" id="createInvoiceBtn">Create Invoice</button>

        <!-- Create Invoice Form -->
        <div class="form-section hidden" id="createInvoiceForm">
          <% if (error) { %>
            <div class="error-message"><%= error %></div>
          <% } %>
          <form id="invoiceForm" action="/invoices/create" method="POST">
            <div>
              <select id="customerSelect" name="customerId" required>
                <option value="">Select Customer</option>
                <% customers.forEach(customer => { %>
                  <option value="<%= customer._id %>" <%= formData.customerId === customer._id.toString() ? 'selected' : '' %>>
                    <%= customer.name %> (<%= customer.phone || 'N/A' %>)
                  </option>
                <% }) %>
                <option value="new" <%= formData.customerId === 'new' ? 'selected' : '' %>>Create New Customer</option>
              </select>
              <div class="field-error" id="customerSelectError"></div>
            </div>

            <div id="newCustomerFields">
              <input type="text" name="newCustomerName" id="newCustomerName" placeholder="New Customer Name" value="<%= formData.newCustomerName || '' %>" <%= formData.customerId === 'new' ? 'required' : '' %>>
              <div class="field-error" id="newCustomerNameError"></div>
              <input type="text" name="newCustomerPhone" id="newCustomerPhone" placeholder="Phone Number" value="<%= formData.newCustomerPhone || '' %>">
              <input type="email" name="newCustomerEmail" id="newCustomerEmail" placeholder="Email Address" value="<%= formData.newCustomerEmail || '' %>">
            </div>

            <div id="itemsContainer">
              <% if (formData.items && formData.items.itemId) { %>
                <% const itemIds = Array.isArray(formData.items.itemId) ? formData.items.itemId : [formData.items.itemId]; %>
                <% const quantities = Array.isArray(formData.items.quantity) ? formData.items.quantity : [formData.items.quantity]; %>
                <% itemIds.forEach((itemId, index) => { %>
                  <div class="item-row" data-index="<%= index %>">
                    <select name="items[itemId][]" required>
                      <option value="">Select Item</option>
                      <% inventory.forEach(item => { %>
                        <option value="<%= item._id %>" <%= itemId === item._id.toString() ? 'selected' : '' %> data-stock="<%= item.stock %>">
                          <%= item.name %> (Stock: <%= item.stock %>)
                        </option>
                      <% }) %>
                      <option value="new">Create New Product</option>
                    </select>
                    <input type="number" name="items[quantity][]" placeholder="Quantity" min="1" value="<%= quantities[index] || '' %>" required>
                    <button type="button" class="remove-btn">Remove</button>
                    <div class="new-product-fields hidden" id="newProductFields<%= index %>">
                      <input type="text" name="items[newProductName][]" placeholder="Product Name">
                      <input type="number" name="items[newProductCost][]" placeholder="Cost" min="0" step="0.01">
                      <input type="number" name="items[newProductStock][]" placeholder="Stock" min="0">
                    </div>
                    <div class="field-error" id="itemError<%= index %>"></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="item-row" data-index="0">
                  <select name="items[itemId][]" required>
                    <option value="">Select Item</option>
                    <% inventory.forEach(item => { %>
                      <option value="<%= item._id %>" data-stock="<%= item.stock %>">
                        <%= item.name %> (Stock: <%= item.stock %>)
                      </option>
                    <% }) %>
                    <option value="new">Create New Product</option>
                  </select>
                  <input type="number" name="items[quantity][]" placeholder="Quantity" min="1" required>
                  <button type="button" class="remove-btn">Remove</button>
                  <div class="new-product-fields hidden" id="newProductFields0">
                    <input type="text" name="items[newProductName][]" placeholder="Product Name">
                    <input type="number" name="items[newProductCost][]" placeholder="Cost" min="0" step="0.01">
                    <input type="number" name="items[newProductStock][]" placeholder="Stock" min="0">
                  </div>
                  <div class="field-error" id="itemError0"></div>
                </div>
              <% } %>
            </div>

            <button type="button" class="create-btn" id="addItemBtn">Add Another Item</button>

            <div>
              <select name="paymentMethod" id="paymentMethod" required>
                <option value="">Select Payment Method</option>
                <option value="Cash" <%= formData.paymentMethod === 'Cash' ? 'selected' : '' %>>Cash</option>
                <option value="Credit Card" <%= formData.paymentMethod === 'Credit Card' ? 'selected' : '' %>>Credit Card</option>
                <option value="Bank Transfer" <%= formData.paymentMethod === 'Bank Transfer' ? 'selected' : '' %>>Bank Transfer</option>
                <option value="Mobile Payment" <%= formData.paymentMethod === 'Mobile Payment' ? 'selected' : '' %>>Mobile Payment</option>
              </select>
              <div class="field-error" id="paymentMethodError"></div>
            </div>

            <div id="bankDetails">
              <input type="text" name="bankName" id="bankName" placeholder="Bank Name" value="<%= formData.bankName || '' %>">
              <div class="field-error" id="bankNameError"></div>
              <input type="text" name="bankAccountName" id="bankAccountName" placeholder="Bank Account Name" value="<%= formData.bankAccountName || '' %>">
              <div class="field-error" id="bankAccountNameError"></div>
              <input type="text" name="accountNumber" id="accountNumber" placeholder="Account Number" value="<%= formData.accountNumber || '' %>">
              <div class="field-error" id="accountNumberError"></div>
            </div>

            <div class="form-actions">
              <button type="submit" class="create-btn">Create Invoice</button>
              <button type="button" class="cancel-btn" id="cancelInvoiceBtn">Cancel</button>
            </div>
          </form>
        </div>

        <!-- Invoices Table -->
        <div class="table-section">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Customer Name</th>
                <th>Items</th>
                <th>Total Amount</th>
                <th>Payment Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% sales.forEach(sale => { %>
                <tr id="sale-<%= sale._id %>">
                  <td><%= new Date(sale.date).toLocaleDateString() %></td>
                  <td><%= sale.customerName %></td>
                  <td>
                    <% if (sale.items) { %>
                      <%= sale.items.map(item => `${item.itemName} (${item.quantity})`).join(', ') %>
                    <% } else { %>
                      <%= `${sale.itemName} (${sale.quantity})` %>
                    <% } %>
                  </td>
                  <td><%= admin.currency %><%= formatCurrency(sale.totalAmount || 0) %></td>
                  <td class="payment-status"><%= sale.paymentStatus || 'Pending' %></td>
                  <td>
                    <div class="invoice-actions">
                      <a href="/invoices/download/<%= sale._id %>">
                        <button class="download-btn">Download PDF</button>
                      </a>
                      <% if (sale.paymentStatus !== 'Paid') { %>
                        <form action="/invoices/mark-paid/<%= sale._id %>" method="POST" class="action-form" data-sale-id="<%= sale._id %>">
                          <button type="submit" class="mark-paid-btn">Mark as Paid</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- JavaScript -->
    <script>
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('mainContent');
      const toggleBtn = document.getElementById('toggleBtn');
      const createInvoiceBtn = document.getElementById('createInvoiceBtn');
      const createInvoiceForm = document.getElementById('createInvoiceForm');
      const cancelInvoiceBtn = document.getElementById('cancelInvoiceBtn');
      const customerSelect = document.getElementById('customerSelect');
      const newCustomerFields = document.getElementById('newCustomerFields');
      const itemsContainer = document.getElementById('itemsContainer');
      const addItemBtn = document.getElementById('addItemBtn');
      const paymentMethod = document.getElementById('paymentMethod');
      const bankDetails = document.getElementById('bankDetails');
      const invoiceForm = document.getElementById('invoiceForm');
    
      // Toggle sidebar visibility
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
      });
    
      // Toggle invoice form visibility
      createInvoiceBtn.addEventListener('click', () => {
        createInvoiceBtn.classList.add('hidden');
        createInvoiceForm.classList.remove('hidden');
      });
      
      // Cancel invoice creation
      cancelInvoiceBtn.addEventListener('click', () => {
        createInvoiceForm.classList.add('hidden');
        createInvoiceBtn.classList.remove('hidden');
        invoiceForm.reset();
        // Reset to single item row if multiple exist
        const rows = itemsContainer.querySelectorAll('.item-row');
        if (rows.length > 1) {
          for (let i = 1; i < rows.length; i++) {
            rows[i].remove();
          }
        }
      });
    
      // Toggle new customer fields
      customerSelect.addEventListener('change', () => {
        const isNewCustomer = customerSelect.value === 'new';
        newCustomerFields.style.display = isNewCustomer ? 'block' : 'none';
        newCustomerFields.querySelectorAll('input').forEach(input => {
          input.required = isNewCustomer;
        });
        validateCustomer();
      });
    
      // Toggle bank details
      paymentMethod.addEventListener('change', () => {
        const isBankTransfer = paymentMethod.value === 'Bank Transfer';
        bankDetails.style.display = isBankTransfer ? 'block' : 'none';
        bankDetails.querySelectorAll('input').forEach(input => {
          input.required = isBankTransfer;
        });
        validatePaymentMethod();
      });
    
      // Add new item row with "Create New Product" option
      let itemIndex = <%= formData.items && formData.items.itemId ? (Array.isArray(formData.items.itemId) ? formData.items.itemId.length : 1) : 1 %>;
      addItemBtn.addEventListener('click', () => {
        const newRow = document.createElement('div');
        newRow.className = 'item-row';
        newRow.dataset.index = itemIndex;
        newRow.innerHTML = `
          <select name="items[itemId][]" required>
            <option value="">Select Item</option>
            <% inventory.forEach(item => { %>
              <option value="<%= item._id %>" data-stock="<%= item.stock %>">
                <%= item.name %> (Stock: <%= item.stock %>)
              </option>
            <% }) %>
            <option value="new">Create New Product</option>
          </select>
          <input type="number" name="items[quantity][]" placeholder="Quantity" min="1" required>
          <button type="button" class="remove-btn">Remove</button>
          <div class="new-product-fields hidden" id="newProductFields${itemIndex}">
            <input type="text" name="items[newProductName][]" placeholder="Product Name">
            <input type="number" name="items[newProductCost][]" placeholder="Cost" min="0" step="0.01">
            <input type="number" name="items[newProductStock][]" placeholder="Stock" min="0">
          </div>
          <div class="field-error" id="itemError${itemIndex}"></div>
        `;
        itemsContainer.appendChild(newRow);
        const select = newRow.querySelector('select');
        select.addEventListener('change', () => toggleNewProductFields(select));
        newRow.querySelector('select').addEventListener('change', validateItems);
        newRow.querySelector('input[type="number"]').addEventListener('input', validateItems);
        newRow.querySelectorAll('.new-product-fields input').forEach(input => input.addEventListener('input', validateItems));
        itemIndex++;
        updateRemoveButtons();
      });
    
      // Toggle new product fields based on selection
      function toggleNewProductFields(select) {
        const index = select.closest('.item-row').dataset.index;
        const newProductFields = document.getElementById(`newProductFields${index}`);
        const isNewProduct = select.value === 'new';
        newProductFields.classList.toggle('hidden', !isNewProduct);
        newProductFields.querySelectorAll('input').forEach(input => {
          input.required = isNewProduct;
        });
        validateItems();
      }
    
      // Update remove buttons visibility
      function updateRemoveButtons() {
        const rows = itemsContainer.querySelectorAll('.item-row');
        rows.forEach((row, index) => {
          const removeBtn = row.querySelector('.remove-btn');
          removeBtn.style.display = index === 0 && rows.length === 1 ? 'none' : 'inline-block';
          removeBtn.onclick = () => {
            if (rows.length > 1) {
              row.remove();
              validateItems();
              updateRemoveButtons();
            }
          };
        });
      }
    
      // Client-side validation
      function validateCustomer() {
        const errorElement = document.getElementById('customerSelectError');
        if (!customerSelect.value) {
          errorElement.textContent = 'Please select a customer.';
          errorElement.style.display = 'block';
        } else if (customerSelect.value === 'new') {
          const name = document.getElementById('newCustomerName').value.trim();
          const nameError = document.getElementById('newCustomerNameError');
          if (!name) {
            nameError.textContent = 'Customer name is required.';
            nameError.style.display = 'block';
            errorElement.style.display = 'none';
          } else {
            nameError.style.display = 'none';
            errorElement.style.display = 'none';
          }
        } else {
          errorElement.style.display = 'none';
        }
      }
    
      function validateItems() {
        const rows = itemsContainer.querySelectorAll('.item-row');
        rows.forEach(row => {
          const index = row.dataset.index;
          const select = row.querySelector('select');
          const quantityInput = row.querySelector('input[type="number"]');
          const errorElement = document.getElementById(`itemError${index}`);
          const isNewProduct = select.value === 'new';
    
          if (!select.value) {
            errorElement.textContent = 'Please select an item.';
            errorElement.style.display = 'block';
          } else if (isNewProduct) {
            const name = row.querySelector('input[name="items[newProductName][]"]').value.trim();
            const cost = parseFloat(row.querySelector('input[name="items[newProductCost][]"]').value) || 0;
            const stock = parseInt(row.querySelector('input[name="items[newProductStock][]"]').value) || 0;
            const qty = parseInt(quantityInput.value) || 0;
    
            if (!name) {
              errorElement.textContent = 'Product name is required.';
              errorElement.style.display = 'block';
            } else if (cost <= 0) {
              errorElement.textContent = 'Cost must be greater than 0.';
              errorElement.style.display = 'block';
            } else if (stock < 0) {
              errorElement.textContent = 'Stock cannot be negative.';
              errorElement.style.display = 'block';
            } else if (qty <= 0) {
              errorElement.textContent = 'Quantity must be greater than 0.';
              errorElement.style.display = 'block';
            } else if (qty > stock) {
              errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
              errorElement.style.display = 'block';
            } else {
              errorElement.style.display = 'none';
            }
          } else {
            const stock = parseInt(select.selectedOptions[0].dataset.stock) || 0;
            const qty = parseInt(quantityInput.value) || 0;
    
            if (qty <= 0) {
              errorElement.textContent = 'Quantity must be greater than 0.';
              errorElement.style.display = 'block';
            } else if (qty > stock) {
              errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
              errorElement.style.display = 'block';
            } else {
              errorElement.style.display = 'none';
            }
          }
        });
      }
    
      function validatePaymentMethod() {
        const errorElement = document.getElementById('paymentMethodError');
        if (!paymentMethod.value) {
          errorElement.textContent = 'Please select a payment method.';
          errorElement.style.display = 'block';
        } else if (paymentMethod.value === 'Bank Transfer') {
          const bankName = document.getElementById('bankName').value.trim();
          const bankAccountName = document.getElementById('bankAccountName').value.trim();
          const accountNumber = document.getElementById('accountNumber').value.trim();
          const bankNameError = document.getElementById('bankNameError');
          const bankAccountNameError = document.getElementById('bankAccountNameError');
          const accountNumberError = document.getElementById('accountNumberError');
    
          if (!bankName) {
            bankNameError.textContent = 'Bank name is required.';
            bankNameError.style.display = 'block';
            errorElement.style.display = 'none';
          } else {
            bankNameError.style.display = 'none';
          }
          if (!bankAccountName) {
            bankAccountNameError.textContent = 'Bank account name is required.';
            bankAccountNameError.style.display = 'block';
            errorElement.style.display = 'none';
          } else {
            bankAccountNameError.style.display = 'none';
          }
          if (!accountNumber) {
            accountNumberError.textContent = 'Account number is required.';
            accountNumberError.style.display = 'block';
            errorElement.style.display = 'none';
          } else {
            accountNumberError.style.display = 'none';
          }
          if (bankName && bankAccountName && accountNumber) {
            errorElement.style.display = 'none';
          }
        } else {
          errorElement.style.display = 'none';
        }
      }
    
      // Attach validation and toggle listeners
      customerSelect.addEventListener('change', validateCustomer);
      document.getElementById('newCustomerName')?.addEventListener('input', validateCustomer);
      paymentMethod.addEventListener('change', validatePaymentMethod);
      document.getElementById('bankName')?.addEventListener('input', validatePaymentMethod);
      document.getElementById('bankAccountName')?.addEventListener('input', validatePaymentMethod);
      document.getElementById('accountNumber')?.addEventListener('input', validatePaymentMethod);
      itemsContainer.querySelectorAll('select').forEach(select => {
        select.addEventListener('change', () => toggleNewProductFields(select));
        select.addEventListener('change', validateItems);
      });
      itemsContainer.querySelectorAll('input[type="number"]').forEach(input => input.addEventListener('input', validateItems));
      itemsContainer.querySelectorAll('.new-product-fields input').forEach(input => input.addEventListener('input', validateItems));
    
      // Handle form submission
      invoiceForm.addEventListener('submit', (e) => {
        validateCustomer();
        validateItems();
        validatePaymentMethod();
        const errors = document.querySelectorAll('.field-error[style="display: block"]');
        if (errors.length > 0) {
          e.preventDefault();
        }
      });
    
      // Handle "Mark as Paid" form submission
      document.querySelectorAll('.action-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const saleId = form.dataset.saleId;
          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            });
            if (response.ok) {
              const row = document.getElementById(`sale-${saleId}`);
              row.querySelector('.payment-status').textContent = 'Paid';
              form.remove();
            } else {
              alert('Failed to mark invoice as paid.');
            }
          } catch (error) {
            console.error('Error marking invoice as paid:', error);
            alert('An error occurred while marking the invoice as paid.');
          }
        });
      });
    
      // Initial setup
      updateRemoveButtons();
      newCustomerFields.style.display = customerSelect.value === 'new' ? 'block' : 'none';
      bankDetails.style.display = paymentMethod.value === 'Bank Transfer' ? 'block' : 'none';
      <% if (error) { %>
        createInvoiceBtn.classList.add('hidden');
        createInvoiceForm.classList.remove('hidden');
      <% } else { %>
        createInvoiceForm.classList.add('hidden');
      <% } %>
      itemsContainer.querySelectorAll('select').forEach(select => toggleNewProductFields(select));
      validateCustomer();
      validateItems();
      validatePaymentMethod();
    </script>
  </body>
</html>