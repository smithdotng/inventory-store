<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Signup | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="https://img.shed.ng/status.jpg" />

    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Cropper.js CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS for Fixes, Menu, Search Results, Form Styling, and Image -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
            margin-top: 20px;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Adjust .mil-frame-top to be fixed at top */
        .mil-frame-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px;
            background: #fff;
            height: 70px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }
        .mil-logo img {
            width: 100px;
            height: auto;
        }
        .mil-main-menu {
            display: flex;
            position: relative;
        }
        .mil-main-menu ul {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .mil-main-menu ul li {
            position: relative;
            margin: 0 10px;
        }
        .mil-main-menu ul li a {
            color: #333;
            text-decoration: none;
            font-size: 14px;
            padding: 8px;
            display: block;
        }
        .mil-main-menu ul li.mil-has-children > a::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-left: 5px;
            font-size: 10px;
        }
        .mil-main-menu ul li ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            min-width: 180px;
            flex-direction: column;
            z-index: 1000;
        }
        .mil-main-menu ul li ul li {
            margin: 0;
        }
        .mil-main-menu ul li ul li a {
            padding: 8px 12px;
            color: #333;
            font-size: 14px;
        }
        .mil-main-menu ul li:hover > ul {
            display: flex;
        }
        .mil-main-menu ul li ul li:hover a {
            background: #f5f5f5;
        }
        .mil-menu-btn {
            display: none;
            cursor: pointer;
            font-size: 20px;
            color: #333;
        }
        /* Style mil-frame-bottom to scroll with the page */
        .mil-frame-bottom {
            background: #1a1a1a;
            padding: 10px;
            text-align: center;
            color: #fff;
        }
        .mil-frame-bottom .mil-back-to-top a {
            color: #fff;
            text-decoration: none;
        }
        /* Search form and results */
        .mil-subscribe-form {
            position: relative;
            display: flex;
            align-items: center;
            padding: 5px;
            border-radius: 5px;
        }
        .mil-subscribe-form input {
            flex: 1;
            border: none;
            background-color: beige;
            padding: 8px;
            font-size: 14px;
            outline: none;
        }
        .mil-subscribe-form button {
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .mil-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            display: none;
        }
        .mil-search-results.active {
            display: block;
        }
        .mil-search-result-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #333;
        }
        .mil-search-result-item:hover {
            background: #f5f5f5;
        }
        .mil-search-result-item img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }
        .mil-search-result-item div {
            flex: 1;
        }
        .mil-search-result-item h6 {
            margin: 0;
            font-size: 14px;
            color: #333;
        }
        .mil-search-result-item p {
            margin: 0;
            font-size: 12px;
            color: #666;
        }
        .mil-search-no-results {
            padding: 10px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        /* Mobile Menu */
        @media screen and (max-width: 991px) {
            .mil-main-menu {
                display: none;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: #fff;
                z-index: 999;
            }
            .mil-main-menu.active {
                display: block;
            }
            .mil-main-menu ul {
                flex-direction: column;
                padding: 10px;
            }
            .mil-main-menu ul li {
                margin: 5px 0;
            }
            .mil-main-menu ul li ul {
                position: static;
                box-shadow: none;
                display: none;
            }
            .mil-main-menu ul li.mil-has-children.active > ul {
                display: flex;
            }
            .mil-menu-btn {
                display: block;
            }
            .mil-subscribe-form {
                width: 100%;
            }
            .mil-search-results {
                width: 100%;
            }
        }
        /* Content padding to avoid overlap with fixed header */
        .mil-content {
            padding-top: 80px;
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-main-menu ul li::before,
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        .mil-accordion-content ol li {
            padding-left: 30px;
            margin-bottom: 10px;
        }
        .mil-accordion-content ol li::before {
            font-size: 16px;
            color: #008B8B;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            
            font-size: 16px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        .mil-form-group select.mil-form-control {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.75rem center;
            background-size: 1em;
            padding-right: 2rem;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
        }
        .mil-password-requirements {
            margin-top: 5px;
            font-size: 12px;
        }
        .mil-password-requirements ul {
            padding-left: 15px;
            margin-bottom: 0;
            color: #333;
        }
        .mil-password-requirements .valid {
            color: #90EE90;
        }
        .mil-password-requirements .invalid {
            color: #333;
        }
        .mil-password-requirements .error {
            color: #FF0000;
        }
        #confirmPasswordFeedback.valid {
            color: #90EE90;
        }
        #confirmPasswordFeedback.invalid {
            color: #FF0000;
        }
        .file-upload-label {
            display: inline-block;
            font-size: 13px;
            padding: 10px 20px;
            background-color: rgb(235, 166, 17);
            color: #333333;
            border: 2px solid #ffffff;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
            text-align: center;
            width: 100%;
            max-width: 200px;
        }
        .file-upload-label:hover {
            background-color: #ffffff;
            color: rgb(235, 166, 17);
            border-color: rgb(235, 166, 17);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }
        .file-upload-label.uploaded {
            background-color: #e9ecef;
            border-color: #495057;
            color: #495057;
        }
        .file-upload-label.uploaded:hover {
            background-color: #d3d7db;
        }
        #logoPreview {
            max-width: 120px;
            max-height: 120px;
            display: none;
            margin-top: 10px;
        }
        /* Cropper Modal Styles */
        .mil-cropper-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            z-index: 10000;
            display: none;
            justify-content: center;
            align-items: center;
        }
        .mil-cropper-modal-content {
            background: #ffffff;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            overflow: hidden;
            padding: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
        .mil-cropper-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            background: #ffffff;
        }
        .mil-cropper-header h3 {
            margin: 0;
            font-size: 16px;
            color: #333333;
            font-weight: 500;
        }
        .mil-close-cropper {
            cursor: pointer;
            font-size: 20px;
            color: #333333;
        }
        .mil-cropper-body {
            margin-bottom: 15px;
            background: #ffffff;
        }
        .mil-cropper-body img {
            display: block;
            max-width: 100%;
            height: auto;
        }
        .mil-cropper-footer {
            text-align: right;
            background: #ffffff;
        }
        .mil-cropper-footer .mil-button {
            font-size: 14px;
            padding: 8px 16px;
            margin-left: 10px;
        }
        /* Promo Image Styling */
        .mil-promo-image {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 15px;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .file-upload-label {
                font-size: 12px;
                padding: 8px 16px;
                max-width: 100%;
            }
            .mil-password-requirements {
                font-size: 11px;
            }
            .mil-cropper-modal-content {
                width: 95%;
                padding: 10px;
            }
            .mil-cropper-header h3 {
                font-size: 14px;
            }
            .mil-close-cropper {
                font-size: 18px;
            }
            .mil-cropper-footer .mil-button {
                font-size: 12px;
                padding: 6px 12px;
            }
            .mil-promo-image {
                max-height: 300px;
            }
        }
        @media screen and (max-width: 991px) {
            .mil-main-menu ul li {
                padding-left: 25px;
            }
            .mil-main-menu ul li::before {
                content: '\f00c';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                color: #008B8B;
                position: absolute;
                left: 5px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 14px;
            }
            .mil-main-menu ul li ul li::before {
                left: 15px;
            }
        }
    </style>

    <title>Shed | Sell Anywhere. Manage Everything</title>
</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- cursor -->
        <div class="mil-ball">
            <span class="mil-icon-1">
                <svg viewBox="0 0 128 128">
                    <path d="M106.1,41.9c-1.2-1.2-3.1-1.2-4.2,0c-1.2,1.2-1.2,3.1,0,4.2L116.8,61H11.2l14.9-14.9c1.2-1.2,1.2-3.1,0-4.2 c-1.2-1.2-3.1-1.2-4.2,0l-20,20c-1.2,1.2-1.2,3.1,0,4.2l20,20c0.6,0.6,1.4,0.9,2.1,0.9s1.5-0.3,2.1-0.9c1.2-1.2,1.2-3.1,0-4.2 L11.2,67h105.5l-14.9,14.9c-1.2,1.2-1.2,3.1,0,4.2c0.6,0.6,1.4,0.9,2.1,0.9s1.5-0.3,2.1-0.9l20-20c1.2-1.2,1.2-3.1,0-4.2L106.1,41.9 z" />
                </svg>
            </span>
            <div class="mil-more-text">More</div>
            <div class="mil-choose-text">Сhoose</div>
        </div>
        <!-- cursor end -->

        <!-- preloader -->
        <div class="mil-preloader">
            <div class="mil-preloader-animation">
                <div class="mil-pos-abs mil-animation-2">
                    <div class="mil-reveal-frame">
                        <p class="mil-reveal-box"></p>
                        <p class="mil-h3 mil-muted mil-thin">Shed.ng</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- preloader end -->

        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- frame top (header) -->
        <div class="mil-frame-top">
            <a href="home-1.html" class="mil-logo"><img src="images/logo.png" alt="Logo"></a>
            <nav class="mil-main-menu" id="swupMenu">
                <form class="mil-subscribe-form mil-up" style="background-color: beige;">
                    <input type="text" placeholder="Search for a Shed" size="50">
                    <button type="submit" class="mil-button mil-icon-button-sm mil-arrow-place"></button>
                    <div class="mil-search-results"></div>
                </form>
            </nav>
            <div class="mil-menu-btn">
                <i class="fas fa-search"></i>
            </div>
        </div>
        <!-- frame top end -->

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Create your </span>Shed </h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Join thousands of businesses managing inventory, sales, and growth with Shed.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- Content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-6">
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-bell"></i> <%= error %>
                                    </div>
                                <% } %>

                                <form action="/admin-register<%= typeof referralCode !== 'undefined' && referralCode ? '?ref=' + referralCode : '' %>" method="POST" enctype="multipart/form-data" class="mil-up">
                                    <!-- Business Name -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-building"></i> Business Name</label>
                                        <input type="text" class="mil-form-control" id="businessName" name="businessName" placeholder="Enter business name..." required value="<%= typeof businessName !== 'undefined' ? businessName : '' %>">
                                    </div>

                                    <!-- Username -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-user"></i> Username</label>
                                        <input type="text" class="mil-form-control" id="username" name="username" placeholder="Enter username..." required value="<%= typeof username !== 'undefined' ? username : '' %>">
                                    </div>

                                    <!-- First Name and Last Name -->
                                    <div class="mil-form-row">
                                        <div class="mil-form-col">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-user"></i> First Name</label>
                                                <input type="text" class="mil-form-control" id="firstName" name="firstName" placeholder="Enter first name..." required value="<%= typeof firstName !== 'undefined' ? firstName : '' %>">
                                            </div>
                                        </div>
                                        <div class="mil-form-col">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-user"></i> Last Name</label>
                                                <input type="text" class="mil-form-control" id="lastName" name="lastName" placeholder="Enter last name..." required value="<%= typeof lastName !== 'undefined' ? lastName : '' %>">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Email Address -->
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-envelope"></i> Email Address</label>
                                        <input type="email" class="mil-form-control" id="email" name="email" placeholder="Enter email address..." required value="<%= typeof email !== 'undefined' ? email : '' %>">
                                    </div>

                                    <!-- Country and Currency -->
                                    <div class="mil-form-row">
                                        <div class="mil-form-col">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-globe"></i> Country</label>
                                                <select class="mil-form-control" id="country" name="country" required>
                                                    <option value="">Select your country</option>
                                                    <optgroup label="Africa">
                                                        <option value="Nigeria" <%= typeof country !== 'undefined' && country === 'Nigeria' ? 'selected' : '' %>>Nigeria</option>
                                                        <option value="South Africa" <%= typeof country !== 'undefined' && country === 'South Africa' ? 'selected' : '' %>>South Africa</option>
                                                        <option value="Ghana" <%= typeof country !== 'undefined' && country === 'Ghana' ? 'selected' : '' %>>Ghana</option>
                                                        <option value="Kenya" <%= typeof country !== 'undefined' && country === 'Kenya' ? 'selected' : '' %>>Kenya</option>
                                                    </optgroup>
                                                    <optgroup label="Europe">
                                                        <option value="United Kingdom" <%= typeof country !== 'undefined' && country === 'United Kingdom' ? 'selected' : '' %>>United Kingdom</option>
                                                        <option value="Germany" <%= typeof country !== 'undefined' && country === 'Germany' ? 'selected' : '' %>>Germany</option>
                                                    </optgroup>
                                                    <optgroup label="Americas">
                                                        <option value="United States" <%= typeof country !== 'undefined' && country === 'United States' ? 'selected' : '' %>>United States</option>
                                                    </optgroup>
                                                    <optgroup label="Other">
                                                        <option value="Other" <%= typeof country !== 'undefined' && country === 'Other' ? 'selected' : '' %>>Other Country</option>
                                                    </optgroup>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="mil-form-col">
                                            <div class="mil-form-group">
                                                <label><i class="fa-solid fa-coins"></i> Currency</label>
                                                <select class="mil-form-control" id="currency" name="currency" required>
                                                    <option value="">Select your currency</option>
                                                    <optgroup label="African Currencies">
                                                        <option value="ZAR" <%= typeof currency !== 'undefined' && currency === 'ZAR' ? 'selected' : '' %>>South African Rand (ZAR)</option>
