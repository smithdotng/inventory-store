    <!-- Fallback for .row visibility -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const row = document.querySelector('.mil-banner-content .row');
            if (row) {
                row.style.display = 'flex';
                row.style.visibility = 'visible';
                row.style.opacity = '1';
            }
        });
    </script>

    <!-- Sidebar Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const toggleBtn = document.getElementById('toggleBtn');

            const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
            if (isSidebarHidden) {
                sidebar.classList.add('hidden');
                mainContent.classList.add('full-width');
                toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
            } else {
                sidebar.classList.remove('hidden');
                mainContent.classList.remove('full-width');
                toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
            }

            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                mainContent.classList.toggle('full-width');
                toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                localStorage.setItem('sidebarHidden', sidebar.classList.contains('hidden'));
            });

            function setSidebarState() {
                if (sidebar.classList.contains('hidden')) {
                    mainContent.classList.add('full-width');
                } else {
                    mainContent.classList.remove('full-width');
                }
            }
            setSidebarState();
            window.addEventListener('resize', setSidebarState);
        });
    </script>

    <!-- POS Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const itemsContainer = document.getElementById('itemsContainer');
                const addItemBtn = document.getElementById('addItemBtn');
                const salesForm = document.getElementById('salesForm');

                // Initialize searchable selects
                function initializeSearchableSelects() {
                    document.querySelectorAll('.item-row').forEach(row => {
                        const searchInput = row.querySelector('.mil-product-search');
                        const selectElement = row.querySelector('.mil-product-select');
                        const resultsContainer = row.querySelector('.mil-search-results');
                        const options = Array.from(selectElement.options);

                        // Show/hide results on focus/blur
                        searchInput.addEventListener('focus', () => {
                            resultsContainer.style.display = 'block';
                            filterOptions();
                        });

                        searchInput.addEventListener('blur', () => {
                            setTimeout(() => {
                                resultsContainer.style.display = 'none';
                            }, 200);
                        });

                        // Filter options as user types
                        searchInput.addEventListener('input', filterOptions);

                        function filterOptions() {
                            const searchTerm = searchInput.value.toLowerCase();
                            resultsContainer.innerHTML = '';

                            const filteredOptions = options.filter(option =>
                                option.textContent.toLowerCase().includes(searchTerm) && option.value
                            );

                            if (filteredOptions.length === 0) {
                                const noResults = document.createElement('div');
                                noResults.className = 'mil-search-result-item';
                                noResults.textContent = 'No products found';
                                resultsContainer.appendChild(noResults);
                                return;
                            }

                            filteredOptions.forEach(option => {
                                const resultItem = document.createElement('div');
                                resultItem.className = 'mil-search-result-item';
                                resultItem.textContent = option.textContent;
                                resultItem.dataset.value = option.value;

                                resultItem.addEventListener('mousedown', (e) => {
                                    e.preventDefault();
                                    selectElement.value = option.value;
                                    searchInput.value = option.getAttribute('data-name');
                                    resultsContainer.style.display = 'none';

                                    // Trigger change event for validation
                                    const event = new Event('change');
                                    selectElement.dispatchEvent(event);
                                });

                                resultsContainer.appendChild(resultItem);
                            });
                        }

                        // Allow keyboard navigation
                        searchInput.addEventListener('keydown', (e) => {
                            const results = resultsContainer.querySelectorAll('.mil-search-result-item');
                            let highlighted = resultsContainer.querySelector('.highlighted');

                            if (e.key === 'ArrowDown') {
                                e.preventDefault();
                                if (!highlighted) {
                                    results[0]?.classList.add('highlighted');
                                } else {
                                    highlighted.classList.remove('highlighted');
                                    const next = highlighted.nextElementSibling;
                                    if (next) next.classList.add('highlighted');
                                }
                            } else if (e.key === 'ArrowUp') {
                                e.preventDefault();
                                if (highlighted) {
                                    highlighted.classList.remove('highlighted');
                                    const prev = highlighted.previousElementSibling;
                                    if (prev) prev.classList.add('highlighted');
                                }
                            } else if (e.key === 'Enter' && highlighted) {
                                e.preventDefault();
                                selectElement.value = highlighted.dataset.value;
                                searchInput.value = options.find(opt => opt.value === highlighted.dataset.value)?.getAttribute('data-name') || '';
                                resultsContainer.style.display = 'none';

                                // Trigger change event for validation
                                const event = new Event('change');
                                selectElement.dispatchEvent(event);
                            }
                        });
                    });
                }

                // Add new item row
                let itemIndex = 1;
                if (addItemBtn) {
                    addItemBtn.addEventListener('click', () => {
                        const newRow = document.createElement('div');
                        newRow.className = 'item-row';
                        newRow.dataset.index = itemIndex;
                        newRow.innerHTML = `
                            <div class="mil-searchable-select">
                                <input type="text" class="mil-form-control mil-product-search" placeholder="Search products..." autocomplete="off">
                                <select name="items[itemId][]" class="mil-form-control mil-product-select" required style="display: none;">
                                    <option value="">Select Product</option>
                                    <% inventory.forEach(item => { %>
                                        <% if (item.stock > 0) { %>
                                            <option value="<%= item._id %>" data-stock="<%= item.stock %>" data-price="<%= item.cost %>" data-name="<%= item.name %>">
                                                <%= item.name %> (Stock: <%= item.stock %>) - <%= admin.currency || '$' %><%= item.cost.toFixed(2) %>
                                            </option>
                                        <% } %>
                                    <% }) %>
                                </select>
                                <div class="mil-search-results" style="display: none;"></div>
                            </div>
                            <input type="number" name="items[quantity][]" class="mil-form-control" placeholder="Quantity" min="1" required>
                            <button type="button" class="mil-button delete-btn remove-btn">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <div class="mil-field-error" id="itemError${itemIndex}"></div>
                        `;
                        itemsContainer.appendChild(newRow);
                        itemIndex++;
                        updateRemoveButtons();
                        initializeSearchableSelects();
                        attachItemValidation(newRow);
                    });
                }

                // Update remove buttons visibility
                function updateRemoveButtons() {
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    rows.forEach((row, index) => {
                        const removeBtn = row.querySelector('.remove-btn');
                        removeBtn.style.display = index === 0 && rows.length === 1 ? 'none' : 'block';
                        removeBtn.onclick = () => {
                            if (rows.length > 1) {
                                row.remove();
                                updateRemoveButtons();
                                validateItems();
                            }
                        };
                    });
                }

                // Attach validation to item row
                function attachItemValidation(row) {
                    const select = row.querySelector('.mil-product-select');
                    const searchInput = row.querySelector('.mil-product-search');
                    const quantityInput = row.querySelector('input[type="number"]');
                    const errorElement = row.querySelector('.mil-field-error');

                    select.addEventListener('change', () => {
                        if (select.value) {
                            const stock = parseInt(select.options[select.selectedIndex].getAttribute('data-stock'));
                            quantityInput.setAttribute('max', stock);
                        }
                        validateItems();
                    });

                    searchInput.addEventListener('change', () => {
                        validateItems();
                    });

                    quantityInput.addEventListener('input', validateItems);
                }

                // Validate all items
                function validateItems() {
                    let isValid = true;
                    const rows = itemsContainer.querySelectorAll('.item-row');

                    rows.forEach(row => {
                        const select = row.querySelector('.mil-product-select');
                        const quantityInput = row.querySelector('input[type="number"]');
                        const errorElement = row.querySelector('.mil-field-error');

                        if (!select.value) {
                            errorElement.textContent = 'Please select an item.';
                            errorElement.style.display = 'block';
                            isValid = false;
                        } else {
                            const stock = parseInt(select.options[select.selectedIndex].getAttribute('data-stock'));
                            const quantity = parseInt(quantityInput.value) || 0;

                            if (quantity <= 0) {
                                errorElement.textContent = 'Quantity must be greater than 0.';
                                errorElement.style.display = 'block';
                                isValid = false;
                            } else if (quantity > stock) {
                                errorElement.textContent = `Insufficient stock. Only ${stock} available.`;
                                valueElement.style.display = 'block';
                                isValid = false;
                            } else {
                                errorElement.style.display = 'none';
                            }
                        }
                    });

                    return isValid;
                }

                // Validate customer name
                function validateCustomer() {
                    const customerName = salesForm.querySelector('input[name="customerName"]');
                    const errorElement = document.getElementById('customerNameError');

                    if (!customerName.value.trim()) {
                        errorElement.textContent = 'Customer name is required.';
                        errorElement.style.display = 'block';
                        return false;
                    } else {
                        errorElement.style.display = 'none';
                        return true;
                    }
                }

                // Validate payment method
                function validatePaymentMethod() {
                    const paymentMethod = salesForm.querySelector('select[name="paymentMethod"]');
                    const errorElement = document.getElementById('paymentMethodError');

                    if (!paymentMethod.value) {
                        errorElement.textContent = 'Please select a payment method.';
                        errorElement.style.display = 'block';
                        return false;
                    } else {
                        errorElement.style.display = 'none';
                        return true;
                    }
                }

                // Form submission
                if (salesForm) {
                    salesForm.addEventListener('submit', (e) => {
                        const isCustomerValid = validateCustomer();
                        const isPaymentMethodValid = validatePaymentMethod();
                        const areItemsValid = validateItems();

                        if (!isCustomerValid || !isPaymentMethodValid || !areItemsValid) {
                            e.preventDefault();
                        }
                    });
                }

                // Initial setup
                updateRemoveButtons();
                initializeSearchableSelects();
                attachItemValidation(itemsContainer.querySelector('.item-row'));
            } catch (error) {
                console.error('Error initializing scripts:', error);
            }
        });
    </script>
    <script>
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
