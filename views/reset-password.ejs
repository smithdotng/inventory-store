<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Reuse styles from login.ejs */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background-color: #f5f5f5;
      padding: 20px;
    }
    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 600px;
      background: white;
      padding: 30px;
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      text-align: center;
    }
    .logo-container img {
      width: 100%;
      max-width: 250px;
      margin-bottom: 20px;
    }
    .form-section {
      width: 100%;
    }
    h2 {
      margin-bottom: 20px;
    }
    .error {
      color: red;
      margin-bottom: 10px;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    input {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }
    button {
      padding: 12px;
      background-color: green;
      color: white;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: darkgreen;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Yearnings Custom Store Logo">
    </div>
    <div class="form-section">
      <h2 style="color: cadetblue;">Reset Password</h2>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/reset-password" method="POST">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="password" name="password" placeholder="New Password" required>
        <input type="password" name="confirmPassword" placeholder="Confirm New Password" required>
        <button type="submit">Reset Password</button>
      </form>
    </div>
  </div>
</body>
</html>