    <!-- Inline CSS for Fixes and Menu -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
            margin-top: 20px;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Make .mil-frame fixed at bottom */
        .mil-frame {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }
        /* Adjust .mil-frame-top to be shorter and fixed at top */
        .mil-frame-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px;
            background: #fff;
            height: 70px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }
        .mil-logo img {
            width: 100px;
            height: auto;
        }
        .mil-main-menu {
            display: flex;
        }
        .mil-main-menu ul {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .mil-main-menu ul li {
            position: relative;
            margin: 0 10px;
        }
        .mil-main-menu ul li a {
            color: #333;
            text-decoration: none;
            font-size: 14px;
            padding: 8px;
            display: block;
        }
        .mil-main-menu ul li.mil-has-children > a::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-left: 5px;
            font-size: 10px;
        }
        .mil-main-menu ul li ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            min-width: 180px;
            flex-direction: column;
            z-index: 1000;
        }
        .mil-main-menu ul li ul li {
            margin: 0;
        }
        .mil-main-menu ul li ul li a {
            padding: 8px 12px;
            color: #333;
            font-size: 14px;
        }
        .mil-main-menu ul li:hover > ul {
            display: flex;
        }
        .mil-main-menu ul li ul li:hover a {
            background: #f5f5f5;
        }
        .mil-menu-btn {
            display: none;
            cursor: pointer;
        }
        .mil-menu-btn span {
            display: block;
            width: 20px;
            height: 2px;
            background: #333;
            margin: 4px 0;
        }
        /* Mobile Menu */
        @media screen and (max-width: 991px) {
            .mil-main-menu {
                display: none;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: #fff;
                z-index: 999;
            }
            .mil-main-menu.active {
                display: block;
            }
            .mil-main-menu ul {
                flex-direction: column;
                padding: 10px;
            }
            .mil-main-menu ul li {
                margin: 5px 0;
            }
            .mil-main-menu ul li ul {
                position: static;
                box-shadow: none;
                display: none;
            }
            .mil-main-menu ul li.mil-has-children.active > ul {
                display: flex;
            }
            .mil-menu-btn {
                display: block;
            }
        }
        /* Content padding to avoid overlap with fixed elements */
        .mil-content {
            padding-top: 80px;
            padding-bottom: 60px;
        }

        .mil-light-soft {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        color: #fff !important; /* White for dark backgrounds */
        font-size: 16px !important; /* Ensure readable size */
    }

    /* Adjust for light backgrounds (e.g., mil-soft-bg sections) */
    .mil-soft-bg .mil-light-soft {
        color: #333 !important; /* Dark color for light backgrounds */
    }

    /* Ensure parent containers are visible */
    .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
        visibility: visible !important;
        opacity: 1 !important;
    }

    /* Override potential animation issues */
    .mil-up {
        transform: none !important;
        opacity: 1 !important;
    }
    /* Add tick to all <li> elements */
        li {
        position: relative;
        padding-left: 25px; /* Space for the tick */
    }
    li::before {
        content: '\f00c'; /* Font Awesome check mark */
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #008B8B; /* Primary color (darkcyan) */
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
    }
    /* Exceptions for specific lists */
    .mil-main-menu ul li::before,
    .mil-footer-menu ul li::before,
    .mil-social-icons li::before {
        content: none; /* Remove ticks from navigation and social icons */
    }
    .mil-menu-list li::before {
        color: #fff; /* White ticks for footer menu-list on dark background */
    }
    /* Style for ordered list in accordion */
    .mil-accordion-content ol li {
        padding-left: 30px;
        margin-bottom: 10px;
    }
    .mil-accordion-content ol li::before {
        font-size: 16px;
        color: #008B8B;
    }
    /* Mobile menu adjustments */
    @media screen and (max-width: 991px) {
        .mil-main-menu ul li {
            padding-left: 25px;
        }
        .mil-main-menu ul li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 5px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-main-menu ul li ul li::before {
            left: 15px; /* Indent sub-menu ticks */
        }
    }
    </style>

