            const mainContent = document.querySelector('.mil-main-content');
            const container = document.querySelector('.mil-about .container');
            const row = document.querySelector('.mil-about .row');
            const col = document.querySelector('.col-lg-8');
            const table = document.querySelector('.mil-table-section table');

            console.log('Main content width:', mainContent.scrollWidth, 'Viewport width:', window.innerWidth);
            console.log('Container width:', container.scrollWidth);
            console.log('Row width:', row.scrollWidth);
            console.log('Col width:', col.scrollWidth);
            console.log('Table width:', table.scrollWidth);

            mainContent.addEventListener('scroll', () => {
                console.log('Main content scrollLeft:', mainContent.scrollLeft);
                console.log('Max scrollLeft:', mainContent.scrollWidth - mainContent.clientWidth);
            });

            // Force scroll to left on load
            mainContent.scrollLeft = 0;
        });
    </script>

    <!-- Update Stock Scripts -->
    <script>
        function toggleEdit(id) {
            const row = document.getElementById(`row-${id}`);
            if (!row) return;
            const stockInput = row.querySelector('.stock-input');
            const costDisplay = row.querySelector('.cost-display');
            const costInput = row.querySelector('.cost-input');
            const commissionDisplay = row.querySelector('.commission-display');
            const commissionInput = row.querySelector('.commission-input');
            const editBtn = row.querySelector('.edit-btn');
            const updateBtn = row.querySelector('.update-btn');
            const cancelBtn = row.querySelector('.cancel-btn');

            stockInput.disabled = false;
            costInput.disabled = false;
            commissionInput.disabled = false;

            costDisplay.style.display = 'none';
            costInput.style.display = 'inline-block';
            commissionDisplay.style.display = 'none';
            commissionInput.style.display = 'inline-block';
            editBtn.style.display = 'none';
            updateBtn.style.display = 'inline-block';
            cancelBtn.style.display = 'inline-block';

            updateHiddenInputs(id);
        }

        function updateHiddenInputs(id) {
            const row = document.getElementById(`row-${id}`);
            if (!row) return;
            const stockInput = row.querySelector('.stock-input');
            const costInput = row.querySelector('.cost-input');
            const commissionInput = row.querySelector('.commission-input');
            const hiddenStock = row.querySelector('.hidden-stock');
            const hiddenCost = row.querySelector('.hidden-cost');
            const hiddenCommission = row.querySelector('.hidden-commission');

            hiddenStock.value = stockInput.value;
            hiddenCost.value = costInput.value;
            hiddenCommission.value = commissionInput.value || '0';
        }

        function cancelEdit(id) {
            const row = document.getElementById(`row-${id}`);
            if (!row) return;
            const stockInput = row.querySelector('.stock-input');
            const costDisplay = row.querySelector('.cost-display');
            const costInput = row.querySelector('.cost-input');
            const commissionDisplay = row.querySelector('.commission-display');
            const commissionInput = row.querySelector('.commission-input');
            const editBtn = row.querySelector('.edit-btn');
            const updateBtn = row.querySelector('.update-btn');
            const cancelBtn = row.querySelector('.cancel-btn');

            stockInput.value = cancelBtn.dataset.stock;
            costInput.value = cancelBtn.dataset.cost;
            commissionInput.value = cancelBtn.dataset.commission;

            stockInput.disabled = true;
            costInput.disabled = true;
            commissionInput.disabled = true;

            costDisplay.textContent = '<%= admin.currency || '' %>' + Number(cancelBtn.dataset.cost).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            costDisplay.style.display = 'inline';
            costInput.style.display = 'none';
            commissionDisplay.textContent = (cancelBtn.dataset.commission || '0') + '%';
            commissionDisplay.style.display = 'inline';
            commissionInput.style.display = 'none';
            editBtn.style.display = 'inline-block';
            updateBtn.style.display = 'none';
            cancelBtn.style.display = 'none';
        }

        function showDeleteModal(id, name) {
            const modal = document.createElement('div');
            modal.className = 'mil-modal active';
            modal.innerHTML = `
                <div class="mil-modal-content">
                    <h5>Delete ${name}?</h5>
                    <p>Are you sure you want to delete this item? This action cannot be undone.</p>
                    <div class="mil-modal-buttons">
                        <button class="mil-button cancel-btn" type="button">Cancel <i class="fa-solid fa-times"></i></button>
                        <form action="/delete-stock" method="POST">
                            <input type="hidden" name="_id" value="${id}">
                            <input type="hidden" name="search" value="<%= search || '' %>">
                            <button type="submit" class="mil-button delete-btn">Delete <i class="fa-solid fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);

            modal.querySelector('.mil-modal-buttons button[type="button"]').addEventListener('click', () => {
                modal.remove();
            });
        }

        function shareStorefrontLink() {
            const storeUrl = `<%= baseUrl %>/store/<%= username %>`;
            if (navigator.share) {
                navigator.share({
                    title: '<%= admin.businessName || "My Store" %> - Shop Now',
                    text: 'Check out my online store on Shed!',
                    url: storeUrl
                }).catch((error) => console.error('Error sharing storefront:', error));
            } else {
                navigator.clipboard.writeText(storeUrl).then(() => {
                    alert('Storefront link copied to clipboard: ' + storeUrl);
                }).catch((error) => {
                    console.error('Error copying link:', error);
                    alert('Failed to copy link. Your store URL is: ' + storeUrl);
                });
            }
        }

        let currentDescriptionId = null;

        function showDescriptionModal(id, description) {
            currentDescriptionId = id;
            const modal = document.getElementById('descriptionModal');
            const textarea = document.getElementById('descriptionTextarea');
            textarea.value = description || '';
            modal.classList.add('active');
        }

        function hideDescriptionModal() {
            const modal = document.getElementById('descriptionModal');
            modal.classList.remove('active');
            currentDescriptionId = null;
        }

        function saveDescription() {
            if (!currentDescriptionId) return;
            
            const textarea = document.getElementById('descriptionTextarea');
            const newDescription = textarea.value;
            
            const descriptionCell = document.querySelector(`.description-cell[data-id="${currentDescriptionId}"]`);
            if (descriptionCell) {
                descriptionCell.dataset.description = newDescription;
                descriptionCell.textContent = newDescription ? 
                    (newDescription.length > 50 ? newDescription.substring(0, 50) + '...' : newDescription) : 
                    'N/A';
            }
            
            fetch('/update-description', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    _id: currentDescriptionId,
                    description: newDescription,
                    search: '<%= search || "" %>'
                })
            }).then(response => {
                if (!response.ok) {
                    throw new Error('Failed to update description');
                }
                return response.json();
            }).then(data => {
                if (data.error) {
                    alert('Error updating description: ' + data.error);
                } else {
                    hideDescriptionModal();
                }
            }).catch(error => {
                console.error('Error:', error);
                alert('Error updating description');
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            try {
                const addProductBtn = document.getElementById('addProductBtn');
                const addProductForm = document.getElementById('addProductForm');
                const cancelAddBtn = document.getElementById('cancelAddBtn');
                const productImagesInput = document.getElementById('productImages');
                const imagePreviewsContainer = document.getElementById('imagePreviews');
                const imagePlaceholder = document.getElementById('imagePlaceholder');
                const shareStoreBtn = document.getElementById('shareStoreBtn');

                if (addProductBtn && addProductForm) {
                    addProductBtn.addEventListener('click', () => {
                        addProductForm.style.display = 'block';
                        document.querySelector('.mil-button-group').style.display = 'none';
                        document.querySelector('.mil-search-section form').style.display = 'none';
                    });
                }

                if (cancelAddBtn && addProductForm) {
                    cancelAddBtn.addEventListener('click', () => {
                        addProductForm.style.display = 'none';
                        document.querySelector('.mil-button-group').style.display = 'flex';
                        document.querySelector('.mil-search-section form').style.display = 'flex';
                        addProductForm.querySelector('form').reset();
                        if (imagePreviewsContainer) {
                            for (let i = 1; i <= 4; i++) {
                                const preview = document.getElementById(`imagePreview${i}`);
                                if (preview) {
                                    preview.style.display = 'none';
                                    preview.src = '#';
                                }
                            }
                        }
                        if (imagePlaceholder) imagePlaceholder.style.display = 'flex';
                        if (productImagesInput) productImagesInput.value = '';
                    });
                }

                if (productImagesInput && imagePreviewsContainer && imagePlaceholder) {
                    productImagesInput.addEventListener('change', function(e) {
                        const files = e.target.files;
                        if (files && files.length > 0) {
                            const validFiles = Array.from(files).slice(0, 4);
                            if (validFiles.length > 0) {
                                imagePlaceholder.style.display = 'none';
                            }
                            for (let i = 0; i < 4; i++) {
                                const preview = document.getElementById(`imagePreview${i + 1}`);
                                if (i < validFiles.length) {
                                    const reader = new FileReader();
                                    reader.onload = function(event) {
                                        preview.src = event.target.result;
                                        preview.style.display = 'block';
                                    };
                                    reader.readAsDataURL(validFiles[i]);
                                } else {
                                    preview.style.display = 'none';
                                    preview.src = '#';
                                }
                            }
                        } else {
                            imagePlaceholder.style.display = 'flex';
                            for (let i = 1; i <= 4; i++) {
                                const preview = document.getElementById(`imagePreview${i}`);
                                if (preview) preview.style.display = 'none';
                            }
                        }
                    });
                }

                document.querySelectorAll('.edit-btn').forEach(button => {
                    button.addEventListener('click', () => {
                        const id = button.dataset.id;
                        toggleEdit(id);
                    });
                });

                document.querySelectorAll('.cancel-btn').forEach(button => {
                    button.addEventListener('click', () => {
                        const id = button.closest('tr').id.replace('row-', '');
                        cancelEdit(id);
                    });
                });

                document.querySelectorAll('.mil-delete-icon').forEach(icon => {
                    icon.addEventListener('click', () => {
                        const id = icon.dataset.id;
                        const name = icon.dataset.name;
                        showDeleteModal(id, name);
                    });
                });

                document.querySelectorAll('.stock-input, .cost-input, .commission-input').forEach(input => {
                    input.addEventListener('change', function() {
                        const row = this.closest('tr');
                        if (row) {
                            const id = row.id.replace('row-', '');
                            updateHiddenInputs(id);
                        }
                    });
                });

                document.querySelectorAll('.update-form').forEach(form => {
                    form.addEventListener('submit', (e) => {
                        const stockInput = form.querySelector('.stock-input');
                        const costInput = form.querySelector('.cost-input');
                        const commissionInput = form.querySelector('.commission-input');
                        if (!stockInput || !costInput || !commissionInput) return;
                        const stock = stockInput.value;
                        const cost = costInput.value;
                        const commission = commissionInput.value;
                        if (stock < 0) {
                            alert('Stock cannot be negative.');
                            e.preventDefault();
                        }
                        if (cost < 0) {
                            alert('Cost cannot be negative.');
                            e.preventDefault();
                        }
                        if (commission && (commission < 0 || commission > 100)) {
                            alert('Commission must be between 0 and 100.');
                            e.preventDefault();
                        }
                    });
                });

                if (shareStoreBtn) {
                    shareStoreBtn.addEventListener('click', shareStorefrontLink);
                }

                document.querySelectorAll('.description-cell').forEach(cell => {
                    cell.addEventListener('click', () => {
                        showDescriptionModal(cell.dataset.id, cell.dataset.description);
                    });
                });

                document.getElementById('cancelDescriptionEdit')?.addEventListener('click', hideDescriptionModal);
                document.getElementById('saveDescription')?.addEventListener('click', saveDescription);
            } catch (error) {
                console.error('Error initializing scripts:', error);
            }
        });
    </script>
    <script>
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
</body>

</html>