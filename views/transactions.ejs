<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="Transactions | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet" href="/css/custom.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Banner starts at top */
        .mil-banner {
            margin-top: 0;
            padding-top: 0;
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
        }
        /* Content padding */
        .mil-content {
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
            align-items: center;
            gap: 10px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-alert.success {
            background-color: #d4edda;
            color: #155724;
        }
        .mil-alert i {
            margin-right: 8px;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 10px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-button.search-button {
            background-color: rgb(0, 123, 255);
            color: #fff;
            width: 38px;
            height: 38px;
            padding: 0;
        }
        .mil-button.search-button:hover {
            background-color: #fff;
            color: rgb(0, 123, 255);
            border: 2px solid rgb(0, 123, 255);
        }
        .mil-button.update-btn {
            background-color: rgb(40, 167, 69);
            color: #fff;
        }
        .mil-button.update-btn:hover {
            background-color: #fff;
            color: rgb(40, 167, 69);
            border: 2px solid rgb(40, 167, 69);
        }
        .mil-button.cancel-btn {
            background-color: rgb(108, 117, 125);
            color: #fff;
        }
        .mil-button.cancel-btn:hover {
            background-color: #fff;
            color: rgb(108, 117, 125);
            border: 2px solid rgb(108, 117, 125);
        }
        .mil-button.clear-btn {
            background-color: rgb(52, 58, 64);
            color: #fff;
        }
        .mil-button.clear-btn:hover {
            background-color: #fff;
            color: rgb(52, 58, 64);
            border: 2px solid rgb(52, 58, 64);
        }
        /* Sidebar styling */
        .mil-wrapper .mil-sidebar {
            width: 250px;
            background-color: #f8f8f8 !important;
            opacity: 1 !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 20px;
            z-index: 1001;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .mil-wrapper .mil-sidebar.hidden {
            transform: translateX(-100%);
        }
        .mil-wrapper .mil-sidebar * {
            background-color: transparent !important;
            opacity: 1 !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container {
            text-align: center;
            margin-bottom: 20px;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container img {
            width: 100px;
            height: auto;
        }
        .mil-wrapper .mil-sidebar h2 {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 500;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: background 0.3s ease;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a:hover {
            background: rgb(235, 166, 17) !important;
            color: #fff;
        }
        .mil-wrapper .mil-sidebar a.active {
            background: rgb(235, 166, 17) !important;
            color: #fff;
            font-weight: bold;
        }
        /* Toggle button */
        .mil-toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            background: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 8px 12px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            z-index: 1002;
        }
        /* Main content */
        .mil-main-content {
            padding: 20px;
            transition: margin-left 0.3s ease;
            width: 100%;
            box-sizing: border-box;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .mil-main-content.full-width {
            margin-left: 0;
        }
        /* Center the main content container */
        .mil-about .container {
            display: flex;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .mil-sidebar:not(.hidden) ~ .mil-content .mil-about .container {
            margin-left: calc(250px + ((100% - 250px - 800px) / 2));
            margin-right: auto;
        }
        .mil-sidebar.hidden ~ .mil-content .mil-about .container {
            margin-left: auto;
            margin-right: auto;
        }
        /* Search section */
        .mil-search-section {
            margin-bottom: 20px;
        }
        .mil-search-section form {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        .mil-search-section .mil-form-group {
            flex: 1;
            margin-bottom: 0;
            position: relative;
        }
        .mil-search-section .mil-form-control {
            padding-right: 40px;
        }
        .mil-search-section .mil-button.search-button {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
        }
        /* Table styling */
        .mil-table-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .mil-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .mil-table th, .mil-table td {
            padding: 10px;
            border: 1px solid #dee2e6;
            text-align: left;
            color: #333;
        }
        .mil-table th {
            background-color: #e9ecef;
            color: #333;
            font-weight: 500;
        }
        .mil-table td {
            background-color: white;
        }
        /* Payment status badges */
        .mil-badge-paid {
            background-color: #28a745;
            color: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
        }
        .mil-badge-pending {
            background-color: #ffc107;
            color: #212529;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
        }
        /* Outlet indicator */
        .mil-outlet-indicator {
            font-size: 11px;
            color: #6c757d;
            display: block;
            margin-top: 3px;
        }
        /* Action buttons */
        .mil-action-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        /* Button group */
        .mil-button-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        /* Hidden class */
        .hidden {
            display: none !important;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-wrapper .mil-sidebar {
                width: 200px;
                background-color: #f8f8f8 !important;
                opacity: 1 !important;
            }
            .mil-main-content {
                margin-left: 0;
            }
            .mil-main-content.full-width {
                margin-left: 0;
            }
            .mil-form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .mil-search-section form,
            .mil-form-row {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-search-section .mil-form-control {
                margin-bottom: 40px;
            }
            .mil-button-group, .mil-action-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-button-group .mil-button,
            .mil-action-buttons .mil-button {
                width: 100%;
            }
            .mil-about .container {
                margin-left: auto;
                margin-right: auto;
                max-width: 100%;
                padding-left: 15px;
                padding-right: 15px;
            }
            .mil-table {
                font-size: 12px;
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
            .mil-table th, .mil-table td {
                padding: 8px;
                min-width: 100px;
            }
            .mil-button.search-button {
                width: 34px;
                height: 34px;
            }
        }
        @media (max-width: 576px) {
            .mil-main-content {
                padding: 10px;
                width: 95%;
                margin: 0 auto;
            }
            .mil-table th, .mil-table td {
                padding: 6px;
                min-width: 90px;
            }
        }
    </style>

    <title>Transactions</title>
</head>
<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up active"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-messages" class="mil-up"><i class="fas fa-envelope"></i> Messages</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">View </span>Transactions</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Track transactions for <%= admin.businessName || 'Your Business' %>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo" style="height: 50px; margin-bottom: 10px;">
                                        <h4 style="color: #333; font-size: 16px;">Transactions for <%= admin.businessName || 'Your Business' %></h4>
                                        <p style="color: #333; font-size: 13px;">
                                            Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Error/Success Messages -->
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-exclamation-circle"></i> <%= error %>
                                    </div>
                                <% } %>
                                <% if (success) { %>
                                    <div class="mil-alert success mil-up">
                                        <i class="fa-solid fa-check"></i> <%= success %>
                                    </div>
                                <% } %>

                                <!-- Search Section -->
                                <div class="mil-search-section mil-up">
                                    <form method="GET" action="/transactions">
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-search"></i> Search Transactions</label>
                                            <div style="position: relative; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                                                <div style="position: relative; flex: 1;">
                                                    <input type="text" name="search" class="mil-form-control" placeholder="Search by customer or item" value="<%= search || '' %>">
                                                    <button type="submit" class="mil-button search-button">
                                                        <i class="fa-solid fa-search"></i>
                                                    </button>
                                                </div>
                                                <% if (search) { %>
                                                    <a href="/transactions" class="mil-button clear-btn">
                                                        Clear <i class="fa-solid fa-times"></i>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                                <!-- Date Filter Section -->
                                <div class="mil-search-section mil-up hidden" id="dateFilterSection">
                                    <form method="GET" action="/transactions">
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-calendar"></i> Filter by Date Range</label>
                                            <div class="mil-form-row">
                                                <div class="mil-form-col">
                                                    <input type="date" name="startDate" class="mil-form-control" value="<%= startDate || '' %>">
                                                </div>
                                                <span>to</span>
                                                <div class="mil-form-col">
                                                    <input type="date" name="endDate" class="mil-form-control" value="<%= endDate || '' %>">
                                                </div>
                                                <button type="submit" class="mil-button">
                                                    Apply <i class="fa-solid fa-filter"></i>
                                                </button>
                                                <a href="/transactions" class="mil-button cancel-btn">
                                                    Reset <i class="fa-solid fa-sync-alt"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                                <!-- Toggle Filter Button -->
                                <div class="mil-button-group">
                                    <button id="toggleFilterBtn" class="mil-button">
                                        <i class="fa-solid fa-filter"></i> Date Filter
                                    </button>
                                </div>

                                <!-- Table Section -->
                                <div class="mil-table-section mil-up">
                                    <h2 class="mil-mb-30">Transaction History</h2>
                                    <% if (transactions && transactions.length > 0) { %>
                                        <table class="mil-table">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Customer</th>
                                                    <th>Items</th>
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                    <th>Source</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% transactions.forEach(transaction => { %>
                                                    <tr>
                                                        <td><%= new Date(transaction.date).toLocaleString() %></td>
                                                        <td><%= transaction.customerName || 'Walk-in' %></td>
                                                        <td>
                                                            <% if (transaction.items && transaction.items.length > 0) { %>
                                                                <ul style="padding-left: 15px; margin: 0;">
                                                                    <% transaction.items.forEach(item => { %>
                                                                        <li><%= item.itemName %> (Qty: <%= item.quantity %>)</li>
                                                                    <% }) %>
                                                                </ul>
                                                            <% } else { %>
                                                                <%= transaction.itemName || 'N/A' %> (Qty: <%= transaction.quantity || 1 %>)
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <%= admin.currency %><%= formatCurrency(transaction.totalAmount || (transaction.cost * transaction.quantity)) %>
                                                        </td>
                                                        <td>
                                                            <% if (transaction.paymentStatus === 'Paid') { %>
                                                                <span class="mil-badge-paid">Paid</span>
                                                            <% } else { %>
                                                                <span class="mil-badge-pending">Pending</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (transaction.outletName) { %>
                                                                <%= transaction.outletName %>
                                                                <span class="mil-outlet-indicator">Outlet</span>
                                                            <% } else { %>
                                                                Main Store
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <div class="mil-action-buttons">
                                                                <a href="/receipt/<%= transaction._id %>" class="mil-button">
                                                                    <i class="fa-solid fa-receipt"></i> Receipt
                                                                </a>
                                                                <% if (transaction.paymentStatus !== 'Paid') { %>
                                                                    <form action="/transactions/mark-paid/<%= transaction._id %>" method="POST" class="action-form">
                                                                        <button type="submit" class="mil-button update-btn">
                                                                            <i class="fa-solid fa-check"></i> Paid
                                                                        </button>
                                                                    </form>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    <% } else { %>
                                        <p style="text-align: center; color: #333;">No transactions found.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- footer -->
        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container mil-p-120-60">
                    <div class="row justify-content-between">
                        <div class="col-md-4 col-lg-4 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-md-7 col-lg-6">
                            <div class="row justify-content-end">
                                <div class="col-md-6 col-lg-9">
                                    <div class="mil-vert-between">
                                        <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- footer end -->

