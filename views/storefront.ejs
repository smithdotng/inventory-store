    <script>
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        const currency = '<%= currency %>';

        function saveCart() {
            localStorage.setItem('cart', JSON.stringify(cart));
        }

        function formatCurrency(value) {
            return parseFloat(value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        }

        function addToCart(itemId, itemName, itemCost, maxStock, button) {
            try {
                const decodedItemId = decodeURIComponent(itemId);
                console.log('addToCart called:', { itemId: decodedItemId, itemName, itemCost, maxStock });

                if (!decodedItemId) {
                    console.error('Error: decodedItemId is empty or invalid');
                    alert('Error: Invalid item ID. Please try again.');
                    return;
                }

                if (isNaN(itemCost) || itemCost < 0) {
                    console.error('Error: Invalid itemCost:', itemCost);
                    alert('Error: Invalid item cost. Please try again.');
                    return;
                }

                if (isNaN(maxStock) || maxStock < 0) {
                    console.error('Error: Invalid maxStock:', maxStock);
                    alert('Error: Invalid stock value. Please try again.');
                    return;
                }

                const quantityInput = document.querySelector(`.mil-inventory-item[data-item-id="${CSS.escape(decodedItemId)}"] .mil-quantity-input`);
                if (!quantityInput) {
                    console.error(`Error: Quantity input not found for itemId=${decodedItemId}`);
                    alert('Error: Could not find quantity input. Please try again.');
                    return;
                }

                const quantity = parseInt(quantityInput.value);
                if (isNaN(quantity) || quantity <= 0 || quantity > maxStock) {
                    console.error('Error: Invalid quantity', { quantity, maxStock });
                    alert('Please enter a valid quantity within available stock.');
                    return;
                }

                const existingItemIndex = cart.findIndex(item => item.id === decodedItemId);
                if (existingItemIndex !== -1) {
                    cart.splice(existingItemIndex, 1);
                    button.classList.remove('mil-added');
                    button.innerHTML = '<i class="fas fa-cart-plus mil-mr-5"></i> Add to Cart';
                    button.style.backgroundColor = '';
                } else {
                    cart.push({
                        id: decodedItemId,
                        name: itemName,
                        cost: Number(itemCost),
                        quantity: quantity,
                        image: document.querySelector(`.mil-inventory-item[data-item-id="${CSS.escape(decodedItemId)}"] .mil-product-image`)?.src || ''
                    });
                    button.classList.add('mil-added');
                    button.innerHTML = '<i class="fas fa-trash mil-mr-5"></i> Remove from Cart';
                    button.style.backgroundColor = '#dc3545';
                }
                saveCart();
                updateCartCount();
                updateCartSummary();
            } catch (error) {
                console.error('Error in addToCart:', error.message, error.stack);
                alert('Error adding item to cart: ' + error.message);
            }
        }

        function removeFromCart(itemId) {
            cart = cart.filter(item => item.id !== itemId);
            saveCart();
            updateCartCount();
            updateCartSummary();
            initializeButtonStates();
            if (cart.length === 0) {
                hideCheckoutForm();
                alert('Your cart is now empty.');
            }
        }

        function updateCartCount() {
            const cartLabel = document.getElementById('cartLabel');
            const cartCount = document.getElementById('cartCount');
            const itemCount = cart.reduce((total, item) => total + item.quantity, 0);
            const totalValue = cart.reduce((total, item) => total + item.cost * item.quantity, 0);

            cartCount.textContent = `${currency}${formatCurrency(totalValue)} (${itemCount} item${itemCount !== 1 ? 's' : ''})`;
            cartLabel.textContent = itemCount > 0 ? 'Checkout' : 'Cart';
        }

        function updateCartSummary() {
            const cartSummaryBody = document.getElementById('cartSummaryBody');
            const cartTotal = document.getElementById('cartTotal');
            if (!cartSummaryBody || !cartTotal) return;

            cartSummaryBody.innerHTML = cart.map(item => `
                <tr>
                    <td>${item.name}</td>
                    <td>${item.quantity}</td>
                    <td>${currency}${formatCurrency(item.cost)}</td>
                    <td>${currency}${formatCurrency(item.cost * item.quantity)}</td>
                    <td><button class="mil-delete-item" onclick="removeFromCart('${item.id}')"><i class="fas fa-trash"></i></button></td>
                </tr>
            `).join('');

            const totalValue = cart.reduce((total, item) => total + item.cost * item.quantity, 0);
            cartTotal.textContent = `Total: ${currency}${formatCurrency(totalValue)}`;
        }

        function initializeButtonStates() {
            document.querySelectorAll('.mil-inventory-item').forEach(item => {
                const itemId = item.dataset.itemId;
                const button = item.querySelector('.mil-add-to-cart');
                if (cart.some(cartItem => cartItem.id === itemId)) {
                    button.classList.add('mil-added');
                    button.innerHTML = '<i class="fas fa-trash mil-mr-5"></i> Remove from Cart';
                    button.style.backgroundColor = '#dc3545';
                } else {
                    button.classList.remove('mil-added');
                    button.innerHTML = '<i class="fas fa-cart-plus mil-mr-5"></i> Add to Cart';
                    button.style.backgroundColor = '';
                }
            });
        }

        function scrollToStore() {
            const storeSection = document.getElementById('store');
            if (storeSection && typeof gsap !== 'undefined') {
                gsap.to(window, {
                    duration: 1,
                    scrollTo: {y: storeSection, offsetY: 80},
                    ease: 'power2.out'
                });
            } else {
                window.scrollTo({top: storeSection?.offsetTop - 80, behavior: 'smooth'});
            }
        }

        function showCheckoutForm() {
            if (cart.length === 0) {
                alert('Please add items to your cart before checking out.');
                return;
            }
            const cartItemsInput = document.getElementById('cartItems');
            try {
                if (!Array.isArray(cart) || !cart.every(item => item.id && item.name && item.cost && item.quantity)) {
                    throw new Error('Invalid cart structure');
                }
                cartItemsInput.value = JSON.stringify(cart);
            } catch (err) {
                console.error('Error stringifying cart:', err);
                alert('Error preparing cart data. Please try again.');
                return;
            }
            updateCartSummary();
            document.getElementById('overlay').style.display = 'block';
            document.getElementById('checkoutForm').style.display = 'block';
        }

        function hideCheckoutForm() {
            document.getElementById('overlay').style.display = 'none';
            document.getElementById('checkoutForm').style.display = 'none';
        }

        function searchInventory() {
            const input = document.getElementById('inventorySearchInput').value.toLowerCase();
            const grid = document.getElementById('inventoryGrid');
            const items = grid.getElementsByClassName('mil-inventory-item');

            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const name = item.querySelector('.mil-product-title').textContent.toLowerCase();
                const match = name.includes(input);
                item.style.display = match ? '' : 'none';
            }
        }

        function searchOrderTable() {
            const input = document.getElementById('orderSearchInput').value.toLowerCase();
            const table = document.getElementById('orderTable');
            const rows = table.getElementsByTagName('tr');

            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName('td');
                let match = false;

                for (let j = 0; j < cells.length; j++) {
                    if (cells[j].textContent.toLowerCase().includes(input)) {
                        match = true;
                        break;
                    }
                }

                row.style.display = match ? '' : 'none';
            }
        }

        document.getElementById('checkoutFormSubmit').addEventListener('submit', async (e) => {
            e.preventDefault();

            const customerName = document.getElementById('customerName').value.trim();
            const phoneNumber = document.getElementById('phoneNumber').value.trim();
            const email = document.getElementById('email').value.trim();
            const cartItemsInput = document.getElementById('cartItems');

            if (!customerName || !phoneNumber || !email) {
                alert('Please fill in all required fields.');
                return;
            }

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                alert('Please enter a valid email address.');
                return;
            }

            if (!/[\d]{6,}/.test(phoneNumber)) {
                alert('Please enter a valid phone number.');
                return;
            }

            if (cart.length === 0) {
                alert('Your cart is empty. Please add items before checking out.');
                return;
            }

            const submitBtn = e.target.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mil-mr-5"></i> Processing...';

            try {
                const payload = {
                    customerName,
                    phoneNumber,
                    email,
                    cartItems: cartItemsInput.value
                };

                const response = await fetch(e.target.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.error || `HTTP error! Status: ${response.status}`);
                }

                if (result.success && result.invoiceUrl) {
                    cart = [];
                    saveCart();
                    updateCartCount();
                    initializeButtonStates();
                    updateCartSummary();
                    window.location.href = result.invoiceUrl;
                } else {
                    throw new Error(result.error || 'Invalid server response');
                }
            } catch (error) {
                console.error('Checkout error:', error.message, error.stack);
                alert(`Error submitting order: ${error.message}. Please try again or contact support.`);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check mil-mr-5"></i> Submit Order';
            }
        });

        window.addEventListener('load', () => {
            updateCartCount();
            initializeButtonStates();
            updateCartSummary();
        });

        if (window.location.search.includes('checkout_success=true')) {
            setTimeout(() => {
                alert('Your order has been placed successfully!');
                cart = [];
                saveCart();
                updateCartCount();
                initializeButtonStates();
                updateCartSummary();
                history.replaceState(null, '', window.location.pathname);
            }, 500);
        }

        document.getElementById('inventorySearchInput')?.addEventListener('input', searchInventory);
        document.getElementById('orderSearchInput')?.addEventListener('input', searchOrderTable);

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof gsap !== 'undefined') {
                gsap.set(['.mil-search-input', '.mil-quantity-input', '.mil-form-control'], {
                    textTransform: 'none',
                    clearProps: 'textTransform'
                });
                gsap.set('footer.mil-dark-bg', {
                    opacity: 1,
                    display: 'block',
                    visibility: 'visible',
                    clearProps: 'all'
                });
                console.log('Storefront GSAP reset applied');
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const subscribeForm = document.getElementById('subscribeForm');
            const errorDiv = document.querySelector('.mil-subscribe-error');
            const successDiv = document.querySelector('.mil-subscribe-success');
            const formContainer = document.querySelector('.mil-subscribe-container');

            if (!subscribeForm || !errorDiv || !successDiv || !formContainer) {
                console.warn('Subscription form elements not found');
                return;
            }

            subscribeForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = subscribeForm.querySelector('input[name="email"]').value.trim();

                errorDiv.style.display = 'none';
                errorDiv.textContent = '';
                successDiv.style.display = 'none';

                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errorDiv.textContent = 'Please enter a valid email address';
                    errorDiv.style.display = 'block';
                    return;
                }

                try {
                    const response = await fetch('/api/subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({email})
                    });

                    const data = await response.json();

                    if (response.ok) {
                        subscribeForm.style.display = 'none';
                        successDiv.style.display = 'block';
                        if (typeof gsap !== 'undefined') {
                            gsap.fromTo(successDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                        }
                        subscribeForm.reset();
                    } else {
                        errorDiv.textContent = data.message || 'Subscription failed. Please try again.';
                        errorDiv.style.display = 'block';
                        if (typeof gsap !== 'undefined') {
                            gsap.fromTo(errorDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                        }
                    }
                } catch (error) {
                    console.error('Subscription error:', error.message);
                    let errorMessage = 'Network error. Please try again.';
                    if (error.message.includes('Failed to fetch')) {
                        errorMessage = 'Unable to reach server. Check /api/subscribe endpoint.';
                    }
                    errorDiv.textContent = errorMessage;
                    errorDiv.style.display = 'block';
                    if (typeof gsap !== 'undefined') {
                        gsap.fromTo(errorDiv, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
                    }
                }
            });
        });
    </script>
</body>
</html>