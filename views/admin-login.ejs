<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GJRGT3KCZ7');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="https://img.shed.ng/status.jpg" />
    <title>Admin Login - Shed</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Now UI Kit CSS -->
    <link href="assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="assets/css/now-ui-dashboard.css" rel="stylesheet" />
    <link href="assets/css/bootstrap.min.css.map" rel="stylesheet" />
    <link href="assets/css/now-ui-dashboard.min.css" rel="stylesheet" />
    
    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <style>
        body {
            background-image: url('images/bg.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            position: relative;
            min-height: 100vh;
            font-size: 14px;
            margin: 0;
        }
        
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: -1;
        }
        
        .main-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: stretch;
            min-height: 100vh;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .image-container {
            flex: 0 0 40%;
            max-width: 400px;
            background-color: #ffffff;
            border-radius: 10px 0 0 10px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        
        .registration-container {
            flex: 0 0 60%;
            max-width: 600px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .registration-card {
            width: 100%;
            border-radius: 0 10px 10px 0;
            box-shadow: 0 10px 25px 0 rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
            background-color: darkcyan;
            border: 1px solid #e0e0e0;
        }
        
        .logo-container {
            text-align: center;
            margin-bottom: 15px;
            padding-top: 15px;
        }
        
        .logo-container img {
            height: 50px;
            margin-bottom: 10px;
            max-width: 100%;
        }
        
        .card-body {
            padding: 20px;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            color: white;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        
        .form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
        }
        
        .login-link {
            text-align: center;
            margin-top: 15px;
            color: #6c757d;
            font-size: 13px;
        }
        
        .login-link a {
            color: rgb(224, 235, 17);
            font-weight: 500;
            text-decoration: none;
            font-size: 13px;
        }
        
        .btn-create-account {
            background-color: rgb(224, 235, 17);
            width: 100%;
            max-width: 300px;
            transition: all 0.3s ease;
            border: none;
            font-weight: 500;
            font-size: 14px;
            padding: 10px 20px;
        }
        
        /* Responsive Design */
        @media (max-width: 992px) {
            .main-container {
                flex-direction: column;
                align-items: center;
            }
            
            .image-container {
                flex: 0 0 100%;
                max-width: 100%;
                height: 200px;
                border-radius: 10px 10px 0 0;
                margin-bottom: 20px;
            }
            
            .registration-container {
                flex: 0 0 100%;
                max-width: 100%;
            }
            
            .registration-card {
                border-radius: 0 0 10px 10px;
            }
        }

        @media (max-width: 768px) {
            .form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            
            .form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            
            .btn-create-account {
                font-size: 13px;
                padding: 8px 16px;
            }
            
            .login-link {
                font-size: 12px;
            }
        }

        @media (max-width: 576px) {
            .main-container {
              padding: 10px;
              width: 80%;
              min-width: 80%;
              margin: 0 auto;
            }
            
            .image-container {
                height: 150px;
            }
            
            .registration-container {
                padding: 10px;
            }
            
            .card-body {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="main-container">
        
        <div class="registration-container">
            <div class="card registration-card">
                <div class="card-body">
                    <div class="logo-container">
                        <img src="images/logo-a.png" alt="Shed Logo">
                        <h4 style="color: white; font-size: 16px;">Login to your Shed</h4>
                    </div>
                    
                    <% if (error) { %>
                        <div class="alert alert-danger" style="font-size: 13px;">
                            <div class="container">
                                <div class="alert-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </div>
                                <%= error %>
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">
                                        <i class="fa-solid fa-xmark"></i>
                                    </span>
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <form id="loginForm" action="/admin-login" method="POST">
                        <div class="form-group">
                            <label>Username or Email <i class="fa-solid fa-user"></i></label>
                            <input type="text" class="form-control" id="usernameOrEmail" name="usernameOrEmail" placeholder="Enter username or email..." required>
                        </div>
                        
                        <div class="form-group">
                            <label>Password <i class="fa-solid fa-lock"></i></label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Enter password..." required>
                        </div>
                        
                        <div class="form-group" style="text-align: center; margin-top: 15px;">
                            <button type="submit" class="btn btn-round btn-lg btn-create-account">
                                Login <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            </button>
                        </div>
                    </form>
                    
                    <div class="login-link">
                        <span style="color: white;">New? </span><a href="/admin-register">Create your Shed!</a><br>
                        <span style="color: white;">Forgot password? </span><a href="/forgot-password">Reset here</a><br>
                        <span style="color: white;">Outlet account? </span><a href="/outlet-login">Outlet Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Now UI Kit JS -->
    <script src="assets/js/core/jquery.min.js"></script>
    <script src="assets/js/core/popper.min.js"></script>
    <script src="assets/js/core/bootstrap.min.js"></script>
    <script src="assets/js/now-ui-dashboard.js"></script>
    <script src="assets/js/now-ui-dashboard.js.map"></script>
    <script src="assets/js/now-ui-dashboard.min.js"></script>
    <script src="assets/js/bootstrap.min.js.map"></script>

    <script>
        // Service worker registration
        if (typeof navigator.serviceWorker !== 'undefined') {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
</body>
</html>