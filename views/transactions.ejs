    <!-- Sidebar Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                const toggleBtn = document.getElementById('toggleBtn');

                const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
                if (isSidebarHidden) {
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                } else {
                    sidebar.classList.remove('hidden');
                    mainContent.classList.remove('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
                }

                toggleBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('hidden');
                    mainContent.classList.toggle('full-width');
                    toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                    localStorage.setItem('sidebarHidden', sidebar.classList.contains('hidden'));
                });

                function setSidebarState() {
                    if (sidebar.classList.contains('hidden')) {
                        mainContent.classList.add('full-width');
                    } else {
                        mainContent.classList.remove('full-width');
                    }
                }
                setSidebarState();
                window.addEventListener('resize', setSidebarState);
            } catch (error) {
                console.error('Error initializing sidebar:', error);
            }
        });
    </script>

    <!-- Transaction Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const toggleFilterBtn = document.getElementById('toggleFilterBtn');
                const dateFilterSection = document.getElementById('dateFilterSection');

                // Toggle date filter section
                if (toggleFilterBtn && dateFilterSection) {
                    toggleFilterBtn.addEventListener('click', () => {
                        if (dateFilterSection.classList.contains('hidden')) {
                            dateFilterSection.classList.remove('hidden');
                            toggleFilterBtn.innerHTML = '<i class="fa-solid fa-times"></i> Close Filter';
                            toggleFilterBtn.classList.add('cancel-btn');
                            toggleFilterBtn.classList.remove('mil-button');
                        } else {
                            dateFilterSection.classList.add('hidden');
                            toggleFilterBtn.innerHTML = '<i class="fa-solid fa-filter"></i> Date Filter';
                            toggleFilterBtn.classList.remove('cancel-btn');
                            toggleFilterBtn.classList.add('mil-button');
                        }
                    });
                }

                // Handle "Mark as Paid" form submission
                document.querySelectorAll('.action-form').forEach(form => {
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        const transactionId = form.action.split('/').pop();
                        try {
                            const response = await fetch(form.action, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            });
                            if (response.ok) {
                                const row = form.closest('tr');
                                row.querySelector('.mil-badge-pending')?.classList.replace('mil-badge-pending', 'mil-badge-paid');
                                row.querySelector('.mil-badge-paid').textContent = 'Paid';
                                form.remove();
                            } else {
                                alert('Failed to mark transaction as paid.');
                            }
                        } catch (error) {
                            console.error('Error marking transaction as paid:', error);
                            alert('An error occurred while marking the transaction as paid.');
                        }
                    });
                });
            } catch (error) {
                console.error('Error initializing transaction scripts:', error);
            }
        });
    </script>
