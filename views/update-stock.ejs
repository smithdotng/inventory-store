    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/custom.css">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <title>Shed | Update Stock</title>
</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up active"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-messages" class="mil-up"><i class="fas fa-envelope"></i> Messages</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Update </span>Stock</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Manage your inventory for <%= admin.businessName || 'Your Business' %>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo">
                                        <h4>Update Stock for <%= admin.businessName || 'Your Business' %></h4>
                                        <p>
                                            Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                        </p>
                                        <p>
                                            Store URL: <a href="<%= storeUrl %>" target="_blank"><%= storeUrl %></a>
                                        </p>
                                    </div>
                                </div>

                                <!-- Error/Success Messages -->
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-bell"></i> <%= error %>
                                    </div>
                                <% } %>
                                <% if (success) { %>
                                    <div class="mil-alert success mil-up">
                                        <i class="fa-solid fa-check"></i> <%= success %>
                                    </div>
                                <% } %>

                                <!-- Search Section -->
                                <div class="mil-search-section mil-up">
                                    <form method="GET" action="/update-stock">
                                        <div class="mil-form-group">
                                            <label>Search Products <i class="fa-solid fa-search"></i></label>
                                            <div>
                                                <div>
                                                    <input type="text" name="search" class="mil-form-control" placeholder="Search by product name" value="<%= search || '' %>">
                                                    <button type="submit" class="mil-button search-button">
                                                        <i class="fa-solid fa-search"></i>
                                                    </button>
                                                </div>
                                                <% if (search) { %>
                                                    <a href="/update-stock" class="mil-button clear-btn">
                                                        Clear <i class="fa-solid fa-times"></i>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                                <!-- Form Section (Hidden by Default) -->
                                <div class="mil-form-section mil-up" id="addProductForm" style="display: none;">
                                    <h2 class="mil-mb-30">Add New Product</h2>
                                    <form action="/add-product" method="POST" enctype="multipart/form-data">
                                        <div class="mil-form-group">
                                            <label>Product Name <i class="fa-solid fa-box"></i></label>
                                            <input type="text" name="name" class="mil-form-control" placeholder="Product Name" required>
                                        </div>
                                        <div class="mil-form-group">
                                            <label>Description (max 400 characters) <i class="fa-solid fa-info-circle"></i></label>
                                            <textarea name="description" class="mil-form-control description-input" placeholder="Product description" maxlength="400"></textarea>
                                        </div>
                                        <div class="mil-form-group">
                                            <label>Product Images (up to 4) <i class="fa-solid fa-camera"></i></label>
                                            <div class="image-preview-container">
                                                <div class="image-placeholder" id="imagePlaceholder">
                                                    <span>No images selected</span>
                                                </div>
                                                <div class="image-previews" id="imagePreviews">
                                                    <img id="imagePreview1" class="image-preview" src="#" alt="Product Preview 1">
                                                    <img id="imagePreview2" class="image-preview" src="#" alt="Product Preview 2">
                                                    <img id="imagePreview3" class="image-preview" src="#" alt="Product Preview 3">
                                                    <img id="imagePreview4" class="image-preview" src="#" alt="Product Preview 4">
                                                </div>
                                                <input type="file" name="productImages" id="productImages" class="d-none" accept="image/*" multiple>
                                                <button type="button" class="mil-button image-upload-btn" onclick="document.getElementById('productImages').click()">
                                                    Choose Images <i class="fa-solid fa-upload"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label>Initial Stock <i class="fa-solid fa-cubes"></i></label>
                                            <input type="number" name="stock" class="mil-form-control" placeholder="Initial Stock" min="0" required>
                                        </div>
                                        <div class="mil-form-group">
                                            <label>Cost <i class="fa-solid fa-money-bill"></i></label>
                                            <input type="number" name="cost" class="mil-form-control" placeholder="Cost" min="0" step="0.01" required>
                                        </div>
                                        <div class="mil-form-group">
                                            <label>Commission % <i class="fa-solid fa-percentage"></i></label>
                                            <input type="number" name="commission" class="mil-form-control" placeholder="Commission %" min="0" max="100" step="0.01">
                                        </div>
                                        <div class="mil-form-row mil-center">
                                            <button type="submit" class="mil-button add-product-btn">
                                                Add Product <i class="fa-solid fa-plus"></i>
                                            </button>
                                            <button type="button" id="cancelAddBtn" class="mil-button cancel-btn">
                                                Cancel <i class="fa-solid fa-times"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <!-- Add Product and Share Storefront Buttons -->
                                <div class="mil-button-group mil-up">
                                    <button id="addProductBtn" class="mil-button add-product-btn">
                                        Add Product <i class="fa-solid fa-plus"></i>
                                    </button>
                                    <button id="shareStoreBtn" class="mil-button share-store-btn">
                                        Invite Customers to your Store <i class="fa-solid fa-share-alt"></i>
                                    </button>
                                </div>

                                <!-- Table Section -->
                                <div class="mil-table-section mil-up">
                                    <% if (inventory && inventory.length > 0) { %>
                                        <h2 class="mil-mb-30">Inventory</h2>
                                        <table style="min-width: 1000px;">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Description</th>
                                                    <th>Images</th>
                                                    <th>Stock</th>
                                                    <th>Cost</th>
                                                    <th>Commission</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% inventory.forEach(item => { %>
                                                    <tr id="row-<%= item._id %>">
                                                        <td><%= item.name || 'N/A' %></td>
                                                        <td class="description-cell" data-id="<%= item._id %>" data-description="<%= item.description || '' %>">
                                                            <%= item.description ? (item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description) : 'N/A' %>
                                                        </td>
                                                        <td>
                                                            <% if (item.images && item.images.length > 0) { %>
                                                                <% item.images.forEach(image => { %>
                                                                    <img src="<%= image %>" class="product-thumbnail" alt="<%= item.name || 'Product' %>">
                                                                <% }) %>
                                                            <% } else { %>
                                                                No images
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <input type="number" class="mil-form-control stock-input" value="<%= item.stock %>" min="0" disabled>
                                                        </td>
                                                        <td>
                                                            <span class="cost-display"><%= admin.currency || '' %><%= formatCurrency(item.cost) %></span>
                                                            <input type="number" class="mil-form-control cost-input" value="<%= item.cost %>" min="0" step="0.01" disabled style="display: none;">
                                                        </td>
                                                        <td>
                                                            <span class="commission-display"><%= item.commission || '0' %>%</span>
                                                            <input type="number" class="mil-form-control commission-input" value="<%= item.commission || '0' %>" min="0" max="100" step="0.01" disabled style="display: none;">
                                                        </td>
                                                        <td>
                                                            <div class="mil-form-row">
                                                                <button class="mil-button edit-btn" data-id="<%= item._id %>" aria-label="Edit <%= item.name || 'Item' %>">
                                                                    Edit <i class="fa-solid fa-edit"></i>
                                                                </button>
                                                                <form action="/update-stock" method="POST" class="update-form">
                                                                    <input type="hidden" name="_id" value="<%= item._id %>">
                                                                    <input type="hidden" name="stock" class="hidden-stock">
                                                                    <input type="hidden" name="cost" class="hidden-cost">
                                                                    <input type="hidden" name="commission" class="hidden-commission">
                                                                    <input type="hidden" name="search" value="<%= search || '' %>">
                                                                    <button type="submit" class="mil-button update-btn" style="display: none;" aria-label="Update <%= item.name || 'Item' %>">
                                                                        Update <i class="fa-solid fa-check"></i>
                                                                    </button>
                                                                    <button type="button" class="mil-button cancel-btn" style="display: none;" data-stock="<%= item.stock %>" data-cost="<%= item.cost %>" data-commission="<%= item.commission || '0' %>" aria-label="Cancel editing <%= item.name || 'Item' %>">
                                                                        Cancel <i class="fa-solid fa-times"></i>
                                                                    </button>
                                                                </form>
                                                                <i class="fa-solid fa-trash mil-delete-icon" data-id="<%= item._id %>" data-name="<%= item.name ? item.name.replace(/'/g, "\\'") : 'Item' %>" aria-label="Delete <%= item.name || 'Item' %>"></i>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    <% } else { %>
                                        <p class="mil-center">No inventory items found.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- Description Modal -->
        <div id="descriptionModal" class="mil-modal">
            <div class="mil-modal-content">
                <h5>Edit Description</h5>
                <div class="mil-description-modal">
                    <textarea id="descriptionTextarea" class="mil-form-control" maxlength="400"></textarea>
                </div>
                <div class="mil-modal-buttons">
                    <button type="button" class="mil-button cancel-btn" id="cancelDescriptionEdit">
                        Cancel <i class="fa-solid fa-times"></i>
                    </button>
                    <button type="button" class="mil-button update-btn" id="saveDescription">
                        Save <i class="fa-solid fa-check"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- footer -->
        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container mil-p-120-60">
                    <div class="row justify-content-between">
                        <div class="col-md-4 col-lg-4 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-md-7 col-lg-6">
                            <div class="row justify-content-end">
                                <div class="col-md-6 col-lg-9">
                                    <div class="mil-vert-between">
                                        <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
