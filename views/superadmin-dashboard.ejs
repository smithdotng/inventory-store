<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Superadmin Dashboard | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Superadmin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
  </head>
  <body>
    <div class="sidebar" id="sidebar">
      <div class="logo-container">
        <img src="/images/logo.png" alt="Shedfactory Business Solutions">
      </div>
      <h2>Welcome, Superadmin!</h2>
      <a href="/superadmin/dashboard">Dashboard</a>
      <a href="/superadmin/create-admin">Create Admin</a>
      <a href="/admin-logout">Log Out</a>
    </div>

    <button class="toggle-btn" id="toggleBtn">☰</button>

    <div class="main-content" id="mainContent">
      <div class="container">
        <div class="content-logo-container">
          <img src="/images/logo.jpg" alt="Shedfactory Business Solutions">
        </div>
        <h1>Superadmin Dashboard</h1>

        <div class="table-section">
          <table>
            <thead>
              <tr>
                <th>Username</th>
                <th>Business Name</th>
                <th>Email</th>
                <th>Currency</th>
                <th>Role</th>
                <th>Has Logged In?</th>
                <th>Login Count</th>
                <th>Last Login</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% admins.forEach(admin => { %>
                <tr id="row-<%= admin._id %>">
                  <td><%= admin.username %></td>
                  <td>
                    <span class="display-value"><%= admin.businessName || 'N/A' %></span>
                    <input type="text" class="edit-input" name="businessName" value="<%= admin.businessName || '' %>" style="display: none;">
                  </td>
                  <td><%= admin.email || 'N/A' %></td>
                  <td>
                    <span class="display-value"><%= admin.currency || 'N/A' %></span>
                    <input type="text" class="edit-input" name="currency" value="<%= admin.currency || '' %>" style="display: none;">
                  </td>
                  <td>
                    <span class="display-value"><%= admin.role %></span>
                    <select class="edit-input" name="role" style="display: none;">
                      <option value="admin" <%= admin.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      <option value="superadmin" <%= admin.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
                    </select>
                  </td>
                  <td><%= admin.hasLoggedIn ? 'Yes' : 'No' %></td>
                  <td><%= admin.loginCount %></td>
                  <td><%= admin.lastLogin ? new Date(admin.lastLogin).toLocaleString() : 'Never' %></td>
                  <td>
                    <button class="edit-btn" onclick="toggleEdit('<%= admin._id %>')">Edit</button>
                    <form action="/superadmin/update-admin/<%= admin._id %>" method="POST" class="update-form" style="display: inline;">
                      <input type="hidden" name="businessName" value="<%= admin.businessName || '' %>">
                      <input type="hidden" name="currency" value="<%= admin.currency || '' %>">
                      <input type="hidden" name="role" value="<%= admin.role %>">
                      <button type="submit" class="update-btn" style="display: none;">Update</button>
                    </form>
                    <button class="cancel-btn" style="display: none;" onclick="cancelEdit('<%= admin._id %>', '<%= admin.businessName || 'N/A' %>', '<%= admin.currency || 'N/A' %>', '<%= admin.role %>')">Cancel</button>
                    <form action="/superadmin/reset-password/<%= admin._id %>" method="POST" style="display: inline;">
                      <button type="submit" class="reset-btn">Reset Password</button>
                    </form>
                    <% if (admin._id.toString() !== currentAdminId) { %>
                      <form action="/superadmin/delete-admin/<%= admin._id.toString() %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete <%= admin.username %>?');">
                        <button type="submit" class="delete-btn">Delete</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <a href="/superadmin/create-admin" class="create-btn">Create New Admin</a>
      </div>
    </div>

    <script>
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('mainContent');
      const toggleBtn = document.getElementById('toggleBtn');

      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
        sidebar.classList.toggle('hidden');
        mainContent.style.marginLeft = sidebar.classList.contains('visible') ? '200px' : '0';
        mainContent.style.width = sidebar.classList.contains('visible') ? 'calc(100% - 200px)' : '100%';
      });

      function setSidebarState() {
        if (window.innerWidth <= 768) {
          sidebar.classList.add('hidden');
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        } else {
          sidebar.classList.remove('hidden');
          sidebar.classList.remove('visible');
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        }
      }
      setSidebarState();
      window.addEventListener('resize', setSidebarState);

      function toggleEdit(id) {
        const row = document.getElementById(`row-${id}`);
        const displayValues = row.querySelectorAll('.display-value');
        const editInputs = row.querySelectorAll('.edit-input');
        const editBtn = row.querySelector('.edit-btn');
        const updateBtn = row.querySelector('.update-btn');
        const cancelBtn = row.querySelector('.cancel-btn');

        displayValues.forEach(span => span.style.display = 'none');
        editInputs.forEach(input => input.style.display = 'inline');
        editBtn.style.display = 'none';
        updateBtn.style.display = 'inline';
        cancelBtn.style.display = 'inline';
      }

      function cancelEdit(id, originalBusinessName, originalCurrency, originalRole) {
        const row = document.getElementById(`row-${id}`);
        const displayValues = row.querySelectorAll('.display-value');
        const editInputs = row.querySelectorAll('.edit-input');
        const editBtn = row.querySelector('.edit-btn');
        const updateBtn = row.querySelector('.update-btn');
        const cancelBtn = row.querySelector('.cancel-btn');

        displayValues[0].textContent = originalBusinessName;
        displayValues[1].textContent = originalCurrency;
        displayValues[2].textContent = originalRole;
        editInputs[0].value = originalBusinessName === 'N/A' ? '' : originalBusinessName;
        editInputs[1].value = originalCurrency === 'N/A' ? '' : originalCurrency;
        editInputs[2].value = originalRole;

        displayValues.forEach(span => span.style.display = 'inline');
        editInputs.forEach(input => input.style.display = 'none');
        editBtn.style.display = 'inline';
        updateBtn.style.display = 'none';
        cancelBtn.style.display = 'none';
      }

      document.querySelectorAll('.update-form').forEach(form => {
        form.addEventListener('submit', (e) => {
          const id = form.action.split('/').pop();
          const row = document.getElementById(`row-${id}`);
          const inputs = row.querySelectorAll('.edit-input');
          const hiddenInputs = form.querySelectorAll('input[type="hidden"]');
          inputs.forEach((input, index) => hiddenInputs[index].value = input.value);
        });
      });
    </script>
  </body>
</html>