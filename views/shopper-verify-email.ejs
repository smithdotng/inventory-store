<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Verify Your Email</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; font-family: 'Jost', sans-serif; }
    body { display: flex !important; min-height: 100vh; background: #0d0d1a !important; color: #333 !important; }

    .auth-left {
      width: 38%; background: #0d0d1a; display: flex; flex-direction: column;
      justify-content: center; padding: 70px 52px; position: relative; overflow: hidden;
    }
    .auth-left::before { content: ''; position: absolute; top: -80px; right: -80px; width: 340px; height: 340px; border-radius: 50%; background: rgba(255,152,0,0.08); }
    .auth-left::after { content: ''; position: absolute; bottom: -60px; left: -40px; width: 240px; height: 240px; border-radius: 50%; background: rgba(255,152,0,0.05); }
    .auth-logo { margin-bottom: 44px; }
    .auth-logo img { width: 120px; height: auto; }
    .auth-tagline h1 { font-size: 2rem; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 16px; }
    .auth-tagline h1 span { color: #FF9800; }
    .auth-tagline p { color: rgba(255,255,255,0.5); font-size: 0.95rem; line-height: 1.7; }

    .verify-icon { width: 72px; height: 72px; border-radius: 50%; background: rgba(255,152,0,0.14); display: flex; align-items: center; justify-content: center; margin: 40px 0 20px; }
    .verify-icon i { font-size: 2rem; color: #FF9800; }

    .auth-right { flex: 1; background: #fff !important; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 60px 40px; }
    .auth-form-wrap { width: 100%; max-width: 440px; }
    .auth-form-wrap h2 { font-size: 1.65rem; font-weight: 700; color: #0d0d1a !important; margin-bottom: 6px; }
    .auth-form-wrap .auth-sub { color: #888 !important; font-size: 0.92rem; margin-bottom: 32px; line-height: 1.5; }
    .auth-form-wrap .auth-sub strong { color: #0d0d1a !important; }

    .flash-error { background: #fff5f5; border: 1px solid #fcc; border-radius: 8px; padding: 12px 16px; color: #c0392b; font-size: 0.88rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
    .flash-success { background: #fff8ec; border: 1px solid #ffd699; border-radius: 8px; padding: 12px 16px; color: #b26a00; font-size: 0.88rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }

    .otp-row { display: flex; gap: 10px; justify-content: center; margin-bottom: 28px; }
    .otp-digit {
      width: 52px; height: 60px; border: 2px solid #e0e0e0 !important; border-radius: 10px; text-align: center;
      font-size: 1.5rem !important; font-weight: 700; color: #0d0d1a !important; background: #fff !important;
      outline: none !important; box-shadow: none !important; transition: border-color 0.18s; caret-color: #FF9800;
      -webkit-text-fill-color: #0d0d1a !important;
    }
    .otp-digit:focus { border-color: #FF9800 !important; }
    #otpHidden { display: none; }

    .btn-submit { width: 100%; padding: 14px; background: #FF9800; color: #fff; border: none; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.18s; margin-bottom: 20px; }
    .btn-submit:hover { background: #e68900; }
    .btn-submit:disabled { background: #ccc; cursor: default; }

    .auth-footer { text-align: center; color: #999; font-size: 0.88rem; }
    .auth-footer a { color: #FF9800; text-decoration: none; font-weight: 600; }
    .resend-row { text-align: center; margin-top: 14px; font-size: 0.88rem; color: #aaa; }
    .resend-row a { color: #FF9800; font-weight: 600; text-decoration: none; }
    .expiry-note { text-align: center; font-size: 0.8rem; color: #bbb; margin-bottom: 24px; }

    @media (max-width: 768px) {
      body { flex-direction: column; }
      .auth-left { width: 100%; padding: 40px 28px; }
      .auth-right { padding: 40px 20px; }
      .otp-digit { width: 42px; height: 52px; font-size: 1.3rem; }
    }
  </style>
</head>
<body>

  <div class="auth-left">
    <div class="auth-logo"><a href="/"><img src="/images/logo.png" alt="Shed"></a></div>
    <div class="auth-tagline">
      <h1>Almost <span>there!</span></h1>
      <p>We sent a 6-digit code to your email. Enter it to activate your shopper account.</p>
    </div>
    <div class="verify-icon"><i class="fas fa-envelope-open-text"></i></div>
    <p style="color:rgba(255,255,255,0.4);font-size:0.8rem;margin-top:8px;">Check your spam folder if you don't see the email.</p>
  </div>

  <div class="auth-right">
    <div class="auth-form-wrap">
      <h2>Enter verification code</h2>
      <p class="auth-sub">We sent a 6-digit code to <strong><%= email %></strong>.<br>It expires in 15 minutes.</p>

      <% if (error) { %><div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
      <% if (message) { %><div class="flash-success"><i class="fas fa-check-circle"></i> <%= message %></div><% } %>

      <form action="/shopper/verify-email" method="POST" id="verifyForm" onsubmit="assembleOtp()">
        <input type="hidden" name="email" value="<%= email %>">
        <input type="hidden" name="otp" id="otpHidden">
        <div class="otp-row" id="otpRow">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
          <input class="otp-digit" type="text" inputmode="numeric" maxlength="1" autocomplete="off">
        </div>
        <p class="expiry-note"><i class="fas fa-clock"></i> Code expires in <span id="countdown">15:00</span></p>
        <button type="submit" class="btn-submit" id="submitBtn" disabled>Verify &amp; Create Account</button>
      </form>

      <div class="resend-row">
        Didn't receive it?
        <form action="/shopper/verify-email/resend" method="POST" style="display:inline;">
          <input type="hidden" name="email" value="<%= email %>">
          <button type="submit" style="background:none;border:none;color:#FF9800;font-weight:600;font-size:0.88rem;cursor:pointer;padding:0;font-family:inherit;">Resend code</button>
        </form>
        &nbsp;·&nbsp; <a href="/shopper/register">Start over</a>
      </div>

      <div class="auth-footer" style="margin-top:28px;">Already have an account? <a href="/shopper/login">Log in</a></div>
    </div>
  </div>

  <script>
    const digits = document.querySelectorAll('.otp-digit');
    const submitBtn = document.getElementById('submitBtn');
    digits.forEach((input, i) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/\D/g, '');
        e.target.value = val.slice(-1);
        if (val && i < digits.length - 1) digits[i + 1].focus();
        checkComplete();
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && i > 0) digits[i - 1].focus();
      });
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
        pasted.split('').slice(0, 6).forEach((ch, idx) => { if (digits[idx]) digits[idx].value = ch; });
        const next = Math.min(pasted.length, 5);
        digits[next].focus();
        checkComplete();
      });
    });
    function checkComplete() { submitBtn.disabled = ![...digits].every(d => d.value.length === 1); }
    function assembleOtp() { document.getElementById('otpHidden').value = [...digits].map(d => d.value).join(''); }
    let seconds = 15 * 60;
    const countdownEl = document.getElementById('countdown');
    const timer = setInterval(() => {
      seconds--;
      if (seconds <= 0) {
        clearInterval(timer);
        countdownEl.textContent = 'Expired';
        countdownEl.style.color = '#c0392b';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Code expired — re-enter your details';
        return;
      }
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      countdownEl.textContent = `${m}:${s}`;
    }, 1000);
    digits[0].focus();
  </script>
</body>
</html>
