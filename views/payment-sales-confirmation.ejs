<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Confirm Sales | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Confirm Sales</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    
    
  </head>
<body>
  <div class="container">
    <h1>Payment Confirmation</h1>
    <div class="sale-details">
      <p><strong>Customer Name:</strong> <%= sale.customerName %></p>
      <p><strong>Total Amount:</strong> <%= admin.currency %> <%= sale.totalAmount.toFixed(2) %></p>
      <p><strong>Payment Status:</strong> <%= sale.paymentStatus %></p>
    </div>

    <form action="/confirm-payment/<%= sale._id %>" method="POST">
      <button type="submit">Confirm Payment</button>
    </form>
  </div>
</body>
</html>