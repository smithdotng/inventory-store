<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta property="og:title" content="POS | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Banner starts at top */
        .mil-banner {
            margin-top: 0;
            padding-top: 0;
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
        }
        /* Content padding */
        .mil-content {
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-alert i {
            margin-right: 8px;
        }
        .mil-field-error {
            color: #d32f2f;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }
        /* Searchable select */
        .mil-searchable-select {
            position: relative;
            flex: 1;
            min-width: 150px;
        }
        .mil-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            max-height: 200px;
            overflow-y: auto;
            background: white;
            border: 1px solid #ced4da;
            border-top: none;
            border-radius: 0 0 4px 4px;
            z-index: 1000;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            display: none;
        }
        .mil-search-result-item {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 13px;
        }
        .mil-search-result-item:hover {
            background-color: #f8f9fa;
        }
        .mil-search-result-item.highlighted {
            background-color: #e9ecef;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 10px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-button.add-product-btn {
            background-color: rgb(255, 204, 0);
            color: #333;
        }
        .mil-button.add-product-btn:hover {
            background-color: #fff;
            color: rgb(255, 204, 0);
            border: 2px solid rgb(255, 204, 0);
        }
        .mil-button.update-btn {
            background-color: rgb(40, 167, 69);
            color: #fff;
        }
        .mil-button.update-btn:hover {
            background-color: #fff;
            color: rgb(40, 167, 69);
            border: 2px solid rgb(40, 167, 69);
        }
        .mil-button.delete-btn {
            background-color: rgb(220, 53, 69);
            color: #fff;
        }
        .mil-button.delete-btn:hover {
            background-color: #fff;
            color: rgb(220, 53, 69);
            border: 2px solid rgb(220, 53, 69);
        }
        /* Sidebar styling */
        .mil-wrapper .mil-sidebar {
            width: 250px;
            background-color: #f8f8f8 !important;
            opacity: 1 !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 20px;
            z-index: 1001;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .mil-wrapper .mil-sidebar.hidden {
            transform: translateX(-100%);
        }
        .mil-wrapper .mil-sidebar * {
            background-color: transparent !important;
            opacity: 1 !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container {
            text-align: center;
            margin-bottom: 20px;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container img {
            width: 100px;
            height: auto;
        }
        .mil-wrapper .mil-sidebar h2 {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 500;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: background 0.3s ease;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a:hover {
            background: rgb(235, 166, 17) !important;
            color: #fff;
        }
        .mil-wrapper .mil-sidebar a.active {
            background: rgb(235, 166, 17) !important;
            color: #fff;
            font-weight: bold;
        }
        /* Toggle button */
        .mil-toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            background: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 8px 12px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            z-index: 1002;
        }
        /* Main content */
        .mil-main-content {
            padding: 20px;
            transition: margin-left 0.3s ease;
            width: 100%;
            box-sizing: border-box;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .mil-main-content.full-width {
            margin-left: 0;
        }
        /* Center the main content container */
        .mil-about .container {
            display: flex;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .mil-sidebar:not(.hidden) ~ .mil-content .mil-about .container {
            margin-left: calc(250px + ((100% - 250px - 800px) / 2));
            margin-right: auto;
        }
        .mil-sidebar.hidden ~ .mil-content .mil-about .container {
            margin-left: auto;
            margin-right: auto;
        }
        /* Item row */
        .item-row {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        .item-row select,
        .item-row input[type="number"],
        .item-row .mil-searchable-select {
            flex: 1;
            min-width: 150px;
        }
        /* Form actions */
        .mil-form-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-wrapper .mil-sidebar {
                width: 200px;
                background-color: #f8f8f8 !important;
                opacity: 1 !important;
            }
            .mil-main-content {
                margin-left: 0;
            }
            .mil-main-content.full-width {
                margin-left: 0;
            }
            .mil-form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .mil-form-group label {
                font-size: 12px;
                padding-top: 8px;
            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .item-row {
                flex-direction: column;
                align-items: stretch;
            }
            .item-row select,
            .item-row input[type="number"],
            .item-row .mil-searchable-select {
                min-width: 100%;
            }
            .mil-form-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-form-actions .mil-button {
                width: 100%;
            }
            .mil-about .container {
                margin-left: auto;
                margin-right: auto;
                max-width: 100%;
                padding-left: 15px;
                padding-right: 15px;
            }
            .mil-field-error {
                font-size: 12px;
            }
            .mil-searchable-select {
                min-width: 100%;
            }
        }
    </style>

    <title>Shed | Point of Sale</title>
</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up active"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-messages" class="mil-up"><i class="fas fa-envelope"></i> Messages</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Point of </span>Sale</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Record sales for <%= admin.businessName || 'Your Business' %>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo" style="height: 50px; margin-bottom: 10px;">
                                        <h4 style="color: #333; font-size: 16px;">Point of Sale for <%= admin.businessName || 'Your Business' %></h4>
                                        <p style="color: #333; font-size: 13px;">
                                            Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Error Messages -->
                                <% if (typeof error !== 'undefined' && error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-exclamation-circle"></i> <%= error %>
                                    </div>
                                <% } %>

                                <!-- POS Form Section -->
                                <div class="mil-form-section mil-up">
                                    <h2 class="mil-mb-30">Record Sale</h2>
                                    <form id="salesForm" action="/admin/sales-form" method="POST">
                                        <!-- Items Section -->
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-boxes"></i> Items</label>
                                            <div id="itemsContainer">
                                                <div class="item-row" data-index="0">
                                                    <div class="mil-searchable-select">
                                                        <input type="text" class="mil-form-control mil-product-search" placeholder="Search products..." autocomplete="off">
                                                        <select name="items[itemId][]" class="mil-form-control mil-product-select" required style="display: none;">
                                                            <option value="">Select Product</option>
                                                            <% inventory.forEach(item => { %>
                                                                <% if (item.stock > 0) { %>
                                                                    <option value="<%= item._id %>" data-stock="<%= item.stock %>" data-price="<%= item.cost %>" data-name="<%= item.name %>">
                                                                        <%= item.name %> (Stock: <%= item.stock %>) - <%= admin.currency || '$' %><%= item.cost.toFixed(2) %>
                                                                    </option>
                                                                <% } %>
                                                            <% }) %>
                                                        </select>
                                                        <div class="mil-search-results" style="display: none;"></div>
                                                    </div>
                                                    <input type="number" name="items[quantity][]" class="mil-form-control" placeholder="Quantity" min="1" required>
                                                    <button type="button" class="mil-button delete-btn remove-btn" style="display: none;">
                                                        <i class="fa-solid fa-minus"></i>
                                                    </button>
                                                    <div class="mil-field-error" id="itemError0"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Add Item Button -->
                                        <div class="mil-form-actions">
                                            <button type="button" id="addItemBtn" class="mil-button add-product-btn">
                                                Add Another Item <i class="fa-solid fa-plus"></i>
                                            </button>
                                        </div>
                                        <!-- Customer Details -->
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-user"></i> Customer Name</label>
                                            <input type="text" name="customerName" class="mil-form-control" placeholder="Customer Name" required>
                                            <div class="mil-field-error" id="customerNameError"></div>
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-phone"></i> Phone Number</label>
                                            <input type="text" name="phoneNumber" class="mil-form-control" placeholder="Phone Number">
                                        </div>
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-envelope"></i> Email Address</label>
                                            <input type="email" name="email" class="mil-form-control" placeholder="Email Address">
                                        </div>
                                        <!-- Payment Method -->
                                        <div class="mil-form-group">
                                            <label><i class="fa-solid fa-credit-card"></i> Payment Method</label>
                                            <select name="paymentMethod" class="mil-form-control" required>
                                                <option value="">Select Payment Method</option>
                                                <option value="Cash">Cash</option>
                                                <option value="Bank Transfer">Bank Transfer</option>
                                                <option value="Card">Card</option>
                                            </select>
                                            <div class="mil-field-error" id="paymentMethodError"></div>
                                        </div>
                                        <!-- Submit Button -->
                                        <div class="mil-form-actions">
                                            <button type="submit" class="mil-button update-btn">
                                                Record Sale <i class="fa-solid fa-shopping-bag"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- footer -->
        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container mil-p-120-60">
                    <div class="row justify-content-between">
                        <div class="col-md-4 col-lg-4 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-md-7 col-lg-6">
                            <div class="row justify-content-end">
                                <div class="col-md-6 col-lg-9">
                                    <div class="mil-vert-between">
                                        <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- footer end -->

        <!-- hidden elements -->
        <div class="mil-hidden-elements">
            <div class="mil-dodecahedron">
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mil-arrow">
                <path d="M 14 5.3417969 C 13.744125 5.3417969 13.487969 5.4412187 13.292969 5.6367188 L 13.207031 5.7226562 C 12.816031 6.1136563 12.816031 6.7467188 13.207031 7.1367188 L 17.070312 11 L 4 11 C 3.448 11 3 11.448 3 12 C 3 12.552 3.448 13 4 13 L 17.070312 13 L 13.207031 16.863281 C 12.816031 17.254281 12.816031 17.887344 13.207031 18.277344 L 13.292969 18.363281 C 13.683969 18.754281 14.317031 18.754281 14.707031 18.363281 L 20.363281 12.707031 C 20.754281 12.316031 20.754281 11.682969 20.363281 11.292969 L 14.707031 5.6367188 C 14.511531 5.4412187 14.255875 5.3417969 14 5.3417969 z" />
            </svg>
            <svg width="250" viewBox="0 0 300 1404" fill="none" xmlns="http://www.w3.org/2000/svg" class="mil-lines">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M1 892L1 941H299V892C299 809.71 232.29 743 150 743C67.7096 743 1 809.71 1 892ZM0 942H300V892C300 809.157 232.843 742 150 742C67.1573 742 0 809.157 0 892L0 942Z" class="mil-move" />
