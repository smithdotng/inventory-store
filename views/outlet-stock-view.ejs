<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlet Stock View</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<!-- Outlet Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo">
    <img src="/images/logo.png" alt="Shed">
  </div>
  <nav class="sidebar-nav">
    <a href="/outlet/sales-form"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
    <a href="/outlet/<%= outlet._id %>/stock-view" class="active"><i class="fas fa-boxes"></i> View Inventory</a>
    <a href="/outlet-transactions/<%= outlet._id %>"><i class="fas fa-chart-bar"></i> Transactions</a>
    <a href="/outlet-customers/<%= outlet._id %>"><i class="fas fa-users"></i> Customers</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/outlet-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Inventory</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Shed' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= outlet.name[0].toUpperCase() %></div>
        <%= outlet.name %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>Stock View</h1>
        <p><%= outlet.name %> — current inventory</p>
      </div>
    </div>

    <% if (outlet.inventory && outlet.inventory.length > 0) { %>
      <div class="app-card">
        <div style="overflow-x:auto;">
          <table class="app-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Stock</th>
                <th>Price</th>
              </tr>
            </thead>
            <tbody>
              <% outlet.inventory.forEach(item => { %>
                <tr>
                  <td style="font-weight:500;"><%= item.name %></td>
                  <td>
                    <span style="background:<%= item.stock <= 5 ? 'rgba(192,57,43,0.1)' : 'rgba(0,139,139,0.1)' %>; color:<%= item.stock <= 5 ? '#c0392b' : '#008B8B' %>; padding:3px 10px; border-radius:20px; font-size:0.83rem; font-weight:600;">
                      <%= item.stock %>
                    </span>
                  </td>
                  <td style="color:#008B8B; font-weight:600;">
                    <%= admin.currency || '$' %><%= item.cost ? item.cost.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) : '0.00' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-box-open" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No inventory yet</h3>
        <p style="color:#999;">Ask your admin to dispense stock to this outlet.</p>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
