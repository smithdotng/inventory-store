
    <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta property="og:title" content="Store View | Shed: Inventory, Invoices and More" />
        <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
        <meta property="og:image" content="/android-chrome-512x512.png" />
        <title>Store View</title>
        <link rel="stylesheet" href="/style.css">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        
        <style>
            .success-container {
              text-align: center;
              margin-top: 50px;
            }
            .buttons {
              margin-top: 20px;
            }
            .send-options {
              display: none;
              margin-top: 10px;
            }
            .send-options.active {
              display: block;
            }
            button {
              padding: 10px 20px;
              margin: 5px;
              background-color: #4CAF50;
              color: white;
              border: none;
              border-radius: 5px;
              cursor: pointer;
            }
            button:hover {
              background-color: #45a049;
            }
          </style>
        
      </head>
    <body>
      <!-- Sidebar -->
      <div class="sidebar" id="sidebar">
        <div class="logo-container">
          <img src="/images/logo.png" alt="Shedfactory Business Solutions">
        </div>
        
        <h2>Welcome, <%= username %>!</h2>
        <a href="/admin/sales-form">Sell</a>
        <a href="/store-view">View Store</a>
        <a href="/update-stock">Update Stock</a>
        <a href="/create-outlet">Create Outlet</a>
        <a href="/invoices">Invoices</a>
        <a href="/transactions">Transactions</a>
        <a href="/customers">Customers</a>
        <a href="/admin-logout">Log Out</a>
      </div>
    
    
      <button class="toggle-btn" id="toggleBtn">☰</button>
      <!-- Main Content -->
      <div class="main-content" id="mainContent" style="padding-left: 50px;">
        <div class="success-container">
            <h1>Your sale has been successfully posted!</h1>
            <div class="buttons">
              <a href="/receipt/<%= sale._id %>"><button>Download Receipt</button></a>
              <button id="sendReceiptBtn">Send Receipt</button>
            </div>
            <div id="sendOptions" class="send-options">
              <form action="/send-receipt-email/<%= sale._id %>" method="POST">
                <input type="email" name="email" placeholder="Enter email" value="<%= sale.email !== 'N/A' ? sale.email : '' %>" required>
                <button type="submit">Send via Email</button>
              </form>
              <a href="https://wa.me/?text=Please%20find%20your%20receipt%20here:%20http://localhost:3000/receipt/<%= sale._id %>" target="_blank">
                <button>Send via WhatsApp</button>
              </a>
            </div>
          </div>
        
          <script>
            document.getElementById('sendReceiptBtn').addEventListener('click', () => {
              const sendOptions = document.getElementById('sendOptions');
              sendOptions.classList.toggle('active');
            });
          </script>
      </div>
    
      <!-- JavaScript for collapsing sidebar -->
      <script>
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('toggleBtn');
    
        // Toggle sidebar visibility (only active on small screens)
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('visible');
            sidebar.classList.toggle('hidden');
            if (sidebar.classList.contains('visible')) {
              mainContent.style.marginLeft = '200px';
              mainContent.style.width = 'calc(100% - 200px)';
            } else {
              mainContent.style.marginLeft = '0';
              mainContent.style.width = '100%';
            }
          });
      </script>
    </body>
    </html>
    