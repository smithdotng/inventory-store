    </script>
    <!-- Search Functionality -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchForm = document.querySelector('.mil-subscribe-form');
            const searchInput = searchForm.querySelector('input');
            const searchResults = searchForm.querySelector('.mil-search-results');

            // Debounce function to limit API calls
            const debounce = (func, wait) => {
                let timeout;
                return (...args) => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(this, args), wait);
                };
            };

            // Fetch stores from API
            const fetchStores = async (query) => {
                try {
                    const response = await fetch(`/api/stores/search?q=${encodeURIComponent(query)}`);
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    const stores = await response.json();
                    displayResults(stores);
                } catch (error) {
                    console.error('Error fetching stores:', error);
                    searchResults.innerHTML = '<div class="mil-search-no-results">Error searching stores</div>';
                    searchResults.classList.add('active');
                }
            };

            // Display search results
            const displayResults = (stores) => {
                searchResults.innerHTML = '';
                if (stores.length === 0) {
                    searchResults.innerHTML = '<div class="mil-search-no-results">No stores found</div>';
                    searchResults.classList.add('active');
                    return;
                }
                stores.forEach(store => {
                    const resultItem = document.createElement('a');
                    resultItem.href = `/store/${store.username}`; // Adjust URL as needed
                    resultItem.className = 'mil-search-result-item mil-up';
                    resultItem.innerHTML = `
                        ${store.logo ? `<img src="${store.logo}" alt="${store.businessName || 'Store'} logo">` : '<img src="img/placeholder.png" alt="Placeholder">'}
                        <div>
                            <h6>${store.businessName || 'Unnamed Store'}</h6>
                            <p>@${store.username || 'unknown'}</p>
                        </div>
                    `;
                    searchResults.appendChild(resultItem);
                });
                searchResults.classList.add('active');
            };

            // Hide results when clicking outside
            document.addEventListener('click', (e) => {
                if (!searchForm.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });

            // Handle input events (debounced)
            const debouncedSearch = debounce((value) => {
                if (value.trim() === '') {
                    searchResults.classList.remove('active');
                    searchResults.innerHTML = '';
                    return;
                }
                fetchStores(value);
            }, 300);

            searchInput.addEventListener('input', (e) => {
                debouncedSearch(e.target.value);
            });

            // Handle form submission
            searchForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const query = searchInput.value.trim();
                if (query) {
                    fetchStores(query);
                }
            });

            // Show results when input is focused
            searchInput.addEventListener('focus', () => {
                if (searchInput.value.trim() && searchResults.innerHTML) {
                    searchResults.classList.add('active');
                }
            });
        });
    </script>
    <!-- Subscription Form Handling -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const subscribeForm = document.getElementById('subscribeForm');
            const errorDiv = document.querySelector('.mil-subscribe-error');
            const successDiv = document.querySelector('.mil-subscribe-success');
            const formContainer = document.querySelector('.mil-subscribe-form');

            subscribeForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = subscribeForm.email.value.trim();
                
                // Clear previous messages
                errorDiv.style.display = 'none';
                errorDiv.textContent = '';
                
                // Basic validation
                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errorDiv.textContent = 'Please enter a valid email address';
                    errorDiv.style.display = 'block';
                    return;
                }

                try {
                    const response = await fetch('/api/subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email })
                    });

                    const data = await response.json();
                    
                    if (response.ok) {
                        // Hide form and show success message
                        formContainer.style.display = 'none';
                        successDiv.style.display = 'block';
                        
                        // Optionally reset the form
                        subscribeForm.reset();
                    } else {
                        // Show error above the input field
                        errorDiv.textContent = data.message || 'Subscription failed. Please try again.';
                        errorDiv.style.display = 'block';
                    }
                } catch (error) {
                    errorDiv.textContent = 'Network error. Please try again.';
                    errorDiv.style.display = 'block';
                    console.error('Subscription error:', error);
                }
            });
        });
    </script>
