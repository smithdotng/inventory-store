<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlets</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .outlets-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }
    .outlet-card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 14px rgba(0,0,0,0.07);
      transition: all 0.3s ease;
    }
    .outlet-card:hover { transform: translateY(-6px); box-shadow: 0 12px 36px rgba(0,0,0,0.12); }
    .outlet-card-header {
      background: #0d0d1a;
      color: #fff;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .outlet-card-header .icon {
      width: 42px; height: 42px; border-radius: 10px;
      background: rgba(0,139,139,0.2);
      display: flex; align-items: center; justify-content: center;
      color: #008B8B; font-size: 1.1rem;
    }
    .outlet-card-header h3 { margin: 0; font-size: 1.05rem; font-weight: 700; }
    .outlet-card-body { padding: 20px 24px; }
    .outlet-meta { font-size: 0.88rem; color: #666; line-height: 1.9; margin-bottom: 14px; }
    .outlet-meta strong { color: #333; }
    .commission-amount {
      font-size: 1.7rem; font-weight: 700; margin: 10px 0 4px;
    }
    .commission-amount.due { color: #e67e22; }
    .commission-amount.paid { color: #27ae60; }
    .commission-label { font-size: 0.8rem; color: #999; margin-bottom: 16px; }
    .outlet-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 24px 20px; }
    .create-form-box {
      background: #fff; border-radius: 12px;
      box-shadow: 0 2px 14px rgba(0,0,0,0.07);
      padding: 32px; margin-bottom: 28px; display: none;
    }
    .create-form-box.active { display: block; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media(max-width:640px) { .form-row { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'home', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Outlets</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
        <%= admin.firstName || admin.username %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="page-header">
      <div>
        <h1>Manage Outlets</h1>
        <p>Create, monitor and manage your business branches</p>
      </div>
      <button class="btn-primary-app" id="createOutletBtn">
        <i class="fas fa-plus"></i> New Outlet
      </button>
    </div>

    <!-- Create Outlet Form -->
    <div class="create-form-box" id="createOutletForm">
      <h3 style="margin:0 0 24px; font-size:1.1rem; font-weight:700; color:#0d0d1a;">Create New Outlet</h3>
      <form action="/create-outlet" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>Outlet Name <span style="color:#c0392b">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="Branch Name / Location" required>
          </div>
          <div class="form-group">
            <label>Physical Address</label>
            <input type="text" name="location" class="form-control" placeholder="Street, City, State">
          </div>
          <div class="form-group">
            <label>Mobile Number <span style="color:#c0392b">*</span></label>
            <input type="tel" name="mobile" class="form-control" placeholder="0803 xxx xxxx" required>
          </div>
          <div class="form-group">
            <label>Manager Username <span style="color:#c0392b">*</span></label>
            <input type="text" name="username" class="form-control" placeholder="manager_branch1" required>
          </div>
          <div class="form-group">
            <label>Initial Password <span style="color:#c0392b">*</span></label>
            <input type="password" name="password" class="form-control" placeholder="Strong password" required>
          </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:8px;">
          <button type="submit" class="btn-primary-app"><i class="fas fa-store"></i> Create Outlet</button>
          <button type="button" class="btn-secondary-app" id="cancelCreateBtn"><i class="fas fa-times"></i> Cancel</button>
        </div>
      </form>
    </div>

    <!-- Outlets Grid -->
    <% if (outlets && outlets.length > 0) { %>
      <div class="outlets-grid">
        <% outlets.forEach(outlet => { %>
          <div class="outlet-card">
            <div class="outlet-card-header">
              <div class="icon"><i class="fas fa-store"></i></div>
              <div>
                <h3><%= outlet.name %></h3>
                <div style="font-size:0.8rem; color:rgba(255,255,255,0.5); margin-top:2px;"><%= outlet.username %></div>
              </div>
            </div>
            <div class="outlet-card-body">
              <div class="outlet-meta">
                <% if (outlet.location) { %><strong>Location:</strong> <%= outlet.location %><br><% } %>
                <% if (outlet.mobile) { %><strong>Mobile:</strong> <%= outlet.mobile %><br><% } %>
              </div>
              <div class="commission-amount <%= outlet.totalCommissionDue > 0 ? 'due' : 'paid' %>">
                <%= admin.currency %><%= formatCurrency(Number(outlet.totalCommissionDue || 0)) %>
              </div>
              <div class="commission-label">Commission Due</div>
              <% if (outlet.totalCommissionDue > 0) { %>
                <form action="/pay-commission/<%= outlet._id %>" method="POST" style="margin-bottom:4px;">
                  <button type="submit" class="btn-primary-app btn-sm" style="background:#e67e22;" onclick="return confirm('Mark commission as paid?')">
                    <i class="fas fa-check"></i> Pay Commission
                  </button>
                </form>
              <% } else { %>
                <span class="badge badge-success"><i class="fas fa-check-circle"></i> Commission Paid</span>
              <% } %>
            </div>
            <div class="outlet-actions">
              <a href="/dispense-to-outlet/<%= outlet._id %>" class="btn-secondary-app btn-sm">
                <i class="fas fa-box-open"></i> Dispense
              </a>
              <a href="/outlet-details/<%= outlet._id %>" class="btn-secondary-app btn-sm">
                <i class="fas fa-eye"></i> Details
              </a>
              <form action="/delete-outlet/<%= outlet._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this outlet? This cannot be undone.')">
                <button type="submit" class="btn-danger-app btn-sm">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-store" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No outlets yet</h3>
        <p style="color:#999; margin-bottom:24px;">Expand your business by adding your first outlet location.</p>
        <button class="btn-primary-app" id="createFirstOutletBtn"><i class="fas fa-plus"></i> Create First Outlet</button>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
  const form = document.getElementById('createOutletForm');
  function showForm() {
    form.classList.add('active');
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.getElementById('createOutletBtn').addEventListener('click', showForm);
  const firstBtn = document.getElementById('createFirstOutletBtn');
  if (firstBtn) firstBtn.addEventListener('click', showForm);
  document.getElementById('cancelCreateBtn').addEventListener('click', function() {
    form.classList.remove('active');
  });
</script>
</body>
</html>
