<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Invoices</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .invoices-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }
    .invoice-card {
      background: #fff; border-radius: 12px; overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
      transition: all 0.3s ease;
    }
    .invoice-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,0.11); }
    .invoice-card-header {
      background: #0d0d1a; color: #fff;
      padding: 16px 22px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .invoice-card-header .inv-num { font-size: 1rem; font-weight: 700; }
    .invoice-card-header .inv-date { font-size: 0.8rem; color: rgba(255,255,255,0.5); }
    .invoice-card-body { padding: 20px 22px; }
    .invoice-card-body h4 { font-size: 0.98rem; font-weight: 700; color: #0d0d1a; margin:0 0 4px; }
    .invoice-total { font-size:1.4rem; font-weight:700; color:#008B8B; margin:12px 0 6px; }
    .invoice-items { font-size:0.85rem; color:#888; margin-bottom:14px; }
    .invoice-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .create-form-box {
      background:#fff; border-radius:12px;
      box-shadow:0 2px 12px rgba(0,0,0,0.07);
      padding:30px; margin-bottom:26px; display:none;
    }
    .create-form-box.active { display:block; }
    .form-two-col { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
    @media(max-width:768px) { .form-two-col{grid-template-columns:1fr;} }
    .item-row-wrapper {
      background:#f9fbfc; border:1px solid #eef0f4;
      border-radius:8px; padding:18px; margin-bottom:12px;
    }
    .item-row-grid { display:grid; grid-template-columns:1fr auto auto; gap:12px; align-items:end; }
    @media(max-width:480px) { .item-row-grid{grid-template-columns:1fr;} }
    .low-stock { color:#e67e22; font-size:0.8rem; }
  </style>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'invoices', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Invoices</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
        <%= admin.firstName || admin.username %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="page-header">
      <div>
        <h1>Invoices</h1>
        <p>Create, manage and download professional invoices</p>
      </div>
      <button class="btn-primary-app" id="createInvoiceBtn">
        <i class="fas fa-plus"></i> Create Invoice
      </button>
    </div>

    <!-- Create Invoice Form -->
    <div class="create-form-box" id="createInvoiceForm">
      <h3 style="margin:0 0 24px; font-size:1.1rem; font-weight:700; color:#0d0d1a;">New Invoice</h3>
      <form action="/invoices/create" method="POST" id="invoiceForm">
        <div class="form-two-col">
          <!-- Left -->
          <div>
            <div class="form-group">
              <label>Customer <span style="color:#c0392b">*</span></label>
              <select name="customerId" id="customerSelect" class="form-control">
                <option value="">Select Customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c._id %>"><%= c.name %> (<%= c.phone || 'N/A' %>)</option>
                <% }) %>
                <option value="new">+ Create New Customer</option>
              </select>
            </div>
            <div id="newCustomerFields" style="display:none;">
              <div class="form-group">
                <label>New Customer Name <span style="color:#c0392b">*</span></label>
                <input type="text" name="newCustomerName" class="form-control" placeholder="Full name">
              </div>
              <div class="form-group">
                <label>Phone <span style="color:#c0392b">*</span></label>
                <input type="tel" name="newCustomerPhone" class="form-control" placeholder="e.g. 08031234567">
              </div>
              <div class="form-group">
                <label>Email (optional)</label>
                <input type="email" name="newCustomerEmail" class="form-control" placeholder="customer@example.com">
              </div>
            </div>
            <div class="form-group">
              <label>Payment Method <span style="color:#c0392b">*</span></label>
              <select name="paymentMethod" id="paymentMethod" class="form-control">
                <option value="">Choose method</option>
                <option value="Cash">Cash</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="POS">POS / Card</option>
                <option value="Mobile Payment">Mobile Payment</option>
              </select>
            </div>
            <div id="bankDetails" style="display:none;" class="app-card" style="background:#f9fbfc;">
              <div class="app-card-title">Bank Details</div>
              <div class="form-group">
                <label>Bank Name <span style="color:#c0392b">*</span></label>
                <input type="text" name="bankName" class="form-control">
              </div>
              <div class="form-group">
                <label>Account Name <span style="color:#c0392b">*</span></label>
                <input type="text" name="bankAccountName" class="form-control">
              </div>
              <div class="form-group">
                <label>Account Number <span style="color:#c0392b">*</span></label>
                <input type="text" name="accountNumber" class="form-control">
              </div>
            </div>
          </div>
          <!-- Right -->
          <div>
            <div class="form-group">
              <label>Items <span style="color:#c0392b">*</span></label>
              <div id="itemsContainer"></div>
              <button type="button" id="addItemBtn" class="btn-secondary-app" style="margin-top:10px;">
                <i class="fas fa-plus"></i> Add Item
              </button>
            </div>
            <div class="form-group">
              <label>Additional Notes</label>
              <textarea name="additionalComments" class="form-control" rows="4" placeholder="Payment terms, delivery info, thank you message..."></textarea>
            </div>
          </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
          <button type="submit" class="btn-primary-app"><i class="fas fa-file-invoice"></i> Generate Invoice</button>
          <button type="button" class="btn-secondary-app" id="cancelInvoiceBtn"><i class="fas fa-times"></i> Cancel</button>
        </div>
      </form>
    </div>

    <!-- Invoices Grid -->
    <% if (sales && sales.length > 0) { %>
      <div class="invoices-grid">
        <% sales.forEach((sale, i) => { %>
          <div class="invoice-card">
            <div class="invoice-card-header">
              <div>
                <div class="inv-num">INV-<%= String(i+1).padStart(4,'0') %></div>
                <div class="inv-date"><%= new Date(sale.date).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %></div>
              </div>
              <% const ps = sale.paymentStatus || 'Pending'; %>
              <span class="badge <%= ps === 'Paid' ? 'badge-success' : 'badge-warning' %>"><%= ps %></span>
            </div>
            <div class="invoice-card-body">
              <h4><%= sale.customerName %></h4>
              <div style="font-size:0.82rem; color:#999; margin-bottom:10px;"><%= sale.customerPhone || 'No phone' %></div>
              <div class="invoice-items">
                <% (sale.items||[]).slice(0,3).forEach(it => { %>
                  <div>• <%= it.itemName %> × <%= it.quantity %></div>
                <% }) %>
                <% if ((sale.items||[]).length > 3) { %>
                  <div style="color:#aaa;">+ <%= sale.items.length - 3 %> more...</div>
                <% } %>
              </div>
              <div class="invoice-total"><%= admin.currency %><%= formatCurrency(Number(sale.totalAmount||0)) %></div>
              <div class="invoice-actions">
                <a href="/invoices/download/<%= sale._id %>" class="btn-primary-app btn-sm">
                  <i class="fas fa-download"></i> PDF
                </a>
                <% if (ps !== 'Paid') { %>
                  <form action="/invoices/mark-paid/<%= sale._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-secondary-app btn-sm" style="background:#27ae60; color:#fff; border-color:#27ae60;">
                      <i class="fas fa-check"></i> Mark Paid
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-file-invoice" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No invoices yet</h3>
        <p style="color:#999; margin-bottom:24px;">Create your first invoice to get started.</p>
        <button class="btn-primary-app" id="createFirstInvoiceBtn"><i class="fas fa-plus"></i> Create First Invoice</button>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  // Sidebar toggle
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  // Invoice form toggle
  const invForm = document.getElementById('createInvoiceForm');
  function showInvForm() {
    invForm.classList.add('active');
    initializeItemsContainer();
    invForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.getElementById('createInvoiceBtn').addEventListener('click', showInvForm);
  const firstBtn = document.getElementById('createFirstInvoiceBtn');
  if (firstBtn) firstBtn.addEventListener('click', showInvForm);
  document.getElementById('cancelInvoiceBtn').addEventListener('click', function() {
    invForm.classList.remove('active');
    document.getElementById('itemsContainer').innerHTML = '';
  });

  // New customer fields
  document.getElementById('customerSelect').addEventListener('change', function() {
    document.getElementById('newCustomerFields').style.display = this.value === 'new' ? 'block' : 'none';
  });
  // Bank details
  document.getElementById('paymentMethod').addEventListener('change', function() {
    document.getElementById('bankDetails').style.display = this.value === 'Bank Transfer' ? 'block' : 'none';
  });
  // Add item
  document.getElementById('addItemBtn').addEventListener('click', addItemRow);

  // Items management
  let itemCount = 0;

  async function loadProductsIntoSelect(sel) {
    sel.innerHTML = '<option value="">Loading...</option>';
    try {
      const res = await fetch('/api/inventory', { credentials: 'include' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      let html = '<option value="">Select product...</option>';
      if (data.items) {
        data.items.forEach(p => {
          html += `<option value="${p._id}" data-stock="${p.stock}" data-price="${p.cost||0}">
            ${p.name} (Stock: ${p.stock})${p.isVatable ? ' [VAT]' : ''}
          </option>`;
        });
      }
      html += '<option value="new">+ New Product</option>';
      sel.innerHTML = html;
    } catch(e) {
      sel.innerHTML = '<option>Error loading products</option>';
    }
  }

  function addItemRow() {
    itemCount++;
    const wrap = document.createElement('div');
    wrap.className = 'item-row-wrapper';
    wrap.innerHTML = `
      <div class="item-row-grid">
        <div class="form-group" style="margin-bottom:0;">
          <label>Product</label>
          <select name="items[itemId][]" class="form-control" required></select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label>Qty</label>
          <input type="number" name="items[quantity][]" class="form-control" min="1" value="1" style="width:80px;" required>
        </div>
        <div style="padding-top:24px;">
          <button type="button" class="btn-danger-app btn-sm remove-item-btn"><i class="fas fa-trash"></i></button>
        </div>
      </div>`;
    document.getElementById('itemsContainer').appendChild(wrap);
    loadProductsIntoSelect(wrap.querySelector('select'));
    wrap.querySelector('.remove-item-btn').addEventListener('click', function() {
      if (document.querySelectorAll('.item-row-wrapper').length > 1) wrap.remove();
    });
  }

  function initializeItemsContainer() {
    document.getElementById('itemsContainer').innerHTML = '';
    itemCount = 0;
    addItemRow();
  }

  // Form validation
  document.getElementById('invoiceForm').addEventListener('submit', function(e) {
    const errors = [];
    if (!document.getElementById('customerSelect').value) errors.push('Please select or create a customer.');
    if (!document.getElementById('paymentMethod').value) errors.push('Please select a payment method.');
    if (!document.querySelectorAll('.item-row-wrapper').length) errors.push('Add at least one item.');
    if (errors.length) {
      e.preventDefault();
      alert('Cannot generate invoice!\n\n' + errors.join('\n'));
    }
  });
</script>
</body>
</html>
