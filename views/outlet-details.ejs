<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlet Details</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'home', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Outlet Details</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
        <%= admin.firstName || admin.username %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="page-header">
      <div>
        <h1>Outlet Details</h1>
        <p><%= outlet.name %></p>
      </div>
      <a href="/home" class="btn-secondary-app"><i class="fas fa-arrow-left"></i> Back to Outlets</a>
    </div>

    <div style="display:grid; grid-template-columns:1fr 2fr; gap:24px; align-items:start;">

      <!-- Outlet info card -->
      <div class="app-card">
        <div class="app-card-title" style="background:#0d0d1a; color:#fff; margin:-20px -20px 20px; padding:16px 20px; border-radius:12px 12px 0 0;">
          <i class="fas fa-store" style="color:#008B8B;"></i> Outlet Info
        </div>
        <div style="display:flex; flex-direction:column; gap:14px;">
          <div>
            <div style="font-size:0.75rem; color:#999; text-transform:uppercase; letter-spacing:.05em; margin-bottom:3px;">Name</div>
            <div style="font-weight:600; color:#0d0d1a;"><%= outlet.name %></div>
          </div>
          <div>
            <div style="font-size:0.75rem; color:#999; text-transform:uppercase; letter-spacing:.05em; margin-bottom:3px;">Address</div>
            <div style="color:#444;"><i class="fas fa-map-marker-alt" style="color:#008B8B; margin-right:6px;"></i><%= outlet.location %></div>
          </div>
          <div>
            <div style="font-size:0.75rem; color:#999; text-transform:uppercase; letter-spacing:.05em; margin-bottom:3px;">Contact</div>
            <div style="color:#444;"><i class="fas fa-phone" style="color:#008B8B; margin-right:6px;"></i><%= outlet.mobile %></div>
          </div>
          <div>
            <div style="font-size:0.75rem; color:#999; text-transform:uppercase; letter-spacing:.05em; margin-bottom:3px;">Username</div>
            <div style="color:#444; font-family:monospace;"><i class="fas fa-user" style="color:#008B8B; margin-right:6px;"></i><%= outlet.username %></div>
          </div>
        </div>
        <div style="display:flex; flex-direction:column; gap:8px; margin-top:24px;">
          <a href="/outlet-transactions/<%= outlet._id %>" class="btn-primary-app" style="justify-content:center;">
            <i class="fas fa-chart-bar"></i> View Transactions
          </a>
          <a href="/outlet-customers/<%= outlet._id %>" class="btn-secondary-app" style="justify-content:center;">
            <i class="fas fa-users"></i> View Customers
          </a>
          <a href="/dispense-to-outlet/<%= outlet._id %>" class="btn-secondary-app" style="justify-content:center;">
            <i class="fas fa-truck"></i> Dispense Stock
          </a>
        </div>
      </div>

      <!-- Stock table -->
      <div class="app-card">
        <div class="app-card-title" style="background:#0d0d1a; color:#fff; margin:-20px -20px 20px; padding:16px 20px; border-radius:12px 12px 0 0;">
          <i class="fas fa-boxes" style="color:#008B8B;"></i> Stock Inventory
        </div>
        <% if (outlet.inventory && outlet.inventory.length > 0) { %>
          <div style="overflow-x:auto;">
            <table class="app-table">
              <thead>
                <tr>
                  <th>Item Name</th>
                  <th>Stock Qty</th>
                </tr>
              </thead>
              <tbody>
                <% outlet.inventory.forEach(item => { %>
                  <tr>
                    <td style="font-weight:500;"><%= item.name %></td>
                    <td>
                      <span style="background:<%= item.stock <= 5 ? 'rgba(192,57,43,0.1)' : 'rgba(0,139,139,0.1)' %>; color:<%= item.stock <= 5 ? '#c0392b' : '#008B8B' %>; padding:3px 10px; border-radius:20px; font-size:0.83rem; font-weight:600;">
                        <%= item.stock %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="text-align:center; padding:48px 20px; color:#999;">
            <i class="fas fa-box-open" style="font-size:2.5rem; margin-bottom:12px; display:block; color:#ddd;"></i>
            No stock dispensed to this outlet yet.
          </div>
        <% } %>
      </div>

    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
