<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Outlet Point of Sale</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .item-row { display:flex; gap:10px; align-items:flex-end; margin-bottom:12px; }
    .item-row .item-select { flex:3; }
    .item-row .quantity-input { flex:1; min-width:80px; }
    .remove-btn {
      background: #fff0f0; border: 1px solid #ffd0d0; color: #c0392b;
      border-radius: 6px; padding: 0 12px; height: 44px;
      cursor: pointer; font-size: 0.85rem; flex-shrink: 0;
      transition: background .2s;
    }
    .remove-btn:hover { background: #ffd0d0; }
    .add-item-btn {
      background: rgba(0,139,139,0.08); border: 1.5px dashed #008B8B;
      color: #008B8B; border-radius: 8px; padding: 10px 20px;
      cursor: pointer; font-size: 0.9rem; font-weight: 600; width: 100%;
      margin-bottom: 20px; transition: background .2s;
    }
    .add-item-btn:hover { background: rgba(0,139,139,0.15); }
  </style>
</head>
<body>

<!-- Outlet Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo">
    <img src="/images/logo.png" alt="Shed">
  </div>
  <nav class="sidebar-nav">
    <a href="/outlet/sales-form" class="active"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
    <a href="/outlet/<%= outlet._id %>/stock-view"><i class="fas fa-boxes"></i> View Inventory</a>
    <a href="/outlet-transactions/<%= outlet._id %>"><i class="fas fa-chart-bar"></i> Transactions</a>
    <a href="/outlet-customers/<%= outlet._id %>"><i class="fas fa-users"></i> Customers</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/outlet-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Point of Sale</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Shed' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= outlet.name[0].toUpperCase() %></div>
        <%= outlet.name %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <div class="page-header">
      <div>
        <h1>New Sale</h1>
        <p>Record a sale for <%= outlet.name %></p>
      </div>
    </div>

    <div style="max-width:680px;">
      <div class="app-card">
        <div class="app-card-title">Customer & Items</div>
        <form id="salesForm" action="/outlet/sales-form" method="POST">

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:4px;">
            <div class="form-group">
              <label>Customer Name <span style="color:#c0392b">*</span></label>
              <input type="text" name="customerName" class="form-control" placeholder="Customer Name" required>
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <input type="text" name="phoneNumber" class="form-control" placeholder="0803 xxx xxxx">
            </div>
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="customer@example.com">
          </div>

          <div style="margin:20px 0 8px; font-weight:600; color:#0d0d1a; font-size:0.9rem; text-transform:uppercase; letter-spacing:.05em;">
            Products
          </div>

          <button type="button" class="add-item-btn" id="addItemBtn">
            <i class="fas fa-plus"></i> Add Product
          </button>

          <div id="itemsContainer">
            <div class="item-row" data-index="0">
              <div class="item-select form-group" style="margin-bottom:0;">
                <select name="items[0][itemId]" class="form-control" required>
                  <option value="">Select Product</option>
                  <% inventory.forEach(item => { %>
                    <% if (item.stock > 0) { %>
                      <option value="<%= item.id || item._id %>" data-stock="<%= item.stock %>">
                        <%= item.name %> (Stock: <%= item.stock %>) — <%= admin.currency || '$' %><%= item.cost ? formatCurrency(item.cost) : formatCurrency(0) %>
                      </option>
                    <% } %>
                  <% }) %>
                </select>
              </div>
              <div class="quantity-input form-group" style="margin-bottom:0;">
                <input type="number" name="items[0][quantity]" class="form-control" placeholder="Qty" min="1" required>
              </div>
              <button type="button" class="remove-btn" style="display:none;"><i class="fas fa-times"></i></button>
            </div>
          </div>

          <div id="stockError" class="flash-error" style="display:none; margin-top:8px;">
            <i class="fas fa-exclamation-circle"></i> Quantity exceeds available stock.
          </div>

          <div style="margin-top:20px;">
            <button type="submit" class="btn-primary-app" style="width:100%; justify-content:center;">
              <i class="fas fa-check"></i> Complete Sale
            </button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  // Sidebar
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  // Product option template (rendered server-side for first row, replicated client-side)
  const productOptions = `<option value="">Select Product</option>` +
    <%- JSON.stringify(inventory.filter(i => i.stock > 0).map(i =>
      `<option value="${i._id || i.id}" data-stock="${i.stock}">${i.name} (Stock: ${i.stock}) — ${admin.currency || '$'}${i.cost ? parseFloat(i.cost).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) : '0.00'}</option>`
    ).join('')) %>;

  let itemCount = 1;

  document.getElementById('addItemBtn').addEventListener('click', function() {
    const container = document.getElementById('itemsContainer');
    const row = document.createElement('div');
    row.className = 'item-row';
    row.dataset.index = itemCount;
    row.innerHTML = `
      <div class="item-select form-group" style="margin-bottom:0;">
        <select name="items[${itemCount}][itemId]" class="form-control" required>
          ${productOptions}
        </select>
      </div>
      <div class="quantity-input form-group" style="margin-bottom:0;">
        <input type="number" name="items[${itemCount}][quantity]" class="form-control" placeholder="Qty" min="1" required>
      </div>
      <button type="button" class="remove-btn"><i class="fas fa-times"></i></button>
    `;
    container.appendChild(row);
    itemCount++;
    updateRemoveButtons();
    addRowListeners(row);
  });

  document.getElementById('itemsContainer').addEventListener('click', function(e) {
    const btn = e.target.closest('.remove-btn');
    if (btn) {
      btn.closest('.item-row').remove();
      updateRemoveButtons();
    }
  });

  function updateRemoveButtons() {
    const rows = document.querySelectorAll('.item-row');
    rows.forEach(r => {
      const btn = r.querySelector('.remove-btn');
      if (btn) btn.style.display = rows.length > 1 ? 'flex' : 'none';
    });
  }

  function validateStock() {
    let err = false;
    document.querySelectorAll('.item-row').forEach(row => {
      const sel = row.querySelector('select');
      const inp = row.querySelector('input[type="number"]');
      if (sel && inp && sel.value) {
        const opt = sel.options[sel.selectedIndex];
        const stock = parseInt(opt.getAttribute('data-stock') || '0');
        const qty = parseInt(inp.value) || 0;
        if (qty > stock) err = true;
      }
    });
    document.getElementById('stockError').style.display = err ? 'flex' : 'none';
    return !err;
  }

  function addRowListeners(row) {
    row.querySelector('select')?.addEventListener('change', validateStock);
    row.querySelector('input[type="number"]')?.addEventListener('input', validateStock);
  }

  document.querySelectorAll('.item-row').forEach(addRowListeners);

  document.getElementById('salesForm').addEventListener('submit', function(e) {
    if (!validateStock()) e.preventDefault();
  });
</script>
</body>
</html>
