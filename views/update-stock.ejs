<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update Stock</title>
  <link rel="stylesheet" href="/css/conult.css">
  <style>
    /* General layout */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      background-color: #f5f5f5;
    }
    .container {
      text-align: center;
      max-width: 800px;
      width: 100%;
      padding: 20px;
    }
    /* Logo and heading styles */
    .content-logo-container img {
      max-height: 100px;
      margin-bottom: 20px;
      margin-top: 20px;
    }
    h1 {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
      color: #333;
    }
    h2 {
      font-size: 20px;
      margin-bottom: 20px;
      color: #333;
    }
    /* Form styles */
    .form-section {
      background-color: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      margin-bottom: 20px;
    }
    .form-group {
      display: flex;
      justify-content: center;
      gap: 15px; /* Improved spacing */
      flex-wrap: wrap;
    }
    .form-section input {
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      width: 100%;
      max-width: 250px; /* Adjusted for better layout */
      box-sizing: border-box;
      font-size: 16px;
      background-color: #fafafa;
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .form-section input.small {
      max-width: 120px; /* Slightly wider for stock and cost */
    }
    .form-section input:focus {
      border-color: #4CAF50;
      box-shadow: 0 0 5px rgba(76, 175, 80, 0.5);
      outline: none;
    }
    .form-section button,
    .table-section button {
      padding: 12px 25px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      color: white;
      font-size: 16px;
      font-weight: 500;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      transition: background-color 0.3s, transform 0.2s, box-shadow 0.3s;
    }
    .add-btn {
      background-color: #4CAF50;
    }
    .add-btn:hover {
      background-color: #45a049;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .add-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    /* Table styles */
    .table-section {
      background-color: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      margin-bottom: 20px;
      overflow-x: auto;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      margin: 0 auto;
    }
    th, td {
      padding: 12px;
      text-align: left;
    }
    th {
      background-color: #e0e0e0;
    }
    tr {
      border-bottom: 1px solid #ddd;
    }
    .stock-input, .cost-input {
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
      width: 100px;
      font-size: 16px;
      background-color: #fafafa;
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .stock-input:focus, .cost-input:focus {
      border-color: #4CAF50;
      box-shadow: 0 0 5px rgba(76, 175, 80, 0.5);
      outline: none;
    }
    .edit-btn {
      background-color: #0066cc;
      padding: 8px 20px; /* Slightly smaller for table */
    }
    .edit-btn:hover {
      background-color: #0052a3;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .edit-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    .update-btn {
      background-color: #4CAF50;
      padding: 8px 20px;
    }
    .update-btn:hover {
      background-color: #45a049;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .update-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    .cancel-btn {
      background-color: #ff4444;
      padding: 8px 20px;
    }
    .cancel-btn:hover {
      background-color: #cc0000;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }
    .cancel-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    /* Link styles */
    a {
      color: #0066cc;
      text-decoration: none;
      display: block;
      margin-top: 20px;
      font-size: 16px;
      transition: color 0.3s;
    }
    a:hover {
      color: #004d99;
      text-decoration: underline;
    }
    /* Sidebar styles */
    .sidebar {
      width: 200px;
      background-color: #910c0c;
      color: white;
      height: 100vh;
      padding: 20px;
      box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
      position: fixed;
    }
    .sidebar .logo-container {
      margin-bottom: 20px;
    }
    .sidebar .logo-container img {
      max-height: 50px;
      vertical-align: middle;
    }
    .sidebar h2 {
      margin: 0 0 20px;
      white-space: nowrap;
    }
    .sidebar a {
      color: white;
      text-decoration: none;
      display: flex;
      align-items: center;
      padding: 10px;
      margin: 10px 0;
      border-radius: 4px;
      transition: background-color 0.3s;
      white-space: nowrap;
    }
    .sidebar a:hover {
      background-color: #555;
    }
    /* Toggle button */
    .toggle-btn {
      position: fixed;
      top: 10px;
      right: 10px;
      background-color: #4CAF50;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
      padding: 5px 10px;
      border-radius: 4px;
      z-index: 1100;
      transition: background-color 0.3s;
      display: none;
    }
    .toggle-btn:hover {
      background-color: #45a049;
    }
    /* Main content styles */
    .main-content {
      flex: 1;
      padding: 20px;
      margin-left: 200px;
      transition: margin-left 0.3s ease;
    }
    .welcome-message {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
    }
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .sidebar {
        display: none;
      }
      .sidebar.expanded {
        display: block;
        width: 200px;
      }
      .main-content {
        margin-left: 0;
      }
      .main-content.expanded {
        margin-left: 200px;
      }
      .form-group {
        flex-direction: column;
        align-items: center;
      }
      .form-section input {
        max-width: 100%;
      }
      .content-logo-container img {
        max-height: 80px;
      }
      h1 {
        font-size: 20px;
      }
      .toggle-btn {
        display: block;
      }
    }
    @media (max-width: 480px) {
      .container {
        padding: 10px;
      }
      .form-section,
      .table-section {
        padding: 15px;
      }
      th, td {
        padding: 8px;
      }
      .welcome-message {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
    </div>
    <h2>Navigation</h2>
    <a href="/sell"><span>Sell</span></a>
    <a href="/store-view"><span>View Store</span></a>
    <a href="/update-stock"><span>Update Stock</span></a>
    <a href="/create-outlet"><span>Create an Outlet</span></a>
    <a href="/invoice"><span>Invoice</span></a>
    <a href="/transactions"><span>Transactions</span></a>
  </div>

  <!-- Toggle Button (Visible on Small Screens) -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent" style="padding-left: 50px;">
    <div class="welcome-message">
      Welcome, <%= username %>!
    </div>
    <div class="container" style="justify-self: center;">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
      </div>
      <h1>Update Stock <span class="icon-shopping-cart" style="margin-left: 10px;"></span></h1>

      <!-- Add New Product Form -->
      <div class="form-section">
        <h2>Add New Product <span class="icon-point-of-sale"></span></h2>
        <div class="form-group">
          <form action="/add-product" method="POST">
            <input type="text" id="product-name" name="name" placeholder="Product Name" required>
            <input type="number" id="initial-stock" name="stock" placeholder="Initial Stock" min="0" class="small" required>
            <input type="number" id="cost" name="cost" placeholder="Cost" min="0" step="0.01" class="small" required>
            <button type="submit" class="add-btn">Add Product <span class="icon-right-arrow"></span></button>
          </form>
        </div>
      </div>

      <!-- Inventory Table -->
      <div class="table-section">
        <table>
          <thead>
            <tr class="bg-gray-200">
              <th>Product <span class="icon-consumer-behavior"></span></th>
              <th>Stock <span class="icon-analysis"></span></th>
              <th>Cost <span class="icon-money"></span></th>
              <th>Action <span class="icon-strategy"></span></th>
            </tr>
          </thead>
          <tbody>
            <% inventory.forEach(item => { %>
              <tr id="row-<%= item._id %>">
                <td><%= item.name %></td>
                <td>
                  <input type="number" class="stock-input" value="<%= item.stock %>" disabled>
                </td>
                <td>
                  <input type="number" class="cost-input" value="<%= item.cost %>" step="0.01" disabled>
                </td>
                <td>
                  <button class="edit-btn" onclick="toggleEdit('<%= item._id %>')">Edit Stock</button>
                  <form action="/update-stock" method="POST" style="display:inline;">
                    <input type="hidden" name="id" value="<%= item._id %>">
                    <input type="hidden" name="stock" class="stock-input" value="<%= item.stock %>">
                    <input type="hidden" name="cost" class="cost-input" value="<%= item.cost %>">
                    <button type="button" class="update-btn" style="display:none;" onclick="updateHiddenInputs('<%= item._id %>')">Update</button>
                  </form>
                  <button class="cancel-btn" style="display:none;" onclick="cancelEdit('<%= item._id %>', '<%= item.stock %>', '<%= item.cost %>')">Cancel</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <a href="/store-view">Go to Store View <span class="icon-right-arrow"></span></a>
    </div>
  </div>

  <!-- JavaScript for sidebar toggle and table editing -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Sidebar toggle
    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('expanded');
      mainContent.classList.toggle('expanded');
    });

    // Table editing functions
    function toggleEdit(id) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const editBtn = row.querySelector('.edit-btn');
      const updateBtn = row.querySelector('.update-btn');
      const cancelBtn = row.querySelector('.cancel-btn');

      stockInput.disabled = false;
      costInput.disabled = false;
      editBtn.style.display = 'none';
      updateBtn.style.display = 'inline';
      cancelBtn.style.display = 'inline';
    }

    function updateHiddenInputs(id) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const hiddenStock = row.querySelector('input[name="stock"]');
      const hiddenCost = row.querySelector('input[name="cost"]');
      const form = row.querySelector('form');

      hiddenStock.value = stockInput.value;
      hiddenCost.value = costInput.value;
      form.submit(); // Submit the form to update the stock
    }

    function cancelEdit(id, originalStock, originalCost) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const editBtn = row.querySelector('.edit-btn');
      const updateBtn = row.querySelector('.update-btn');
      const cancelBtn = row.querySelector('.cancel-btn');

      stockInput.value = originalStock;
      costInput.value = originalCost;
      stockInput.disabled = true;
      costInput.disabled = true;
      editBtn.style.display = 'inline';
      updateBtn.style.display = 'none';
      cancelBtn.style.display = 'none';
    }
  </script>
</body>
</html>