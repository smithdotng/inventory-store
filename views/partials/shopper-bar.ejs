<!-- Shopper auth / cart controls.
     Docks itself into `.shed-topbar-right` on pages that have a fixed topbar
     (landing, storefront) so it never sits on top of the search / menu icons.
     On pages with no topbar (cluster-index, cluster-view, search-results,
     product) it falls back to the original floating pill.
     Both signed-in and signed-out states use the same single-button dropdown. -->
<style>
  #shedShopperBar {
    --sb-accent: #FF9800;
    --sb-accent-dark: #F57C00;
    display: flex; align-items: center; gap: 8px;
    font-family: 'Jost', Arial, sans-serif;
    opacity: 0; transition: opacity .18s ease;
  }
  #shedShopperBar[data-ready] { opacity: 1; }

  /* ── floating pill (pages without a topbar) ── */
  #shedShopperBar[data-mode="floating"] {
    position: fixed; top: 14px; right: 14px; z-index: 99999;
    background: rgba(13,13,26,0.92);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 999px; padding: 6px 6px 6px 8px;
    box-shadow: 0 6px 22px rgba(0,0,0,0.28);
  }
  /* ── docked into the site topbar ── */
  #shedShopperBar[data-mode="docked"] {
    position: static; background: none; border: 0;
    box-shadow: none; padding: 0; gap: 10px;
  }

  #shedShopperBar .sb-account { position: relative; display: flex; }
  #shedShopperBar .sb-trigger {
    display: inline-flex; align-items: center; gap: 8px;
    height: 34px; border-radius: 999px; line-height: 1;
    font-size: 0.8rem; white-space: nowrap; cursor: pointer;
    border: 1px solid transparent; font-family: inherit;
    transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  #shedShopperBar .sb-trigger:focus-visible,
  #shedShopperBar .sb-cart:focus-visible,
  #shedShopperBar .sb-menu a:focus-visible {
    outline: 2px solid var(--sb-accent); outline-offset: 2px;
  }
  #shedShopperBar .sb-caret { font-size: 0.62rem; opacity: 0.75; transition: transform .18s ease; }
  #shedShopperBar .sb-trigger[aria-expanded="true"] .sb-caret { transform: rotate(180deg); }

  /* signed out — single primary button */
  #shedShopperBar .sb-trigger.sb-guest {
    padding: 0 14px; color: #fff; background: var(--sb-accent); font-weight: 600;
    box-shadow: 0 2px 10px rgba(255,152,0,0.30);
  }
  #shedShopperBar .sb-trigger.sb-guest:hover,
  #shedShopperBar .sb-trigger.sb-guest[aria-expanded="true"] {
    background: var(--sb-accent-dark); box-shadow: 0 3px 14px rgba(255,152,0,0.42);
  }
  #shedShopperBar .sb-guest-icon { font-size: 0.9rem; }

  /* signed in — avatar chip */
  #shedShopperBar .sb-trigger.sb-user {
    padding: 0 12px 0 4px; color: #fff; font-weight: 500;
    background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.14);
  }
  #shedShopperBar .sb-trigger.sb-user:hover,
  #shedShopperBar .sb-trigger.sb-user[aria-expanded="true"] {
    background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.30);
  }
  #shedShopperBar .sb-avatar {
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #FFB74D, #F57C00);
    color: #fff; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
  }

  /* ── dropdown ── */
  #shedShopperBar .sb-menu {
    position: absolute; top: calc(100% + 10px); right: 0; z-index: 100000;
    min-width: 268px; max-width: calc(100vw - 20px); padding: 6px;
    background: #16161f; border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px; box-shadow: 0 12px 34px rgba(0,0,0,0.45);
    display: none;
  }
  #shedShopperBar .sb-menu[data-open] { display: block; }
  #shedShopperBar .sb-menu a {
    display: flex; align-items: center; gap: 11px;
    padding: 10px 12px; border-radius: 8px;
    color: #e9e9f2; font-size: 0.82rem; font-weight: 500; text-decoration: none;
    transition: background-color .15s ease, color .15s ease;
  }
  #shedShopperBar .sb-menu a i { width: 15px; text-align: center; opacity: 0.75; font-size: 0.85rem; flex-shrink: 0; }
  #shedShopperBar .sb-menu a:hover { background: rgba(255,255,255,0.08); color: #fff; }
  #shedShopperBar .sb-menu .sb-primary-item { color: #fff; font-weight: 600; }
  #shedShopperBar .sb-menu .sb-primary-item i { color: var(--sb-accent); opacity: 1; }
  #shedShopperBar .sb-menu .sb-primary-item:hover { background: rgba(255,152,0,0.14); }
  #shedShopperBar .sb-menu .sb-sub { display: block; margin-top: 2px; color: rgba(255,255,255,0.45); font-size: 0.7rem; font-weight: 400; }
  #shedShopperBar .sb-menu .sb-signout { color: #ff9a8f; margin-top: 4px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.09); }
  #shedShopperBar .sb-menu .sb-signout:hover { background: rgba(255,90,70,0.14); color: #ff7a6b; }
  #shedShopperBar .sb-menu-head {
    padding: 8px 12px 10px; margin-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,0.09);
  }
  #shedShopperBar .sb-menu-head b { display: block; color: #fff; font-size: 0.82rem; font-weight: 600; }
  #shedShopperBar .sb-menu-head span { display: block; color: rgba(255,255,255,0.5); font-size: 0.7rem; margin-top: 2px; }
  #shedShopperBar .sb-menu-sep { height: 1px; margin: 5px 8px; background: rgba(255,255,255,0.09); }

  /* ── cart ── */
  #shedShopperBar .sb-cart {
    position: relative; width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--sb-accent); color: #fff !important; text-decoration: none; font-size: 14px;
    transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
  }
  #shedShopperBar .sb-cart:hover { background: var(--sb-accent-dark); transform: translateY(-1px); }
  /* inside the topbar the orange button is the accent, so the cart goes quiet */
  #shedShopperBar[data-mode="docked"] .sb-cart {
    background: transparent; border: 1px solid rgba(255,255,255,0.30); font-size: 15px;
  }
  #shedShopperBar[data-mode="docked"] .sb-cart:hover { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.65); }
  #shedShopperBar .sb-cart-count {
    position: absolute; top: -3px; right: -3px;
    background: #c0392b; color: #fff; font-size: 0.62rem; font-weight: 700;
    min-width: 17px; height: 17px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center; padding: 0 4px;
    border: 2px solid rgba(13,13,26,0.92);
  }
  #shedShopperBar[data-mode="docked"] .sb-cart-count { border-color: #0b0b0b; }

  /* ── narrow screens: labels collapse, icon + caret remain ── */
  @media (max-width: 700px) {
    #shedShopperBar { gap: 7px; }
    #shedShopperBar .sb-label { display: none; }
    #shedShopperBar .sb-trigger.sb-guest { padding: 0 11px; }
    #shedShopperBar .sb-trigger.sb-user { padding: 0 8px 0 4px; }
  }
  @media (max-width: 600px) {
    #shedShopperBar[data-mode="floating"] { top: auto; bottom: 14px; right: 14px; }
    #shedShopperBar[data-mode="floating"] .sb-menu { top: auto; bottom: calc(100% + 10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shedShopperBar, #shedShopperBar * { transition: none !important; }
  }
</style>

<div id="shedShopperBar" data-mode="floating">
  <div class="sb-account">
    <% if (typeof shopper !== 'undefined' && shopper) { %>
      <button type="button" class="sb-trigger sb-user" data-sb-trigger
              aria-haspopup="true" aria-expanded="false" aria-controls="sbAccountMenu">
        <span class="sb-avatar" aria-hidden="true"><%= (shopper.firstName || '?').charAt(0) %></span>
        <span class="sb-label"><%= shopper.firstName %></span>
        <i class="fas fa-chevron-down sb-caret" aria-hidden="true"></i>
      </button>
      <div class="sb-menu" id="sbAccountMenu" data-sb-menu role="menu">
        <div class="sb-menu-head">
          <b><%= shopper.firstName %><%= shopper.lastName ? ' ' + shopper.lastName : '' %></b>
          <% if (shopper.email) { %><span><%= shopper.email %></span><% } %>
        </div>
        <a href="/shopper/account" role="menuitem"><i class="fas fa-user" aria-hidden="true"></i> My account</a>
        <a href="/shopper/account" role="menuitem"><i class="fas fa-box" aria-hidden="true"></i> My orders</a>
        <a href="/cart" role="menuitem"><i class="fas fa-shopping-cart" aria-hidden="true"></i> My cart</a>
        <a href="/shopper/logout" role="menuitem" class="sb-signout"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Log out</a>
      </div>
    <% } else { %>
      <button type="button" class="sb-trigger sb-guest" data-sb-trigger
              aria-haspopup="true" aria-expanded="false" aria-controls="sbAccountMenu"
              aria-label="Shopper account">
        <i class="fas fa-user sb-guest-icon" aria-hidden="true"></i>
        <span class="sb-label">Log in</span>
        <i class="fas fa-chevron-down sb-caret" aria-hidden="true"></i>
      </button>
      <div class="sb-menu" id="sbAccountMenu" data-sb-menu role="menu">
        <div class="sb-menu-head"><b>Shopper account</b><span>Shop, track orders and check out</span></div>
        <a href="/shopper/login" role="menuitem" class="sb-primary-item">
          <i class="fas fa-right-to-bracket fa-sign-in-alt" aria-hidden="true"></i>
          <span>Log in to your shopper account</span>
        </a>
        <div class="sb-menu-sep"></div>
        <a href="/shopper/register" role="menuitem">
          <i class="fas fa-user-plus" aria-hidden="true"></i>
          <span>Create a shopper account<span class="sb-sub">Takes about a minute</span></span>
        </a>
      </div>
    <% } %>
  </div>
  <a class="sb-cart" href="/cart" aria-label="My cart">
    <i class="fas fa-shopping-cart" aria-hidden="true"></i>
    <span class="sb-cart-count" id="shedCartCount" style="display:none;">0</span>
  </a>
</div>

<script>
(function () {
  if (window.__shedShopperBarInit) return;
  window.__shedShopperBarInit = true;

  function init() {
    var bar = document.getElementById('shedShopperBar');
    if (!bar) return;

    // Dock into the page's own topbar when there is one, so the auth controls
    // sit inline with search / menu instead of floating on top of them.
    var slot = document.querySelector('.shed-topbar-right');
    if (slot) {
      slot.insertBefore(bar, slot.firstChild);
      bar.setAttribute('data-mode', 'docked');
    }
    bar.setAttribute('data-ready', '');

    // Single dropdown implementation, used by both the signed-in chip and the
    // signed-out "Log in" button.
    var btn  = bar.querySelector('[data-sb-trigger]');
    var menu = bar.querySelector('[data-sb-menu]');
    if (btn && menu) {
      var close = function (refocus) {
        menu.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
        menu.style.cssText = '';
        if (refocus) btn.focus();
      };
      // Anchored under the button by default; if that would push it off-screen
      // (narrow viewports), pin it to the viewport edge instead.
      var place = function () {
        menu.style.cssText = '';
        var m = menu.getBoundingClientRect();
        if (m.left >= 8 && m.right <= window.innerWidth - 8) return;
        var b = btn.getBoundingClientRect();
        menu.style.position = 'fixed';
        menu.style.right = '10px';
        menu.style.left = 'auto';
        if (b.top > window.innerHeight / 2) {
          menu.style.bottom = (window.innerHeight - b.top + 10) + 'px';
          menu.style.top = 'auto';
        } else {
          menu.style.top = (b.bottom + 10) + 'px';
          menu.style.bottom = 'auto';
        }
      };
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (menu.hasAttribute('data-open')) { close(false); return; }
        menu.setAttribute('data-open', '');
        btn.setAttribute('aria-expanded', 'true');
        place();
      });
      document.addEventListener('click', function (e) {
        if (menu.hasAttribute('data-open') && !menu.contains(e.target) && !btn.contains(e.target)) close(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.hasAttribute('data-open')) close(true);
      });
      window.addEventListener('resize', function () {
        if (menu.hasAttribute('data-open')) close(false);
      });
    }

    // Cart badge
    fetch('/cart/count').then(function (r) { return r.json(); }).then(function (d) {
      var el = document.getElementById('shedCartCount');
      if (el && d && d.count > 0) { el.textContent = d.count > 99 ? '99+' : d.count; el.style.display = 'flex'; }
    }).catch(function () {});
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
