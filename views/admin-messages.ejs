<!-- Inline CSS -->
<style>
    /* Match update-stock styling */
    .mil-banner { height: 400px; }
    .mil-main-content { padding: 20px; transition: margin-left 0.3s ease; width: 100%; box-sizing: border-box; }
    .mil-main-content.full-width { margin-left: 0; }
    .mil-sidebar { width: 250px; background-color: #f8f8f8; position: fixed; top: 0; left: 0; bottom: 0; padding: 20px; z-index: 1001; transition: transform 0.3s ease; overflow-y: auto; }
    .mil-sidebar.hidden { transform: translateX(-100%); }
    .mil-toggle-btn { position: fixed; top: 10px; left: 10px; background: #eba611; color: #333; border: none; padding: 8px 12px; font-size: 16px; cursor: pointer; border-radius: 4px; z-index: 1002; }
    .mil-form-group { margin-bottom: 15px; }
    .mil-form-control { background-color: white; border: 1px solid #ced4da; color: #495057; font-size: 13px; padding: 0.375rem 0.75rem; width: 100%; border-radius: 4px; }
    .mil-form-control:focus { border-color: #80bdff; box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25); outline: none; }
    .mil-button { background-color: #eba611; color: #333; border: none; padding: 10px 20px; font-size: 13px; font-weight: 500; border-radius: 5px; cursor: pointer; transition: all 0.3s ease; }
    .mil-button:hover { background-color: #fff; color: #eba611; border: 2px solid #eba611; }
    .mil-button i { margin-left: 8px; }
    .mil-button.delete-btn { background-color: #dc3545; color: #fff; }
    .mil-button.delete-btn:hover { background-color: #fff; color: #dc3545; border: 2px solid #dc3545; }
    .mil-button.mark-read-btn { background-color: #28a745; color: #fff; }
    .mil-button.mark-read-btn:hover { background-color: #fff; color: #28a745; border: 2px solid #28a745; }
    .mil-alert { color: #d32f2f; background-color: #fde8e8; padding: 12px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #f5c2c7; font-size: 14px; display: flex; align-items: center; }
    .mil-alert.success { color: #388e3c; background-color: #e8f5e9; border: 1px solid #c8e6c9; }
    .mil-alert i { margin-right: 8px; }
    .mil-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9999; display: none; align-items: center; justify-content: center; }
    .mil-modal.active { display: flex; }
    .mil-modal-content { background: white; padding: 20px; border-radius: 8px; max-width: 500px; width: 90%; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); }
    .mil-modal-buttons { display: flex; justify-content: flex-end; gap: 10px; margin-top: 15px; }
    .mil-table-section table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 1000px; }
    .mil-table-section th, .mil-table-section td { padding: 10px; border: 1px solid #dee2e6; text-align: left; }
    .mil-table-section th { background-color: #f8f9fa; color: #333; font-weight: 500; }
    .mil-table-section tr:nth-child(even) { background-color: #f9f9f9; }
    .mil-table-section .content-cell { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
    .mil-table-section .unread { font-weight: bold; background-color: #e6f3ff; }
    .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; position: relative; }
    .table-responsive::-webkit-scrollbar { height: 8px; }
    .table-responsive::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
    .table-responsive::-webkit-scrollbar-track { background: #f1f1f1; }
    
    /* Sidebar overlay for mobile */
    .mil-sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: none;
    }
    
    @media (max-width: 768px) {
        .mil-sidebar { 
            width: 250px; 
            transform: translateX(-100%); 
            overflow-y: auto;
        }
        .mil-sidebar.hidden { 
            transform: translateX(-100%); 
        }
        .mil-sidebar:not(.hidden) {
            transform: translateX(0);
        }
        .mil-sidebar-overlay.active {
            display: block;
        }
        .mil-main-content { padding: 10px; }
        .mil-table-section table { min-width: 800px; }
        .mil-form-control { font-size: 12px; }
        .mil-button { font-size: 12px; padding: 8px 16px; }
        .mil-modal-content { width: 95%; padding: 15px; }
    }
    @media (max-width: 576px) {
        .mil-table-section table { min-width: 600px; }
        .mil-form-control { font-size: 11px; }
        .mil-button { font-size: 11px; padding: 6px 12px; }
    }
</style>

<title>Shed | Messages</title>

</head>

<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
    <!-- sidebar -->
    <div class="mil-sidebar" id="sidebar">
        <div class="mil-logo-container">
            <img src="/images/logo.png" alt="Shed Logo">
        </div>
        <h2 class="mil-up">Welcome, <%= username %>!</h2>
        <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
        <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
        <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
        <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
        <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
        <a href="/home" class="mil-up"><i class="fas fa-store"></i> Manage Outlets</a>
        <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
        <a href="/admin-messages" class="mil-up active"><i class="fas fa-envelope"></i> Messages</a>
        <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
    </div>

    <!-- Sidebar overlay -->
    <div class="mil-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- toggle button -->
    <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

    <!-- content -->
    <div class="mil-content">
        <div id="swupMain" class="mil-main-transition">
            <!-- banner -->
            <section class="mil-banner mil-dark-bg">
                <div class="mi-invert-fix">
                    <div class="mil-animation-frame">
                        <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                        <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                        <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                    </div>
                    <div class="mil-gradient"></div>
                    <div class="container">
                        <div class="mil-banner-content mil-up">
                            <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Admin </span>Messages</h1>
                            <div class="row">
                                <div class="col-md-7 col-lg-5">
                                    <p class="mil-light-soft mil-mb-60">View messages for <%= admin.businessName || 'Your Business' %>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- main content -->
            <section class="mil-about">
                <div class="container mil-p-120-60">
                    <div class="row">
                        <div class="col-lg-8 mil-main-content" id="mainContent">
                            <!-- Business Info -->
                            <div class="mil-form-section mil-up">
                                <div class="mil-center">
                                    <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo">
                                    <h4>Messages for <%= admin.businessName || 'Your Business' %></h4>
                                    <p>
                                        Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                    </p>
                                </div>
                            </div>

                            <!-- Error/Success Messages -->
                            <% if (error) { %>
                                <div class="mil-alert mil-up">
                                    <i class="fa-solid fa-bell"></i> <%= error %>
                                </div>
                            <% } %>
                            <% if (success) { %>
                                <div class="mil-alert success mil-up">
                                    <i class="fa-solid fa-check"></i> <%= success %>
                                </div>
                            <% } %>

                            <!-- Search Section -->
                            <div class="mil-search-section mil-up">
                                <form method="GET" action="/admin-messages">
                                    <div class="mil-form-group">
                                        <label>Search Messages <i class="fa-solid fa-search"></i></label>
                                        <div>
                                            <div>
                                                <input type="text" name="search" class="mil-form-control" placeholder="Search by sender or subject" value="<%= search || '' %>">
                                                <button type="submit" class="mil-button search-button">
                                                    <i class="fa-solid fa-search"></i>
                                                </button>
                                            </div>
                                            <% if (search) { %>
                                                <a href="/admin-messages" class="mil-button clear-btn">
                                                    Clear <i class="fa-solid fa-times"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- Table Section -->
                            <div class="mil-table-section mil-up">
                                <% if (messages && messages.length > 0) { %>
                                    <h2 class="mil-mb-30">Messages</h2>
                                    <div class="table-responsive">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Sender</th>
                                                    <th>Subject</th>
                                                    <th>Date</th>
                                                    <th>Content</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% messages.forEach(message => { %>
                                                    <tr id="row-<%= message._id %>" class="<%= message.read ? '' : 'unread' %>">
                                                        <td><%= message.sender || 'N/A' %></td>
                                                        <td><%= message.subject || 'No Subject' %></td>
                                                        <td><%= message.createdAt ? new Date(message.createdAt).toLocaleString() : 'N/A' %></td>
                                                        <td class="content-cell" data-id="<%= message._id %>" data-content="<%= message.content ? message.content.replace(/'/g, "\\'") : '' %>">
                                                            <%= message.content ? (message.content.length > 50 ? message.content.substring(0, 50) + '...' : message.content) : 'N/A' %>
                                                        </td>
                                                        <td>
                                                            <div class="mil-form-row">
                                                                <button class="mil-button mark-read-btn" data-id="<%= message._id %>" data-read="<%= message.read %>" aria-label="<%= message.read ? 'Mark as Unread' : 'Mark as Read' %>">
                                                                    <%= message.read ? 'Mark Unread' : 'Mark Read' %> <i class="fa-solid fa-envelope<%= message.read ? '-open' : '' %>"></i>
                                                                </button>
                                                                <i class="fa-solid fa-trash mil-delete-icon" data-id="<%= message._id %>" data-subject="<%= message.subject ? message.subject.replace(/'/g, "\\'") : 'Message' %>" aria-label="Delete Message"></i>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <p class="mil-center">No messages found.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Content Modal -->
    <div id="contentModal" class="mil-modal">
        <div class="mil-modal-content">
            <h5>Message Content</h5>
            <div class="mil-content-modal">
                <p id="contentText"></p>
            </div>
            <div>
            <div>

    <!-- Delete Modal -->
    <div id="deleteModal" class="mil-modal">
        <div class="modal-content">
            <h5>Delete Message</h5>
            <p>Are you sure you want to delete "<span id="deleteModalSubject"></span>"? This action cannot be undone.</p>
            <div>
            <div class="mil-modal-buttons">
                <button type="mil-button cancel-btn" id="cancelDeleteModal">
                    Cancel <i class="fa-solid fa-times"></i>
                </button>
                <form id="deleteForm" action="/admin/delete-message" method="POST">
                    <input type="hidden" name="_id" id="deleteMessageId">
                    <input type="submit" class="mil-button delete-btn">
                        Delete <i class="fa-solid fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- footer -->
    <footer class="mil-dark-bg">
        <div class="mil-footer">
            <div class="container mil-p-120-60">
                <div class="row justify-content-between">
                    <div class="col-md-4 col-lg-4 mil-mb-60">
                        <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                    </div>
                    <div class="col-md-7 col-lg-6">
                        <div class="row justify-content-end">
                            <div class="mil-vert-between">
                                <p class="mil-light-soft mil-up"><a>New to Shed? <a href="/admin-register">Create New Shed!</a></p>
                            </div>
                        </div>
