        document.addEventListener('DOMContentLoaded', () => {
            const row = document.querySelector('.mil-banner-content .row');
            if (row) {
                row.style.display = 'flex';
                row.style.visibility = 'visible';
                row.style.opacity = '1';
            }
        });
    </script>
    <!-- Mobile Menu Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const menuBtn = document.querySelector('.mil-menu-btn');
            const menu = document.querySelector('.mil-main-menu');
            const menuItems = document.querySelectorAll('.mil-has-children');

            menuBtn.addEventListener('click', () => {
                menu.classList.toggle('active');
            });

            // Toggle submenus on mobile
            menuItems.forEach(item => {
                item.addEventListener('click', (e) => {
                    if (window.innerWidth < 992) {
                        e.preventDefault();
                        item.classList.toggle('active');
                    }
                });
            });
        });
    </script>
    <script>
        // Country-Currency Mapping
        document.getElementById('country').addEventListener('change', function() {
            const currencySelect = document.getElementById('currency');
            const country = this.value;
            currencySelect.querySelectorAll('option').forEach(opt => opt.removeAttribute('selected'));
            const countryToCurrency = {
                'South Africa': 'ZAR',
                'Nigeria': 'NGN',
                'Ghana': 'GHS',
                'Kenya': 'KES',
                'United Kingdom': 'GBP',
                'Germany': 'EUR',
                'United States': 'USD',
                'Other': ''
            };
            currencySelect.value = countryToCurrency[country] || '';
        });

        // Initialize Cropper.js and Other Functionalities
        document.addEventListener('DOMContentLoaded', function() {
            const countrySelect = document.getElementById('country');
            if (countrySelect.value) countrySelect.dispatchEvent(new Event('change'));

            let cropper;
            const fileInput = document.getElementById('logo');
            const fileLabel = document.querySelector('.file-upload-label');
            const logoPreview = document.getElementById('logoPreview');
            const cropperModal = document.getElementById('cropperModal');
            const imageToCrop = document.getElementById('imageToCrop');
            const cancelCrop = document.getElementById('cancelCrop');
            const saveCrop = document.getElementById('saveCrop');
            const closeCropper = document.querySelector('.mil-close-cropper');
            const croppedImageData = document.getElementById('croppedImageData');

            cropperModal.style.display = 'none';

            fileInput.addEventListener('change', function(e) {
                if (this.files && this.files.length > 0) {
                    const file = this.files[0];
                    if (!file.type.match('image.*')) {
                        alert('Please select an image file');
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        cropperModal.style.display = 'flex';
                        imageToCrop.src = event.target.result;
                        if (cropper) cropper.destroy();
                        cropper = new Cropper(imageToCrop, {
                            aspectRatio: 1,
                            viewMode: 1,
                            autoCropArea: 0.8,
                            responsive: true,
                            background: false
                        });
                    };
                    reader.readAsDataURL(file);
                } else {
                    fileLabel.innerHTML = '<i class="fa-solid fa-file-import"></i> Click to upload logo';
                    fileLabel.classList.remove('uploaded');
                    logoPreview.style.display = 'none';
                    croppedImageData.value = '';
                }
            });

            closeCropper.addEventListener('click', function() {
                cropperModal.style.display = 'none';
                if (cropper) cropper.destroy();
                fileInput.value = '';
                fileLabel.innerHTML = '<i class="fa-solid fa-file-import"></i> Click to upload logo';
                fileLabel.classList.remove('uploaded');
                logoPreview.style.display = 'none';
                croppedImageData.value = '';
            });

            cancelCrop.addEventListener('click', function() {
                cropperModal.style.display = 'none';
                if (cropper) cropper.destroy();
                fileInput.value = '';
                fileLabel.innerHTML = '<i class="fa-solid fa-file-import"></i> Click to upload logo';
                fileLabel.classList.remove('uploaded');
                logoPreview.style.display = 'none';
                croppedImageData.value = '';
            });

            saveCrop.addEventListener('click', function() {
                if (cropper) {
                    const canvas = cropper.getCroppedCanvas({
                        width: 500,
                        height: 500,
                        minWidth: 256,
                        minHeight: 256,
                        fillColor: '#fff',
                        imageSmoothingEnabled: true,
                        imageSmoothingQuality: 'high'
                    });
                    if (canvas) {
                        const croppedDataUrl = canvas.toDataURL('image/png');
                        logoPreview.src = croppedDataUrl;
                        logoPreview.style.display = 'block';
                        croppedImageData.value = croppedDataUrl;
                        fileLabel.innerHTML = `<i class="fa-solid fa-image"></i> ${fileInput.files[0].name}`;
                        fileLabel.classList.add('uploaded');
                        cropperModal.style.display = 'none';
                        cropper.destroy();
                    }
                }
            });

            // Password validation
            document.getElementById('password').addEventListener('input', function() {
                const password = this.value;
                const lengthValid = password.length >= 8;
                const uppercaseValid = /[A-Z]/.test(password);
                const lowercaseValid = /[a-z]/.test(password);
                const numberValid = /[0-9]/.test(password);
                const specialValid = /[^A-Za-z0-9]/.test(password);

                updateRequirement('length', lengthValid);
                updateRequirement('uppercase', uppercaseValid);
                updateRequirement('lowercase', lowercaseValid);
                updateRequirement('number', numberValid); // Fixed typo: was number()
                updateRequirement('special', specialValid);
            });

            function updateRequirement(id, isValid) {
                const element = document.getElementById(id);
                if (element) { // Ensure element exists
                    if (isValid) {
                        element.className = 'valid';
                        element.innerHTML = '<i class="fa-solid fa-check"></i> ' + element.textContent.replace(/^[^a-zA-Z]+/, '');
                    } else {
                        element.className = 'invalid';
                        element.innerHTML = '<i class="fa-solid fa-xmark"></i> ' + element.textContent.replace(/^[^a-zA-Z]+/, '');
                    }
                }
            }

            document.getElementById('confirmPassword').addEventListener('input', function() {
                const password = document.getElementById('password').value;
                const confirmPassword = this.value;
                const feedback = document.getElementById('confirmPasswordFeedback');
                if (confirmPassword === '') {
                    feedback.style.display = 'none';
                } else if (password === confirmPassword) {
                    feedback.textContent = 'Passwords match!';
                    feedback.className = 'valid';
                    feedback.style.display = 'block';
                } else {
                    feedback.textContent = 'Passwords do not match!';
                    feedback.className = 'invalid';
                    feedback.style.display = 'block';
                }
            });

            document.querySelector('form').addEventListener('submit', function(e) {
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                if (password !== confirmPassword) {
                    e.preventDefault();
                    document.getElementById('confirmPasswordFeedback').textContent = 'Passwords must match!';
                    document.getElementById('confirmPasswordFeedback').className = 'invalid';
                    document.getElementById('confirmPasswordFeedback').style.display = 'block';
                    document.getElementById('confirmPassword').focus();
                    return;
                }
                const validations = {
                    length: password.length >= 8,
                    uppercase: /[A-Z]/.test(password),
                    lowercase: /[a-z]/.test(password),
                    number: /[0-9]/.test(password),
                    special: /[^A-Za-z0-9]/.test(password)
                };
                const isStrong = Object.values(validations).every(v => v);
                if (!isStrong) {
                    e.preventDefault();
                    Object.keys(validations).forEach(id => {
                        if (!validations[id]) {
                            const element = document.getElementById(id);
                            if (element) { // Ensure element exists
                                element.className = 'error';
                                element.innerHTML = '<i class="fa-solid fa-xmark"></i> ' + element.textContent.replace(/^[^a-zA-Z]+/, '');
                            }
                        }
                    });
                    alert('Please ensure your password meets all the requirements.');
                    document.getElementById('password').focus();
                }
            });
        });

        // Service Worker
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
