<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Update Stock | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stored Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Update Stock</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
        /* Existing styles remain unchanged */
        .add-product-form {
            margin: 20px 0;
        }
        
        .add-product-form form {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 10px;
            align-items: center;
        }
        
        .add-product-form input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
        }
        
        /* Updated Button Styles */
        .add-product-btn,
        .edit-btn,
        .update-btn,
        .cancel-btn,
        .go-to-store-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s ease;
            display: inline-block;
            text-decoration: none;
            width: 50%;
        }
    
        /* Add Product Button */
        .add-product-btn {
            background-color: #27ae60;
            color: white;
            width: 50%;
        }
        
        .add-product-btn:hover {
            background-color: #2ecc71;
            transform: translateY(-1px);
        }
    
        /* Edit Button */
        .edit-btn {
            background-color: #3498db;
            color: white;
        }
        
        .edit-btn:hover {
            background-color: #2980b9;
            transform: translateY(-1px);
        }
    
        /* Update Button */
        .update-btn {
            background-color: #2ecc71;
            color: white;
        }
        
        .update-btn:hover {
            background-color: #27ae60;
            transform: translateY(-1px);
        }
    
        /* Cancel Button */
        .cancel-btn {
            background-color: #e74c3c;
            color: white;
        }
        
        .cancel-btn:hover {
            background-color: #c0392b;
            transform: translateY(-1px);
        }
    
        /* Go to Store Button */
        .go-to-store-btn {
            background-color: #8e44ad;
            color: white;
            padding: 10px 20px;
            margin-top: 20px;
        }
        
        .go-to-store-btn:hover {
            background-color: #9b59b6;
            transform: translateY(-1px);
        }
    
        /* Responsive Styles */
        @media (max-width: 900px) {
            .add-product-form form {
                grid-template-columns: 1.5fr 1fr 1fr auto;
            }
        }
        
        @media (max-width: 768px) {
            .add-product-form form {
                grid-template-columns: 1fr;
            }
            
            .add-product-btn,
            .edit-btn,
            .update-btn,
            .cancel-btn,
            .go-to-store-btn {
                width: 50%;
                padding: 10px;
                margin: 5px 0;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="logo-container">
            <img src="/images/logo-a.png" alt="Shedfactory Business Solutions">
        </div>
        <h2>Welcome, <%= username %>!</h2>
        <a href="/pos">Point of Sale</a>
        <a href="/update-stock" class="active">Manage Inventory</a>
        <a href="/invoices">Generate Invoice</a>
        <a href="/transactions">View Transactions</a>
        <a href="/customers">Customers</a>
        <a href="/home">Manage Outlets</a>
        <a href="/admin-logout">Log Out</a>
    </div>

    <button class="toggle-btn" id="toggleBtn">☰</button>

    <div class="main-content" id="mainContent">
        <div class="container">
            <div class="content-logo-container">
                <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
            </div>
            <h1>Update Stock</h1>

            <div class="form-section">
                <h2>Add New Product</h2>
                <div class="add-product-form">
                    <form action="/add-product" method="POST">
                        <input type="text" name="name" placeholder="Product Name" required>
                        <input type="number" name="stock" placeholder="Initial Stock" min="0" required>
                        <input type="number" name="cost" placeholder="Cost" min="0" step="0.01" required>
                        <button type="submit" class="add-product-btn">Add Product</button>
                    </form>
                </div>
            </div>

            <div class="table-section">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Stock</th>
                            <th>Cost</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% inventory.forEach(item => { %>
                            <tr id="row-<%= item._id %>">
                                <td><%= item.name %></td>
                                <td>
                                    <input type="number" class="stock-input" value="<%= item.stock %>" disabled>
                                </td>
                                <td>
                                    <span class="cost-display"><%= admin.currency %><%= formatCurrency(item.cost) %></span>
                                    <input type="number" class="cost-input" value="<%= item.cost %>" step="0.01" disabled style="display: none;">
                                </td>
                                <td>
                                    <button class="edit-btn" onclick="toggleEdit('<%= item._id %>')">Edit Stock</button>
                                    <form action="/update-stock" method="POST" style="display:inline;">
                                        <input type="hidden" name="id" value="<%= item._id %>">
                                        <input type="hidden" name="stock" class="stock-input" value="<%= item.stock %>">
                                        <input type="hidden" name="cost" class="cost-input" value="<%= item.cost %>">
                                        <button type="button" class="update-btn" style="display:none;" onclick="updateHiddenInputs('<%= item._id %>')">Update</button>
                                    </form>
                                    <button class="cancel-btn" style="display:none;" onclick="cancelEdit('<%= item._id %>', '<%= item.stock %>', '<%= item.cost %>')">Cancel</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <a href="/store-view" class="go-to-store-btn">Go to Store View</a>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('toggleBtn');

        // Toggle sidebar visibility
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('visible');
            sidebar.classList.toggle('hidden');
            mainContent.style.marginLeft = sidebar.classList.contains('visible') ? '200px' : '0';
            mainContent.style.width = sidebar.classList.contains('visible') ? 'calc(100% - 200px)' : '100%';
        });

        // Set initial sidebar state
        function setSidebarState() {
            if (window.innerWidth <= 768) {
                sidebar.classList.add('hidden');
                mainContent.style.marginLeft = '0';
                mainContent.style.width = '100%';
            } else {
                sidebar.classList.remove('hidden');
                sidebar.classList.remove('visible');
                mainContent.style.marginLeft = '200px';
                mainContent.style.width = 'calc(100% - 200px)';
            }
        }
        setSidebarState();
        window.addEventListener('resize', setSidebarState);

        // Table editing functions
        function toggleEdit(id) {
            const row = document.getElementById(`row-${id}`);
            const stockInput = row.querySelector('.stock-input');
            const costDisplay = row.querySelector('.cost-display');
            const costInput = row.querySelector('.cost-input');
            const editBtn = row.querySelector('.edit-btn');
            const updateBtn = row.querySelector('.update-btn');
            const cancelBtn = row.querySelector('.cancel-btn');

            stockInput.disabled = false;
            costInput.disabled = false;
            costDisplay.style.display = 'none';
            costInput.style.display = 'inline';
            editBtn.style.display = 'none';
            updateBtn.style.display = 'inline';
            cancelBtn.style.display = 'inline';
        }

        function updateHiddenInputs(id) {
            const row = document.getElementById(`row-${id}`);
            const stockInput = row.querySelector('.stock-input');
            const costInput = row.querySelector('.cost-input');
            const hiddenStock = row.querySelector('input[name="stock"]');
            const hiddenCost = row.querySelector('input[name="cost"]');
            const form = row.querySelector('form');

            hiddenStock.value = stockInput.value;
            hiddenCost.value = costInput.value;
            form.submit();
        }

        function cancelEdit(id, originalStock, originalCost) {
            const row = document.getElementById(`row-${id}`);
            const stockInput = row.querySelector('.stock-input');
            const costDisplay = row.querySelector('.cost-display');
            const costInput = row.querySelector('.cost-input');
            const editBtn = row.querySelector('.edit-btn');
            const updateBtn = row.querySelector('.update-btn');
            const cancelBtn = row.querySelector('.cancel-btn');

            stockInput.value = originalStock;
            costInput.value = originalCost;
            stockInput.disabled = true;
            costInput.disabled = true;
            costDisplay.textContent = '<%= admin.currency %>' + Number(originalCost).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            costDisplay.style.display = 'inline';
            costInput.style.display = 'none';
            editBtn.style.display = 'inline';
            updateBtn.style.display = 'none';
            cancelBtn.style.display = 'none';
        }
    </script>
</body>
</html>