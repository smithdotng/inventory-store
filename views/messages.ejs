<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Messages</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .msg-table-wrap {
      background: #fff; border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      overflow: hidden;
    }
    .msg-unread td { background: #fffef5; font-weight: 600; }
    .msg-unread td:first-child::before {
      content: '';
      display: inline-block;
      width: 7px; height: 7px;
      background: #008B8B; border-radius: 50%;
      margin-right: 8px; vertical-align: middle;
    }
    .content-cell { cursor: pointer; color: #008B8B; }
    .content-cell:hover { text-decoration: underline; }
    .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-bar input { flex: 1; }

    /* Modal */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.5); z-index: 9999;
      align-items: center; justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
      background: #fff; border-radius: 12px; padding: 28px;
      max-width: 600px; width: 92%;
      box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    .modal-box h4 { margin: 0 0 16px; font-size: 1.1rem; font-weight: 700; }
    .modal-body { line-height: 1.7; color: #444; font-size: 0.92rem; max-height: 400px; overflow-y: auto; }
    .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
    .message-content-container table { width: 100%; border-collapse: collapse; }
    .message-content-container td, .message-content-container th { border: 1px solid #ddd; padding: 8px; }
  </style>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'messages', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Messages</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
          <%= admin.firstName || admin.username %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/profile"><i class="fas fa-user-circle"></i> Profile &amp; Settings</a>
          <a href="/admin-messages"><i class="fas fa-envelope"></i> Messages</a>
          <div class="dropdown-divider"></div>
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="page-header">
      <div><h1>Messages</h1><p>Inbox for <%= admin.businessName || 'Your Business' %></p></div>
    </div>

    <!-- Search -->
    <form method="GET" action="/admin-messages">
      <div class="search-bar">
        <input type="text" name="search" class="form-control" placeholder="Search by sender or subject…" value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button type="submit" class="btn-primary-app"><i class="fas fa-search"></i> Search</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/admin-messages" class="btn-secondary-app"><i class="fas fa-times"></i> Clear</a>
        <% } %>
      </div>
    </form>

    <% if (messages && messages.length > 0) { %>
      <div class="msg-table-wrap">
        <table class="app-table">
          <thead>
            <tr>
              <th>Sender</th>
              <th>Subject</th>
              <th>Date</th>
              <th>Preview</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% messages.forEach(message => { %>
              <tr id="row-<%= message._id %>" class="<%= message.read ? '' : 'msg-unread' %>">
                <td><%= message.sender || 'System' %></td>
                <td style="font-weight:600;"><%= message.subject || 'No Subject' %></td>
                <td style="font-size:0.83rem; color:#888; white-space:nowrap;">
                  <%= message.createdAt ? new Date(message.createdAt).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : 'N/A' %>
                </td>
                <td class="content-cell"
                    data-id="<%= message._id %>"
                    data-content="<%= message.content ? message.content.replace(/"/g, '&quot;') : '' %>"
                    data-is-html="<%= message.isHtml || false %>"
                    data-subject="<%= (message.subject || 'Message').replace(/"/g, '&quot;') %>">
                  <% if (message.content) { %>
                    <% const preview = message.isHtml ? message.content.replace(/<[^>]*>/g,'') : message.content; %>
                    <%= preview.substring(0,60) %><%= preview.length > 60 ? '…' : '' %>
                  <% } else { %>
                    <span style="color:#ccc;">—</span>
                  <% } %>
                </td>
                <td>
                  <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <button class="btn-secondary-app btn-sm mark-read-btn"
                            data-id="<%= message._id %>"
                            data-read="<%= message.read %>">
                      <%= message.read ? 'Mark Unread' : 'Mark Read' %>
                    </button>
                    <button class="btn-danger-app btn-sm delete-msg-btn"
                            data-id="<%= message._id %>"
                            data-subject="<%= (message.subject || 'Message').replace(/"/g, '&quot;') %>">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:80px 20px; background:#fff; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <i class="fas fa-inbox" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
        <h3 style="color:#0d0d1a; margin-bottom:8px;">No messages</h3>
        <p style="color:#999;">Your inbox is empty.</p>
      </div>
    <% } %>

  </main>
</div>

<!-- Content Modal -->
<div class="modal-overlay" id="contentModal">
  <div class="modal-box">
    <h4 id="contentModalTitle">Message</h4>
    <div class="modal-body message-content-container" id="contentText"></div>
    <div class="modal-actions">
      <button type="button" class="btn-secondary-app" id="closeContentModal"><i class="fas fa-times"></i> Close</button>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal-box">
    <h4>Delete Message</h4>
    <p style="color:#666;">Move "<span id="deleteModalSubject"></span>" to trash?</p>
    <div class="modal-actions">
      <button type="button" class="btn-danger-app" id="confirmDeleteModal"><i class="fas fa-trash"></i> Move to Trash</button>
      <button type="button" class="btn-secondary-app" id="cancelDeleteModal">Cancel</button>
    </div>
  </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  // Sidebar toggle
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  // Content modal
  function showContentModal(content, isHtml, subject) {
    document.getElementById('contentModalTitle').textContent = subject || 'Message';
    const el = document.getElementById('contentText');
    if (isHtml) el.innerHTML = content || '<p>No content</p>';
    else el.textContent = content || 'No content';
    document.getElementById('contentModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function hideContentModal() {
    document.getElementById('contentModal').classList.remove('active');
    document.body.style.overflow = '';
  }
  document.getElementById('closeContentModal').addEventListener('click', hideContentModal);
  document.getElementById('contentModal').addEventListener('click', function(e) { if (e.target === this) hideContentModal(); });

  document.querySelectorAll('.content-cell').forEach(function(cell) {
    cell.addEventListener('click', function() {
      showContentModal(this.dataset.content, this.dataset.isHtml === 'true', this.dataset.subject);
    });
  });

  // Delete modal
  let currentDeleteId = null;
  function showDeleteModal(id, subject) {
    currentDeleteId = id;
    document.getElementById('deleteModalSubject').textContent = subject;
    document.getElementById('deleteModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function hideDeleteModal() {
    document.getElementById('deleteModal').classList.remove('active');
    currentDeleteId = null;
    document.body.style.overflow = '';
  }
  document.getElementById('cancelDeleteModal').addEventListener('click', hideDeleteModal);
  document.getElementById('deleteModal').addEventListener('click', function(e) { if (e.target === this) hideDeleteModal(); });

  document.querySelectorAll('.delete-msg-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { showDeleteModal(this.dataset.id, this.dataset.subject); });
  });

  document.getElementById('confirmDeleteModal').addEventListener('click', async function() {
    if (!currentDeleteId) return;
    try {
      const res = await fetch('/admin/delete-message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ _id: currentDeleteId })
      });
      const data = await res.json();
      if (res.ok) {
        const row = document.getElementById('row-' + currentDeleteId);
        if (row) row.remove();
        hideDeleteModal();
        window.location.reload();
      } else {
        alert('Failed: ' + (data.error || 'Unknown error'));
      }
    } catch(e) { alert('Error deleting message'); }
  });

  // Mark read/unread
  document.querySelectorAll('.mark-read-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const id = this.dataset.id;
      const isRead = this.dataset.read === 'true';
      try {
        const res = await fetch('/mark-as-read', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ _id: id, read: !isRead })
        });
        const data = await res.json();
        if (data.success) {
          this.dataset.read = !isRead;
          this.textContent = isRead ? 'Mark Read' : 'Mark Unread';
          const row = document.getElementById('row-' + id);
          row.classList.toggle('msg-unread', !isRead);
        }
      } catch(e) { alert('Error updating message'); }
    });
  });

  // Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { hideContentModal(); hideDeleteModal(); }
  });
</script>
</body>
</html>
