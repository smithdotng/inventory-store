                                        </div>
                                    <% } else { %>
                                        <table class="mil-table">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Customer Name</th>
                                                    <th>Items</th>
                                                    <th>Total Amount</th>
                                                    <th>Payment Status</th>
                                                    <th>Action</th>
