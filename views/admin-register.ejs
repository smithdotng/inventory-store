<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shed | Create Your Account</title>

    <!-- favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- vendor css -->
    <link rel="stylesheet" href="asset1/css/bootstrap.min.css">
    <link rel="stylesheet" href="asset1/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="asset1/css/animate.min.css">

    <!-- Cropper.js CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">

    <!-- template styles -->
    <link rel="stylesheet" href="asset1/css/main.css">
    <link rel="stylesheet" href="asset1/css/rtl.css">

    <style>
        body {
            background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Jost', sans-serif;
        }

        .register-wrapper {
            max-width: 580px;
            width: 100%;
            margin: 40px auto;
            padding: 50px 40px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        }

        .register-logo {
            text-align: center;
            margin-bottom: 40px;
        }

        .register-logo img {
            max-width: 180px;
            height: auto;
        }

        .register-title {
            text-align: center;
            margin-bottom: 40px;
            color: #2c3e50;
        }

        .form-group {
            margin-bottom: 28px;
        }

        .form-group label {
            font-weight: 600;
            color: #444;
            margin-bottom: 10px;
            display: block;
        }

        .thm-btn.register-btn {
            width: 100%;
            padding: 14px;
            font-size: 1.1rem;
            background: #27ae60;
            border: none;
            border-radius: 30px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .thm-btn.register-btn:hover {
            background: #218838;
            transform: translateY(-2px);
        }

        .links {
            text-align: center;
            margin-top: 30px;
            color: #666;
        }

        .links a {
            color: #e74c3c;
            font-weight: 500;
            text-decoration: none;
            margin: 0 12px;
        }

        .links a:hover {
            color: #c0392b;
            text-decoration: underline;
        }

        .alert {
            border-radius: 8px;
            padding: 14px;
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .password-requirements {
            font-size: 0.85rem;
            color: #666;
            margin-top: 8px;
        }

        .password-requirements li {
            margin: 4px 0;
        }

        .password-requirements .valid { color: var(--success); }
        .password-requirements .invalid { color: var(--danger); }

        .logo-preview-container {
            text-align: center;
            margin: 20px 0;
        }

        #logoPreview {
            max-width: 140px;
            max-height: 140px;
            border-radius: 12px;
            border: 3px solid #eee;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

<div class="register-wrapper wow fadeInUp" data-wow-duration="800ms">
    <!-- Logo -->
    <div class="register-logo">
        <img src="/images/logo.png" alt="Shed Logo">
    </div>

    <!-- Title -->
    <h2 class="register-title">Create Your Shed</h2>

    <!-- Error Message -->
    <% if (error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
        </div>
    <% } %>

    <!-- Registration Form -->
    <form action="/admin-register<%= typeof referralCode !== 'undefined' && referralCode ? '?ref=' + referralCode : '' %>" method="POST" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Business Name</label>
                    <input type="text" class="form-control" name="businessName" placeholder="Your Business Name" required value="<%= typeof businessName !== 'undefined' ? businessName : '' %>">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" class="form-control" name="username" placeholder="Choose a username" required value="<%= typeof username !== 'undefined' ? username : '' %>">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>First Name</label>
                    <input type="text" class="form-control" name="firstName" placeholder="First Name" required value="<%= typeof firstName !== 'undefined' ? firstName : '' %>">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text" class="form-control" name="lastName" placeholder="Last Name" required value="<%= typeof lastName !== 'undefined' ? lastName : '' %>">
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Email Address</label>
            <input type="email" class="form-control" name="email" placeholder="your@email.com" required value="<%= typeof email !== 'undefined' ? email : '' %>">
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Country</label>
                    <select class="form-control" name="country" id="country" required>
                        <option value="">Select Country</option>
                        <option value="Nigeria" <%= typeof country !== 'undefined' && country === 'Nigeria' ? 'selected' : '' %>>Nigeria</option>
                        <option value="South Africa" <%= typeof country !== 'undefined' && country === 'South Africa' ? 'selected' : '' %>>South Africa</option>
                        <!-- Add more countries as needed -->
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Currency</label>
                    <select class="form-control" name="currency" id="currency" required>
                        <option value="">Select Currency</option>
                        <option value="NGN" <%= typeof currency !== 'undefined' && currency === 'NGN' ? 'selected' : '' %>>NGN (₦)</option>
                        <option value="USD" <%= typeof currency !== 'undefined' && currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                        <!-- Add more currencies -->
                    </select>
                </div>
            </div>
        </div>

        <!-- Logo Upload -->
        <div class="form-group">
            <label>Business Logo (Optional)</label>
            <input type="file" id="logoInput" name="logo" accept="image/*" class="d-none">
            <input type="hidden" name="croppedImageData" id="croppedImageData">
            <button type="button" class="thm-btn dynamic-radius" onclick="document.getElementById('logoInput').click()">
                Upload Logo
            </button>
            <div class="logo-preview-container">
                <img id="logoPreview" style="max-width:140px; margin-top:15px; border-radius:12px; display:none;">
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Create password" required>
                    <div class="password-requirements">
                        <ul>
                            <li id="length" class="invalid">At least 8 characters</li>
                            <li id="uppercase" class="invalid">One uppercase letter</li>
                            <li id="lowercase" class="invalid">One lowercase letter</li>
                            <li id="number" class="invalid">One number</li>
                            <li id="special" class="invalid">One special character</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm password" required>
                    <div id="confirmFeedback" style="font-size:0.85rem; margin-top:6px;"></div>
                </div>
            </div>
        </div>

        <button type="submit" class="thm-btn register-btn mt-4">
            Create Account <i class="fas fa-arrow-right ms-2"></i>
        </button>
    </form>

    <!-- Links -->
    <div class="links">
        <p>Already have an account? <a href="/admin-login">Sign in</a></p>
        <p>Outlet manager? <a href="/outlet-login">Outlet Login →</a></p>
    </div>
</div>

<!-- Scripts -->
<script src="asset1/js/jquery-3.5.1.min.js"></script>
<script src="asset1/js/wow.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<script>
    new WOW().init();

    // Country → Currency auto-sync (optional - expand as needed)
    $('#country').change(function() {
        const val = $(this).val();
        if (val === 'Nigeria') $('#currency').val('NGN');
        else if (val === 'South Africa') $('#currency').val('ZAR');
        else $('#currency').val('');
    });

    // Logo Cropper
    let cropper;
    $('#logoInput').change(function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(ev) {
                $('#logoPreview').attr('src', ev.target.result).show();
                // Optional: Open cropper modal here if you want to keep it
            };
            reader.readAsDataURL(file);
        }
    });

    // Password strength
    $('#password').on('input', function() {
        const pwd = $(this).val();
        $('#length').toggleClass('invalid', pwd.length < 8).toggleClass('valid', pwd.length >= 8);
        $('#uppercase').toggleClass('invalid', !/[A-Z]/.test(pwd)).toggleClass('valid', /[A-Z]/.test(pwd));
        $('#lowercase').toggleClass('invalid', !/[a-z]/.test(pwd)).toggleClass('valid', /[a-z]/.test(pwd));
        $('#number').toggleClass('invalid', !/[0-9]/.test(pwd)).toggleClass('valid', /[0-9]/.test(pwd));
        $('#special').toggleClass('invalid', !/[^A-Za-z0-9]/.test(pwd)).toggleClass('valid', /[^A-Za-z0-9]/.test(pwd));
    });

    // Confirm password match
    $('#confirmPassword').on('input', function() {
        const pwd = $('#password').val();
        const confirm = $(this).val();
        $('#confirmFeedback')
            .text(confirm === pwd && pwd ? 'Passwords match ✓' : confirm ? 'Passwords do not match' : '')
            .css('color', confirm === pwd && pwd ? 'var(--success)' : 'var(--danger)');
    });
</script>

</body>
</html>