    <!-- Inline CSS for Fixes, Menu, and Search Results -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
            margin-top: 20px;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Adjust .mil-frame-top to be fixed at top */
        .mil-frame-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px;
            background: #fff;
            height: 70px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
        }
        .mil-logo img {
            width: 100px;
            height: auto;
        }
        .mil-main-menu {
            display: flex;
            position: relative;
        }
        .mil-main-menu ul {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .mil-main-menu ul li {
            position: relative;
            margin: 0 10px;
        }
        .mil-main-menu ul li a {
            color: #333;
            text-decoration: none;
            font-size: 14px;
            padding: 8px;
            display: block;
        }
        .mil-main-menu ul li.mil-has-children > a::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            margin-left: 5px;
            font-size: 10px;
        }
        .mil-main-menu ul li ul {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            min-width: 180px;
            flex-direction: column;
            z-index: 1000;
        }
        .mil-main-menu ul li ul li {
            margin: 0;
        }
        .mil-main-menu ul li ul li a {
            padding: 8px 12px;
            color: #333;
            font-size: 14px;
        }
        .mil-main-menu ul li:hover > ul {
            display: flex;
        }
        .mil-main-menu ul li ul li:hover a {
            background: #f5f5f5;
        }
        .mil-menu-btn {
            display: none;
            cursor: pointer;
            font-size: 20px;
            color: #333;
        }
        /* Style mil-frame-bottom to scroll with the page */
        .mil-frame-bottom {
            background: #1a1a1a;
            padding: 10px;
            text-align: center;
            color: #fff;
        }
        .mil-frame-bottom .mil-back-to-top a {
            color: #fff;
            text-decoration: none;
        }
        /* Search form and results */
        .mil-subscribe-form {
            position: relative;
            display: flex;
            align-items: center;
            /*background-color: beige;*/
            padding: 5px;
            border-radius: 5px;
        }
        .mil-subscribe-form input {
            flex: 1;
            border: none;
            
            background-color: beige;
            padding: 8px;
            font-size: 14px;
            outline: none;
        }
        .mil-subscribe-form button {
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .mil-search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            display: none;
        }
        .mil-search-results.active {
            display: block;
        }
        .mil-search-result-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #333;
        }
        .mil-search-result-item:hover {
            background: #f5f5f5;
        }
        .mil-search-result-item img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }
        .mil-search-result-item div {
            flex: 1;
        }
        .mil-search-result-item h6 {
            margin: 0;
            font-size: 14px;
            color: #333;
        }
        .mil-search-result-item p {
            margin: 0;
            font-size: 12px;
            color: #666;
        }
        .mil-search-no-results {
            padding: 10px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        /* Mobile Menu */
        @media screen and (max-width: 991px) {
            .mil-main-menu {
                display: none;
                width: 100%;
                position: absolute;
                top: 100%;
                left: 0;
                background: #fff;
                z-index: 999;
            }
            .mil-main-menu.active {
                display: block;
            }
            .mil-main-menu ul {
                flex-direction: column;
                padding: 10px;
            }
            .mil-main-menu ul li {
                margin: 5px 0;
            }
            .mil-main-menu ul li ul {
                position: static;
                box-shadow: none;
                display: none;
            }
            .mil-main-menu ul li.mil-has-children.active > ul {
                display: flex;
            }
            .mil-menu-btn {
                display: block;
            }
            .mil-subscribe-form {
                width: 100%;
            }
            .mil-search-results {
                width: 100%;
            }
        }
        /* Content padding to avoid overlap with fixed header */
        .mil-content {
            padding-top: 80px;
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-main-menu ul li::before,
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        .mil-accordion-content ol li {
            padding-left: 30px;
            margin-bottom: 10px;
        }
        .mil-accordion-content ol li::before {
            font-size: 16px;
            color: #008B8B;
        }
        /* Subscription form styles */
        .mil-subscribe-container {
            position: relative;
            margin-top: 20px;
        }
        .mil-subscribe-success {
            display: none;
            color: #4CAF50;
            font-size: 16px;
            padding: 10px;
            text-align: center;
        }
        .mil-subscribe-error {
            display: none;
            color: #F44336;
            font-size: 14px;
            margin-bottom: 5px;
        }
        @media screen and (max-width: 991px) {
            .mil-main-menu ul li {
                padding-left: 25px;
            }
            .mil-main-menu ul li::before {
                content: '\f00c';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                color: #008B8B;
                position: absolute;
                left: 5px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 14px;
            }
            .mil-main-menu ul li ul li::before {
                left: 15px;
            }
        }
    </style>

    <title>Shed | Sell Anywhere. Manage Everything</title>
</head>

<body>
