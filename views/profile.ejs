<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Profile & Settings</title>
  <%- include('partials/app-head', { extraCssUrl: 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css' }) %>
  <style>
    .profile-layout { display: grid; grid-template-columns: 280px 1fr; gap: 24px; }
    @media(max-width:900px) { .profile-layout{grid-template-columns:1fr;} }

    .profile-summary-card {
      background: #fff; border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
      padding: 28px; text-align: center;
    }
    .profile-logo {
      width: 100px; height: 100px; border-radius: 16px;
      object-fit: cover; margin-bottom: 16px;
      border: 3px solid #f0f0f0;
    }
    .profile-logo-placeholder {
      width: 100px; height: 100px; border-radius: 16px;
      background: #f4f6f9; border: 2px dashed #ddd;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem; color: #ccc; margin: 0 auto 16px;
    }
    .profile-summary-card h3 { font-size: 1.1rem; font-weight: 700; color: #0d0d1a; margin: 0 0 4px; }
    .profile-summary-card p { font-size: 0.85rem; color: #888; margin: 0 0 20px; }
    .profile-info-row { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 8px 0; border-top: 1px solid #f5f5f5; }
    .profile-info-row .label { color: #999; }
    .profile-info-row .val { color: #333; font-weight: 500; }

    .edit-form-card {
      background: #fff; border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
      padding: 28px;
    }
    .section-heading {
      font-size: 0.9rem; font-weight: 700; color: #0d0d1a;
      margin: 24px 0 16px; padding-bottom: 8px;
      border-bottom: 2px solid #008B8B; display: flex; align-items: center; gap: 8px;
    }
    .section-heading:first-child { margin-top: 0; }
    .form-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .form-three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }
    @media(max-width:640px) { .form-two-col,.form-three-col{grid-template-columns:1fr;} }
    .checkbox-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 0.85rem; color: #666; }
    .checkbox-row input { width: 15px; height: 15px; cursor: pointer; accent-color: #008B8B; }

    .logo-upload-area { text-align: center; margin: 12px 0; }
    .logo-preview { width: 90px; height: 90px; border-radius: 12px; object-fit: cover; border: 2px solid #eee; }
    .logo-placeholder {
      width: 90px; height: 90px; border-radius: 12px;
      background: #f9fbfc; border: 2px dashed #ddd;
      display: flex; align-items: center; justify-content: center;
      color: #ccc; font-size: 2rem; margin: 0 auto 8px;
    }

    /* Crop modal */
    .crop-modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.6); z-index: 9999;
      align-items: center; justify-content: center;
    }
    .crop-modal-overlay.active { display: flex; }
    .crop-modal {
      background: #fff; border-radius: 12px; padding: 24px;
      max-width: 560px; width: 90%;
    }
    .crop-modal h4 { margin: 0 0 16px; font-size: 1.1rem; font-weight: 700; }
    #imageToCrop { max-width: 100%; display: block; }
    .crop-modal-actions { display: flex; gap: 12px; margin-top: 16px; }
  </style>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'profile', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Profile & Settings</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
          <%= admin.firstName || admin.username %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/profile"><i class="fas fa-user-circle"></i> Profile &amp; Settings</a>
          <a href="/admin-messages"><i class="fas fa-envelope"></i> Messages</a>
          <div class="dropdown-divider"></div>
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="page-header">
      <div><h1>Profile & Settings</h1><p>Manage your personal info, business details and preferences</p></div>
    </div>

    <div class="profile-layout">

      <!-- Summary card -->
      <div>
        <div class="profile-summary-card">
          <% if (admin.logo) { %>
            <img src="<%= admin.logo %>" alt="Logo" class="profile-logo">
          <% } else { %>
            <div class="profile-logo-placeholder"><i class="fas fa-store"></i></div>
          <% } %>
          <h3><%= admin.businessName || 'Your Business' %></h3>
          <p><%= admin.email %></p>

          <div class="profile-info-row">
            <span class="label">Username</span>
            <span class="val">@<%= admin.username %></span>
          </div>
          <div class="profile-info-row">
            <span class="label">Currency</span>
            <span class="val"><%= admin.currency || 'Not set' %></span>
          </div>
          <div class="profile-info-row">
            <span class="label">VAT</span>
            <span class="val"><%= admin.applyVat ? 'Enabled (' + (admin.vatRate||0) + '%)' : 'Disabled' %></span>
          </div>
          <div class="profile-info-row">
            <span class="label">Phone</span>
            <span class="val"><%= admin.phone || 'Not set' %></span>
          </div>
        </div>
      </div>

      <!-- Edit form -->
      <div class="edit-form-card">
        <form id="updateProfileForm" action="/profile/update" method="POST" enctype="multipart/form-data">

          <div class="section-heading"><i class="fas fa-user"></i> Personal Information</div>
          <div class="form-two-col">
            <div class="form-group">
              <label>First Name</label>
              <input type="text" name="firstName" class="form-control" value="<%= admin.firstName || '' %>" placeholder="First Name">
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input type="text" name="lastName" class="form-control" value="<%= admin.lastName || '' %>" placeholder="Last Name">
            </div>
          </div>
          <div class="form-two-col">
            <div class="form-group">
              <label>Business Name</label>
              <input type="text" name="businessName" class="form-control" value="<%= admin.businessName || '' %>" placeholder="Business Name">
            </div>
            <div class="form-group">
              <label>Currency</label>
              <select name="currency" class="form-control">
                <option value="">Select Currency</option>
                <option value="NGN" <%= admin.currency === 'NGN' ? 'selected' : '' %>>NGN (₦)</option>
                <option value="USD" <%= admin.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                <option value="EUR" <%= admin.currency === 'EUR' ? 'selected' : '' %>>EUR (€)</option>
                <option value="GBP" <%= admin.currency === 'GBP' ? 'selected' : '' %>>GBP (£)</option>
                <option value="ZAR" <%= admin.currency === 'ZAR' ? 'selected' : '' %>>ZAR (R)</option>
                <option value="GHS" <%= admin.currency === 'GHS' ? 'selected' : '' %>>GHS (₵)</option>
                <option value="KES" <%= admin.currency === 'KES' ? 'selected' : '' %>>KES (KSh)</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" value="<%= admin.email || '' %>">
            <div class="checkbox-row">
              <input type="checkbox" name="publicEmail" id="publicEmail" <%= admin.publicEmail ? 'checked' : '' %>>
              <label for="publicEmail">Make email public on storefront</label>
            </div>
          </div>
          <div class="form-two-col">
            <div class="form-group">
              <label>Phone</label>
              <input type="text" name="phone" class="form-control" value="<%= admin.phone || '' %>" placeholder="Phone number">
              <div class="checkbox-row">
                <input type="checkbox" name="publicPhone" id="publicPhone" <%= admin.publicPhone ? 'checked' : '' %>>
                <label for="publicPhone">Make public</label>
              </div>
            </div>
            <div class="form-group">
              <label>Address</label>
              <input type="text" name="address" class="form-control" value="<%= admin.address || '' %>" placeholder="Full address">
              <div class="checkbox-row">
                <input type="checkbox" name="publicAddress" id="publicAddress" <%= admin.publicAddress ? 'checked' : '' %>>
                <label for="publicAddress">Make public</label>
              </div>
            </div>
          </div>

          <div class="section-heading"><i class="fas fa-percentage"></i> VAT Configuration</div>
          <div class="form-group">
            <div class="checkbox-row" style="margin-bottom:10px;">
              <input type="checkbox" name="applyVat" id="applyVat" <%= admin.applyVat ? 'checked' : '' %>>
              <label for="applyVat" style="font-weight:600; font-size:0.9rem;">Enable VAT on products</label>
            </div>
            <div id="vatRateGroup" style="display:<%= admin.applyVat ? 'block' : 'none' %>;">
              <label>VAT Rate (%)</label>
              <input type="number" name="vatRate" class="form-control" value="<%= admin.vatRate || 0 %>" min="0" max="100" step="0.01" style="max-width:180px;">
            </div>
          </div>

          <div class="section-heading"><i class="fas fa-image"></i> Business Logo</div>
          <div class="logo-upload-area">
            <% if (admin.logo) { %>
              <img src="<%= admin.logo %>" class="logo-preview" id="imagePreview">
            <% } else { %>
              <div class="logo-placeholder" id="imagePlaceholder"><i class="fas fa-image"></i></div>
            <% } %>
            <input type="file" name="logo" id="logoInput" accept="image/*" style="display:none;">
            <input type="hidden" name="croppedImageData" id="croppedImageData">
            <br>
            <button type="button" class="btn-secondary-app" style="margin-top:8px;" onclick="document.getElementById('logoInput').click()">
              <i class="fas fa-upload"></i> Upload Logo
            </button>
          </div>

          <div class="section-heading"><i class="fas fa-university"></i> Bank Accounts</div>
          <div class="form-two-col">
            <div>
              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#888; margin-bottom:12px;">Primary Account</div>
              <div class="form-group">
                <label>Account Name</label>
                <input type="text" name="primaryBankAccountName" class="form-control" value="<%= admin.primaryAccount?.bankAccountName || '' %>">
              </div>
              <div class="form-group">
                <label>Account Number</label>
                <input type="text" name="primaryAccountNumber" class="form-control" value="<%= admin.primaryAccount?.accountNumber || '' %>">
              </div>
              <div class="form-group">
                <label>Bank Name</label>
                <input type="text" name="primaryBankName" class="form-control" value="<%= admin.primaryAccount?.bankName || '' %>">
              </div>
            </div>
            <div>
              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#888; margin-bottom:12px;">Secondary Account (optional)</div>
              <div class="form-group">
                <label>Account Name</label>
                <input type="text" name="secondaryBankAccountName" class="form-control" value="<%= admin.secondaryAccount?.bankAccountName || '' %>">
              </div>
              <div class="form-group">
                <label>Account Number</label>
                <input type="text" name="secondaryAccountNumber" class="form-control" value="<%= admin.secondaryAccount?.accountNumber || '' %>">
              </div>
              <div class="form-group">
                <label>Bank Name</label>
                <input type="text" name="secondaryBankName" class="form-control" value="<%= admin.secondaryAccount?.bankName || '' %>">
              </div>
            </div>
          </div>

          <div class="section-heading"><i class="fas fa-share-alt"></i> Social Media</div>
          <div class="form-three-col">
            <div class="form-group">
              <label>Facebook</label>
              <input type="url" name="facebook" class="form-control" value="<%= admin.facebook || '' %>" placeholder="https://facebook.com/...">
            </div>
            <div class="form-group">
              <label>Instagram</label>
              <input type="url" name="instagram" class="form-control" value="<%= admin.instagram || '' %>" placeholder="https://instagram.com/...">
            </div>
            <div class="form-group">
              <label>X (Twitter)</label>
              <input type="url" name="twitter" class="form-control" value="<%= admin.twitter || '' %>" placeholder="https://twitter.com/...">
            </div>
          </div>

          <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-primary-app"><i class="fas fa-save"></i> Save Changes</button>
          </div>
        </form>
      </div>

    </div>
  </main>
</div>

<!-- Crop Modal -->
<div class="crop-modal-overlay" id="cropModalOverlay">
  <div class="crop-modal">
    <h4>Crop & Resize Logo</h4>
    <img id="imageToCrop" src="#" alt="Crop preview">
    <div class="crop-modal-actions">
      <button type="button" class="btn-primary-app" id="cropButton"><i class="fas fa-crop"></i> Crop & Save</button>
      <button type="button" class="btn-secondary-app" id="cancelCropBtn">Cancel</button>
    </div>
  </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
<script>
  // Sidebar toggle
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  // VAT toggle
  document.getElementById('applyVat').addEventListener('change', function() {
    document.getElementById('vatRateGroup').style.display = this.checked ? 'block' : 'none';
  });

  // Logo cropper
  let cropper;
  const logoInput = document.getElementById('logoInput');
  const cropOverlay = document.getElementById('cropModalOverlay');
  const imageToCrop = document.getElementById('imageToCrop');

  logoInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(ev) {
      imageToCrop.src = ev.target.result;
      cropOverlay.classList.add('active');
      setTimeout(function() {
        if (cropper) cropper.destroy();
        cropper = new Cropper(imageToCrop, {
          aspectRatio: NaN, viewMode: 1, autoCropArea: 0.8,
          responsive: true, minContainerHeight: 300
        });
      }, 200);
    };
    reader.readAsDataURL(file);
  });

  document.getElementById('cropButton').addEventListener('click', function() {
    if (cropper) {
      const canvas = cropper.getCroppedCanvas({ maxWidth: 600, maxHeight: 400 });
      const dataUrl = canvas.toDataURL('image/png');
      const preview = document.getElementById('imagePreview');
      if (preview) { preview.src = dataUrl; }
      else {
        const img = document.createElement('img');
        img.id = 'imagePreview'; img.className = 'logo-preview'; img.src = dataUrl;
        const ph = document.getElementById('imagePlaceholder');
        if (ph) ph.replaceWith(img);
      }
      document.getElementById('croppedImageData').value = dataUrl;
      cropOverlay.classList.remove('active');
    }
  });

  document.getElementById('cancelCropBtn').addEventListener('click', function() {
    cropOverlay.classList.remove('active');
    if (cropper) { cropper.destroy(); cropper = null; }
    logoInput.value = '';
  });
</script>
</body>
</html>
