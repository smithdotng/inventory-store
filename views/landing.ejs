    </script>
    <!-- Menu toggle -->
    <!-- Search Functionality -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchOverlay  = document.getElementById('searchOverlay');
            const searchToggleBtn = document.getElementById('searchToggleBtn');
            const searchCloseBtn  = document.getElementById('searchCloseBtn');
            const searchForm     = document.getElementById('searchForm');
            const searchInput    = searchForm.querySelector('input[name="q"]');
            const searchResults  = searchForm.querySelector('.mil-search-results');

            function openSearch() {
                searchOverlay.classList.add('active');
                setTimeout(() => searchInput.focus(), 50);
            }
            function closeSearch() {
                searchOverlay.classList.remove('active');
                searchResults.classList.remove('active');
                searchInput.value = '';
            }

            searchToggleBtn.addEventListener('click', openSearch);
            searchCloseBtn.addEventListener('click', closeSearch);
            searchOverlay.addEventListener('click', (e) => {
                if (e.target === searchOverlay) closeSearch();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeSearch();
            });

            // Create search tabs
            const createSearchTabs = () => {
                const tabsHtml = `
                    <div class="mil-search-tabs">
                        <button class="mil-search-tab active" data-type="all">All</button>
                        <button class="mil-search-tab" data-type="stores">Stores</button>
                        <button class="mil-search-tab" data-type="products">Products</button>
                    </div>
                `;
                searchResults.insertAdjacentHTML('afterbegin', tabsHtml);
            };

            // Initialize tabs
            createSearchTabs();

            // Debounce function
            const debounce = (func, wait) => {
                let timeout;
                return (...args) => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(this, args), wait);
                };
            };

            // Fetch data based on active tab
            const fetchSearchResults = async (query, type) => {
                try {
                    const endpoint = `/api/search/suggestions?q=${encodeURIComponent(query)}&type=${type}`;
                    const response = await fetch(endpoint);
                    if (!response.ok) throw new Error('Network response was not ok');
                    return await response.json();
                } catch (error) {
                    console.error(`Error fetching suggestions:`, error);
                    throw error;
                }
            };

            // Display suggestion results
            const displaySuggestions = (data, type) => {
                const sectionId = `mil-search-${type}`;
                let section = document.getElementById(sectionId);
                
                if (!section) {
                    section = document.createElement('div');
                    section.id = sectionId;
                    section.className = `mil-search-section ${type === 'all' ? 'active' : ''}`;
                    
                    const header = document.createElement('div');
                    header.className = 'mil-search-section-header';
                    header.textContent = type === 'all' ? 'All Results' : 
                                       type === 'stores' ? 'Stores' : 'Products';
                    
                    section.appendChild(header);
                    searchResults.appendChild(section);
                }
                
                section.innerHTML = ''; // Clear previous content
                
                // Re-add header
                const header = document.createElement('div');
                header.className = 'mil-search-section-header';
                header.textContent = type === 'all' ? 'All Results' : 
                                   type === 'stores' ? 'Stores' : 'Products';
                section.appendChild(header);
                
                if (data.length === 0) {
                    const noResults = document.createElement('div');
                    noResults.className = 'mil-search-no-results';
                    noResults.textContent = `No ${type} found`;
                    section.appendChild(noResults);
                    return;
                }
                
                data.forEach(item => {
                    const resultItem = document.createElement('a');
                    resultItem.className = 'mil-search-result-item mil-up';
                    
                    if (type === 'stores' || (type === 'all' && item.type === 'store')) {
                        resultItem.href = `/store/${item.username}`;
                        resultItem.innerHTML = `
                            ${item.logo ? `<img src="${item.logo}" alt="${item.businessName || 'Store'} logo">` : '<img src="/img/placeholder-store.png" alt="Store placeholder">'}
                            <div>
                                <h6>${item.businessName || 'Unnamed Store'}</h6>
                                <p>@${item.username || 'unknown'}</p>
                            </div>
                            <div class="mil-search-arrow">→</div>
                        `;
                    } else if (type === 'products' || (type === 'all' && item.type === 'product')) {
                        resultItem.href = `/store/${item.storeUsername}?product=${item._id}`;
                        resultItem.innerHTML = `
                            ${item.image ? `<img src="${item.image}" alt="${item.name}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">` : '<img src="/img/placeholder-product.png" alt="Product placeholder" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: #f0f0f0;">'}
                            <div style="flex: 1;">
                                <h6>${item.name || 'Unnamed Product'}</h6>
                                <p style="font-size: 12px; color: #666; margin: 2px 0;">₦${item.cost ? parseFloat(item.cost).toLocaleString('en-US') : 'Price not set'}</p>
                                ${item.storeName ? `<p style="font-size: 11px; color: #888;">From: ${item.storeName}</p>` : ''}
                            </div>
                            <div class="mil-search-arrow">→</div>
                        `;
                    } else if (type === 'all') {
                        // For "all" type, show mixed results
                        resultItem.href = item.type === 'store' ? `/store/${item.username}` : `/store/${item.storeUsername}?product=${item._id}`;
                        resultItem.innerHTML = `
                            ${item.logo || item.image ? `<img src="${item.logo || item.image}" alt="${item.businessName || item.name}" style="width: 40px; height: 40px; object-fit: cover; border-radius: ${item.type === 'store' ? '50%' : '4px'};">` : 
                            `<img src="${item.type === 'store' ? '/img/placeholder-store.png' : '/img/placeholder-product.png'}" alt="${item.type === 'store' ? 'Store' : 'Product'} placeholder" style="width: 40px; height: 40px; object-fit: cover; border-radius: ${item.type === 'store' ? '50%' : '4px'}; background: #f0f0f0;">`}
                            <div style="flex: 1;">
                                <h6>${item.businessName || item.name || 'Unnamed'}</h6>
                                <p style="font-size: 12px; color: #666; margin: 2px 0;">
                                    ${item.type === 'store' ? `@${item.username}` : `₦${item.cost ? parseFloat(item.cost).toLocaleString('en-US') : 'Price not set'}`}
                                </p>
                                ${item.type === 'product' && item.storeName ? `<p style="font-size: 11px; color: #888;">From: ${item.storeName}</p>` : ''}
                            </div>
                            <div class="mil-search-arrow">→</div>
                        `;
                    }
                    
                    section.appendChild(resultItem);
                });
                
                // Add "View all results" link
                const viewAllLink = document.createElement('a');
                viewAllLink.href = `/search?q=${encodeURIComponent(query)}&type=${type}`;
                viewAllLink.className = 'mil-search-result-item mil-up';
                viewAllLink.style.justifyContent = 'center';
                viewAllLink.style.fontWeight = '600';
                viewAllLink.style.color = '#008B8B';
                viewAllLink.innerHTML = `View all ${type} results →`;
                section.appendChild(viewAllLink);
            };

            // Handle tab switching
            searchResults.addEventListener('click', (e) => {
                if (e.target.classList.contains('mil-search-tab')) {
                    // Update active tab
                    document.querySelectorAll('.mil-search-tab').forEach(tab => {
                        tab.classList.remove('active');
                    });
                    e.target.classList.add('active');
                    
                    // Show active section
                    const type = e.target.dataset.type;
                    document.querySelectorAll('.mil-search-section').forEach(section => {
                        section.classList.remove('active');
                    });
                    const activeSection = document.getElementById(`mil-search-${type}`);
                    if (activeSection) {
                        activeSection.classList.add('active');
                    }
                    
                    // If there's a search query, fetch suggestions for the new tab
                    const query = searchInput.value.trim();
                    if (query) {
                        fetchAndShowSuggestions(query, type);
                    }
                }
            });

            // Main suggestion function
            const fetchAndShowSuggestions = async (query, type = 'all') => {
                if (!query || query.length < 2) {
                    searchResults.classList.remove('active');
                    return;
                }
                
                try {
                    const data = await fetchSearchResults(query, type);
                    displaySuggestions(data, type);
                    searchResults.classList.add('active');
                } catch (error) {
                    const sectionId = `mil-search-${type}`;
                    let section = document.getElementById(sectionId);
                    
                    if (!section) {
                        section = document.createElement('div');
                        section.id = sectionId;
                        section.className = `mil-search-section ${type === 'all' ? 'active' : ''}`;
                        
                        const header = document.createElement('div');
                        header.className = 'mil-search-section-header';
                        header.textContent = type === 'all' ? 'All Results' : 
                                           type === 'stores' ? 'Stores' : 'Products';
                        section.appendChild(header);
                        
                        searchResults.appendChild(section);
                    }
                    
                    const errorMsg = document.createElement('div');
                    errorMsg.className = 'mil-search-no-results';
                    errorMsg.textContent = 'Error loading suggestions';
                    section.appendChild(errorMsg);
                    
                    searchResults.classList.add('active');
                }
            };

            // Debounced search for suggestions
            const debouncedSuggestions = debounce((query) => {
                const activeTab = document.querySelector('.mil-search-tab.active');
                const type = activeTab ? activeTab.dataset.type : 'all';
                fetchAndShowSuggestions(query, type);
            }, 200);

            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.trim();
                debouncedSuggestions(query);
            });

            // Handle form submission - redirect to search page
            searchForm.addEventListener('submit', (e) => {
                const query = searchInput.value.trim();
                if (!query) {
                    e.preventDefault();
                    return;
                }
                
                // Get active tab to determine type
                const activeTab = document.querySelector('.mil-search-tab.active');
                const type = activeTab ? activeTab.dataset.type : 'all';
                
                // Add type parameter to form
                const typeInput = document.createElement('input');
                typeInput.type = 'hidden';
                typeInput.name = 'type';
                typeInput.value = type;
                searchForm.appendChild(typeInput);
                
                // Form will submit normally to /search?q=query&type=type
            });

            // Hide results when clicking outside the form (but inside the overlay)
            searchOverlay.addEventListener('click', (e) => {
                if (!searchForm.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });

            // Show suggestions when input is focused (if there's a query)
            searchInput.addEventListener('focus', () => {
                const query = searchInput.value.trim();
                if (query && query.length >= 2) {
                    const activeTab = document.querySelector('.mil-search-tab.active');
                    const type = activeTab ? activeTab.dataset.type : 'all';
                    
                    // Check if we already have suggestions for this type
                    const section = document.getElementById(`mil-search-${type}`);
                    if (section && section.children.length > 0) {
                        searchResults.classList.add('active');
                    } else if (query.length >= 2) {
                        // Fetch fresh suggestions
                        fetchAndShowSuggestions(query, type);
                    }
                }
            });

            // Keyboard navigation for suggestions
            searchInput.addEventListener('keydown', (e) => {
                if (!searchResults.classList.contains('active')) return;
                
                const items = searchResults.querySelectorAll('.mil-search-result-item');
                if (items.length === 0) return;
                
                let currentIndex = -1;
                items.forEach((item, index) => {
                    if (item === document.activeElement) {
                        currentIndex = index;
                    }
                });
                
                switch(e.key) {
                    case 'ArrowDown':
                        e.preventDefault();
                        const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
                        items[nextIndex].focus();
                        break;
                    case 'ArrowUp':
                        e.preventDefault();
                        const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
                        items[prevIndex].focus();
                        break;
                    case 'Escape':
                        searchResults.classList.remove('active');
                        searchInput.focus();
                        break;
                }
            });
        });
    </script>
    <!-- Subscription Form Handling -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const subscribeForm = document.getElementById('subscribeForm');
            const errorDiv = document.querySelector('.mil-subscribe-error');
            const successDiv = document.querySelector('.mil-subscribe-success');
            const formContainer = document.querySelector('.mil-subscribe-form');

            subscribeForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = subscribeForm.email.value.trim();
                
                // Clear previous messages
                errorDiv.style.display = 'none';
                errorDiv.textContent = '';
                
                // Basic validation
                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errorDiv.textContent = 'Please enter a valid email address';
                    errorDiv.style.display = 'block';
                    return;
                }

                try {
                    const response = await fetch('/api/subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email })
                    });

                    const data = await response.json();
                    
                    if (response.ok) {
                        // Hide form and show success message
                        formContainer.style.display = 'none';
                        successDiv.style.display = 'block';
                        
                        // Optionally reset the form
                        subscribeForm.reset();
                    } else {
                        // Show error above the input field
                        errorDiv.textContent = data.message || 'Subscription failed. Please try again.';
                        errorDiv.style.display = 'block';
                    }
                } catch (error) {
                    errorDiv.textContent = 'Network error. Please try again.';
                    errorDiv.style.display = 'block';
                    console.error('Subscription error:', error);
                }
            });
        });
    </script>
    <!-- Service Worker -->
    <script>
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
    <script>
        (function() {
            function initMenu() {
                var openBtn  = document.getElementById('shedMenuOpen');
                var closeBtn = document.getElementById('shedMenuClose');
                var frame    = document.getElementById('shedMenuFrame');
                if (openBtn)  openBtn.onclick  = function() { frame.classList.add('mil-active'); };
                if (closeBtn) closeBtn.onclick = function() { frame.classList.remove('mil-active'); };
                if (frame) frame.addEventListener('click', function(e) {
                    if (e.target === frame) frame.classList.remove('mil-active');
                });
            }
            document.addEventListener('DOMContentLoaded', initMenu);
            if (window.swup) window.swup.on('contentReplaced', initMenu);
        })();
    </script>
</body>

</html>