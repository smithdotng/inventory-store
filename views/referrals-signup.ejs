    <!-- Fallback for .row visibility -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const row = document.querySelector('.mil-banner-content .row');
            if (row) {
                row.style.display = 'flex';
                row.style.visibility = 'visible';
                row.style.opacity = '1';
            }
        });
    </script>
    <!-- Mobile Menu Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const menuBtn = document.querySelector('.mil-menu-btn');
            const menu = document.querySelector('.mil-main-menu');
            const menuItems = document.querySelectorAll('.mil-has-children');

            menuBtn.addEventListener('click', () => {
                menu.classList.toggle('active');
            });

            // Toggle submenus on mobile
            menuItems.forEach(item => {
                item.addEventListener('click', (e) => {
                    if (window.innerWidth < 992) {
                        e.preventDefault();
                        item.classList.toggle('active');
                    }
                });
            });
        });
    </script>
    <script>
        // Service Worker
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register('/sw.js', { scope: '/' });
        }
    </script>
