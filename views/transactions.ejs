<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Transactions | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Transactions</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    
    
  </head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="/images/logo.png" alt="Shedfactory Business Solutions">
    </div>
    
    <h2>Welcome, <%= username %>!</h2>
    <a href="/admin/sales-form">Sell</a>
    <a href="/store-view">View Store</a>
    <a href="/update-stock">Update Stock</a>
    <a href="/create-outlet">Create Outlet</a>
    <a href="/invoices">Invoices</a>
    <a href="/transactions">Transactions</a>
    <a href="/customers">Customers</a>
    <a href="/admin-logout">Log Out</a>
  </div>

  <!-- Toggle Button -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent">
    <div class="welcome-message">Welcome, <%= username %>!</div>
    <div class="container">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
      </div>
      <h1>Transactions</h1>

      <!-- Business Details -->
      <div class="business-details">
        <p><strong>Business Name:</strong> <%= admin.businessName || 'N/A' %></p>
        <p><strong>Email:</strong> <%= admin.email || 'N/A' %></p>
        <p><strong>Currency:</strong> <%= admin.currency || 'N/A' %></p>
      </div>

      <!-- Transactions Table -->
      <div class="table-section">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Customer Name</th>
              <th>Items</th>
              <th>Total Amount</th>
              <th>Payment Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(transaction => { %>
              <tr>
                <!-- Date -->
                <td><%= transaction.date ? new Date(transaction.date).toLocaleDateString() : 'N/A' %></td>

                <!-- Customer Name -->
                <td><%= transaction.customerName || 'N/A' %></td>

                <!-- Items -->
                <td>
                  <ul>
                    <% if (transaction.items && transaction.items.length > 0) { %>
                      <% transaction.items.forEach(item => { %>
                        <li>
                          <%= item.itemName %> 
                          (Qty: <%= item.quantity %>, Cost: <%= admin.currency %> <%= (item.unitCost || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>)
                        </li>
                      <% }) %>
                    <% } else { %>
                      <li>No items found.</li>
                    <% } %>
                  </ul>
                </td>

                <!-- Total Amount -->
                <td>
                  <%= admin.currency %> 
                  <% if (transaction.totalAmount !== undefined && transaction.totalAmount !== null) { %>
                    <%= transaction.totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  <% } else { %>
                    0.00
                  <% } %>
                </td>

                <!-- Payment Status -->
                <td><%= transaction.paymentStatus || 'Pending' %></td>

                <!-- Actions -->
                <td>
                  <div class="actions-container">
                    <% if (transaction.paymentStatus === 'Pending') { %>
                      <form action="/transactions/mark-paid/<%= transaction._id %>" method="POST" style="display: inline;">
                        <button type="submit" class="mark-paid-btn">Mark as Paid</button>
                      </form>
                    <% } %>
                    <a href="/receipt/<%= transaction._id %>" class="download-btn">Download Receipt</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Toggle sidebar visibility (only active on small screens)
    toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
        sidebar.classList.toggle('hidden');
        if (sidebar.classList.contains('visible')) {
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        } else {
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        }
      });

    // Set initial sidebar state
    function setSidebarState() {
      if (window.innerWidth <= 768) {
        sidebar.classList.add('hidden');
        mainContent.style.marginLeft = '0';
        mainContent.style.width = '100%';
      } else {
        sidebar.classList.remove('hidden');
        sidebar.classList.remove('visible');
        mainContent.style.marginLeft = '200px';
        mainContent.style.width = 'calc(100% - 200px)';
      }
    }
    setSidebarState();
    window.addEventListener('resize', setSidebarState);

    // Table editing functions
    function toggleEdit(id) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const editBtn = row.querySelector('.edit-btn');
      const updateBtn = row.querySelector('.update-btn');
      const cancelBtn = row.querySelector('.cancel-btn');

      stockInput.disabled = false;
      costInput.disabled = false;
      editBtn.style.display = 'none';
      updateBtn.style.display = 'inline';
      cancelBtn.style.display = 'inline';
    }

    function updateHiddenInputs(id) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const hiddenStock = row.querySelector('input[name="stock"]');
      const hiddenCost = row.querySelector('input[name="cost"]');
      const form = row.querySelector('form');

      hiddenStock.value = stockInput.value;
      hiddenCost.value = costInput.value;
      form.submit(); // Submit the form to update the stock
    }

    function cancelEdit(id, originalStock, originalCost) {
      const row = document.getElementById(`row-${id}`);
      const stockInput = row.querySelector('.stock-input');
      const costInput = row.querySelector('.cost-input');
      const editBtn = row.querySelector('.edit-btn');
      const updateBtn = row.querySelector('.update-btn');
      const cancelBtn = row.querySelector('.cancel-btn');

      stockInput.value = originalStock;
      costInput.value = originalCost;
      stockInput.disabled = true;
      costInput.disabled = true;
      editBtn.style.display = 'inline';
      updateBtn.style.display = 'none';
      cancelBtn.style.display = 'none';
    }
  </script>
</body>
</html>