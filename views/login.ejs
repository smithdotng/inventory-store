<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Sign In</title>

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Ashley CSS (same stack as landing page) -->
  <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
  <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Jost', sans-serif; }
    body { display: flex; min-height: 100vh; background: #0d0d1a; }

    /* ── Left dark panel ── */
    .auth-left {
      width: 45%;
      background: #0d0d1a;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 70px 60px;
      position: relative;
      overflow: hidden;
    }
    .auth-left::before {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 380px; height: 380px;
      border-radius: 50%;
      background: rgba(0, 139, 139, 0.07);
      pointer-events: none;
    }
    .auth-left::after {
      content: '';
      position: absolute;
      bottom: -60px; left: -40px;
      width: 280px; height: 280px;
      border-radius: 50%;
      background: rgba(0, 139, 139, 0.05);
      pointer-events: none;
    }
    .auth-logo { margin-bottom: 52px; }
    .auth-logo img { width: 130px; height: auto; filter: brightness(1.1); }
    .auth-tagline h1 {
      font-size: 2.4rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.25;
      margin-bottom: 18px;
    }
    .auth-tagline h1 span { color: #008B8B; }
    .auth-tagline p { color: rgba(255,255,255,0.55); font-size: 1rem; line-height: 1.7; }
    .auth-features { margin-top: 48px; display: flex; flex-direction: column; gap: 14px; }
    .auth-feature-item { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.7); font-size: 0.9rem; }
    .auth-feature-item i { color: #008B8B; font-size: 1rem; width: 18px; }

    /* ── Right form panel ── */
    .auth-right {
      flex: 1;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 40px;
    }
    .auth-form-box { width: 100%; max-width: 420px; }
    .auth-form-box h2 {
      font-size: 2rem;
      font-weight: 700;
      color: #0d0d1a;
      margin-bottom: 6px;
    }
    .auth-form-box .subtitle { color: #888; font-size: 0.95rem; margin-bottom: 36px; }

    .form-group { margin-bottom: 22px; }
    .form-group label {
      display: block;
      font-weight: 600;
      font-size: 0.85rem;
      color: #444;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .form-control {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid #e5e5e5;
      border-radius: 8px;
      font-size: 0.97rem;
      font-family: 'Jost', sans-serif;
      color: #222;
      background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: #008B8B;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(0,139,139,0.1);
    }
    .btn-auth {
      width: 100%;
      padding: 14px;
      background: #008B8B;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      font-family: 'Jost', sans-serif;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-top: 8px;
    }
    .btn-auth:hover { background: #006f6f; transform: translateY(-1px); }
    .btn-auth:active { transform: translateY(0); }

    .auth-links { text-align: center; margin-top: 28px; color: #888; font-size: 0.9rem; }
    .auth-links a { color: #008B8B; font-weight: 500; text-decoration: none; }
    .auth-links a:hover { text-decoration: underline; }
    .auth-links .divider { margin: 0 10px; color: #ccc; }

    .alert-error {
      background: #fff5f5;
      border: 1px solid #ffd0d0;
      color: #c0392b;
      padding: 13px 16px;
      border-radius: 8px;
      margin-bottom: 24px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .alert-success {
      background: #f0fff4;
      border: 1px solid #b2f2c9;
      color: #1a7a3c;
      padding: 13px 16px;
      border-radius: 8px;
      margin-bottom: 24px;
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      body { flex-direction: column; }
      .auth-left { display: none; }
      .auth-right { padding: 48px 24px; }
    }
  </style>
</head>
<body>

  <!-- Left: Dark branding panel -->
  <div class="auth-left">
    <div class="auth-logo">
      <img src="/images/logo.png" alt="Shed">
    </div>
    <div class="auth-tagline">
      <h1>Organize Your Business,<br>Like a <span>Well-Stocked Shed.</span></h1>
      <p>The all-in-one platform to sell anywhere<br>and manage everything.</p>
    </div>
    <div class="auth-features">
      <div class="auth-feature-item"><i class="fas fa-store"></i> Point of Sale & Online Storefront</div>
      <div class="auth-feature-item"><i class="fas fa-boxes"></i> Inventory & Stock Management</div>
      <div class="auth-feature-item"><i class="fas fa-users"></i> Customer & Outlet Management</div>
      <div class="auth-feature-item"><i class="fas fa-chart-bar"></i> Sales Reports & Invoices</div>
    </div>
  </div>

  <!-- Right: Form panel -->
  <div class="auth-right">
    <div class="auth-form-box">
      <h2>Welcome Back</h2>
      <p class="subtitle">Sign in to your Shed account to continue</p>

      <% if (error) { %>
        <div class="alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="alert-success"><i class="fas fa-check-circle"></i> <%= message %></div>
      <% } %>

      <form action="/admin-login" method="POST">
        <div class="form-group">
          <label for="usernameOrEmail">Username or Email</label>
          <input
            type="text"
            class="form-control"
            id="usernameOrEmail"
            name="usernameOrEmail"
            placeholder="Enter your username or email"
            required
            autofocus
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
          >
        </div>

        <button type="submit" class="btn-auth">
          Sign In &nbsp;<i class="fas fa-arrow-right"></i>
        </button>
      </form>

      <div class="auth-links">
        <p>
          <a href="/admin-register">Create a Shed account</a>
          <span class="divider">|</span>
          <a href="/forgot-password">Forgot password?</a>
        </p>
        <p style="margin-top:12px;">
          <a href="/outlet-login">Sign in as Outlet Manager →</a>
        </p>
      </div>
    </div>
  </div>

  <script src="/js/plugins/jquery.min.js"></script>
</body>
</html>
