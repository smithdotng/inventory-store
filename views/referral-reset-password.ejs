                display: block;
            }
            .mil-main-menu ul {
                flex-direction: column;
                padding: 10px;
            }
            .mil-main-menu ul li {
                margin: 5px 0;
            }
            .mil-main-menu ul li ul {
                position: static;
                box-shadow: none;
                display: none;
            }
            .mil-main-menu ul li.mil-has-children.active > ul {
                display: flex;
            }
            .mil-menu-btn {
                display: block;
            }
            .mil-subscribe-form {
                width: 100%;
            }
            .mil-search-results {
                width: 100%;
            }
        }
        .mil-content {
            padding-top: 80px;
            padding-bottom: 30px;
        }
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-main-menu ul li::before,
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        .mil-accordion-content ol li {
            padding-left: 30px;
            margin-bottom: 10px;
        }
        .mil-accordion-content ol li::before {
            font-size: 16px;
            color: #008B8B;
        }
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
        }
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-login-links {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
        }
        .mil-login-links p {
            margin: 5px 0;
            color: #333;
        }
        .mil-login-links a {
            color: rgb(235, 166, 17);
            text-decoration: none;
            font-weight: 500;
        }
        .mil-login-links a:hover {
            text-decoration: underline;
        }
        .mil-promo-image {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 15px;
        }
        @media (max-width: 768px) {
            .mil-form-group label {
