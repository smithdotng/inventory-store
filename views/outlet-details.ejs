    <!-- Bootstrap Grid CSS -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="/css/plugins/font-awesome.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css">
    <!-- Fancybox CSS -->
    <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
    <!-- Ashley SCSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Inline CSS -->
    <style>
        /* Ensure .row is visible */
        .mil-banner-content .row {
            display: flex;
            visibility: visible;
            opacity: 1;
            max-height: none;
        }
        .mil-banner-content .col-md-7.col-lg-5 {
            display: block;
            visibility: visible;
            opacity: 1;
        }
        .mil-banner-content .col-md-7.col-lg-5 p {
            display: block;
            visibility: visible;
            opacity: 1;
            color: #fff;
        }
        /* Banner starts at top */
        .mil-banner {
            margin-top: 0;
            padding-top: 0;
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
        }
        /* Content padding */
        .mil-content {
            padding-bottom: 30px;
        }
        /* Footer adjustments */
        footer.mil-dark-bg {
            padding-bottom: 0;
        }
        .mil-light-soft {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            color: #fff !important;
            font-size: 16px !important;
        }
        .mil-soft-bg .mil-light-soft {
            color: #333 !important;
        }
        .mil-banner-content, .mil-content, .mil-footer, .mil-about, .mil-services-grid {
            visibility: visible !important;
            opacity: 1 !important;
        }
        .mil-up {
            transform: none !important;
            opacity: 1 !important;
        }
        /* Add tick to all <li> elements */
        li {
            position: relative;
            padding-left: 25px;
        }
        li::before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #008B8B;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
        }
        .mil-footer-menu ul li::before,
        .mil-social-icons li::before {
            content: none;
        }
        .mil-menu-list li::before {
            color: #fff;
        }
        .mil-accordion-content ol li {
            padding-left: 30px;
            margin-bottom: 10px;
        }
        .mil-accordion-content ol li::before {
            font-size: 16px;
            color: #008B8B;
        }
        /* Form styling */
        .mil-form-group {
            margin-bottom: 15px;
        }
        .mil-form-group label {
            color: #333;
            margin-bottom: 6px;
            display: block;
            font-weight: 500;
            font-size: 13px;
            padding-top: 10px;
        }
        .mil-form-control {
            background-color: white;
            border: 1px solid #ced4da;
            color: #495057;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            font-size: 13px;
            padding: 0.375rem 0.75rem;
            height: calc(1.5em + 0.75rem + 2px);
            width: 100%;
            box-sizing: border-box;
            border-radius: 4px;
            text-transform: none !important;
        }
        .mil-form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            outline: none;
        }
        .mil-form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -5px;
            margin-left: -5px;
        }
        .mil-form-col {
            flex: 1;
            padding-right: 5px;
            padding-left: 5px;
            min-width: 0;
        }
        /* Alert styling */
        .mil-alert {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            align-items: center;
        }
        .mil-alert i {
            margin-right: 8px;
        }
        .mil-alert.success {
            background-color: #d4edda;
            color: #155724;
        }
        /* Button styling */
        .mil-button {
            background-color: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 500;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .mil-button:hover {
            background-color: #fff;
            color: rgb(235, 166, 17);
            border: 2px solid rgb(235, 166, 17);
        }
        .mil-button i {
            margin-left: 8px;
        }
        .mil-button.transactions-btn {
            background-color: rgb(0, 123, 255);
            color: #fff;
        }
        .mil-button.transactions-btn:hover {
            background-color: #fff;
            color: rgb(0, 123, 255);
            border: 2px solid rgb(0, 123, 255);
        }
        .mil-button.customers-btn {
            background-color: rgb(255, 152, 0);
            color: #fff;
        }
        .mil-button.customers-btn:hover {
            background-color: #fff;
            color: rgb(255, 152, 0);
            border: 2px solid rgb(255, 152, 0);
        }
        .mil-button.cancel-btn {
            background-color: rgb(108, 117, 125);
            color: #fff;
        }
        .mil-button.cancel-btn:hover {
            background-color: #fff;
            color: rgb(108, 117, 125);
            border: 2px solid rgb(108, 117, 125);
        }
        /* Sidebar styling */
        .mil-wrapper .mil-sidebar {
            width: 250px;
            background-color: #f8f8f8 !important;
            opacity: 1 !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 20px;
            z-index: 1001;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }
        .mil-wrapper .mil-sidebar.hidden {
            transform: translateX(-100%);
        }
        .mil-wrapper .mil-sidebar * {
            background-color: transparent !important;
            opacity: 1 !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container {
            text-align: center;
            margin-bottom: 20px;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar .mil-logo-container img {
            width: 100px;
            height: auto;
        }
        .mil-wrapper .mil-sidebar h2 {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 500;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            border-radius: 4px;
            transition: background 0.3s ease;
            background: none !important;
        }
        .mil-wrapper .mil-sidebar a:hover {
            background: rgb(235, 166, 17) !important;
            color: #fff;
        }
        .mil-wrapper .mil-sidebar a.active {
            background: rgb(235, 166, 17) !important;
            color: #fff;
            font-weight: bold;
        }
        /* Toggle button */
        .mil-toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            background: rgb(235, 166, 17);
            color: #333;
            border: none;
            padding: 8px 12px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            z-index: 1002;
        }
        /* Main content */
        .mil-main-content {
            padding: 20px;
            transition: margin-left 0.3s ease;
            width: 100%;
            box-sizing: border-box;
        }
        .mil-main-content.full-width {
            margin-left: 0;
        }
        /* Center the main content container */
        .mil-about .container {
            display: flex;
            justify-content: center;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .mil-sidebar:not(.hidden) ~ .mil-content .mil-about .container {
            margin-left: calc(250px + ((100% - 250px - 800px) / 2));
            margin-right: auto;
        }
        .mil-sidebar.hidden ~ .mil-content .mil-about .container {
            margin-left: auto;
            margin-right: auto;
        }
        /* Outlet details styling */
        .mil-outlet-details {
            background: #fff;
            padding: 20px;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }
        .mil-outlet-details h5 {
            color: #333;
            font-size: 14px;
            margin-bottom: 15px;
        }
        .mil-outlet-details p {
            margin: 10px 0;
            font-size: 13px;
            color: #333;
            display: flex;
            align-items: center;
        }
        .mil-outlet-details p i {
            margin-right: 8px;
            color: #008B8B;
        }
        .mil-outlet-details p strong {
            width: 150px;
            font-weight: 500;
            color: #333;
        }
        /* Table styling */
        .mil-table-section table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .mil-table-section th,
        .mil-table-section td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #eee;
            font-size: 13px;
            color: #333;
        }
        .mil-table-section th {
            background: rgb(235, 166, 17);
            color: #fff;
            font-weight: 500;
        }
        .mil-table-section tr:hover {
            background: #f5f5f5;
        }
        .mil-table-section .no-data {
            text-align: center;
            font-size: 13px;
            color: #333;
            padding: 20px;
        }
        /* Button group */
        .mil-button-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        /* Responsive Design */
        @media (max-width: 768px) {
            .mil-wrapper .mil-sidebar {
                width: 200px;
                background-color: #f8f8f8 !important;
                opacity: 1 !important;
            }
            .mil-main-content {
                margin-left: 0;
            }
            .mil-main-content.full-width {
                margin-left: 0;
            }
            .mil-outlet-details p {
                font-size: 12px;
                flex-direction: column;
                align-items: flex-start;
            }
            .mil-outlet-details p strong {
                width: auto;
                margin-bottom: 5px;
            }
            .mil-table-section table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
            .mil-table-section th,
            .mil-table-section td {
                font-size: 12px;
                padding: 8px;
            }
            .mil-button {
                font-size: 12px;
                padding: 8px 16px;
            }
            .mil-button-group {
                flex-direction: column;
                align-items: stretch;
            }
            .mil-button-group .mil-button {
                width: 100%;
            }
            .mil-about .container {
                margin-left: auto;
                margin-right: auto;
                max-width: 100%;
                padding-left: 15px;
                padding-right: 15px;
            }
        }
    </style>

    <title>Shed | Outlet Details</title>
</head>
<body>
    <!-- wrapper -->
    <div class="mil-wrapper" id="top">
        <!-- scrollbar progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scrollbar progress end -->

        <!-- sidebar -->
        <div class="mil-sidebar" id="sidebar">
            <div class="mil-logo-container">
                <img src="/images/logo.png" alt="Shed Logo">
            </div>
            <h2 class="mil-up">Welcome, <%= username %>!</h2>
            <a href="/pos" class="mil-up"><i class="fas fa-shopping-bag"></i> Point of Sale</a>
            <a href="/update-stock" class="mil-up"><i class="fas fa-boxes"></i> Manage Inventory</a>
            <a href="/invoices" class="mil-up"><i class="fas fa-file-invoice"></i> Generate Invoice</a>
            <a href="/transactions" class="mil-up"><i class="fas fa-chart-bar"></i> View Transactions</a>
            <a href="/customers" class="mil-up"><i class="fas fa-users"></i> Customers</a>
            <a href="/home" class="mil-up active"><i class="fas fa-store"></i> Manage Outlets</a>
            <a href="/profile" class="mil-up"><i class="fas fa-user"></i> Profile</a>
            <a href="/admin-logout" class="mil-up"><i class="fas fa-power-off"></i> Log Out</a>
        </div>
        <!-- sidebar end -->

        <!-- toggle button -->
        <button class="mil-toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>

        <!-- content -->
        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <!-- banner -->
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Outlet </span>Details</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">View details for <%= outlet.name || 'Outlet' %>.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- banner end -->

                <!-- main content -->
                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 mil-main-content" id="mainContent">
                                <!-- Business Info -->
                                <div class="mil-form-section mil-up">
                                    <div class="mil-center">
                                        <img src="<%= admin.logo || '/images/logo.png' %>" alt="Business Logo" style="height: 50px; margin-bottom: 10px;">
                                        <h4 style="color: #333; font-size: 16px;">Outlet Details for <%= admin.businessName || 'Your Business' %></h4>
                                        <p style="color: #333; font-size: 13px;">
                                            Email: <%= admin.email || 'N/A' %> | Currency: <%= admin.currency || 'N/A' %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Error/Success Messages -->
                                <% if (error) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-bell"></i> <%= error %>
                                    </div>
                                <% } %>
                                <% if (success) { %>
                                    <div class="mil-alert success mil-up">
                                        <i class="fa-solid fa-check"></i> <%= success %>
                                    </div>
                                <% } %>

                                <!-- Outlet Details -->
                                <div class="mil-outlet-details mil-up">
                                    <h5>Outlet Information</h5>
                                    <p>
                                        <i class="fa-solid fa-store"></i>
                                        <strong>Name:</strong> <%= outlet.name %>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-map-marker-alt"></i>
                                        <strong>Address:</strong> <%= outlet.location %>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-phone"></i>
                                        <strong>Contact:</strong> <%= outlet.mobile %>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-user"></i>
                                        <strong>Username:</strong> <%= outlet.username %>
                                    </p>
                                </div>

                                <!-- Stock Table -->
                                <div class="mil-table-section mil-up">
                                    <h5>Stock Inventory</h5>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Item Name</th>
                                                <th>Stock Quantity</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% outlet.inventory.forEach(item => { %>
                                                <tr>
                                                    <td><%= item.name %></td>
                                                    <td><%= item.stock %></td>
                                                </tr>
                                            <% }) %>
                                            <% if (outlet.inventory.length === 0) { %>
                                                <tr>
                                                    <td colspan="2" class="no-data">No stock available for this outlet.</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Action Buttons -->
                                <div class="mil-button-group mil-up">
                                    <a href="/outlet-transactions/<%= outlet._id %>" class="mil-button transactions-btn">
                                        View Transactions <i class="fa-solid fa-chart-bar"></i>
                                    </a>
                                    <a href="/outlet-customers/<%= outlet._id %>" class="mil-button customers-btn">
                                        View Customers <i class="fa-solid fa-users"></i>
                                    </a>
                                    <a href="/home" class="mil-button cancel-btn">
                                        Back to Outlets <i class="fa-solid fa-arrow-left"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- footer -->
        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container mil-p-120-60">
                    <div class="row justify-content-between">
                        <div class="col-md-4 col-lg-4 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-md-7 col-lg-6">
                            <div class="row justify-content-end">
                                <div class="col-md-6 col-lg-9">
                                    <div class="mil-vert-between">
                                        <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- footer end -->

        <!-- hidden elements -->
        <div class="mil-hidden-elements">
            <div class="mil-d揃odecahedron">
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
                <div class="mil-pentagon">
                    <div></div><div></div><div></div><div></div><div></div>
                </div>
            </div>
