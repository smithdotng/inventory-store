<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Outlet</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
    </div>
    <h2>Navigation</h2>
    <a href="/sell"><span>Sell</span></a>
    <a href="/store-view"><span>View Store</span></a>
    <a href="/update-stock"><span>Update Stock</span></a>
    <a href="/create-outlet"><span>Create an Outlet</span></a>
    <a href="/invoice"><span>Invoice</span></a>
    <a href="/transactions"><span>Transactions</span></a>
  </div>

  <!-- Toggle Button (Visible on Small Screens) -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent" style="padding-left: 50px;">
    <div class="welcome-message">
      Welcome, <%= username %>!
    </div>
    <div class="container" style="justify-self: center;">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
      </div>
      <div class="form-section">
        <h2>Create Outlet <span class="icon-group" style="margin-left: 10px;"></span></h2>
        <% if (error) { %>
          <div class="error"><%= error %></div>
        <% } %>
        <form action="/create-outlet" method="POST">
          <input type="text" name="name" placeholder="Outlet Name" required>
          <input type="text" name="location" placeholder="Location/Address" required>
          <input type="text" name="mobile" placeholder="Mobile Number" required>
          <input type="text" name="username" placeholder="Username" required>
          <input type="password" name="password" placeholder="Password" required>
          <button type="submit">Create Outlet <span class="icon-right-arrow"></span></button>
        </form>
        <a href="/home">Back to Home <span class="icon-right-arrow"></span></a>
      </div>
    </div>
  </div>

  <!-- JavaScript for sidebar toggle -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Sidebar toggle
    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('expanded');
      mainContent.classList.toggle('expanded');
    });
  </script>
</body>
</html>