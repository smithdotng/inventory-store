    <title>Shed | Reset Password</title>
</head>

<body>
    <div class="mil-wrapper" id="top">
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <div class="mil-frame-top">
            <a href="/" class="mil-logo"><img src="/images/logo.png" alt="Shed Logo"></a>
            <nav class="mil-main-menu" id="swupMenu">
                <form class="mil-subscribe-form mil-up" style="background-color: beige;">
                    <input type="text" placeholder="Search for a Shed" size="50">
                    <button type="submit" class="mil-button mil-icon-button-sm mil-arrow-place"></button>
                    <div class="mil-search-results"></div>
                </form>
            </nav>
            <div class="mil-menu-btn">
                <i class="fas fa-search"></i>
            </div>
        </div>

        <div class="mil-content">
            <div id="swupMain" class="mil-main-transition">
                <section class="mil-banner mil-dark-bg" style="height: 400px;">
                    <div class="mi-invert-fix">
                        <div class="mil-animation-frame">
                            <div class="mil-animation mil-position-1 mil-scale" data-value-1="7" data-value-2="1.6"></div>
                            <div class="mil-animation mil-position-2 mil-scale" data-value-1="4" data-value-2="1"></div>
                            <div class="mil-animation mil-position-3 mil-scale" data-value-1="1.2" data-value-2=".1"></div>
                        </div>
                        <div class="mil-gradient"></div>
                        <div class="container">
                            <div class="mil-banner-content mil-up">
                                <h1 class="mil-muted mil-mb-60"><span class="mil-thin">Set a New </span>Password</h1>
                                <div class="row">
                                    <div class="col-md-7 col-lg-5">
                                        <p class="mil-light-soft mil-mb-60">Enter your new password below to reset your account.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mil-about">
                    <div class="container mil-p-120-60">
                        <div class="row justify-content-center">
                            <div class="col-lg-6">
                                <% if (error.length > 0) { %>
                                    <div class="mil-alert mil-up">
                                        <i class="fa-solid fa-bell"></i> <%= error %>
                                    </div>
                                <% } %>

                                <form action="/referrals/reset-password/<%= token %>" method="POST" class="mil-up">
                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-lock"></i> New Password</label>
                                        <input type="password" class="mil-form-control" id="password" name="password" placeholder="Enter new password..." required>
                                    </div>

                                    <div class="mil-form-group">
                                        <label><i class="fa-solid fa-lock"></i> Confirm Password</label>
                                        <input type="password" class="mil-form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password..." required>
                                    </div>

                                    <div class="mil-form-group mil-center">
                                        <button type="submit" class="mil-button mil-arrow-place">
                                            Reset Password <i class="fa-solid fa-key"></i>
                                        </button>
                                    </div>

                                    <div class="mil-login-links">
                                        <p>Remembered your password? <a href="/referrals/login">Log in here</a></p>
                                        <p>Not an affiliate yet? <a href="/referrals/signup">Sign up here</a></p>
                                    </div>
                                </form>
                            </div>
                            <div class="col-lg-6">
                                <img src="/images/promo.jpg" alt="Promotional Image" class="mil-promo-image mil-up">
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <footer class="mil-dark-bg">
            <div class="mi-invert-fix">
                <div class="container mil-p-120-60">
                    <div class="row justify-content-between">
                        <div class="col-md-4 col-lg-4 mil-mb-60">
                            <div class="mil-muted mil-logo mil-up mil-mb-30">Shed.</div>
                        </div>
                        <div class="col-md-7 col-lg-6">
                            <div class="row justify-content-end">
                                <div class="col-md-6 col-lg-9">
                                    <div class="mil-vert-between">
                                        <p class="mil-light-soft mil-up">New to Shed? <a href="/admin-register">Create your Shed!</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

        <div class="mil-hidden-elements">
            <div class="mil-dodecahedron">
                <div class="mil-pentagon"><div></div><div></div><div></div><div></div><div></div></div>
                <div class="mil-pentagon"><div></div><div></div><div></div><div></div><div></div></div>
