<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Create Outlet</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<%- include('partials/app-sidebar', { currentPage: 'home', admin: admin }) %>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Create Outlet</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business"><%= admin.businessName || 'Your Business' %></span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (admin.firstName || admin.username || 'A')[0].toUpperCase() %></div>
        <%= admin.firstName || admin.username %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <div class="page-header">
      <div>
        <h1>Create Outlet</h1>
        <p>Add a new outlet location for your business</p>
      </div>
      <a href="/home" class="btn-secondary-app"><i class="fas fa-arrow-left"></i> Back to Outlets</a>
    </div>

    <div style="max-width:560px;">
      <div class="app-card">
        <div class="app-card-title">Outlet Details</div>
        <form action="/create-outlet" method="POST">
          <div class="form-group">
            <label>Outlet Name <span style="color:#c0392b">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Downtown Branch" required>
          </div>
          <div class="form-group">
            <label>Location / Address <span style="color:#c0392b">*</span></label>
            <input type="text" name="location" class="form-control" placeholder="Street, City" required>
          </div>
          <div class="form-group">
            <label>Mobile Number <span style="color:#c0392b">*</span></label>
            <input type="text" name="mobile" class="form-control" placeholder="0803 xxx xxxx" required>
          </div>
          <div class="form-group">
            <label>Login Username <span style="color:#c0392b">*</span></label>
            <input type="text" name="username" class="form-control" placeholder="outlet_username" required>
          </div>
          <div class="form-group">
            <label>Password <span style="color:#c0392b">*</span></label>
            <input type="password" name="password" class="form-control" placeholder="Choose a password" required>
          </div>
          <div style="display:flex; gap:12px; margin-top:8px;">
            <button type="submit" class="btn-primary-app">
              <i class="fas fa-plus"></i> Create Outlet
            </button>
            <a href="/home" class="btn-secondary-app">
              <i class="fas fa-times"></i> Cancel
            </a>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
