<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="Outlet Stock View | Shed: Inventory, Invoices and More" />
  <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
  <meta property="og:image" content="/android-chrome-512x512.png" />
  <title>Outlet Stock View</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 0;
      background-image: url('/images/bg.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
      position: relative;
    }
    
    body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: -1;
    }
    
    .sidebar {
      position: fixed;
      width: 200px;
      height: 100vh;
      background: #2c3e50;
      color: white;
      padding: 20px;
      transition: all 0.3s;
    }
    
    .sidebar.visible {
      left: 0;
    }
    
    .sidebar.hidden {
      left: -200px;
    }
    
    .toggle-btn {
      position: fixed;
      top: 10px;
      left: 10px;
      z-index: 1000;
      background: #27ae60;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 4px;
      cursor: pointer;
    }
    
    .main-content {
      transition: all 0.3s;
      min-height: 100vh;
    }
    
    .container {
      padding: 20px;
      max-width: 900px;
      margin: 0 auto;
    }
    
    .logo-container img {
      max-height: 80px;
      margin-bottom: 15px;
    }
    
    .content-logo-container img {
      max-height: 100px;
      margin-bottom: 20px;
    }
    
    .table-section {
      background: rgba(255, 255, 255, 0.95);
      padding: 25px;
      border-radius: 8px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      margin-bottom: 20px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
    }
    
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    
    th {
      background-color: #f8f9fa;
      font-weight: 600;
      color: #2c3e50;
    }
    
    tr:hover {
      background-color: #f5f5f5;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .container {
        padding: 15px;
      }
      
      .table-section {
        padding: 15px;
      }
      
      th, td {
        padding: 8px 10px;
        font-size: 14px;
      }
    }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Shedfactory Business Solutions">
    </div>
    <h2>Welcome, <%= outlet.name %>!</h2>
    <a href="/outlet/sales-form">Point of Sale</a>
    <a href="/outlet/<%= outlet._id %>/stock-view" class="active">View Inventory</a>
    <a href="/outlet-transactions/<%= outlet._id %>">View Transactions</a>
    <a href="/outlet-customers/<%= outlet._id %>">Customers</a>
    <a href="/outlet-logout">Log Out</a>
  </div>

  <!-- Toggle Button -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent">
    <div class="container">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="<%= admin.businessName || 'Shed' %>">
      </div>
      <h1>Outlet Stock View</h1>

      <!-- Inventory Table -->
      <div class="table-section">
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Stock</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% outlet.inventory.forEach(item => { %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.stock %></td>
                <td><%= admin.currency || '$' %><%= item.cost ? item.cost.toFixed(2) : '0.00' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Initialize sidebar state
    sidebar.classList.add('visible');
    sidebar.classList.remove('hidden');
    mainContent.style.marginLeft = '200px';
    mainContent.style.width = 'calc(100% - 200px)';

    // Toggle sidebar visibility
    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('visible');
      sidebar.classList.toggle('hidden');
      if (sidebar.classList.contains('visible')) {
        mainContent.style.marginLeft = '200px';
        mainContent.style.width = 'calc(100% - 200px)';
      } else {
        mainContent.style.marginLeft = '0';
        mainContent.style.width = '100%';
      }
    });

    // Responsive adjustments
    function handleResize() {
      if (window.innerWidth > 768) {
        sidebar.classList.add('visible');
        sidebar.classList.remove('hidden');
        mainContent.style.marginLeft = '200px';
        mainContent.style.width = 'calc(100% - 200px)';
      } else {
        sidebar.classList.remove('visible');
        sidebar.classList.add('hidden');
        mainContent.style.marginLeft = '0';
        mainContent.style.width = '100%';
      }
    }

    window.addEventListener('resize', handleResize);
    handleResize(); // Initialize on load
  </script>
</body>
</html>