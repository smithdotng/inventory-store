            }
            .mil-form-control {
                font-size: 12px;
                padding: 0.3rem 0.6rem;
                height: calc(1.5em + 0.6rem + 2px);
            }
            .mil-button {
                font-size: 13px;
                padding: 8px 16px;
            }
            .mil-login-links {
                font-size: 12px;
            }
            .mil-promo-image {
                max-height: 300px;
            }
        }
        @media screen and (max-width: 991px) {
            .mil-main-menu ul li {
                padding-left: 25px;
            }
            .mil-main-menu ul li::before {
                content: '\f00c';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                color: #008B8B;
                position: absolute;
                left: 5px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 14px;
            }
            .mil-main-menu ul li ul li::before {
                left: 15px;
            }
        }
