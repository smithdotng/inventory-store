<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shed | Transactions – Sales History</title>
    <meta name="description" content="View and manage all your business transactions and sales records">

    <!-- favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- vendor css -->
    <link rel="stylesheet" href="asset1/css/bootstrap.min.css">
    <link rel="stylesheet" href="asset1/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="asset1/css/swiper.min.css">
    <link rel="stylesheet" href="asset1/css/animate.min.css">
    <link rel="stylesheet" href="asset1/css/magnific-popup.css">
    <link rel="stylesheet" href="asset1/css/bootstrap-select.min.css">

    <!-- template styles -->
    <link rel="stylesheet" href="asset1/css/main.css">
    <link rel="stylesheet" href="asset1/css/rtl.css">

    <style>
        :root {
            --primary: #e74c3c;
            --success: #27ae60;
            --info: #17a2b8;
            --warning: #f39c12;
            --danger: #c0392b;
        }

        .main-header__two { position: relative; z-index: 91; }

        .sidebar-nav {
            position: fixed;
            left: -280px;
            top: 0; bottom: 0;
            width: 280px;
            background: #2c3e50;
            color: white;
            transition: left .4s ease;
            z-index: 9999;
            padding-top: 90px;
            overflow-y: auto;
        }

        .sidebar-nav.active { left: 0; }

        .sidebar-nav a {
            color: white;
            display: block;
            padding: 14px 28px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active { background: rgba(255,255,255,0.1); }

        .mobile-nav__toggler {
            font-size: 28px;
            color: white;
            background: none;
            border: none;
            cursor: pointer;
        }

        .transactions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .transaction-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 30px rgba(0,0,0,0.08);
            transition: all 0.35s ease;
            cursor: pointer;
        }

        .transaction-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 50px rgba(0,0,0,0.14);
        }

        .transaction-header {
            background: #2c5530;
            color: white;
            padding: 22px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .transaction-id {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .transaction-date {
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .transaction-content {
            padding: 28px;
        }

        .transaction-amount {
            font-size: 1.55rem;
            font-weight: 700;
            color: #2c5530;
            text-align: right;
            margin: 20px 0;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-badge.Paid    { background: var(--success); color: white; }
        .status-badge.Pending { background: var(--warning); color: #212529; }

        .source-tag {
            font-size: 0.9rem;
            color: #666;
            margin-top: 8px;
            display: block;
        }

        .thm-btn.sm {
            padding: 9px 20px;
            font-size: 0.92rem;
        }

        @media (max-width: 991px) {
            .transactions-grid {
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            }
        }
    </style>
</head>
<body>

<div class="page-wrapper">

    <!-- header -->
    <div class="main-header__two">
        <div class="header-upper">
            <div class="container">
                <div class="logo-box">
                    <a href="/home">
                        <img src="/images/logo.png" width="140" alt="Shed">
                    </a>
                    <button type="button" class="mobile-nav__toggler">
                        <i class="fa fa-bars"></i>
                    </button>
                </div>

                <div class="header-info">
                    <div class="header-info__box">
                        <i class="azino-icon-email1"></i>
                        <div class="header-info__box-content">
                            <h3>Email</h3>
                            <p><a href="mailto:<%= admin.email %>"><%= admin.email || 'admin@shed.app' %></a></p>
                        </div>
                    </div>
                    <div class="header-info__box">
                        <i class="azino-icon-calling"></i>
                        <div class="header-info__box-content">
                            <h3>Business</h3>
                            <p><%= admin.businessName || 'Your Business' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <nav class="main-menu">
            <div class="container">
                <ul class="main-menu__list">
                    <li><a href="/pos">Point of Sale</a></li>
                    <li><a href="/update-stock">Inventory</a></li>
                    <li><a href="/invoices">Invoices</a></li>
                    <li class="active"><a href="/transactions">Transactions</a></li>
                    <li><a href="/customers">Customers</a></li>
                    <li><a href="/home">Outlets</a></li>
                    <li><a href="/profile">Profile</a></li>
                </ul>
                <a href="/admin-logout" class="thm-btn dynamic-radius">Logout</a>
            </div>
        </nav>
    </div>

    <!-- mobile sidebar -->
    <div class="sidebar-nav" id="sidebarNav">
        <button type="button" class="mobile-nav__close mobile-nav__toggler" style="position:absolute;top:20px;right:25px;font-size:30px;color:white;">
            <i class="fa fa-times"></i>
        </button>

        <div style="padding: 0 30px 25px;">
            <h3 style="color:white;margin-bottom:35px;">Menu</h3>
        </div>

        <a href="/pos"><i class="fas fa-shopping-bag mr-2"></i> Point of Sale</a>
        <a href="/update-stock"><i class="fas fa-boxes mr-2"></i> Manage Inventory</a>
        <a href="/invoices"><i class="fas fa-file-invoice mr-2"></i> Generate Invoice</a>
        <a href="/transactions" class="active"><i class="fas fa-chart-bar mr-2"></i> Transactions</a>
        <a href="/customers"><i class="fas fa-users mr-2"></i> Customers</a>
        <a href="/home"><i class="fas fa-store mr-2"></i> Manage Outlets</a>
        <a href="/profile"><i class="fas fa-user mr-2"></i> Profile</a>
        <a href="/admin-logout"><i class="fas fa-power-off mr-2"></i> Log Out</a>
    </div>

    <!-- banner -->
    <section class="main-slider main-slider__two">
        <div class="swiper-container thm-swiper__slider" data-swiper-options='{"slidesPerView": 1, "loop": true, "effect": "fade", "autoplay": {"delay": 6500}}'>
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <div class="image-layer" style="background-image: url(asset1/images/main-slider/slider-1-3.jpg);"></div>
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-xl-8">
                                <h2>Transaction <span>History</span></h2>
                                <p>Track every sale, payment and business movement</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- main content -->
    <section class="service-two pt-120 pb-120">
        <div class="container">

            <!-- title & actions -->
            <div class="row align-items-center mb-60">
                <div class="col-lg-8">
                    <div class="block-title">
                        <p><img src="asset1/images/shapes/heart-2-1.png" width="15" alt=""> Financial Records</p>
                        <h3>All Transactions</h3>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-right">
                    <div class="d-flex gap-3 justify-content-lg-end flex-wrap">
                        <button class="thm-btn dynamic-radius">Export CSV</button>
                        <button class="thm-btn dynamic-radius" style="background:var(--info);">Filter Date</button>
                    </div>
                </div>
            </div>

            <!-- Transactions Grid -->
            <div class="transactions-grid">
                <% if (transactions && transactions.length > 0) { %>
                    <% transactions.forEach((t, i) => { %>
                        <div class="transaction-card wow fadeInUp" data-wow-duration="1000ms">
                            <div class="transaction-header">
                                <div class="transaction-id">TXN-<%= String(i+1).padStart(5,'0') %></div>
                                <div class="transaction-date">
                                    <%= new Date(t.date).toLocaleDateString() %>
                                </div>
                            </div>

                            <div class="transaction-content">
                                <h5>
                                    <%= t.customerName || 'Walk-in Customer' %>
                                </h5>

                                <p style="color:#666; font-size:0.95rem; margin:8px 0;">
                                    <% if (t.items && t.items.length) { %>
                                        <%= t.items.length %> item<% if(t.items.length>1){ %>s<% } %>
                                    <% } else { %>
                                        <%= t.itemName || 'Single Item' %>
                                    <% } %>
                                </p>

                                <div class="transaction-amount">
                                    <%= admin.currency %><%= Number(t.totalAmount || (t.cost * t.quantity)).toFixed(2) %>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-4">
                                    <span class="status-badge <%= t.paymentStatus || 'Pending' %>">
                                        <%= t.paymentStatus || 'Pending' %>
                                    </span>

                                    <div>
                                        <% if (t.paymentStatus !== 'Paid') { %>
                                            <form action="/transactions/mark-paid/<%= t._id %>" method="POST" style="display:inline;">
                                                <button type="submit" class="thm-btn dynamic-radius sm" style="background:var(--success);">
                                                    Mark Paid
                                                </button>
                                            </form>
                                        <% } %>
                                        <a href="/receipt/<%= t._id %>" class="thm-btn dynamic-radius sm" style="margin-left:8px;">
                                            Receipt
                                        </a>
                                    </div>
                                </div>

                                <% if (t.outletName) { %>
                                    <span class="source-tag">
                                        <i class="fas fa-store mr-1"></i> <%= t.outletName %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-history fa-5x text-muted mb-4"></i>
                        <h4>No transactions recorded yet</h4>
                        <p class="text-muted mb-4">Every sale will appear here automatically</p>
                        <a href="/pos" class="thm-btn dynamic-radius">Go to POS →</a>
                    </div>
                <% } %>
            </div>

        </div>
    </section>

    <!-- footer -->
    <section class="site-footer">
        <div class="main-footer pt-120 pb-80">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <a href="/home">
                                <img src="/images/logo.png" width="140" alt="">
                            </a>
                            <p class="mt-3">Complete visibility of all your business sales & payments</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Quick Links</h3>
                            <ul class="list-unstyled">
                                <li><a href="/pos">Point of Sale</a></li>
                                <li><a href="/update-stock">Inventory</a></li>
                                <li><a href="/invoices">Invoices</a></li>
                                <li><a href="/profile">Settings</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Contact</h3>
                            <p><strong><%= admin.businessName || 'Your Business' %></strong><br>
                            <%= admin.email || 'No email set' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>© <%= new Date().getFullYear() %> Shed – All Rights Reserved</p>
            </div>
        </div>
    </section>

</div>

<div class="mobile-nav__overlay mobile-nav__toggler"></div>

<script src="asset1/js/jquery-3.5.1.min.js"></script>
<script src="asset1/js/bootstrap.bundle.min.js"></script>
<script src="asset1/js/swiper.min.js"></script>
<script src="asset1/js/wow.js"></script>
<script src="asset1/js/bootstrap-select.min.js"></script>
<script src="asset1/js/theme.js"></script>

<script>
$(document).ready(function(){
    // Mobile menu toggle
    $('.mobile-nav__toggler').click(function(e){
        e.preventDefault();
        $('#sidebarNav').toggleClass('active');
        $('.mobile-nav__overlay').toggleClass('active');
    });

    $('.mobile-nav__close, .mobile-nav__overlay').click(function(){
        $('#sidebarNav').removeClass('active');
        $('.mobile-nav__overlay').removeClass('active');
    });
});
</script>

</body>
</html>