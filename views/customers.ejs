<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shed | Customers – Manage Your Contacts</title>
    <meta name="description" content="View, add and manage your customers and client relationships">

    <!-- favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- vendor css -->
    <link rel="stylesheet" href="asset1/css/bootstrap.min.css">
    <link rel="stylesheet" href="asset1/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="asset1/css/swiper.min.css">
    <link rel="stylesheet" href="asset1/css/animate.min.css">
    <link rel="stylesheet" href="asset1/css/magnific-popup.css">
    <link rel="stylesheet" href="asset1/css/bootstrap-select.min.css">

    <!-- template styles -->
    <link rel="stylesheet" href="asset1/css/main.css">
    <link rel="stylesheet" href="asset1/css/rtl.css">

    <style>
        :root {
            --primary: #e74c3c;
            --success: #27ae60;
            --info: #17a2b8;
            --warning: #f39c12;
            --danger: #c0392b;
        }

        .main-header__two { position: relative; z-index: 91; }

        .sidebar-nav {
            position: fixed;
            left: -280px;
            top: 0; bottom: 0;
            width: 280px;
            background: #2c3e50;
            color: white;
            transition: left .4s ease;
            z-index: 9999;
            padding-top: 90px;
            overflow-y: auto;
        }

        .sidebar-nav.active { left: 0; }

        .sidebar-nav a {
            color: white;
            display: block;
            padding: 14px 28px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active { background: rgba(255,255,255,0.1); }

        .mobile-nav__toggler {
            font-size: 28px;
            color: white;
            background: none;
            border: none;
            cursor: pointer;
        }

        .customers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .customer-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 30px rgba(0,0,0,0.08);
            transition: all 0.35s ease;
            cursor: pointer;
        }

        .customer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 50px rgba(0,0,0,0.14);
        }

        .customer-header {
            background: #2c5530;
            color: white;
            padding: 22px 28px;
            text-align: center;
        }

        .customer-name {
            font-size: 1.35rem;
            font-weight: 700;
            margin: 0;
        }

        .customer-content {
            padding: 28px;
            text-align: center;
        }

        .customer-meta {
            margin: 20px 0;
            font-size: 1rem;
            color: #555;
        }

        .customer-meta strong {
            color: #333;
        }

        .customer-total {
            font-size: 1.6rem;
            font-weight: 700;
            color: #2c5530;
            margin: 15px 0;
        }

        .customer-actions {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .status-pill {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            background: #e9ecef;
            color: #495057;
        }

        @media (max-width: 991px) {
            .customers-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }
        }
    </style>
</head>
<body>



<div class="page-wrapper">

    <!-- header -->
    <div class="main-header__two">
        <div class="header-upper">
            <div class="container">
                <div class="logo-box">
                    <a href="/home">
                        <img src="/images/logo.png" width="140" alt="Shed">
                    </a>
                    <button type="button" class="mobile-nav__toggler">
                        <i class="fa fa-bars"></i>
                    </button>
                </div>

                <div class="header-info">
                    <div class="header-info__box">
                        <i class="azino-icon-email1"></i>
                        <div class="header-info__box-content">
                            <h3>Email</h3>
                            <p><a href="mailto:<%= admin.email %>"><%= admin.email || 'hello@shed.ng' %></a></p>
                        </div>
                    </div>
                    <div class="header-info__box">
                        <i class="azino-icon-calling"></i>
                        <div class="header-info__box-content">
                            <h3>Business</h3>
                            <p><%= admin.businessName || 'Your Business' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <nav class="main-menu">
            <div class="container">
                <ul class="main-menu__list">
                    <li><a href="/pos">Point of Sale</a></li>
                    <li><a href="/update-stock">Inventory</a></li>
                    <li><a href="/invoices">Invoices</a></li>
                    <li><a href="/transactions">Transactions</a></li>
                    <li class="active"><a href="/customers">Customers</a></li>
                    <li><a href="/home">Outlets</a></li>
                    <li><a href="/profile">Profile</a></li>
                </ul>
                <a href="/admin-logout" class="thm-btn dynamic-radius">Logout</a>
            </div>
        </nav>
    </div>

    <!-- mobile sidebar -->
    <div class="sidebar-nav" id="sidebarNav">
        <button type="button" class="mobile-nav__close mobile-nav__toggler" style="position:absolute;top:20px;right:25px;font-size:30px;color:white;">
            <i class="fa fa-times"></i>
        </button>

        <div style="padding: 0 30px 25px;">
            <h3 style="color:white;margin-bottom:35px;">Menu</h3>
        </div>

        <a href="/pos"><i class="fas fa-shopping-bag mr-2"></i> Point of Sale</a>
        <a href="/update-stock"><i class="fas fa-boxes mr-2"></i> Manage Inventory</a>
        <a href="/invoices"><i class="fas fa-file-invoice mr-2"></i> Generate Invoice</a>
        <a href="/transactions"><i class="fas fa-chart-bar mr-2"></i> Transactions</a>
        <a href="/customers" class="active"><i class="fas fa-users mr-2"></i> Customers</a>
        <a href="/home"><i class="fas fa-store mr-2"></i> Manage Outlets</a>
        <a href="/profile"><i class="fas fa-user mr-2"></i> Profile</a>
        <a href="/admin-logout"><i class="fas fa-power-off mr-2"></i> Log Out</a>
    </div>

    <!-- banner -->
    <section class="main-slider main-slider__two">
        <div class="swiper-container thm-swiper__slider" data-swiper-options='{"slidesPerView": 1, "loop": true, "effect": "fade", "autoplay": {"delay": 6500}}'>
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <div class="image-layer" style="background-image: url(asset1/images/main-slider/slider-1-1.jpg);"></div>
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-xl-8">
                                <h2>Your <span>Customers</span></h2>
                                <p>Build relationships, track purchases and manage contacts</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- main content -->
    <section class="service-two pt-120 pb-120">
        <div class="container">

            <!-- title & actions -->
            <div class="row align-items-center mb-60">
                <div class="col-lg-8">
                    <div class="block-title">
                        <p><img src="asset1/images/shapes/heart-2-1.png" width="15" alt=""> Relationship Management</p>
                        <h3>Customer Directory</h3>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-right">
                    <button id="addCustomerBtn" class="thm-btn dynamic-radius">Add New Customer</button>
                </div>
            </div>

            <!-- Add Customer Form -->
            <div id="addCustomerForm" class="wow fadeInUp" data-wow-duration="1200ms" style="display:none;">
                <form action="/add-customer" method="POST">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>Full Name <span style="color:var(--danger)">*</span></label>
                                <input type="text" name="name" class="form-control" placeholder="John Doe" required>
                            </div>
                            <div class="form-group">
                                <label>Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="0803 xxx xxxx">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" name="email" class="form-control" placeholder="customer@example.com">
                            </div>
                            <div class="form-group">
                                <label>Notes / Tags (optional)</label>
                                <input type="text" name="notes" class="form-control" placeholder="VIP, Wholesale, Regular...">
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-40">
                        <button type="submit" class="thm-btn dynamic-radius">Save Customer</button>
                        <button type="button" id="cancelAddBtn" class="thm-btn dynamic-radius cancel ml-3">Cancel</button>
                    </div>
                </form>
            </div>

            <!-- Customers Grid -->
            <div class="customers-grid">
                <% if (customers && customers.length > 0) { %>
                    <% customers.forEach(customer => { %>
                        <div class="customer-card wow fadeInUp" data-wow-duration="1000ms">
                            <div class="customer-header">
                                <h3 class="customer-name"><%= customer.name %></h3>
                            </div>

                            <div class="customer-content">
                                <div class="customer-meta">
                                    <strong>Phone:</strong> <%= customer.phone || 'Not provided' %><br>
                                    <strong>Email:</strong> <%= customer.email || 'Not provided' %>
                                </div>

                                <% if (customer.totalValue) { %>
                                    <div class="customer-total">
                                        <%= admin.currency %><%= Number(customer.totalValue).toFixed(2) %>
                                        <small style="font-size:0.9rem; color:#666;">Total Spent</small>
                                    </div>
                                <% } %>

                                <% if (customer.lastPurchaseDate) { %>
                                    <p style="color:#666; margin:15px 0;">
                                        Last purchase: <%= new Date(customer.lastPurchaseDate).toLocaleDateString() %>
                                    </p>
                                <% } %>

                                <div class="customer-actions">
                                    <a href="/customer-details/<%= customer._id %>" class="thm-btn dynamic-radius sm" style="background:var(--info);">
                                        View Details
                                    </a>
                                    <a href="/edit-customer/<%= customer._id %>" class="thm-btn dynamic-radius sm" style="background:var(--warning);">
                                        Edit
                                    </a>
                                    <form action="/delete-customer/<%= customer._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete <%= customer.name %>?');">
                                        <button type="submit" class="thm-btn dynamic-radius sm" style="background:var(--danger);">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-users fa-5x text-muted mb-4"></i>
                        <h4>No customers yet</h4>
                        <p class="text-muted mb-4">Start building your customer base today</p>
                        <button id="addFirstCustomerBtn" class="thm-btn dynamic-radius">Add Your First Customer</button>
                    </div>
                <% } %>
            </div>

        </div>
    </section>

    <!-- footer -->
    <section class="site-footer">
        <div class="main-footer pt-120 pb-80">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <a href="/home">
                                <img src="/images/logo.png" width="140" alt="">
                            </a>
                            <p class="mt-3">Powerful customer management for growing businesses</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Quick Links</h3>
                            <ul class="list-unstyled">
                                <li><a href="/pos">Point of Sale</a></li>
                                <li><a href="/update-stock">Inventory</a></li>
                                <li><a href="/invoices">Invoices</a></li>
                                <li><a href="/profile">Settings</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Contact</h3>
                            <p><strong><%= admin.businessName || 'Your Business' %></strong><br>
                            <%= admin.email || 'No email set' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>© <%= new Date().getFullYear() %> Shed – All Rights Reserved</p>
            </div>
        </div>
    </section>

</div>

<div class="mobile-nav__overlay mobile-nav__toggler"></div>

<script src="asset1/js/jquery-3.5.1.min.js"></script>
<script src="asset1/js/bootstrap.bundle.min.js"></script>
<script src="asset1/js/swiper.min.js"></script>
<script src="asset1/js/wow.js"></script>
<script src="asset1/js/bootstrap-select.min.js"></script>
<script src="asset1/js/theme.js"></script>

<script>
$(document).ready(function(){
    // Mobile menu toggle
    $('.mobile-nav__toggler').click(function(e){
        e.preventDefault();
        $('#sidebarNav').toggleClass('active');
        $('.mobile-nav__overlay').toggleClass('active');
    });

    $('.mobile-nav__close, .mobile-nav__overlay').click(function(){
        $('#sidebarNav').removeClass('active');
        $('.mobile-nav__overlay').removeClass('active');
    });

    // Add customer form toggle
    const form = $('#addCustomerForm');
    $('#addCustomerBtn, #addFirstCustomerBtn').click(function(){
        form.slideDown(400);
        $('html,body').animate({scrollTop: form.offset().top - 120}, 600);
    });

    // Cancel button
    $('#cancelAddBtn').click(function(){
        form.slideUp(300);
    });
});
</script>

</body>
</html>