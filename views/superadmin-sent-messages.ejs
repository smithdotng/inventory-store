<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Sent Messages</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
</head>
<body>

<!-- Superadmin Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo"><img src="/images/logo.png" alt="Shed"></div>
  <nav class="sidebar-nav">
    <a href="/superadmin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
    <a href="/superadmin/create-admin"><i class="fas fa-user-plus"></i> Create Admin</a>
    <a href="/superadmin/affiliates"><i class="fas fa-handshake"></i> Affiliates</a>
    <a href="/superadmin/outlets"><i class="fas fa-store"></i> All Outlets</a>
    <a href="/superadmin/sent-messages" class="active"><i class="fas fa-envelope"></i> Sent Messages</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/admin-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Sent Messages</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business">Superadmin</span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= currentAdmin.username[0].toUpperCase() %></div>
          <%= currentAdmin.username %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (Array.isArray(success) && success.length > 0) { %>
      <% success.forEach(msg => { %><div class="flash-success"><i class="fas fa-check-circle"></i> <%= msg %></div><% }) %>
    <% } %>
    <% if (Array.isArray(error) && error.length > 0) { %>
      <% error.forEach(msg => { %><div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= msg %></div><% }) %>
    <% } %>

    <div class="page-header">
      <div><h1>Sent Messages</h1><p>All messages sent to admins</p></div>
      <a href="/superadmin/dashboard" class="btn-secondary-app"><i class="fas fa-arrow-left"></i> Dashboard</a>
    </div>

    <div class="app-card">
      <% if (messages && messages.length > 0) { %>
        <div style="overflow-x:auto;">
          <table class="app-table">
            <thead>
              <tr>
                <th>Recipient</th>
                <th>Message</th>
                <th>Date Sent</th>
                <th>Read Status</th>
              </tr>
            </thead>
            <tbody>
              <% messages.forEach(msg => { %>
                <tr>
                  <td style="font-weight:600;"><%= msg.recipient %></td>
                  <td style="max-width:300px; white-space:pre-wrap; font-size:0.88rem;"><%= msg.content %></td>
                  <td style="font-size:0.83rem; color:#888; white-space:nowrap;"><%= msg.formattedDate %></td>
                  <td>
                    <% if (msg.read) { %>
                      <span style="background:rgba(0,139,139,0.1); color:#008B8B; padding:3px 10px; border-radius:20px; font-size:0.78rem; font-weight:600;">
                        <i class="fas fa-check-double"></i> Read
                      </span>
                      <% if (msg.readAtFormatted) { %>
                        <br><small style="color:#aaa; font-size:0.72rem;"><%= msg.readAtFormatted %></small>
                      <% } %>
                    <% } else { %>
                      <span style="background:rgba(235,166,17,0.1); color:#b8830a; padding:3px 10px; border-radius:20px; font-size:0.78rem; font-weight:600;">
                        <i class="fas fa-clock"></i> Unread
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align:center; padding:80px; color:#999;">
          <i class="fas fa-envelope-open" style="font-size:3.5rem; color:#ddd; margin-bottom:20px; display:block;"></i>
          <h3 style="color:#0d0d1a; margin-bottom:8px;">No messages sent yet</h3>
        </div>
      <% } %>
    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });
</script>
</body>
</html>
