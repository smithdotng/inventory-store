<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Featured Ads</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .ad-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .ad-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; }
    .ad-card-img { width: 100%; height: 160px; object-fit: cover; background: #f4f6f9; display: flex; align-items: center; justify-content: center; }
    .ad-card-img img { width: 100%; height: 160px; object-fit: cover; }
    .ad-card-img .ad-no-img { color: #ccc; font-size: 2.5rem; }
    .ad-card-body { padding: 16px; }
    .ad-card-name { font-size: 1rem; font-weight: 700; color: #0d0d1a; margin-bottom: 4px; }
    .ad-card-store { font-size: 0.8rem; color: #008B8B; margin-bottom: 6px; }
    .ad-card-desc { font-size: 0.82rem; color: #888; margin-bottom: 8px; min-height: 32px; }
    .ad-card-price { font-size: 1rem; font-weight: 700; color: #0d0d1a; margin-bottom: 12px; }
    .ad-card-position { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; background: #f0f0f0; color: #666; margin-bottom: 12px; }
    .ad-card-actions { display: flex; gap: 8px; }
    .ad-inactive { opacity: 0.55; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media(max-width:600px) { .form-row { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<!-- Superadmin Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo"><img src="/images/logo.png" alt="Shed"></div>
  <nav class="sidebar-nav">
    <a href="/superadmin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
    <a href="/superadmin/create-admin"><i class="fas fa-user-plus"></i> Create Admin</a>
    <a href="/superadmin/affiliates"><i class="fas fa-handshake"></i> Affiliates</a>
    <a href="/superadmin/outlets"><i class="fas fa-store"></i> All Outlets</a>
    <a href="/superadmin/ads" class="active"><i class="fas fa-ad"></i> Featured Ads</a>
    <a href="/superadmin/clusters"><i class="fas fa-map-marker-alt"></i> Market Clusters</a>
    <a href="/superadmin/sent-messages"><i class="fas fa-envelope"></i> Sent Messages</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/admin-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Featured Ads</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business">Superadmin</span>
      <div class="user-dropdown" id="userDropdown">
        <button class="topbar-user-chip user-dropdown-btn" id="userDropdownBtn">
          <div class="avatar"><%= (currentAdmin ? currentAdmin.username : 'S')[0].toUpperCase() %></div>
          <%= currentAdmin ? currentAdmin.username : 'Superadmin' %>
          <i class="fas fa-chevron-down user-dropdown-chevron"></i>
        </button>
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <a href="/admin-logout" class="dropdown-item-danger"><i class="fas fa-sign-out-alt"></i> Log Out</a>
        </div>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (Array.isArray(success) && success.length > 0) { %>
      <% success.forEach(msg => { %><div class="flash-success"><i class="fas fa-check-circle"></i> <%= msg %></div><% }) %>
    <% } %>
    <% if (Array.isArray(error) && error.length > 0) { %>
      <% error.forEach(msg => { %><div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= msg %></div><% }) %>
    <% } %>

    <div class="page-header">
      <div>
        <h1>Featured Ads</h1>
        <p>Manage store sidebar ads visible to all shoppers</p>
      </div>
    </div>

    <!-- Create Ad Form -->
    <div class="app-card" style="margin-bottom:32px;">
      <div class="app-card-title"><i class="fas fa-plus-circle" style="color:#008B8B;margin-right:8px;"></i>Add New Featured Ad</div>
      <form action="/superadmin/ads/create" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>Product Name <span style="color:#c0392b;">*</span></label>
            <input type="text" name="productName" class="form-control" placeholder="e.g. Premium Wireless Headphones" required>
          </div>
          <div class="form-group">
            <label>Business / Store Name</label>
            <input type="text" name="businessName" class="form-control" placeholder="e.g. TechHub Store">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Store URL <span style="color:#c0392b;">*</span></label>
            <div style="display:flex;gap:8px;align-items:center;">
              <select name="_storeSelect" class="form-control" id="storeSelect" style="max-width:180px;" onchange="prefillStoreUrl(this)">
                <option value="">— Pick a store —</option>
                <% admins.forEach(a => { %>
                  <option value="/store/<%= a.username %>" data-biz="<%= a.businessName || a.username %>"><%= a.businessName || a.username %></option>
                <% }) %>
              </select>
              <span style="color:#aaa;font-size:0.8rem;">or type manually:</span>
            </div>
            <input type="text" name="storeUrl" id="storeUrlInput" class="form-control" style="margin-top:8px;" placeholder="/store/username" required>
          </div>
          <div class="form-group">
            <label>Product Image URL</label>
            <input type="text" name="imageUrl" class="form-control" placeholder="https://example.com/image.jpg">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Price</label>
            <input type="number" name="price" class="form-control" placeholder="0.00" min="0" step="0.01">
          </div>
          <div class="form-group">
            <label>Currency</label>
            <input type="text" name="currency" class="form-control" placeholder="₦" value="₦" maxlength="5">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Short Description</label>
            <input type="text" name="description" class="form-control" placeholder="One-line teaser (optional)">
          </div>
          <div class="form-group">
            <label>Sidebar Position</label>
            <select name="position" class="form-control">
              <option value="both">Both sidebars</option>
              <option value="left">Left sidebar only</option>
              <option value="right">Right sidebar only</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn-primary-app" style="margin-top:8px;">
          <i class="fas fa-plus"></i> Create Ad
        </button>
      </form>
    </div>

    <!-- Ads List -->
    <div class="page-header" style="margin-bottom:16px;">
      <div><h2 style="font-size:1.15rem;font-weight:700;color:#0d0d1a;margin:0;">Active & Inactive Ads</h2></div>
      <span style="font-size:0.85rem;color:#888;"><%= ads.length %> total</span>
    </div>

    <% if (ads.length === 0) { %>
      <div class="app-card" style="text-align:center;padding:60px;">
        <i class="fas fa-ad" style="font-size:3rem;color:#ddd;display:block;margin-bottom:16px;"></i>
        <p style="color:#999;">No ads yet. Create one above.</p>
      </div>
    <% } else { %>
      <div class="ad-grid">
        <% ads.forEach(ad => { %>
          <div class="ad-card <%= ad.isActive ? '' : 'ad-inactive' %>">
            <div class="ad-card-img">
              <% if (ad.imageUrl) { %>
                <img src="<%= ad.imageUrl %>" alt="<%= ad.productName %>" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                <div class="ad-no-img" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;"><i class="fas fa-image"></i></div>
              <% } else { %>
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;"><i class="fas fa-image ad-no-img"></i></div>
              <% } %>
            </div>
            <div class="ad-card-body">
              <div class="ad-card-name"><%= ad.productName %></div>
              <% if (ad.businessName) { %>
                <div class="ad-card-store"><i class="fas fa-store" style="margin-right:4px;"></i><%= ad.businessName %></div>
              <% } %>
              <% if (ad.description) { %>
                <div class="ad-card-desc"><%= ad.description %></div>
              <% } %>
              <div class="ad-card-price"><%= ad.currency %><%= ad.price ? ad.price.toLocaleString('en-US', {minimumFractionDigits:2,maximumFractionDigits:2}) : '—' %></div>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <span class="ad-card-position" style="background:<%= ad.position==='both'?'rgba(0,139,139,0.1)':ad.position==='left'?'rgba(52,152,219,0.1)':'rgba(155,89,182,0.1)' %>;color:<%= ad.position==='both'?'#008B8B':ad.position==='left'?'#2980b9':'#8e44ad' %>">
                  <%= ad.position === 'both' ? 'Both' : ad.position === 'left' ? 'Left' : 'Right' %>
                </span>
                <span class="badge <%= ad.isActive ? 'badge-success' : 'badge-secondary' %>">
                  <%= ad.isActive ? 'Active' : 'Inactive' %>
                </span>
              </div>
              <div class="ad-card-actions">
                <form action="/superadmin/ads/toggle/<%= ad._id %>" method="POST" style="flex:1;">
                  <button type="submit" class="btn-secondary-app btn-sm" style="width:100%;">
                    <i class="fas fa-<%= ad.isActive ? 'pause' : 'play' %>"></i>
                    <%= ad.isActive ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
                <form action="/superadmin/ads/delete/<%= ad._id %>" method="POST" onsubmit="return confirm('Delete this ad?')">
                  <button type="submit" class="btn-danger-app btn-sm">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
              <div style="margin-top:10px;">
                <a href="<%= ad.storeUrl %>" target="_blank" style="font-size:0.78rem;color:#008B8B;text-decoration:none;">
                  <i class="fas fa-external-link-alt"></i> <%= ad.storeUrl %>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  function prefillStoreUrl(sel) {
    if (!sel.value) return;
    document.getElementById('storeUrlInput').value = sel.value;
    const opt = sel.options[sel.selectedIndex];
    const biz = opt.dataset.biz || '';
    const bizInput = document.querySelector('input[name="businessName"]');
    if (bizInput && !bizInput.value) bizInput.value = biz;
  }
</script>
</body>
</html>
