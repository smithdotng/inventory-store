<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Outlet Sales Form | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Outlet Sales Form</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
  </head>
  <body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <div class="logo-container">
        <img src="/images/logo-a.png" alt="Shedfactory Business Solutions">
      </div>
      <h2>Welcome, <%= outlet.name %>!</h2>
        <a href="/outlet/sales-form" class="active">Point of Sale</a>
        <a href="/outlet/<%= outlet._id %>/stock-view">View Inventory</a>
        <a href="/outlet-transactions/<%= outlet._id %>">View Transactions</a>
        <a href="/outlet-customers/<%= outlet._id %>">Customers</a>
        <a href="/outlet-logout">Log Out</a>
    </div>

    <!-- Toggle Button -->
    <button class="toggle-btn" id="toggleBtn">☰</button>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
      <div class="container">
        <div class="content-logo-container">
          <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="<%= admin.businessName || 'Shed' %>">
        </div>
        <h1>Outlet Sales Form</h1>
        <div class="form-section">
          <form id="salesForm" action="/outlet/sales-form" method="POST">
            <!-- Customer Details -->
            <input type="text" name="customerName" placeholder="Customer Name" required>
            <input type="text" name="phoneNumber" placeholder="Phone Number">
            <input type="email" name="email" placeholder="Email Address">

            <!-- Items Section -->
            <div id="itemsContainer">
              <div class="item-row">
                <select name="itemId" class="item-select" required>
                  <option value="">Select Product</option>
                  <% inventory.forEach(item => { %>
                    <% if (item.stock > 0) { %>
                      <option value="<%= item.id %>" data-stock="<%= item.stock %>">
                        <%= item.name %> (Stock: <%= item.stock %>) - <%= admin.currency || '$' %><%= item.cost ? item.cost.toFixed(2) : '0.00' %>
                      </option>
                    <% } %>
                  <% }) %>
                </select>
                <input type="number" name="quantity" class="quantity-input" placeholder="Quantity" min="1" required>
                <button type="button" class="remove-btn" style="display: none;">Remove</button>
              </div>
            </div>

            <!-- Error Message -->
            <div id="errorMessage" class="error-message" style="display: none;">
              <span style="color: red;">Quantity exceeds available stock.</span>
            </div>

            <!-- Submit Button -->
            <button type="submit">Complete Sale</button>
          </form>
        </div>
      </div>
    </div>

    <!-- JavaScript -->
    <script>
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('mainContent');
      const toggleBtn = document.getElementById('toggleBtn');
      const itemsContainer = document.getElementById('itemsContainer');
      const salesForm = document.getElementById('salesForm');
      const errorMessage = document.getElementById('errorMessage');

      // Toggle sidebar visibility
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
        sidebar.classList.toggle('hidden');
        if (sidebar.classList.contains('visible')) {
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        } else {
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        }
      });

      // Hide error message by default
      errorMessage.style.display = 'none';

      // Validate item selection and quantity
      function validateForm() {
        const itemSelect = document.querySelector('.item-select');
        const quantityInput = document.querySelector('.quantity-input');
        
        if (!itemSelect || !quantityInput) return true;
        
        const selectedOption = itemSelect.options[itemSelect.selectedIndex];
        if (!selectedOption || !selectedOption.value) return true;
        
        const stock = parseInt(selectedOption.getAttribute('data-stock'));
        const quantity = parseInt(quantityInput.value) || 0;
        
        if (quantity > stock) {
          errorMessage.style.display = 'block';
          return false;
        } else {
          errorMessage.style.display = 'none';
          return true;
        }
      }

      // Attach validation to form elements
      document.querySelector('.item-select')?.addEventListener('change', validateForm);
      document.querySelector('.quantity-input')?.addEventListener('input', validateForm);

      // Form submission validation
      salesForm.addEventListener('submit', (event) => {
        if (!validateForm()) {
          event.preventDefault();
        }
      });

      // Responsive adjustments
      function handleResize() {
        if (window.innerWidth > 768) {
          sidebar.classList.add('visible');
          sidebar.classList.remove('hidden');
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        } else {
          sidebar.classList.remove('visible');
          sidebar.classList.add('hidden');
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        }
      }

      window.addEventListener('resize', handleResize);
      handleResize(); // Initialize on load
    </script>
  </body>
</html>