<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | My Cart</title>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Jost', sans-serif; background: #f7f7f8; color: #222; }
    .topbar { background: #0d0d1a; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
    .topbar img { height: 34px; }
    .topbar-links a { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem; margin-left: 20px; }
    .topbar-links a:hover { color: #FF9800; }
    .wrap { max-width: 900px; margin: 0 auto; padding: 36px 20px 100px; }
    h1 { font-size: 1.6rem; margin-bottom: 22px; }
    .warn-banner { background: #fff8ec; border: 1px solid #ffd699; color: #b26a00; border-radius: 10px; padding: 12px 16px; font-size: 0.88rem; margin-bottom: 20px; }
    .store-group { background: #fff; border-radius: 14px; padding: 22px 24px; margin-bottom: 18px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
    .store-group.locked { opacity: 0.55; }
    .store-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .store-head h3 { font-size: 1.05rem; }
    .locked-tag { background: #fdecea; color: #c0392b; font-size: 0.72rem; font-weight: 700; padding: 3px 9px; border-radius: 20px; }
    .cart-line { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-top: 1px solid #f0f0f0; }
    .cart-line:first-of-type { border-top: none; }
    .cart-line img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; background: #f0f0f0; }
    .cart-line .name { flex: 1; font-size: 0.92rem; font-weight: 500; }
    .qty-controls { display: flex; align-items: center; gap: 8px; }
    .qty-btn { width: 26px; height: 26px; border-radius: 6px; border: 1px solid #ddd; background: #fafafa; cursor: pointer; font-weight: 700; }
    .qty-controls span { min-width: 20px; text-align: center; font-weight: 600; }
    .line-total { min-width: 90px; text-align: right; font-weight: 600; }
    .remove-btn { background: none; border: none; color: #c0392b; cursor: pointer; font-size: 0.9rem; }
    .store-subtotal { text-align: right; margin-top: 12px; font-weight: 700; color: #FF9800; }
    .summary { background: #fff; border-radius: 14px; padding: 22px 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); position: sticky; bottom: 20px; }
    .summary-row { display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; margin-bottom: 14px; }
    .checkout-btn { width: 100%; padding: 14px; background: #FF9800; color: #fff; border: none; border-radius: 10px; font-size: 1rem; font-weight: 700; cursor: pointer; }
    .checkout-btn:hover { background: #e68900; }
    .checkout-btn:disabled { background: #ccc; cursor: default; }
    .empty-state { text-align: center; color: #999; padding: 60px 0; }
    .empty-state a { color: #FF9800; font-weight: 600; text-decoration: none; }
  </style>
</head>
<body>
  <div class="topbar">
    <a href="/"><img src="/images/logo.png" alt="Shed"></a>
    <div class="topbar-links">
      <a href="/search">Browse Stores</a>
      <a href="/shopper/account">My Account</a>
      <a href="/shopper/logout">Log Out</a>
    </div>
  </div>

  <div class="wrap">
    <h1>My Cart</h1>

    <% if (removedUnavailable) { %>
      <div class="warn-banner"><i class="fas fa-triangle-exclamation"></i> Some items in your cart were removed or reduced because they went out of stock.</div>
    <% } %>

    <% if (!groups.length) { %>
      <div class="empty-state">Your cart is empty. <a href="/search">Find something to buy</a>.</div>
    <% } else { %>
      <% groups.forEach(function(g) { %>
        <div class="store-group <%= g.locked ? 'locked' : '' %>" data-admin-id="<%= g.adminId %>">
          <div class="store-head">
            <h3><%= g.storeName %></h3>
            <% if (g.locked) { %><span class="locked-tag">Unavailable right now</span><% } %>
          </div>
          <% g.items.forEach(function(item) { %>
            <div class="cart-line" data-item-id="<%= item.itemId %>">
              <img src="<%= item.image || '/images/default-product.png' %>" onerror="this.src='/images/default-logo.png'">
              <div class="name"><%= item.name %></div>
              <div class="qty-controls">
                <button class="qty-btn" onclick="updateQty('<%= g.adminId %>','<%= item.itemId %>', <%= item.quantity - 1 %>)">−</button>
                <span><%= item.quantity %></span>
                <button class="qty-btn" onclick="updateQty('<%= g.adminId %>','<%= item.itemId %>', <%= item.quantity + 1 %>)">+</button>
              </div>
              <div class="line-total"><%= g.currency %><%= item.lineTotal.toLocaleString('en-US', {minimumFractionDigits:2}) %></div>
              <button class="remove-btn" onclick="removeItem('<%= g.adminId %>','<%= item.itemId %>')"><i class="fas fa-trash"></i></button>
            </div>
          <% }); %>
          <div class="store-subtotal">Subtotal: <%= g.currency %><%= g.subtotal.toLocaleString('en-US', {minimumFractionDigits:2}) %></div>
        </div>
      <% }); %>

      <div class="summary">
        <div class="summary-row"><span>Total</span><span>₦<%= grandTotal.toLocaleString('en-US', {minimumFractionDigits:2}) %></span></div>
        <button class="checkout-btn" id="checkoutBtn" onclick="startCheckout()" <%= groups.every(g => g.locked) ? 'disabled' : '' %>>
          Checkout Securely with Flutterwave
        </button>
      </div>
    <% } %>
  </div>

  <script>
    async function updateQty(adminId, itemId, quantity) {
      await fetch('/cart/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adminId, itemId, quantity })
      });
      location.reload();
    }
    async function removeItem(adminId, itemId) {
      await fetch('/cart/remove', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adminId, itemId })
      });
      location.reload();
    }
    async function startCheckout() {
      const btn = document.getElementById('checkoutBtn');
      btn.disabled = true;
      btn.textContent = 'Redirecting to secure checkout…';
      try {
        const res = await fetch('/cart/checkout', { method: 'POST' });
        const data = await res.json();
        if (data.link) {
          window.location.href = data.link;
        } else {
          alert(data.error || 'Could not start checkout. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Checkout Securely with Flutterwave';
        }
      } catch (err) {
        alert('Could not start checkout. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Checkout Securely with Flutterwave';
      }
    }
  </script>
</body>
</html>
