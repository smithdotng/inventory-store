                                                        <option value="GHS" <%= typeof currency !== 'undefined' && currency === 'GHS' ? 'selected' : '' %>>Ghanaian Cedi (GHS)</option>
                                                        <option value="KES" <%= typeof currency !== 'undefined' && currency === 'KES' ? 'selected' : '' %>>Kenyan Shilling (KES)</option>
