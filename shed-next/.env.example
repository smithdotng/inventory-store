# Copy to .env.local. Variable names match the old Express .env, so you can copy that file over.

# --- Database (required) ---
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/shed
# Optional: database name if it isn't in the URI
DB_NAME=
# Optional: database that holds the `sessions` collection (defaults to the URI's database, same as connect-mongo)
SESSION_DB_NAME=

# --- Sessions (required) — use the SAME value as the Express app so existing logins keep working ---
SESSION_SECRET=change-me

# --- Public URL used in emails, payment redirects and share links ---
BASE_URL=https://shed.ng

# --- Email (Hostinger SMTP by default) ---
EMAIL_USER=noreply@shed.ng
EMAIL_PASS=
BUSINESS_USER=stanley@shed.ng
CONTACT_INBOX=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# --- Flutterwave (online card payments + seller subscriptions) ---
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_CURRENCY=NGN
SUBSCRIPTION_AMOUNT=

# --- Files ---
# Where uploaded product photos / logos live. Default ../public/uploads shares them with the Express app.
# After retiring Express, move that folder and point this at it, e.g. ./uploads
UPLOADS_DIR=../public/uploads
# Folder the invoice PDFs read store logos from (default ../public)
LEGACY_PUBLIC_DIR=../public

# --- Scheduled subscription sweep (trial reminders, expiry, renewals) ---
# Protects GET /api/cron/subscriptions. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Set to "off" to disable the built-in daily 03:00 timer (e.g. if you use an external cron)
INTERNAL_CRON=

# --- Optional, during migration only ---
# Any URL this app doesn't handle is proxied to the old Express app.
LEGACY_APP_URL=

# --- Social sharing (optional) ---
# Twitter/X handle added to share cards, e.g. @shedng
TWITTER_HANDLE=
