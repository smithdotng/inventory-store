<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="/style.css">

</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <div class="logo-container">
      <img src="/images/logo.png" alt="Shedfactory Business Solutions">
    </div>
    <button class="toggle-btn" id="toggleBtn">☰</button>
    <h2>Welcome, <%= username %>!</h2>
    <a href="/admin-sales-form">Sell</a>
    <a href="/store-view">View Store</a>
    <a href="/update-stock">Update Stock</a>
    <a href="/create-outlet">Create Outlet</a>
    <a href="/invoices">Invoices</a>
    <a href="/transactions">Transactions</a>
    <a href="/admin-logout">Log Out</a>
  </div>

  <!-- Toggle Button (Visible on Small Screens) -->
  <button class="toggle-btn" id="toggleBtn">☰</button>

  <!-- Main Content -->
  <div class="main-content" id="mainContent" style="padding-left: 50px;">
    <div class="welcome-message">
      Welcome, <%= username %>!
    </div>
    <div class="container" style="justify-self: center;">
      <div class="content-logo-container">
        <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
      </div>
      <h1>Store Inventory <span class="icon-shopping-cart" style="margin-left: 10px;"></span></h1>
      <div class="table-section">
        <table>
          <thead>
            <tr class="bg-gray-200">
              <th>Product <span class="icon-consumer-behavior"></span></th>
              <th>Stock <span class="icon-analysis"></span></th>
              <th>Dispense Quantity <span class="icon-point-of-sale"></span></th>
              <th>Action <span class="icon-strategy"></span></th>
            </tr>
          </thead>
          <tbody>
            <% inventory.forEach(item => { %>
              <tr class="border-b">
                <td><%= item.name %></td>
                <td><%= item.stock %></td>
                <td>
                  <form action="/dispense" method="POST" class="form-group">
                    <input type="hidden" name="id" value="<%= item._id %>">
                    <input type="number" name="quantity" min="1" max="<%= item.stock %>" value="1" required>
                  </form>
                </td>
                <td>
                  <div class="action-buttons">
                    <form action="/dispense" method="POST" class="form-group">
                      <input type="hidden" name="id" value="<%= item._id %>">
                      <button type="submit" class="dispense-btn <%= item.stock === 0 ? 'disabled' : '' %>" <%= item.stock === 0 ? 'disabled' : '' %>>Dispense <span class="icon-right-arrow"></span></button>
                    </form>
                    <form action="/delete-product" method="POST" class="form-group">
                      <input type="hidden" name="id" value="<%= item._id %>">
                      <button type="submit" class="delete-btn">Delete <span class="icon-trash"></span></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <a href="/update-stock">Go to Update Stock <span class="icon-right-arrow"></span></a>
    </div>
  </div>

  <!-- JavaScript for collapsing sidebar -->
  <script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggleBtn = document.getElementById('toggleBtn');

    // Sidebar toggle
    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('expanded');
      mainContent.classList.toggle('expanded');
    });
  </script>
</body>
</html>