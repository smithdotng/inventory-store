    <!-- Sidebar Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                const toggleBtn = document.getElementById('toggleBtn');

                const isSidebarHidden = localStorage.getItem('sidebarHidden') === 'true';
                if (isSidebarHidden) {
                    sidebar.classList.add('hidden');
                    mainContent.classList.add('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-bars"></i>';
                } else {
                    sidebar.classList.remove('hidden');
                    mainContent.classList.remove('full-width');
                    toggleBtn.innerHTML = '<i class="fas fa-times"></i>';
                }

                toggleBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('hidden');
                    mainContent.classList.toggle('full-width');
                    toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '<i class="fas fa-bars"></i>' : '<i class="fas fa-times"></i>';
                    localStorage.setItem('sidebarHidden', sidebar.classList.contains('hidden'));
                });

                function setSidebarState() {
                    if (sidebar.classList.contains('hidden')) {
                        mainContent.classList.add('full-width');
                    } else {
                        mainContent.classList.remove('full-width');
                    }
                }
                setSidebarState();
                window.addEventListener('resize', setSidebarState);
            } catch (error) {
                console.error('Error initializing sidebar:', error);
            }
        });
    </script>

    <!-- Profile Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const editProfileBtn = document.getElementById('editProfileBtn');
                const cancelEditBtn = document.getElementById('cancelEditBtn');
                const profileView = document.getElementById('profileView');
                const profileEdit = document.getElementById('profileEdit');

                // Debug: Verify elements exist
                console.log('editProfileBtn:', editProfileBtn);
                console.log('profileView:', profileView);
                console.log('profileEdit:', profileEdit);

                // Toggle edit mode
                if (editProfileBtn) {
                    editProfileBtn.addEventListener('click', () => {
                        console.log('Edit Profile button clicked');
                        if (profileView && profileEdit) {
                            profileView.classList.add('hidden');
                            profileEdit.classList.remove('hidden');
                        } else {
                            console.error('Profile view or edit section not found');
                        }
                    });
                } else {
                    console.error('Edit Profile button not found');
                }

                // Cancel edit mode
                if (cancelEditBtn) {
                    cancelEditBtn.addEventListener('click', () => {
                        console.log('Cancel button clicked');
                        if (profileView && profileEdit) {
                            profileEdit.classList.add('hidden');
                            profileView.classList.remove('hidden');
                            const form = document.getElementById('updateProfileForm');
                            if (form) form.reset();
                            const imagePreview = document.getElementById('imagePreview');
                            const imagePlaceholder = document.getElementById('imagePlaceholder');
                            const croppedImageData = document.getElementById('croppedImageData');
                            if (imagePreview && imagePlaceholder && croppedImageData) {
                                imagePreview.src = '<%= admin.logo || "#" %>';
                                imagePreview.classList.toggle('hidden', !'<%= admin.logo %>');
                                imagePlaceholder.classList.toggle('hidden', '<%= admin.logo %>');
                                croppedImageData.value = '';
                            }
                        } else {
                            console.error('Profile view or edit section not found');
                        }
                    });
                } else {
                    console.error('Cancel button not found');
                }

                // Cropper.js logic
                let cropper;
                const cropModal = document.getElementById('cropModal');
                const logoInput = document.getElementById('logoInput');
                const imageToCrop = document.getElementById('imageToCrop');
                const imagePreview = document.getElementById('imagePreview');
                const imagePlaceholder = document.getElementById('imagePlaceholder');
                const croppedImageData = document.getElementById('croppedImageData');

                // Function to show modal
                const showModal = () => {
                    if (cropModal) {
                        cropModal.classList.add('show');
                        cropModal.setAttribute('aria-hidden', 'false');
                        document.body.classList.add('modal-open');
                        const backdrop = document.createElement('div');
                        backdrop.className = 'modal-backdrop fade show';
                        document.body.appendChild(backdrop);
                    }
                };

                // Function to close modal
                const closeModal = () => {
                    if (cropModal) {
                        cropModal.classList.remove('show');
                        cropModal.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('modal-open');
                        const backdrop = document.querySelector('.modal-backdrop');
                        if (backdrop) backdrop.remove();
                    }
                    if (cropper) {
                        cropper.destroy();
                        cropper = null;
                    }
                };

                if (logoInput) {
                    logoInput.addEventListener('change', function(e) {
                        const files = e.target.files;
                        if (files && files.length > 0) {
                            const reader = new FileReader();
                            reader.onload = function(event) {
                                if (imageToCrop) {
                                    imageToCrop.src = event.target.result;
                                    showModal();
                                    setTimeout(() => {
                                        if (cropper) cropper.destroy();
                                        cropper = new Cropper(imageToCrop, {
                                            aspectRatio: 1,
                                            viewMode: 1,
                                            autoCropArea: 0.8,
                                            responsive: true,
                                            zoomable: true,
                                            scalable: true,
                                            movable: true,
                                            background: true,
                                            minContainerHeight: 300,
                                        });
                                    }, 500);
                                }
                            };
                            reader.readAsDataURL(files[0]);
                        }
                    });
                }

                // Crop button
                const cropButton = document.getElementById('cropButton');
                if (cropButton) {
                    cropButton.addEventListener('click', () => {
                        if (cropper && imagePreview && imagePlaceholder && croppedImageData) {
                            const canvas = cropper.getCroppedCanvas({
                                width: 200,
                                height: 200,
                                imageSmoothingEnabled: true,
                                imageSmoothingQuality: 'high',
                            });
                            const croppedDataUrl = canvas.toDataURL('image/png');
                            imagePreview.src = croppedDataUrl;
                            imagePreview.classList.remove('hidden');
                            imagePlaceholder.classList.add('hidden');
                            croppedImageData.value = croppedDataUrl;
                            closeModal();
                        }
                    });
                }

                // Cancel crop button
                const cropCancelButton = document.getElementById('cropCancelButton');
                if (cropCancelButton) {
                    cropCancelButton.addEventListener('click', () => {
                        closeModal();
                        if (imageToCrop && logoInput) {
                            imageToCrop.src = '#';
                            logoInput.value = '';
                        }
                    });
                }

                // Close modal button
                const cropModalCloseBtn = document.getElementById('cropModalCloseBtn');
                if (cropModalCloseBtn) {
                    cropModalCloseBtn.addEventListener('click', () => {
                        closeModal();
                        if (imageToCrop && logoInput) {
                            imageToCrop.src = '#';
                            logoInput.value = '';
                        }
                    });
                }
            } catch (error) {
                console.error('Error initializing profile scripts:', error);
            }
        });
    </script>
