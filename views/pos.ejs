<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GJRGT3KCZ7"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-GJRGT3KCZ7');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shed | Point of Sale – Fast & Simple Sales</title>
    <meta name="description" content="Record sales quickly and accurately – perfect for your business">

    <!-- favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- vendor css -->
    <link rel="stylesheet" href="asset1/css/bootstrap.min.css">
    <link rel="stylesheet" href="asset1/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="asset1/css/swiper.min.css">
    <link rel="stylesheet" href="asset1/css/animate.min.css">
    <link rel="stylesheet" href="asset1/css/magnific-popup.css">
    <link rel="stylesheet" href="asset1/css/bootstrap-select.min.css">

    <!-- template styles -->
    <link rel="stylesheet" href="asset1/css/main.css">
    <link rel="stylesheet" href="asset1/css/rtl.css">

    <style>
        :root {
            --primary: #e74c3c;
            --success: #27ae60;
            --info: #17a2b8;
            --warning: #f39c12;
            --danger: #c0392b;
        }

        .main-header__two { position: relative; z-index: 91; }

        .sidebar-nav {
            position: fixed;
            left: -280px;
            top: 0; bottom: 0;
            width: 280px;
            background: #2c3e50;
            color: white;
            transition: left .35s ease;
            z-index: 9999;
            padding-top: 100px;
        }

        .sidebar-nav.active { left: 0; }

        .sidebar-nav a {
            color: white;
            display: block;
            padding: 14px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active { background: rgba(255,255,255,0.08); }

        .mobile-nav__toggler {
            font-size: 28px;
            color: white;
            background: none;
            border: none;
            cursor: pointer;
        }

        .pos-form-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
            padding: 40px;
            margin-bottom: 50px;
        }

        .item-row {
            display: flex;
            gap: 15px;
            align-items: flex-start;
            margin-bottom: 25px;
            flex-wrap: wrap;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .item-row:hover {
            background: #f1f3f5;
        }

        .product-search-input {
            flex: 2;
            min-width: 220px;
        }

        .quantity-input {
            width: 110px;
        }

        .remove-btn {
            width: 45px;
            height: 45px;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .search-results {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            max-height: 240px;
            overflow-y: auto;
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            z-index: 100;
            display: none;
        }

        .search-result-item {
            padding: 12px 15px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
            transition: background 0.2s;
        }

        .search-result-item:hover,
        .search-result-item.highlighted {
            background: #e9ecef;
        }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .total-section {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 12px;
            margin: 30px 0;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
            text-align: right;
        }

        @media (max-width: 991px) {
            .item-row { flex-direction: column; }
            .product-search-input, .quantity-input { width: 100% !important; }
        }
    </style>
</head>
<body>



<div class="page-wrapper">

    <!-- header -->
    <div class="main-header__two">
        <div class="header-upper">
            <div class="container">
                <div class="logo-box">
                    <a href="/home">
                        <img src="/images/logo.png" width="140" alt="Shed">
                    </a>
                    <button type="button" class="mobile-nav__toggler">
                        <i class="fa fa-bars"></i>
                    </button>
                </div>

                <div class="header-info">
                    <div class="header-info__box">
                        <i class="azino-icon-email1"></i>
                        <div class="header-info__box-content">
                            <h3>Email</h3>
                            <p><a href="mailto:<%= admin.email %>"><%= admin.email || 'hello@shed.ng' %></a></p>
                        </div>
                    </div>
                    <div class="header-info__box">
                        <i class="azino-icon-calling"></i>
                        <div class="header-info__box-content">
                            <h3>Business</h3>
                            <p><%= admin.businessName || 'Your Business' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <nav class="main-menu">
            <div class="container">
                <ul class="main-menu__list">
                    <li class="active"><a href="/pos">Point of Sale</a></li>
                    <li><a href="/update-stock">Inventory</a></li>
                    <li><a href="/invoices">Invoices</a></li>
                    <li><a href="/transactions">Transactions</a></li>
                    <li><a href="/customers">Customers</a></li>
                    <li><a href="/home">Outlets</a></li>
                    <li><a href="/profile">Profile</a></li>
                </ul>
                <a href="/admin-logout" class="thm-btn dynamic-radius">Logout</a>
            </div>
        </nav>
    </div>

    <!-- mobile sidebar -->
    <div class="sidebar-nav" id="sidebarNav">
        <button type="button" class="mobile-nav__close mobile-nav__toggler" style="position:absolute;top:20px;right:25px;font-size:30px;color:white;">
            <i class="fa fa-times"></i>
        </button>

        <div style="padding: 0 30px;">
            <h3 style="color:white;margin-bottom:35px;">Menu</h3>
        </div>

        <a href="/pos" class="active"><i class="fas fa-shopping-bag mr-2"></i> Point of Sale</a>
        <a href="/update-stock"><i class="fas fa-boxes mr-2"></i> Manage Inventory</a>
        <a href="/invoices"><i class="fas fa-file-invoice mr-2"></i> Generate Invoice</a>
        <a href="/transactions"><i class="fas fa-chart-bar mr-2"></i> Transactions</a>
        <a href="/customers"><i class="fas fa-users mr-2"></i> Customers</a>
        <a href="/home"><i class="fas fa-store mr-2"></i> Manage Outlets</a>
        <a href="/profile"><i class="fas fa-user mr-2"></i> Profile</a>
        <a href="/admin-logout"><i class="fas fa-power-off mr-2"></i> Log Out</a>
    </div>

    <!-- banner -->
    <section class="main-slider main-slider__two">
        <div class="swiper-container thm-swiper__slider" data-swiper-options='{"slidesPerView": 1, "loop": true, "effect": "fade", "autoplay": {"delay": 6500}}'>
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <div class="image-layer" style="background-image: url(asset1/images/main-slider/slider-1-2.jpg);"></div>
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-xl-8">
                                <h2>Point of <span>Sale</span></h2>
                                <p>Fast, accurate sales recording – right at your fingertips</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- main content -->
    <section class="service-two pt-120 pb-120">
        <div class="container">

            <div class="row justify-content-center">
                <div class="col-xl-10">

                    <div class="pos-form-card wow fadeInUp" data-wow-duration="1000ms">
                        <div class="block-title text-center mb-50">
                            <p><img src="asset1/images/shapes/heart-2-1.png" width="15" alt=""> Quick Sales</p>
                            <h3>Record New Sale</h3>
                        </div>

                        <form id="salesForm" action="/admin/sales-form" method="POST">
                            <!-- Items -->
                            <div class="mb-40">
                                <h5 class="mb-20">Products</h5>
                                <div id="itemsContainer">
                                    <div class="item-row" data-index="0">
                                        <div class="product-search-input position-relative">
                                            <input type="text" class="form-control mil-product-search" placeholder="Search product..." autocomplete="off">
                                            <div class="search-results"></div>
                                            <select name="items[itemId][]" class="form-control mil-product-select d-none" required>
                                                <option value="">Select Product</option>
                                                <% inventory.forEach(item => { %>
                                                    <% if (item.stock > 0) { %>
                                                        <option value="<%= item._id %>" 
                                                                data-stock="<%= item.stock %>" 
                                                                data-price="<%= item.cost %>" 
                                                                data-name="<%= item.name %>">
                                                            <%= item.name %> (Stock: <%= item.stock %>) - <%= admin.currency %><%= Number(item.cost).toFixed(2) %>
                                                        </option>
                                                    <% } %>
                                                <% }) %>
                                            </select>
                                        </div>

                                        <input type="number" name="items[quantity][]" class="form-control quantity-input" placeholder="Qty" min="1" required>

                                        <button type="button" class="thm-btn dynamic-radius remove-btn" style="background:var(--danger); display:none;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>

                                <button type="button" id="addItemBtn" class="thm-btn dynamic-radius mt-20" style="background:var(--info);">
                                    <i class="fas fa-plus me-2"></i> Add Another Item
                                </button>
                            </div>

                            <!-- Customer -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Customer Name <span style="color:var(--danger)">*</span></label>
                                        <input type="text" name="customerName" class="form-control" placeholder="Walk-in / Customer name" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Phone Number</label>
                                        <input type="tel" name="phoneNumber" class="form-control" placeholder="0803 xxx xxxx">
                                    </div>
                                </div>
                            </div>

                            <!-- Payment -->
                            <div class="form-group">
                                <label>Payment Method <span style="color:var(--danger)">*</span></label>
                                <select name="paymentMethod" class="form-control selectpicker" required>
                                    <option value="">Choose payment method</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Card">Card</option>
                                    <option value="POS">POS Terminal</option>
                                    <option value="Transfer">Instant Transfer</option>
                                </select>
                            </div>

                            <!-- Total Preview -->
                            <div class="total-section" id="totalSection">
                                Total: <%= admin.currency %>0.00
                            </div>

                            <!-- Submit -->
                            <div class="text-center mt-50">
                                <button type="submit" class="thm-btn dynamic-radius btn-lg" style="background:var(--success); font-size:1.25rem; padding:16px 60px;">
                                    Record Sale <i class="fas fa-check-circle ms-3"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- footer -->
    <section class="site-footer">
        <div class="main-footer pt-120 pb-80">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <a href="/home">
                                <img src="/images/logo.png" width="140" alt="">
                            </a>
                            <p class="mt-3">Fast, reliable point of sale for your growing business.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Quick Links</h3>
                            <ul class="list-unstyled">
                                <li><a href="/update-stock">Inventory</a></li>
                                <li><a href="/invoices">Invoices</a></li>
                                <li><a href="/profile">Settings</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-widget mb-40">
                            <h3>Contact</h3>
                            <p><strong><%= admin.businessName || 'Your Business' %></strong><br>
                            <%= admin.email || 'No email set' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>© <%= new Date().getFullYear() %> Shed – All Rights Reserved</p>
            </div>
        </div>
    </section>

</div>

<div class="mobile-nav__overlay mobile-nav__toggler"></div>

<script src="asset1/js/jquery-3.5.1.min.js"></script>
<script src="asset1/js/bootstrap.bundle.min.js"></script>
<script src="asset1/js/swiper.min.js"></script>
<script src="asset1/js/wow.js"></script>
<script src="asset1/js/bootstrap-select.min.js"></script>
<script src="asset1/js/theme.js"></script>

<script>
$(document).ready(function(){
    // Mobile menu toggle
    $('.mobile-nav__toggler').click(function(e){
        e.preventDefault();
        $('#sidebarNav').toggleClass('active');
        $('.mobile-nav__overlay').toggleClass('active');
    });

    $('.mobile-nav__close, .mobile-nav__overlay').click(function(){
        $('#sidebarNav').removeClass('active');
        $('.mobile-nav__overlay').removeClass('active');
    });

    // --- POS Functionality ---
    let itemIndex = 1;
    const itemsContainer = $('#itemsContainer');
    const currency = '<%= admin.currency || "₦" %>';

    // Add new item row
    $('#addItemBtn').click(function(){
        const newRow = $(`
            <div class="item-row" data-index="${itemIndex}">
                <div class="product-search-input position-relative">
                    <input type="text" class="form-control mil-product-search" placeholder="Search product..." autocomplete="off">
                    <div class="search-results"></div>
                    <select name="items[itemId][]" class="form-control mil-product-select d-none" required>
                        <option value="">Select Product</option>
                        <% inventory.forEach(item => { %>
                            <% if (item.stock > 0) { %>
                                <option value="<%= item._id %>" 
                                        data-stock="<%= item.stock %>" 
                                        data-price="<%= item.cost %>" 
                                        data-name="<%= item.name %>">
                                    <%= item.name %> (Stock: <%= item.stock %>) - ${currency}<%= Number(item.cost).toFixed(2) %>
                                </option>
                            <% } %>
                        <% }) %>
                    </select>
                </div>

                <input type="number" name="items[quantity][]" class="form-control quantity-input" placeholder="Qty" min="1" required>

                <button type="button" class="thm-btn dynamic-radius remove-btn" style="background:var(--danger);">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        `);

        itemsContainer.append(newRow);
        initializeSearchableSelect(newRow);
        updateRemoveButtons();
        itemIndex++;
        calculateTotal();
    });

    // Remove item
    itemsContainer.on('click', '.remove-btn', function(){
        if ($('.item-row').length > 1) {
            $(this).closest('.item-row').remove();
            calculateTotal();
        }
    });

    // Initialize searchable select for each row
    function initializeSearchableSelect(row) {
        const searchInput = row.find('.mil-product-search');
        const select = row.find('.mil-product-select');
        const results = row.find('.search-results');
        const options = Array.from(select[0].options);

        searchInput.on('focus input', function(){
            const term = $(this).val().toLowerCase();
            results.empty().show();

            const filtered = options.filter(opt => 
                opt.textContent.toLowerCase().includes(term) && opt.value
            );

            if (filtered.length === 0) {
                results.append('<div class="search-result-item">No products found</div>');
                return;
            }

            filtered.forEach(opt => {
                const item = $(`<div class="search-result-item">${opt.textContent}</div>`);
                item.on('click', function(){
                    select.val(opt.value);
                    searchInput.val(opt.getAttribute('data-name'));
                    results.hide();
                    calculateTotal();
                });
                results.append(item);
            });
        });

        // Hide results on outside click
        $(document).on('click', function(e){
            if (!$(e.target).closest('.product-search-input').length) {
                $('.search-results').hide();
            }
        });
    }

    // Initial setup
    $('.item-row').each(function(){ initializeSearchableSelect($(this)); });

    function updateRemoveButtons() {
        $('.remove-btn').toggle($('.item-row').length > 1);
    }

    // Calculate total (real-time preview)
    function calculateTotal() {
        let total = 0;
        $('.item-row').each(function(){
            const select = $(this).find('.mil-product-select');
            const qty = parseInt($(this).find('input[type="number"]').val()) || 0;
            if (select.val()) {
                const price = parseFloat(select.find('option:selected').data('price')) || 0;
                total += price * qty;
            }
        });
        $('#totalSection').text(`Total: ${currency}${total.toFixed(2)}`);
    }

    // Recalculate on changes
    itemsContainer.on('change input', 'select, input[type="number"]', calculateTotal);
    calculateTotal(); // Initial
});
</script>

</body>
</html>