<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shed | Referrals Dashboard</title>
  <%- include('partials/app-head', { extraCssUrl: '' }) %>
  <style>
    .stat-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
    .stat-card {
      background:#fff; border-radius:12px; padding:24px;
      box-shadow:0 2px 12px rgba(0,0,0,0.06);
      display:flex; align-items:center; gap:16px;
    }
    .stat-icon {
      width:50px; height:50px; border-radius:12px;
      background:rgba(0,139,139,0.1);
      display:flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .stat-icon i { font-size:1.3rem; color:#008B8B; }
    .stat-num { font-size:2rem; font-weight:700; color:#0d0d1a; line-height:1; }
    .stat-label { font-size:0.78rem; color:#999; text-transform:uppercase; letter-spacing:.05em; font-weight:700; margin-bottom:4px; }
    .share-grid { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
    .share-btn {
      display:inline-flex; align-items:center; gap:7px;
      padding:8px 14px; border-radius:7px; font-size:0.85rem; font-weight:600;
      text-decoration:none; cursor:pointer; border:none; font-family:'Jost',sans-serif;
      transition:all .15s;
    }
    .share-copy { background:rgba(0,139,139,0.1); color:#008B8B; }
    .share-copy:hover { background:#008B8B; color:#fff; }
    .share-email { background:rgba(52,152,219,0.1); color:#2980b9; }
    .share-email:hover { background:#2980b9; color:#fff; }
    .share-wa { background:rgba(37,211,102,0.1); color:#128c7e; }
    .share-wa:hover { background:#128c7e; color:#fff; }
    .share-tw { background:rgba(29,161,242,0.1); color:#1da1f2; }
    .share-tw:hover { background:#1da1f2; color:#fff; }
    .share-li { background:rgba(0,119,181,0.1); color:#0077b5; }
    .share-li:hover { background:#0077b5; color:#fff; }
    .share-fb { background:rgba(24,119,242,0.1); color:#1877f2; }
    .share-fb:hover { background:#1877f2; color:#fff; }
    .link-box {
      background:#f8f9fa; border:1.5px solid #e0e0e0; border-radius:8px;
      padding:12px 16px; font-family:monospace; font-size:0.9rem;
      color:#444; word-break:break-all; margin-bottom:12px;
    }
  </style>
</head>
<body>

<!-- Referral Sidebar -->
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-logo"><img src="/images/logo.png" alt="Shed"></div>
  <nav class="sidebar-nav">
    <a href="/referrals-dashboard" class="active"><i class="fas fa-chart-line"></i> Dashboard</a>
  </nav>
  <div class="sidebar-bottom">
    <a href="/referral-logout"><i class="fas fa-power-off"></i> Log Out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="app-main">
  <header class="app-topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" id="hamburgerBtn"><i class="fas fa-bars"></i></button>
      <span class="page-title">Referrals Dashboard</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-business">Affiliate Portal</span>
      <div class="topbar-user-chip">
        <div class="avatar"><%= (affiliate && affiliate.email ? affiliate.email[0] : 'A').toUpperCase() %></div>
        <%= affiliate && affiliate.email ? affiliate.email : 'Affiliate' %>
      </div>
    </div>
  </header>

  <main class="app-content">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <div class="page-header">
      <div><h1>Your Referrals</h1><p>Track your clicks and signups</p></div>
    </div>

    <!-- Stats -->
    <div class="stat-row">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-mouse-pointer"></i></div>
        <div>
          <div class="stat-label">Total Clicks</div>
          <div class="stat-num"><%= clickCount %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-user-plus"></i></div>
        <div>
          <div class="stat-label">Signups</div>
          <div class="stat-num" style="color:#008B8B;"><%= signupCount %></div>
        </div>
      </div>
    </div>

    <!-- Referral link -->
    <div class="app-card" style="margin-bottom:24px;">
      <div class="app-card-title">Your Referral Link</div>
      <% if (referralLink) { %>
        <div class="link-box" id="refLinkBox"><%= referralLink %></div>
        <div class="share-grid">
          <button onclick="copyLink('<%= referralLink %>')" class="share-btn share-copy">
            <i class="fas fa-copy"></i> Copy Link
          </button>
          <button onclick="shareEmail('<%= referralLink %>')" class="share-btn share-email">
            <i class="fas fa-envelope"></i> Email
          </button>
          <button onclick="shareWhatsApp('<%= referralLink %>')" class="share-btn share-wa">
            <i class="fab fa-whatsapp"></i> WhatsApp
          </button>
          <button onclick="shareTwitter('<%= referralLink %>')" class="share-btn share-tw">
            <i class="fab fa-twitter"></i> Twitter
          </button>
          <button onclick="shareLinkedIn('<%= referralLink %>')" class="share-btn share-li">
            <i class="fab fa-linkedin"></i> LinkedIn
          </button>
          <button onclick="shareFacebook('<%= referralLink %>')" class="share-btn share-fb">
            <i class="fab fa-facebook"></i> Facebook
          </button>
          <% if (navigator && navigator.share) { %>
          <button onclick="shareMore('<%= referralLink %>')" class="share-btn share-copy">
            <i class="fas fa-share-nodes"></i> More
          </button>
          <% } %>
        </div>
      <% } else { %>
        <p style="color:#999;">Your referral link is not yet available.</p>
      <% } %>
    </div>

    <!-- Activity log -->
    <div class="app-card">
      <div class="app-card-title">Activity Log</div>
      <% if (activities && activities.length > 0) { %>
        <div style="overflow-x:auto;">
          <table class="app-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Action</th>
                <th>User</th>
              </tr>
            </thead>
            <tbody>
              <% activities.forEach(activity => { %>
                <tr>
                  <td style="font-size:0.83rem; color:#888; white-space:nowrap;">
                    <%= new Date(activity.date).toLocaleString() %>
                  </td>
                  <td><%= activity.action %></td>
                  <td style="font-size:0.83rem;"><%= activity.userEmail || 'N/A' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align:center; padding:48px; color:#999;">
          <i class="fas fa-history" style="font-size:3rem; color:#ddd; margin-bottom:16px; display:block;"></i>
          No activity recorded yet. Share your link to get started.
        </div>
      <% } %>
    </div>

  </main>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script>
  document.getElementById('hamburgerBtn').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('active');
  });
  document.getElementById('sidebarOverlay').addEventListener('click', function() {
    document.getElementById('appSidebar').classList.remove('open');
    this.classList.remove('active');
  });

  function copyLink(link) {
    navigator.clipboard.writeText(link).then(function() {
      alert('Referral link copied!');
    }).catch(function() {
      const box = document.getElementById('refLinkBox');
      const range = document.createRange();
      range.selectNode(box);
      window.getSelection().removeAllRanges();
      window.getSelection().addRange(range);
      document.execCommand('copy');
      alert('Link copied!');
    });
  }
  function shareEmail(link) {
    window.location.href = 'mailto:?subject=Join Shed&body=Sign up using my referral link: ' + encodeURIComponent(link);
  }
  function shareWhatsApp(link) {
    window.open('https://wa.me/?text=' + encodeURIComponent('Check out Shed: ' + link), '_blank');
  }
  function shareTwitter(link) {
    window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent('Check out Shed — ' + link), '_blank');
  }
  function shareLinkedIn(link) {
    window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(link), '_blank');
  }
  function shareFacebook(link) {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(link), '_blank');
  }
  function shareMore(link) {
    if (navigator.share) {
      navigator.share({ title: 'Join Shed', url: link });
    }
  }
</script>
</body>
</html>
