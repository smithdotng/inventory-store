<!-- Shopper nav — small floating pill, safe to include on any public page
     without fighting that page's own header markup/CSS. -->
<style>
  #shedShopperBar {
    position: fixed; top: 14px; right: 14px; z-index: 99999;
    display: flex; align-items: center; gap: 8px;
    background: rgba(13,13,26,0.92); backdrop-filter: blur(6px);
    border-radius: 30px; padding: 7px 10px 7px 16px;
    font-family: 'Jost', Arial, sans-serif; box-shadow: 0 4px 18px rgba(0,0,0,0.18);
  }
  #shedShopperBar a { color: #fff; text-decoration: none; font-size: 0.82rem; font-weight: 500; white-space: nowrap; }
  #shedShopperBar a:hover { color: #FF9800; }
  #shedShopperBar .sb-cart { position: relative; background: #FF9800; color: #fff !important; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  #shedShopperBar .sb-cart-count { position: absolute; top: -4px; right: -4px; background: #c0392b; color: #fff; font-size: 0.62rem; font-weight: 700; min-width: 16px; height: 16px; border-radius: 8px; display: flex; align-items: center; justify-content: center; padding: 0 3px; }
  @media (max-width: 600px) { #shedShopperBar { top: auto; bottom: 14px; right: 14px; } }
</style>
<div id="shedShopperBar">
  <% if (typeof shopper !== 'undefined' && shopper) { %>
    <a href="/shopper/account"><i class="fas fa-user"></i> <%= shopper.firstName %></a>
    <a href="/shopper/logout" title="Log out"><i class="fas fa-sign-out-alt"></i></a>
  <% } else { %>
    <a href="/shopper/login">Log In</a>
    <a href="/shopper/register">Sign Up</a>
  <% } %>
  <a class="sb-cart" href="/cart" title="My Cart">
    <i class="fas fa-shopping-cart"></i>
    <span class="sb-cart-count" id="shedCartCount" style="display:none;">0</span>
  </a>
</div>
<script>
  fetch('/cart/count').then(r => r.json()).then(d => {
    const el = document.getElementById('shedCartCount');
    if (d.count > 0) { el.textContent = d.count; el.style.display = 'flex'; }
  }).catch(() => {});
</script>
