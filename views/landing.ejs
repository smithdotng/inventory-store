                <!-- about -->
                <section id="about">
                    <div class="container mil-p-120-30">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-lg-6 col-xl-5">
                                <div class="mil-mb-90">
                                    <h2 class="mil-up mil-mb-60">Discover <br>Our <span class="mil-thin">Solution</span></h2>
                                    <p class="mil-up mil-mb-30">Tired of juggling spreadsheets, losing track of inventory, or wasting hours on manual updates? Shed is your all-in-one platform designed to simplify operations, boost efficiency, and maximize profits for small and medium businesses.</p>
                                    <p class="mil-up mil-mb-60">Shed is perfect for anyone who has something to sell, retailers, wholesalers, service providers, and multi-location businesses.</p>
                                    <div class="mil-about-quote">
                                        <div class="mil-avatar mil-up">
                                            <img src="android-chrome-512x512.png" alt="Founder">
                                        </div>
                                        <h6 class="mil-quote mil-up">Sell <span class="mil-thin">Everywhere:</span><br> Manage <span class="mil-thin">Everything</span></h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="mil-about-photo mil-mb-90">
