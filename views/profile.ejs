<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="Profile | Shed: Inventory, Invoices and More" />
    <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
    <meta property="og:image" content="/android-chrome-512x512.png" />
    <title>Profile</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <style>
      .error-message {
        color: red;
        margin-bottom: 10px;
        font-weight: bold;
        padding: 5px;
        background-color: #ffe6e6;
        border: 1px solid red;
      }
      .hidden {
        display: none;
      }
      .profile-details p {
        margin: 10px 0;
      }
      .edit-form input, .edit-form select {
        display: block;
        width: 100%;
        margin-bottom: 10px;
      }
      .form-buttons {
        display: flex;
        gap: 10px;
        margin-top: 20px;
      }
      .cancel-btn {
        background-color: #ccc;
        color: #333;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
      }
      .cancel-btn:hover {
        background-color: #bbb;
      }
    </style>
  </head>
  <body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <div class="logo-container">
        <img src="/images/logo.png" alt="Shedfactory Business Solutions">
      </div>
      <h2>Welcome, <%= username %>!</h2>
      <a href="/admin/sales-form">Sell</a>
      <a href="/store-view">View Store</a>
      <a href="/update-stock">Update Stock</a>
      <a href="/create-outlet">Create Outlet</a>
      <a href="/invoices">Invoices</a>
      <a href="/transactions">Transactions</a>
      <a href="/customers">Customers</a>
      <a href="/profile">Profile</a>
      <a href="/admin-logout">Log Out</a>
    </div>

    <!-- Toggle Button -->
    <button class="toggle-btn" id="toggleBtn">☰</button>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
      <div class="container">
        <div class="content-logo-container">
          <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Shedfactory Business Solutions">
        </div>
        <h1>Profile</h1>

        <!-- Profile Details -->
        <div class="profile-details" id="profileDetails">
          <% if (error) { %>
            <div class="error-message"><%= error %></div>
          <% } %>
          <% if (success) { %>
            <div class="success-message"><%= success %></div>
          <% } %>
          <p><strong>Username:</strong> <%= admin.username %></p>
          <p><strong>Email:</strong> <%= admin.email %></p>
          <p><strong>Business Name:</strong> <%= admin.businessName || 'N/A' %></p>
          <p><strong>Currency:</strong> <%= admin.currency || 'N/A' %></p>
          <p><strong>Phone:</strong> <%= admin.phone || 'N/A' %></p>
          <p><strong>Address:</strong> <%= admin.address || 'N/A' %></p>
          <p><strong>Logo:</strong> <img src="<%= admin.logo || '/images/logo.jpg' %>" alt="Logo" style="max-width: 100px;"></p>
          <button class="create-btn" id="editProfileBtn">Edit Profile</button>
        </div>

        <!-- Edit Profile Form -->
        <div class="edit-form hidden" id="editProfileForm">
          <form id="updateProfileForm" action="/profile/update" method="POST" enctype="multipart/form-data">
            <input type="text" name="businessName" value="<%= admin.businessName || '' %>" placeholder="Business Name">
            <select name="currency">
              <option value="">Select Currency</option>
              <option value="USD" <%= admin.currency === 'USD' ? 'selected' : '' %>>USD</option>
              <option value="EUR" <%= admin.currency === 'EUR' ? 'selected' : '' %>>EUR</option>
              <option value="GBP" <%= admin.currency === 'GBP' ? 'selected' : '' %>>GBP</option>
              <!-- Add more currencies as needed -->
            </select>
            <input type="text" name="phone" value="<%= admin.phone || '' %>" placeholder="Phone Number">
            <input type="text" name="address" value="<%= admin.address || '' %>" placeholder="Address">
            <input type="file" name="logo" accept="image/*">
            <div class="form-buttons">
              <button type="submit" class="create-btn">Save Changes</button>
              <button type="button" class="cancel-btn" id="cancelEditBtn">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- JavaScript -->
    <script>
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('mainContent');
      const toggleBtn = document.getElementById('toggleBtn');
      const editProfileBtn = document.getElementById('editProfileBtn');
      const editProfileForm = document.getElementById('editProfileForm');
      const profileDetails = document.getElementById('profileDetails');
      const cancelEditBtn = document.getElementById('cancelEditBtn');

      // Toggle sidebar visibility
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('visible');
        sidebar.classList.toggle('hidden');
        if (sidebar.classList.contains('visible')) {
          mainContent.style.marginLeft = '200px';
          mainContent.style.width = 'calc(100% - 200px)';
        } else {
          mainContent.style.marginLeft = '0';
          mainContent.style.width = '100%';
        }
      });

      // Toggle edit form visibility
      editProfileBtn.addEventListener('click', () => {
        profileDetails.classList.add('hidden');
        editProfileForm.classList.remove('hidden');
      });

      // Cancel edit
      cancelEditBtn.addEventListener('click', () => {
        editProfileForm.classList.add('hidden');
        profileDetails.classList.remove('hidden');
        document.getElementById('updateProfileForm').reset();
      });
    </script>
  </body>
</html>