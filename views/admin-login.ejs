<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="Shed: Inventory, Invoices and More" />
  <meta property="og:description" content="Organize Your Business, Like a Well-Stocked Shed." />
  <meta property="og:image" content="/android-chrome-512x512.png" />
  <title>Login</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background-color: #f5f5f5;
      padding: 20px;
    }

    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 600px;
      background: white;
      padding: 30px;
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      text-align: center;
    }

    .logo-container img {
      width: 80%;
      max-width: 250px;
      margin-bottom: 20px;
    }

    .form-section {
      width: 100%;
    }

    h2 {
      margin-bottom: 20px;
    }

    .error {
      color: red;
      margin-bottom: 10px;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    input {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    button {
      padding: 12px;
      background-color: green;
      color: white;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: darkgreen;
    }

    .register-text {
      margin-top: 20px;
      font-size: 14px;
    }

    .register-text a {
      color: green;
      text-decoration: none;
      font-weight: bold;
    }

    @media (max-width: 768px) {
      .container {
        padding: 20px;
        width: 90%;
      }

      .logo-container img {
        max-width: 200px;
      }

      input {
        font-size: 14px;
      }

      button {
        font-size: 14px;
      }
    }
  </style>

</head>
<body>
  <div class="container">
    <!-- Logo above the form -->
    <div class="logo-container">
      <img src="/images/logo-a.png" alt="Yearnings Custom Store Logo">
    </div>

    <div class="form-section">
      <h2>Login to your Shed<span class="icon-verification"></span></h2>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/admin-login" method="POST">
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Login <span class="icon-right-arrow"></span></button>
      </form>
      <div class="register-text">
        You don't have an account? <a href="/admin-register">Register</a>
      </div>
    </div>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(reg => console.log('Service Worker registered:', reg))
          .catch(err => console.error('Service Worker registration failed:', err));
      });
    }
  </script>
</body>
</html>
